{{ 'rv-landing.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  RV landing page · Photo mosaic. Figma › Section - Gallery (A-DIY in real life) (6644:596):
  the first `photo` block is the large tile spanning two rows, the next six fill a 3×2 grid.
  On mobile the large tile runs full width above a 2-column grid.
{%- endcomment -%}

<div class="rv rv--stone rv-gallery"{% if section.settings.anchor_id != blank %} id="{{ section.settings.anchor_id | handle }}"{% endif %}>
  <div class="rv__inner rv-gallery__inner">
    <div class="rv-gallery__head">
      {%- if section.settings.heading != blank -%}
        <h2 class="rv-h2">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.intro != blank -%}
        <p class="rv-body">{{ section.settings.intro | escape }}</p>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="rv-gallery__grid">
        {%- for block in section.blocks -%}
          {%- if forloop.first -%}
            {%- assign tile_sizes = '(min-width: 1440px) 512px, (min-width: 750px) 36vw, calc(100vw - 40px)' -%}
          {%- else -%}
            {%- assign tile_sizes = '(min-width: 1440px) 275px, (min-width: 750px) 20vw, calc(50vw - 24px)' -%}
          {%- endif -%}
          {%- render 'rv-image', image: block.settings.image, alt: block.settings.alt, sizes: tile_sizes, attrs: block.shopify_attributes -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "RV · Photo mosaic",
  "tag": "section",
  "class": "section",
  "enabled_on": { "templates": ["page"] },
  "max_blocks": 7,
  "settings": [
    { "type": "text", "id": "anchor_id", "label": "Anchor ID" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "RV and Camper Deck Ideas for Your Seasonal Site" },
    { "type": "textarea", "id": "intro", "label": "Intro", "default": "The best RV deck ideas start with how you'll use the space. Here are four layouts you can build with A-DIY's standard kit sizes." }
  ],
  "blocks": [
    {
      "type": "photo",
      "name": "Photo",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "alt", "label": "Alt text (SEO)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "RV · Photo mosaic",
      "blocks": [
        { "type": "photo" }, { "type": "photo" }, { "type": "photo" }, { "type": "photo" },
        { "type": "photo" }, { "type": "photo" }, { "type": "photo" }
      ]
    }
  ]
}
{% endschema %}
