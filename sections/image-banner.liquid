{{ 'section-image-banner.css' | asset_url | stylesheet_tag }}
{%- liquid
  comment
    mobile_count is not computed until further down the file, so this guard reads the
    settings directly. A slider only exists when more than one mobile image is set.
  endcomment
  assign banner_mobile_images = 0
  if section.settings.mobile_image_1 != blank
    assign banner_mobile_images = banner_mobile_images | plus: 1
  endif
  if section.settings.mobile_image_2 != blank
    assign banner_mobile_images = banner_mobile_images | plus: 1
  endif
  if section.settings.mobile_image_3 != blank
    assign banner_mobile_images = banner_mobile_images | plus: 1
  endif
-%}
{%- if banner_mobile_images > 1 -%}
  <link rel="stylesheet" href="{{ 'swiper-bundle.min.css' | asset_url }}" media="print" onload="this.media='all'">
  <noscript>{{ 'swiper-bundle.min.css' | asset_url | stylesheet_tag }}</noscript>
{%- endif -%}

{%- style -%}
  #Banner-{{ section.id }}::after {
    opacity: {{ section.settings.image_overlay_opacity | divided_by: 100.0 }};
  }

  /* Swiper Mobile Specific Dots Styling */
  #Banner-{{ section.id }} .swiper-pagination-bullet-active {
    background: #755845;
  }

  /* Mobile vs Desktop Display Logic */
  {%- if section.settings.mobile_image_1 != blank or section.settings.mobile_image_2 != blank or section.settings.mobile_image_3 != blank -%}
    @media screen and (max-width: 749px) {
      #Banner-{{ section.id }} .desktop-banner-media {
        display: none !important;
      }
      #Banner-{{ section.id }} .mobile-banner-media {
        display: block !important;
      }
    }
    @media screen and (min-width: 750px) {
      #Banner-{{ section.id }} .mobile-banner-media {
        display: none !important;
      }
    }
  {%- endif -%}

  {%- if section.settings.image_height == 'adapt' -%}
    @media screen and (max-width: 749px) {
      {%- assign mobile_adapt_image = section.settings.mobile_image_1 | default: section.settings.image -%}
      {%- if mobile_adapt_image != blank -%}
        #Banner-{{ section.id }}::before,
        #Banner-{{ section.id }} .banner__media::before,
        #Banner-{{ section.id }}:not(.banner--mobile-bottom) .banner__content::before {
          padding-bottom: {{ 1 | divided_by: mobile_adapt_image.aspect_ratio | times: 100 }}%;
          content: '';
          display: block;
        }
      {%- endif -%}
    }

    @media screen and (min-width: 750px) {
      {%- if section.settings.image != blank -%}
        #Banner-{{ section.id }}::before,
        #Banner-{{ section.id }} .banner__media::before {
          padding-bottom: {{ 1 | divided_by: section.settings.image.aspect_ratio | times: 100 }}%;
          content: '';
          display: block;
        }
      {%- endif -%}
    }
  {%- endif -%}

  .banner__features-list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 1.5rem 3rem;
    margin-top: 1.5rem;
    width: 100%;
    margin-bottom: 1.5rem;
  }

  .banner__feature-item {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    color: #755845;
  }

  .banner__feature-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.8rem;
    height: 1.8rem;
    flex-shrink: 0;
  }

  .banner__feature-icon svg {
    width: 100%;
    height: 100%;
  }

  .review-badge-block {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 10px 0;
  }

  .review-badge__text {
    font-weight: 500;
    letter-spacing: 0.5px;
    text-transform: uppercase;
  }
  #Banner-{{ section.id }} .swiper-pagination {
    display: none !important;
  }
  @media screen and (max-width: 749px) {
    #Banner-{{ section.id }} {
      flex-direction: column;
    }
    
    #Banner-{{ section.id }} .banner__content {
      position: absolute !important;
      height: 100% !important;
      width: 100% !important;
      top: 0;
      left: 0;
      background: transparent !important;
    }
    
    #Banner-{{ section.id }}.banner--mobile-bottom::before {
      display: none !important;
    }
  }
{%- endstyle -%}

{%- liquid
  assign full_width = '100vw'
  assign widths = '375, 550, 750, 1100, 1500, 1780, 2000, 2400'

  if section.settings.image_behavior == 'ambient'
    assign half_width = '60vw'
    assign full_width = '120vw'
    assign stacked_sizes = '(min-width: 750px) 60vw, 120vw'
    assign widths = '450, 660, 900, 1320, 1800, 2136, 2400, 2880'
  elsif section.settings.image_behavior == 'fixed' or section.settings.image_behavior == 'zoom-in'
    assign half_width = '100vw'
    assign stacked_sizes = '100vw'
  else
    assign half_width = '50vw'
    assign stacked_sizes = '(min-width: 750px) 50vw, 100vw'
  endif

  assign fetch_priority = 'auto'
  if section.index == 1
    assign fetch_priority = 'high'
  endif

  comment
    Fallback alt text for the banner images. image_tag defaults to the media's own
    alt, which is blank whenever nobody filled it in in the Files admin - and this
    is the hero, so it is the worst place on the site to ship alt="".
  endcomment
  assign banner_alt_fallback = ''
  for block in section.blocks
    if block.type == 'heading' and block.settings.heading != blank
      assign banner_alt_fallback = block.settings.heading | strip_html
      break
    endif
  endfor
  assign banner_alt_fallback = banner_alt_fallback | default: shop.name
  comment
    Both banner sets ship in the same HTML and are switched with display:none, which
    does not prevent a download. These sizes hints tell the browser each set is
    effectively 0px wide outside its own breakpoint, so it picks the smallest
    candidate there instead of a full-width one.
  endcomment
  assign desktop_banner_sizes = '(max-width: 749px) 1px, 100vw'
  assign mobile_banner_sizes = '(min-width: 750px) 1px, 100vw'
  assign banner_image_alt = section.settings.image.alt | default: banner_alt_fallback
  assign banner_image_2_alt = section.settings.image_2.alt | default: banner_alt_fallback

  comment
    Counting uploaded mobile images
  endcomment
  assign mobile_count = 0
  if section.settings.mobile_image_1 != blank
    assign mobile_count = mobile_count | plus: 1
  endif
  if section.settings.mobile_image_2 != blank
    assign mobile_count = mobile_count | plus: 1
  endif
  if section.settings.mobile_image_3 != blank
    assign mobile_count = mobile_count | plus: 1
  endif
-%}

<div
  id="Banner-{{ section.id }}"
  class="{{ section.settings.custom_class }} banner banner--content-align-{{ section.settings.desktop_content_alignment }} banner--content-align-mobile-{{ section.settings.mobile_content_alignment }} banner--{{ section.settings.image_height }}{% if section.settings.stack_images_on_mobile and section.settings.image != blank and section.settings.image_2 != blank %} banner--stacked{% endif %}{% if section.settings.image_height == 'adapt' and section.settings.image != blank %} banner--adapt{% endif %}{% if section.settings.show_text_below %} banner--mobile-bottom{%- endif -%}{% if section.settings.show_text_box == false %} banner--desktop-transparent{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}"
>
  {%- comment -%} STANDARD DESKTOP IMAGES (STATIC) {%- endcomment -%}
  {%- if section.settings.image != blank -%}
    <div class="banner__media media desktop-banner-media{% if mobile_count > 0 %} desktop-image-only{% endif %}{% if section.settings.image_2 != blank %} banner__media-half{% endif %}{% if section.settings.image_behavior != 'none' %} animate--{{ section.settings.image_behavior }}{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
      {%- liquid
        assign image_height = section.settings.image.width | divided_by: section.settings.image.aspect_ratio
        if section.settings.image_2 != blank
          assign image_class = 'banner__media-image-half'
        endif
        if section.settings.image_2 != blank and section.settings.stack_images_on_mobile
          assign sizes = stacked_sizes
        elsif section.settings.image_2 != blank
          assign sizes = half_width
        else
          assign sizes = full_width
        endif
      -%}
      {{
        section.settings.image
        | image_url: width: 2400
        | image_tag:
          width: section.settings.image.width,
          height: image_height,
          class: image_class,
          alt: banner_image_alt,
          sizes: desktop_banner_sizes,
          widths: widths,
          fetchpriority: fetch_priority
      }}
    </div>
  {%- elsif section.settings.image_2 == blank and mobile_count == 0 -%}
    <div class="banner__media media placeholder desktop-banner-media">
      {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
    </div>
  {%- endif -%}

  {%- if section.settings.image_2 != blank -%}
    <div class="banner__media media desktop-banner-media{% if section.settings.image != blank %} banner__media-half{% endif %}{% if section.settings.image_behavior != 'none' %} animate--{{ section.settings.image_behavior }}{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
      {%- liquid
        assign image_height_2 = section.settings.image_2.width | divided_by: section.settings.image_2.aspect_ratio
        if section.settings.image != blank
          assign image_class_2 = 'banner__media-image-half'
        endif
        if section.settings.image != blank and section.settings.stack_images_on_mobile
          assign sizes = stacked_sizes
        elsif section.settings.image_2 != blank
          assign sizes = half_width
        else
          assign sizes = full_width
        endif
      -%}
      {{
        section.settings.image_2
        | image_url: width: 3840
        | image_tag:
          width: section.settings.image_2.width,
          height: image_height_2,
          class: image_class_2,
          alt: banner_image_2_alt,
          sizes: desktop_banner_sizes,
          widths: widths,
          fetchpriority: fetch_priority
      }}
    </div>
  {%- endif -%}

  {%- comment -%} MOBILE SWIPER SLIDER (UP TO 3 IMAGES) {%- endcomment -%}
  {%- if mobile_count > 0 -%}
    <div class="mobile-banner-media swiper swiper-mobile-{{ section.id }}" style="width: 100%;">
      <div class="swiper-wrapper">
        {%- assign rendered_slides = 0 -%}
        {%- for i in (1..3) -%}
          {%- assign mobile_img_key = 'mobile_image_' | append: i -%}
          {%- assign current_mobile_image = section.settings[mobile_img_key] -%}
          {%- if current_mobile_image != blank -%}
            <div class="swiper-slide banner__media media">
              {%- liquid
                assign mobile_image_height = current_mobile_image.width | divided_by: current_mobile_image.aspect_ratio
                assign mobile_image_alt = current_mobile_image.alt | default: banner_alt_fallback

                # Only the first rendered slide can be the LCP. The rest are
                # behind the Swiper and are not revealed for at least 2s.
                assign rendered_slides = rendered_slides | plus: 1
                assign slide_priority = 'low'
                assign slide_loading = 'lazy'
                if rendered_slides == 1
                  assign slide_priority = fetch_priority
                  assign slide_loading = 'eager'
                endif
              -%}
              {{
                current_mobile_image
                | image_url: width: 1500
                | image_tag:
                  width: current_mobile_image.width,
                  height: mobile_image_height,
                  alt: mobile_image_alt,
                  sizes: mobile_banner_sizes,
                  widths: '375, 550, 750, 1100',
                  loading: slide_loading,
                  fetchpriority: slide_priority
              }}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
      {%- if mobile_count > 1 -%}
        <div class="swiper-pagination"></div>
      {%- endif -%}
    </div>
  {%- endif -%}

  {%- comment -%} CONTENT OVERLAY BLOCK {%- endcomment -%}
  <div class="banner__content banner__content--{{ section.settings.desktop_content_position }} page-width{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
    <div class="banner__box content-container content-container--full-width-mobile color-{{ section.settings.color_scheme }} gradient">
      {%- comment -%}Only the first heading block in a section may claim the page h1.{%- endcomment -%}
      {%- assign page_h1_used = false -%}
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'review_badge' -%}
            <div class="review-badge-block" {{ block.shopify_attributes }}>
              {%- if block.settings.star_image != blank -%}
                <img
                  src="{{ block.settings.star_image | image_url: width: 300 }}"
                  alt="Stars Rating"
                  loading="lazy"
                  style="height: {{ block.settings.star_image_height }}px; width: auto; object-fit: contain;"
                >
              {%- endif -%}

              {%- if block.settings.review_text_before != blank -%}
                {% comment %} <span class="review-badge__text" style="color: {{ block.settings.text_color }}; font-size: {{ block.settings.text_size }}px;">
                  {{ block.settings.review_text }}
                </span> {% endcomment %}
                <span class="review-badge__text" style="color: {{ block.settings.text_color }}; font-size: {{ block.settings.text_size }}px;">
                  {{ block.settings.review_text_before }} 
                  <span class="dynamic-review-count-global"></span> 
                  {{ block.settings.review_text_after }}
                </span>
              {%- endif -%}
            </div>

          {%- when 'heading' -%}
            {%- comment -%}
            Page heading rule: the first section rendered in a template owns the page h1,
            everything below it is h2. section.index counts only enabled sections, and is
            nil in the theme editor and the Section Rendering API - those fall through to
            h2, which looks identical because the size is pinned by a heading_size class.
            {%- endcomment -%}
            {%- if section.index == 1 and section.location == 'template' and page_h1_used == false -%}
            {%- assign page_heading_tag = 'h1' -%}
            {%- assign page_h1_used = true -%}
            {%- else -%}
            {%- assign page_heading_tag = 'h2' -%}
            {%- endif -%}
            
            <{{ page_heading_tag }}
              id="BannerHeading-{{ block.id }}"
              class="{{ block.settings.class_heading }} banner__heading inline-richtext"
              {{ block.shopify_attributes }}
            >
              {%- if block.settings.heading_html != blank -%}
                {{ block.settings.heading_html }}
              {%- else -%}
                {{ block.settings.heading }}
              {%- endif -%}
            </{{ page_heading_tag }}>


          {%- when 'text' -%}
            <div class="{{ block.settings.class_text }} banner__text rte {{ block.settings.text_style }}" {{ block.shopify_attributes }}>
              {%- if block.settings.text_html != blank -%}
                <div>{{ block.settings.text_html }}</div>
              {%- elsif block.settings.text != blank -%}
                <p>{{ block.settings.text }}</p>
              {%- endif -%}
            </div>

          {%- when 'feature' -%}
            <div class="banner__features-list" {{ block.shopify_attributes }}>
              {%- for i in (1..3) -%}
                {%- assign text_key = 'text_' | append: i -%}
                {%- assign icon_key = 'custom_icon_' | append: i -%}
                {%- assign item_text = block.settings[text_key] -%}
                {%- assign item_icon = block.settings[icon_key] -%}

                {%- if item_text != blank -%}
                  <div class="banner__feature-item">
                    <span class="banner__feature-icon">
                      {%- if item_icon != blank -%}
                        {{ item_icon | image_url: width: 40 | image_tag: loading: 'lazy', width: 20, height: 20 }}
                      {%- else -%}
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <circle cx="12" cy="12" r="10"></circle>
                          <polyline points="16 10 11 15 8 12"></polyline>
                        </svg>
                      {%- endif -%}
                    </span>
                    <span class="banner__feature-text">{{ item_text }}</span>
                  </div>
                {%- endif -%}
              {%- endfor -%}
            </div>

          {%- when 'buttons' -%}
            <div
              class="banner__buttons{% if block.settings.button_label_1 != blank and block.settings.button_label_2 != blank %} banner__buttons--multiple{% endif %}"
              {{ block.shopify_attributes }}
            >
              {%- if block.settings.button_label_1 != blank -%}
                <a
                  {% if block.settings.button_link_1 == blank %}
                    role="link" aria-disabled="true"
                  {% else %}
                    href="{{ block.settings.button_link_1 }}"
                  {% endif %}
                  class="button{% if block.settings.button_style_secondary_1 %} button--secondary{% else %} button--primary{% endif %}"
                >
                  {{- block.settings.button_label_1 | escape -}}
                </a>
              {%- endif -%}
              {%- if block.settings.button_label_2 != blank -%}
                <a
                  {% if block.settings.button_link_2 == blank %}
                    role="link" aria-disabled="true"
                  {% else %}
                    href="{{ block.settings.button_link_2 }}"
                  {% endif %}
                  class="button{% if block.settings.button_style_secondary_2 %} button--secondary{% else %} button--primary{% endif %}"
                >
                  {{- block.settings.button_label_2 | escape -}}
                </a>
              {%- endif -%}
            </div>

        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{%- comment -%}
  defer keeps this out of the parser's way. Deferred scripts run in document order
  before DOMContentLoaded, so the init listener below still finds Swiper defined.
{%- endcomment -%}
{%- if mobile_count > 1 -%}
  <script src="{{ 'swiper-bundle.min.js' | asset_url }}" defer="defer"></script>
{%- endif -%}
<script>
  document.addEventListener('DOMContentLoaded', function () {
    const autoplaySpeed = {{ section.settings.autorotate_speed | times: 1000 }};
    const enableAutoplay = {{ section.settings.enable_autorotate | json }};

    // Initialize Mobile Swiper only if mobile images > 1
    if ({{ mobile_count }} > 1) {
      new Swiper('.swiper-mobile-{{ section.id }}', {
        loop: true,
        autoplay: enableAutoplay ? { delay: autoplaySpeed, disableOnInteraction: false } : false,
        pagination: { 
          el: '#Banner-{{ section.id }} .swiper-mobile-{{ section.id }} .swiper-pagination', 
          clickable: true 
        },
      });
    }
  });
</script>

{% schema %}
{
  "name": "t:sections.image-banner.name",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "custom_class",
      "label": "Add Class"
    },
    {
      "type": "header",
      "content": "Desktop Banner Images"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.image-banner.settings.image.label"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "t:sections.image-banner.settings.image_2.label"
    },
    {
      "type": "header",
      "content": "Mobile Banner Images (Up to 3 Sliders)"
    },
    {
      "type": "image_picker",
      "id": "mobile_image_1",
      "label": "Mobile Image 1"
    },
    {
      "type": "image_picker",
      "id": "mobile_image_2",
      "label": "Mobile Image 2"
    },
    {
      "type": "image_picker",
      "id": "mobile_image_3",
      "label": "Mobile Image 3"
    },
    {
      "type": "header",
      "content": "Mobile Slider Settings"
    },
    {
      "type": "checkbox",
      "id": "enable_autorotate",
      "label": "Auto-rotate mobile slides",
      "default": true
    },
    {
      "type": "range",
      "id": "autorotate_speed",
      "label": "Change slides every",
      "min": 2,
      "max": 9,
      "step": 1,
      "unit": "s",
      "default": 5
    },
    {
      "type": "range",
      "id": "image_overlay_opacity",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "%",
      "label": "t:sections.image-banner.settings.image_overlay_opacity.label",
      "default": 0
    },
    {
      "type": "select",
      "id": "image_height",
      "options": [
        {
          "value": "adapt",
          "label": "t:sections.image-banner.settings.image_height.options__1.label"
        },
        {
          "value": "small",
          "label": "t:sections.image-banner.settings.image_height.options__2.label"
        },
        {
          "value": "medium",
          "label": "t:sections.image-banner.settings.image_height.options__3.label"
        },
        {
          "value": "large",
          "label": "t:sections.image-banner.settings.image_height.options__4.label"
        }
      ],
      "default": "medium",
      "label": "t:sections.image-banner.settings.image_height.label"
    },
    {
      "type": "select",
      "id": "image_behavior",
      "options": [
        {
          "value": "none",
          "label": "t:sections.all.animation.image_behavior.options__1.label"
        },
        {
          "value": "ambient",
          "label": "t:sections.all.animation.image_behavior.options__2.label"
        },
        {
          "value": "fixed",
          "label": "t:sections.all.animation.image_behavior.options__3.label"
        },
        {
          "value": "zoom-in",
          "label": "t:sections.all.animation.image_behavior.options__4.label"
        }
      ],
      "default": "none",
      "label": "t:sections.all.animation.image_behavior.label"
    },
    {
      "type": "header",
      "content": "t:sections.image-banner.settings.content.content"
    },
    {
      "type": "select",
      "id": "desktop_content_position",
      "options": [
        {
          "value": "top-left",
          "label": "t:sections.image-banner.settings.desktop_content_position.options__1.label"
        },
        {
          "value": "top-center",
          "label": "t:sections.image-banner.settings.desktop_content_position.options__2.label"
        },
        {
          "value": "top-right",
          "label": "t:sections.image-banner.settings.desktop_content_position.options__3.label"
        },
        {
          "value": "middle-left",
          "label": "t:sections.image-banner.settings.desktop_content_position.options__4.label"
        },
        {
          "value": "middle-center",
          "label": "t:sections.image-banner.settings.desktop_content_position.options__5.label"
        },
        {
          "value": "middle-right",
          "label": "t:sections.image-banner.settings.desktop_content_position.options__6.label"
        },
        {
          "value": "bottom-left",
          "label": "t:sections.image-banner.settings.desktop_content_position.options__7.label"
        },
        {
          "value": "bottom-center",
          "label": "t:sections.image-banner.settings.desktop_content_position.options__8.label"
        },
        {
          "value": "bottom-right",
          "label": "t:sections.image-banner.settings.desktop_content_position.options__9.label"
        }
      ],
      "default": "middle-center",
      "label": "t:sections.image-banner.settings.desktop_content_position.label"
    },
    {
      "type": "select",
      "id": "desktop_content_alignment",
      "options": [
        {
          "value": "left",
          "label": "t:sections.image-banner.settings.desktop_content_alignment.options__1.label"
        },
        {
          "value": "center",
          "label": "t:sections.image-banner.settings.desktop_content_alignment.options__2.label"
        },
        {
          "value": "right",
          "label": "t:sections.image-banner.settings.desktop_content_alignment.options__3.label"
        }
      ],
      "default": "center",
      "label": "t:sections.image-banner.settings.desktop_content_alignment.label"
    },
    {
      "type": "checkbox",
      "id": "show_text_box",
      "default": true,
      "label": "t:sections.image-banner.settings.show_text_box.label"
    },
    {
      "type": "color_scheme",
