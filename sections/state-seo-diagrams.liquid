{{ 'state-seo.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  State SEO landing page · What do A-DIY engineering diagrams show. Figma › (1678:445).
  Image left, rich text right (bold lead + bullet list + paragraphs).
{%- endcomment -%}

<div class="ss ss--cream ss-diagrams"{% if section.settings.anchor_id != blank %} id="{{ section.settings.anchor_id | handle }}"{% endif %}>
  <div class="ss__inner ss__inner--wide">
    {%- if section.settings.heading != blank -%}
      <h2 class="ss-h2 ss-center">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    <div class="ss-diagrams__row">
      {%- render 'state-seo-image',
        image: section.settings.image,
        alt: section.settings.image_alt,
        class: 'ss-diagrams__media',
        sizes: '(min-width: 1920px) 759px, (min-width: 990px) 45vw, calc(100vw - 40px)',
        placeholder: 'product-2'
      -%}
      <div class="ss-diagrams__copy">
        {%- if section.settings.list != blank -%}
          <div>{{ section.settings.list }}</div>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div>{{ section.settings.text }}</div>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "State SEO · Diagrams",
  "tag": "section",
  "class": "section",
  "enabled_on": { "templates": ["page"] },
  "settings": [
    { "type": "text", "id": "anchor_id", "label": "Anchor ID", "default": "diagrams" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What Do A-DIY Engineering Diagrams Show?" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "image_alt", "label": "Image alt text (SEO)", "default": "Pressure-treated A-DIY deck sections stacked before assembly" },
    { "type": "richtext", "id": "list", "label": "List", "default": "<p><strong>Diagrams for an applicable A-DIY configuration may show:</strong></p><ul><li>Overall dimensions and structural layout</li><li>Beam and joist locations</li><li>Post locations</li><li>Lumber dimensions and type</li><li>Major connections</li><li>Assembly configuration</li></ul>" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>The building department may still request property specific information, such as a survey, site plan, setbacks, foundation details, stairs, railings, attachment details or professionally stamped documents.</p><p>Requirements vary by municipality, and the local building department has final authority. A-DIY diagrams can support a permit application but do not guarantee approval.</p>" }
  ],
  "presets": [{ "name": "State SEO · Diagrams" }]
}
{% endschema %}
