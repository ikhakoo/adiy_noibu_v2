{% comment %}
  Ultra Smooth Sticky-to-Inline Promo Banner with Dynamic Blocks & Countdown

  Layout note: the bar renders in normal flow (no `is-fixed` in the markup).
  The inline script below runs during parsing - before first paint - measures
  the bar while it is still in flow, hands its height to the spacer and flips
  the bar to fixed in the same task. The browser never paints the intermediate
  state, so the swap costs no layout shift. Shipping `is-fixed` in the markup
  and expanding the spacer later (the previous approach) inserted a full
  bar-height block into the page after paint.
{% endcomment %}

<div id="sticky-promo-wrapper-{{ section.id }}" class="promo-section-wrapper">
  <!-- Reserves the bar's space while it is pinned to the viewport. Height is
       set by the script below, in the same task that pins the bar. -->
  <div id="promo-placeholder-{{ section.id }}" class="promo-placeholder"></div>

  <!-- Actual Sticky Bar -->
  <div id="promo-banner-{{ section.id }}" class="sticky-promo-bar">
    <div class="sticky-promo-content">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          
          {%- when 'text_item' -%}
            <div class="promo-item text-item" {{ block.shopify_attributes }}>
              {% if block.settings.link != blank %}
                <a href="{{ block.settings.link }}" class="promo-link">
              {% endif %}
                {{ block.settings.text }}
              {% if block.settings.link != blank %}
                </a>
              {% endif %}
            </div>

          {%- when 'countdown' -%}
            <div class="promo-item countdown-item" {{ block.shopify_attributes }}>
              {% if block.settings.label != blank %}
                <span class="countdown-label">{{ block.settings.label }}</span>
              {% endif %}
              <span id="countdown-timer-{{ section.id }}" class="timer-display" 
                    data-date="{{ block.settings.end_date }}T{{ block.settings.end_time }}:00">
                00d : 00h : 00m : 00s
              </span>
            </div>

        {%- endcase -%}
        
        {%- unless forloop.last -%}
          <span class="promo-separator">·</span>
        {%- endunless -%}
      {%- endfor -%}
    </div>
  </div>
</div>

<style>
  .promo-section-wrapper {
    width: 100%;
    position: relative;
    display: block;
  }

  .promo-placeholder {
    width: 100%;
    display: none;
    visibility: hidden;
  }

  /* Base Styles — this is also the first-paint state, and is identical in
     geometry to .is-static below. */
  .sticky-promo-bar {
    position: relative;
    width: 100%;
    background-color: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
    padding: 12px 20px;
    box-sizing: border-box;
    transition: background-color 0.3s ease, opacity 0.2s ease-in-out;
  }

  /* State 1: Sticky at Viewport Bottom */
  .sticky-promo-bar.is-fixed {
    position: fixed !important;
    bottom: 0 !important;
    left: 0 !important;
    right: 0 !important;
    z-index: 1 !important;
    box-shadow: 0 -3px 12px rgba(0, 0, 0, 0.12);
    /* Promoted only while pinned — a permanent will-change on a full-width
       element keeps a compositor layer alive for the life of the page. */
    will-change: transform;
    transform: translateZ(0);
  }

  /* State 2: Seamlessly fitted into Normal Flow */
  .sticky-promo-bar.is-static {
    position: relative !important;
    bottom: auto !important;
    left: auto !important;
    right: auto !important;
    box-shadow: none !important;
    z-index: 2 !important;
    will-change: auto;
    transform: none !important;
  }

  .sticky-promo-content {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 15px;
    text-align: center;
    flex-wrap: wrap;
  }

  .promo-item {
    font-size: 14px;
    font-weight: 500;
    display: flex;
    align-items: center;
    gap: 6px;
    white-space: nowrap;
  }

  .promo-link {
    color: inherit;
    text-decoration: none;
  }

  .promo-link:hover {
    text-decoration: underline;
  }

  .promo-separator {
    font-weight: bold;
    opacity: 0.6;
    font-size: 14px;
  }

  .timer-display {
    font-variant-numeric: tabular-nums;
    font-weight: 600;
  }

  @media screen and (max-width: 749px) {
    .sticky-promo-bar {
      padding: 8px 12px;
    }
    .promo-item, .promo-separator {
      font-size: 12px;
    }
    .sticky-promo-content {
      gap: 8px;
    }
  }
</style>

<script>
  (function() {
    var wrapper = document.getElementById('sticky-promo-wrapper-{{ section.id }}');
    var banner = document.getElementById('promo-banner-{{ section.id }}');
    var placeholder = document.getElementById('promo-placeholder-{{ section.id }}');

    if (!wrapper || !banner || !placeholder) return;

    var ticking = false;
    var bannerHeight = 0;

    // Measures the bar in normal flow. Called on init, on resize, and once
    // webfonts settle — never from the scroll handler, which used to read
    // offsetHeight and getBoundingClientRect() on every frame and force a
    // synchronous layout each time.
    function measure() {
      var wasFixed = banner.classList.contains('is-fixed');
      if (wasFixed) banner.classList.remove('is-fixed');

      bannerHeight = banner.offsetHeight;

      if (wasFixed) {
        placeholder.style.height = bannerHeight + 'px';
        banner.classList.add('is-fixed');
      }
    }

    function updatePosition() {
      ticking = false;

      var wrapperTop = wrapper.getBoundingClientRect().top;
      var targetScrollTrigger = window.innerHeight - bannerHeight;

      if (wrapperTop <= targetScrollTrigger) {
        // The bar's resting place has scrolled into view — drop it into flow.
        if (!banner.classList.contains('is-static')) {
          banner.classList.remove('is-fixed');
          banner.classList.add('is-static');
          placeholder.style.display = 'none';
        }
      } else {
        // Pin to the viewport, with the spacer holding the vacated space.
        if (!banner.classList.contains('is-fixed')) {
          placeholder.style.height = bannerHeight + 'px';
          placeholder.style.display = 'block';
          banner.classList.add('is-fixed');
          banner.classList.remove('is-static');
        }
      }
    }

    function onScroll() {
      if (!ticking) {
        window.requestAnimationFrame(updatePosition);
        ticking = true;
      }
    }

    function remeasureAndUpdate() {
      measure();
      updatePosition();
    }

    // Synchronous init. This script sits directly after the markup, so both
    // run during parsing and the measure-then-pin swap lands before the first
    // paint — the whole point of the change.
    measure();
    updatePosition();

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', remeasureAndUpdate);

    // Webfonts can change the wrapped line count, and therefore the bar's
    // height, after init. Re-measure once they are ready.
    if (document.fonts && document.fonts.ready) {
      document.fonts.ready.then(remeasureAndUpdate).catch(function () {});
    }
    window.addEventListener('load', remeasureAndUpdate);

    // Countdown Timer Functionality
    var timerElement = document.getElementById('countdown-timer-{{ section.id }}');
    if (timerElement) {
      var targetDateStr = timerElement.getAttribute('data-date');
      var targetDate = new Date(targetDateStr).getTime();

      if (!isNaN(targetDate)) {
        var timerId = null;

        // textContent, not innerHTML — this runs once a second and the value
        // is plain text. .timer-display is tabular-nums so the digits do not
        // reflow as they tick.
        var updateTimer = function () {
          var distance = targetDate - new Date().getTime();

          if (distance < 0) {
            timerElement.textContent = 'Ended';
            if (timerId) clearInterval(timerId);
            return;
          }

          var days = String(Math.floor(distance / (1000 * 60 * 60 * 24))).padStart(2, '0');
          var hours = String(Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60))).padStart(2, '0');
          var minutes = String(Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60))).padStart(2, '0');
          var seconds = String(Math.floor((distance % (1000 * 60)) / 1000)).padStart(2, '0');

          timerElement.textContent = days + 'd : ' + hours + 'h : ' + minutes + 'm : ' + seconds + 's';
        };

        updateTimer();
        timerId = setInterval(updateTimer, 1000);
      }
    }
  })();
</script>

{% schema %}
{
  "name": "Smooth Scroll-To Banner",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    }
  ],
  "blocks": [
    {
      "type": "text_item",
      "name": "Text Feature",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Flexible Payment Plans"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (Optional)"
        }
      ]
    },
    {
      "type": "countdown",
      "name": "Countdown Timer",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Timer Label",
          "default": "Labor Day Sale — Ends in"
        },
        {
          "type": "text",
          "id": "end_date",
          "label": "Target Date (YYYY-MM-DD)",
          "default": "2026-12-31"
        },
        {
          "type": "text",
          "id": "end_time",
          "label": "Target Time (HH:MM in 24h format)",
          "default": "23:59"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Smooth Scroll-To Banner",
      "blocks": [
        {
          "type": "text_item",
          "settings": {
            "text": "Flexible Payment Plans"
          }
        },
        {
          "type": "text_item",
          "settings": {
            "text": "Made in USA"
          }
        },
        {
          "type": "text_item",
          "settings": {
            "text": "5-Year Warranty"
          }
        },
        {
          "type": "countdown"
        }
      ]
    }
  ]
}
{% endschema %}
