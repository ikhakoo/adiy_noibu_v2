{% comment %}
  Ultra Smooth Sticky-to-Inline Promo Banner with Dynamic Blocks & Countdown
{% endcomment %}

<div id="sticky-promo-wrapper-{{ section.id }}" class="promo-section-wrapper">
  <!-- Layout jump/jerk fix karne ke liye reserved height -->
  <div id="promo-placeholder-{{ section.id }}" class="promo-placeholder"></div>

  <!-- Actual Sticky Bar -->
  <div id="promo-banner-{{ section.id }}" class="sticky-promo-bar is-fixed">
    <div class="sticky-promo-content">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          
          {%- when 'text_item' -%}
            <div class="promo-item text-item" {{ block.shopify_attributes }}>
              {% if block.settings.link != blank %}
                <a href="{{ block.settings.link }}" class="promo-link">
              {% endif %}
                {{ block.settings.text }}
              {% if block.settings.link != blank %}
                </a>
              {% endif %}
            </div>

          {%- when 'countdown' -%}
            <div class="promo-item countdown-item" {{ block.shopify_attributes }}>
              {% if block.settings.label != blank %}
                <span class="countdown-label">{{ block.settings.label }}</span>
              {% endif %}
              <span id="countdown-timer-{{ section.id }}" class="timer-display" 
                    data-date="{{ block.settings.end_date }}T{{ block.settings.end_time }}:00">
                00d : 00h : 00m : 00s
              </span>
            </div>

        {%- endcase -%}
        
        {%- unless forloop.last -%}
          <span class="promo-separator">·</span>
        {%- endunless -%}
      {%- endfor -%}
    </div>
  </div>
</div>

<style>
  .promo-section-wrapper {
    width: 100%;
    position: relative;
    display: block;
  }

  .promo-placeholder {
    width: 100%;
    display: none;
    visibility: hidden;
  }

  /* Base Styles */
  .sticky-promo-bar {
    width: 100%;
    background-color: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
    padding: 12px 20px;
    box-sizing: border-box;
    will-change: transform, position;
    transition: background-color 0.3s ease, opacity 0.2s ease-in-out;
  }

  /* State 1: Sticky at Viewport Bottom */
  .sticky-promo-bar.is-fixed {
    position: fixed !important;
    bottom: 0 !important;
    left: 0 !important;
    right: 0 !important;
    z-index: 1 !important;
    box-shadow: 0 -3px 12px rgba(0, 0, 0, 0.12);
    transform: translateZ(0); /* Hardware Acceleration for smooth render */
  }

  /* State 2: Seamlessly fitted into Normal Flow */
  .sticky-promo-bar.is-static {
    position: relative !important;
    bottom: auto !important;
    left: auto !important;
    right: auto !important;
    box-shadow: none !important;
    z-index: 2 !important;
    transform: none !important;
  }

  .sticky-promo-content {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 15px;
    text-align: center;
    flex-wrap: wrap;
  }

  .promo-item {
    font-size: 14px;
    font-weight: 500;
    display: flex;
    align-items: center;
    gap: 6px;
    white-space: nowrap;
  }

  .promo-link {
    color: inherit;
    text-decoration: none;
  }

  .promo-link:hover {
    text-decoration: underline;
  }

  .promo-separator {
    font-weight: bold;
    opacity: 0.6;
    font-size: 14px;
  }

  .timer-display {
    font-variant-numeric: tabular-nums;
    font-weight: 600;
  }

  @media screen and (max-width: 749px) {
    .sticky-promo-bar {
      padding: 8px 12px;
    }
    .promo-item, .promo-separator {
      font-size: 12px;
    }
    .sticky-promo-content {
      gap: 8px;
    }
  }
</style>

<script>
  (function() {
    function initUltraSmoothBanner() {
      const wrapper = document.getElementById('sticky-promo-wrapper-{{ section.id }}');
      const banner = document.getElementById('promo-banner-{{ section.id }}');
      const placeholder = document.getElementById('promo-placeholder-{{ section.id }}');

      if (!wrapper || !banner || !placeholder) return;

      let ticking = false;

      function updatePosition() {
        const wrapperRect = wrapper.getBoundingClientRect();
        const bannerHeight = banner.offsetHeight;
        const viewportHeight = window.innerHeight;

        // Threshold calculate karein
        const targetScrollTrigger = viewportHeight - bannerHeight;

        if (wrapperRect.top <= targetScrollTrigger) {
          // Normal position me perfectly attach ho jaye bina jhatke ke
          if (!banner.classList.contains('is-static')) {
            banner.classList.remove('is-fixed');
            banner.classList.add('is-static');
            placeholder.style.display = 'none';
          }
        } else {
          // Frame sync sticky state
          if (!banner.classList.contains('is-fixed')) {
            placeholder.style.height = bannerHeight + 'px';
            placeholder.style.display = 'block';
            banner.classList.add('is-fixed');
            banner.classList.remove('is-static');
          }
        }

        ticking = false;
      }

      function onScroll() {
        if (!ticking) {
          // Browser render cycle ke sath heavy layout recalculation sync karna
          window.requestAnimationFrame(updatePosition);
          ticking = true;
        }
      }

      // Intersection Observer se extra smooth scroll start handle karna
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach(entry => {
            updatePosition();
          });
        },
        { threshold: [0, 0.25, 0.5, 0.75, 1] }
      );

      observer.observe(wrapper);

      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', updatePosition);
      
      // Page load / refresh par calculation Sync
      updatePosition();

      // Countdown Timer Functionality
      const timerElement = document.getElementById('countdown-timer-{{ section.id }}');
      if (timerElement) {
        const targetDateStr = timerElement.getAttribute('data-date');
        const targetDate = new Date(targetDateStr).getTime();

        if (!isNaN(targetDate)) {
          const updateTimer = () => {
            const now = new Date().getTime();
            const distance = targetDate - now;

            if (distance < 0) {
              timerElement.innerHTML = "Ended";
              return;
            }

            const days = String(Math.floor(distance / (1000 * 60 * 60 * 24))).padStart(2, '0');
            const hours = String(Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60))).padStart(2, '0');
            const minutes = String(Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60))).padStart(2, '0');
            const seconds = String(Math.floor((distance % (1000 * 60)) / 1000)).padStart(2, '0');

            timerElement.innerHTML = `${days}d : ${hours}h : ${minutes}m : ${seconds}s`;
          };

          updateTimer();
          setInterval(updateTimer, 1000);
        }
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initUltraSmoothBanner);
    } else {
      initUltraSmoothBanner();
    }
  })();
</script>

{% schema %}
{
  "name": "Smooth Scroll-To Banner",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    }
  ],
  "blocks": [
    {
      "type": "text_item",
      "name": "Text Feature",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Flexible Payment Plans"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (Optional)"
        }
      ]
    },
    {
      "type": "countdown",
      "name": "Countdown Timer",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Timer Label",
          "default": "Labor Day Sale — Ends in"
        },
        {
          "type": "text",
          "id": "end_date",
          "label": "Target Date (YYYY-MM-DD)",
          "default": "2026-12-31"
        },
        {
          "type": "text",
          "id": "end_time",
          "label": "Target Time (HH:MM in 24h format)",
          "default": "23:59"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Smooth Scroll-To Banner",
      "blocks": [
        {
          "type": "text_item",
          "settings": {
            "text": "Flexible Payment Plans"
          }
        },
        {
          "type": "text_item",
          "settings": {
            "text": "Made in USA"
          }
        },
        {
          "type": "text_item",
          "settings": {
            "text": "5-Year Warranty"
          }
        },
        {
          "type": "countdown"
        }
      ]
    }
  ]
}
{% endschema %}