{% comment %}
  Hansø Style Ultra-Smooth Sticky Promo Bar with Dynamic Blocks & Countdown
{% endcomment %}

<div id="sticky-promo-wrapper-{{ section.id }}" class="promo-section-wrapper">
  <!-- Dynamic Spacer for Layout Jump Prevention -->
  <div id="promo-placeholder-{{ section.id }}" class="promo-placeholder"></div>

  <!-- Actual Promo Bar -->
  <div id="promo-banner-{{ section.id }}" class="sticky-promo-bar is-fixed">
    <div class="sticky-promo-content">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          
          {%- when 'text_item' -%}
            <div class="promo-item text-item" {{ block.shopify_attributes }}>
              {% if block.settings.link != blank %}
                <a href="{{ block.settings.link }}" class="promo-link">
              {% endif %}
                {{ block.settings.text }}
              {% if block.settings.link != blank %}
                </a>
              {% endif %}
            </div>

          {%- when 'countdown' -%}
            <div class="promo-item countdown-item" {{ block.shopify_attributes }}>
              {% if block.settings.label != blank %}
                <span class="countdown-label">{{ block.settings.label }}</span>
              {% endif %}
              <span id="countdown-timer-{{ section.id }}" class="timer-display" 
                    data-year="{{ block.settings.year }}"
                    data-month="{{ block.settings.month }}"
                    data-day="{{ block.settings.day }}"
                    data-hour="{{ block.settings.hour }}"
                    data-minute="{{ block.settings.minute }}">
                00d : 00h : 00m : 00s
              </span>
            </div>

        {%- endcase -%}
        
        {%- unless forloop.last -%}
          <span class="promo-separator">{{ section.settings.separator }}</span>
        {%- endunless -%}
      {%- endfor -%}
    </div>
  </div>
</div>

<style>
  .promo-section-wrapper {
    width: 100%;
    position: relative;
    display: block;
  }

  .promo-placeholder {
    width: 100%;
    display: none;
    visibility: hidden;
  }

  /* Base Bar Styling */
  .sticky-promo-bar {
    width: 100%;
    background-color: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
    padding: 10px 20px;
    box-sizing: border-box;
    will-change: transform, position;
    z-index: 999999;
  }

  /* State 1: Sticky at Bottom */
  .sticky-promo-bar.is-fixed {
    position: fixed !important;
    bottom: 0 !important;
    left: 0 !important;
    right: 0 !important;
    box-shadow: 0 -3px 15px rgba(0, 0, 0, 0.15);
    transform: translateZ(0); /* GPU acceleration */
  }

  /* State 2: Inline / Normal Flow */
  .sticky-promo-bar.is-static {
    position: relative !important;
    bottom: auto !important;
    left: auto !important;
    right: auto !important;
    box-shadow: none !important;
    transform: none !important;
  }

  .sticky-promo-content {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    display: flex;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
  }

  .promo-item {
    font-size: {{ section.settings.font_size }}px;
    font-weight: 500;
    white-space: nowrap;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .promo-link {
    color: inherit;
    text-decoration: none;
  }

  .promo-link:hover {
    text-decoration: underline;
  }

  .promo-separator {
    font-weight: 400;
    opacity: 0.7;
    font-size: {{ section.settings.font_size }}px;
  }

  .timer-display {
    font-variant-numeric: tabular-nums;
    font-weight: 600;
  }

  @media screen and (max-width: 749px) {
    .sticky-promo-bar {
      padding: 8px 12px;
    }
    .promo-item, .promo-separator {
      font-size: 12px;
    }
    .sticky-promo-content {
      gap: 6px;
    }
  }
</style>

