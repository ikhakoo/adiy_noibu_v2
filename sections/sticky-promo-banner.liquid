{% comment %}
  Ultra Smooth Sticky-to-Inline Promo Banner
{% endcomment %}

<div id="sticky-promo-wrapper-{{ section.id }}" class="promo-section-wrapper">
  <!-- Layout jump/jerk fix karne ke liye reserved height -->
  <div id="promo-placeholder-{{ section.id }}" class="promo-placeholder"></div>

  <!-- Actual Sticky Bar -->
  <div id="promo-banner-{{ section.id }}" class="sticky-promo-bar is-fixed">
    <div class="sticky-promo-content">
      <div class="sticky-promo-text">
        {{ section.settings.banner_text }}
      </div>
      {% if section.settings.button_label != blank %}
        <a href="{{ section.settings.button_link }}" class="sticky-promo-btn">
          {{ section.settings.button_label }}
        </a>
      {% endif %}
    </div>
  </div>
</div>

<style>
  .promo-section-wrapper {
    width: 100%;
    position: relative;
    display: block;
  }

  .promo-placeholder {
    width: 100%;
    display: none;
    visibility: hidden;
  }

  /* Base Styles */
  .sticky-promo-bar {
    width: 100%;
    background-color: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
    padding: 12px 20px;
    box-sizing: border-box;
    will-change: transform, position;
    transition: background-color 0.3s ease, opacity 0.2s ease-in-out;
  }

  /* State 1: Sticky at Viewport Bottom */
  .sticky-promo-bar.is-fixed {
    position: fixed !important;
    bottom: 0 !important;
    left: 0 !important;
    right: 0 !important;
    z-index: 999999 !important;
    box-shadow: 0 -3px 12px rgba(0, 0, 0, 0.12);
    transform: translateZ(0); /* Hardware Acceleration for smooth render */
  }

  /* State 2: Seamlessly fitted into Normal Flow */
  .sticky-promo-bar.is-static {
    position: relative !important;
    bottom: auto !important;
    left: auto !important;
    right: auto !important;
    box-shadow: none !important;
    z-index: 2 !important;
    transform: none !important;
  }

  .sticky-promo-content {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 15px;
    text-align: center;
    flex-wrap: wrap;
  }

  .sticky-promo-text {
    font-size: 14px;
    font-weight: 500;
  }

  .sticky-promo-text p {
    margin: 0;
    line-height: 1.3;
  }

  .sticky-promo-btn {
    display: inline-block;
    padding: 6px 16px;
    background-color: {{ section.settings.btn_bg_color }};
    color: {{ section.settings.btn_text_color }};
    text-decoration: none;
    border-radius: 4px;
    font-size: 13px;
    font-weight: 600;
    white-space: nowrap;
  }

  @media screen and (max-width: 749px) {
    .sticky-promo-bar {
      padding: 8px 12px;
    }
    .sticky-promo-text {
      font-size: 12px;
    }
  }
</style>

<script>
  (function() {
    function initUltraSmoothBanner() {
      const wrapper = document.getElementById('sticky-promo-wrapper-{{ section.id }}');
      const banner = document.getElementById('promo-banner-{{ section.id }}');
      const placeholder = document.getElementById('promo-placeholder-{{ section.id }}');

      if (!wrapper || !banner || !placeholder) return;

      let ticking = false;

      function updatePosition() {
        const wrapperRect = wrapper.getBoundingClientRect();
        const bannerHeight = banner.offsetHeight;
        const viewportHeight = window.innerHeight;

        // Threshold calculate karein
        const targetScrollTrigger = viewportHeight - bannerHeight;

        if (wrapperRect.top <= targetScrollTrigger) {
          // Normal position me perfectly attach ho jaye bina jhatke ke
          if (!banner.classList.contains('is-static')) {
            banner.classList.remove('is-fixed');
            banner.classList.add('is-static');
            placeholder.style.display = 'none';
          }
        } else {
          // Frame sync sticky state
          if (!banner.classList.contains('is-fixed')) {
            placeholder.style.height = bannerHeight + 'px';
            placeholder.style.display = 'block';
            banner.classList.add('is-fixed');
            banner.classList.remove('is-static');
          }
        }

        ticking = false;
      }

      function onScroll() {
        if (!ticking) {
          // Browser render cycle ke sath heavy layout recalculation sync karna
          window.requestAnimationFrame(updatePosition);
          ticking = true;
        }
      }

      // Intersection Observer se extra smooth scroll start handle karna
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach(entry => {
            updatePosition();
          });
        },
        { threshold: [0, 0.25, 0.5, 0.75, 1] }
      );

      observer.observe(wrapper);

      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', updatePosition);
      
      // Page load / refresh par calculation Sync
      updatePosition();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initUltraSmoothBanner);
    } else {
      initUltraSmoothBanner();
    }
  })();
</script>

{% schema %}
{
  "name": "Smooth Scroll-To Banner",
  "settings": [
    {
      "type": "richtext",
      "id": "banner_text",
      "label": "Banner Text",
      "default": "<p>Hansø Labor Day Offers. Up to 35% OFF on Pergolas & Awnings + FREE Gift.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Claim Offer"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#8B6B58"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "btn_bg_color",
      "label": "Button Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "btn_text_color",
      "label": "Button Text Color",
      "default": "#000000"
    }
  ],
  "presets": [
    {
      "name": "Smooth Scroll-To Banner"
    }
  ]
}
{% endschema %}