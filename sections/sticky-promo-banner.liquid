{% comment %}
  Dynamic Blocks & Countdown Timer Sticky Promo Banner
{% endcomment %}

<div id="sticky-promo-wrapper-{{ section.id }}" class="promo-section-wrapper">
  <!-- Layout jump/jerk preventer placeholder -->
  <div id="promo-placeholder-{{ section.id }}" class="promo-placeholder"></div>

  <!-- Main Banner Container -->
  <div id="promo-banner-{{ section.id }}" class="sticky-promo-bar is-fixed">
    <div class="sticky-promo-content">
      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'text_item' %}
            <div class="promo-item text-block" {{ block.shopify_attributes }}>
              {% if block.settings.link != blank %}
                <a href="{{ block.settings.link }}">{{ block.settings.text }}</a>
              {% else %}
                <span>{{ block.settings.text }}</span>
              {% endif %}
            </div>

          {% when 'countdown_timer' %}
            <div class="promo-item timer-block" {{ block.shopify_attributes }}>
              {% if block.settings.heading != blank %}
                <span class="timer-heading">{{ block.settings.heading }}</span>
              {% endif %}
              <div class="countdown-display" data-target-date="{{ block.settings.end_date }}">
                <span class="time-part"><span class="days">00</span>d</span> :
                <span class="time-part"><span class="hours">00</span>h</span> :
                <span class="time-part"><span class="minutes">00</span>m</span> :
                <span class="time-part"><span class="seconds">00</span>s</span>
              </div>
            </div>
        {% endcase %}

        {% unless forloop.last %}
          <span class="promo-separator">{{ section.settings.separator }}</span>
        {% endunless %}
      {% endfor %}
    </div>
  </div>
</div>

<style>
  .promo-section-wrapper {
    width: 100%;
    position: relative;
    display: block;
  }

  .promo-placeholder {
    width: 100%;
    display: none;
    visibility: hidden;
  }

  .sticky-promo-bar {
    width: 100%;
    background-color: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
    padding: 10px 20px;
    box-sizing: border-box;
    will-change: transform, position;
    transition: background-color 0.3s ease;
  }

  /* Fixed State */
  .sticky-promo-bar.is-fixed {
    position: fixed !important;
    bottom: 0 !important;
    left: 0 !important;
    right: 0 !important;
    z-index: 999999 !important;
    box-shadow: 0 -3px 10px rgba(0, 0, 0, 0.2);
    transform: translateZ(0);
  }

  /* Static / Inline State */
  .sticky-promo-bar.is-static {
    position: relative !important;
    bottom: auto !important;
    left: auto !important;
    right: auto !important;
    box-shadow: none !important;
    z-index: 2 !important;
    transform: none !important;
  }

  .sticky-promo-content {
    max-width: 1300px;
    margin: 0 auto;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 12px;
    text-align: center;
    flex-wrap: wrap;
    font-size: 13px;
    font-weight: 500;
  }

  .promo-item a {
    color: inherit;
    text-decoration: none;
  }

  .promo-separator {
    color: {{ section.settings.text_color }};
    opacity: 0.6;
  }

  /* Timer Styling */
  .timer-block {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-weight: 600;
  }

  .countdown-display {
    font-family: monospace, sans-serif;
    letter-spacing: 0.5px;
  }

  @media screen and (max-width: 749px) {
    .sticky-promo-bar {
      padding: 8px 10px;
    }
    .sticky-promo-content {
      font-size: 11px;
      gap: 6px;
    }
    .promo-separator {
      margin: 0 2px;
    }
  }
</style>

