{% comment %}
  Sticky-until-scrolled-to-section Promo Banner
{% endcomment %}

<div id="sticky-promo-wrapper-{{ section.id }}" class="promo-section-wrapper">
  <!-- Dynamic Spacer (Jab section fixed hoga to page height jump se bachaye ga) -->
  <div id="promo-placeholder-{{ section.id }}" class="promo-placeholder" style="display: none;"></div>

  <!-- Actual Banner Container -->
  <div id="promo-banner-{{ section.id }}" class="sticky-promo-bar is-fixed">
    <div class="sticky-promo-content">
      <div class="sticky-promo-text">
        {{ section.settings.banner_text }}
      </div>
      {% if section.settings.button_label != blank %}
        <a href="{{ section.settings.button_link }}" class="sticky-promo-btn">
          {{ section.settings.button_label }}
        </a>
      {% endif %}
    </div>
  </div>
</div>

<style>
  .promo-section-wrapper {
    width: 100%;
    position: relative;
  }

  /* Shared Banner Style */
  .sticky-promo-bar {
    width: 100%;
    background-color: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
    padding: 12px 20px;
    box-sizing: border-box;
    transition: background-color 0.3s ease;
  }

  /* State 1: Sticky at Bottom (Jab tak top content scroll ho raha ho) */
  .sticky-promo-bar.is-fixed {
    position: fixed !important;
    bottom: 0 !important;
    left: 0 !important;
    right: 0 !important;
    z-index: 99999 !important;
    box-shadow: 0 -3px 12px rgba(0, 0, 0, 0.15);
  }

  /* State 2: Static / Normal Section (Jab user is section tak pohnch jaye) */
  .sticky-promo-bar.is-static {
    position: relative !important;
    bottom: auto !important;
    left: auto !important;
    box-shadow: none !important;
    z-index: 1 !important;
  }

  .sticky-promo-content {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 15px;
    text-align: center;
    flex-wrap: wrap;
  }

  .sticky-promo-text {
    font-size: 14px;
    font-weight: 500;
  }

  .sticky-promo-text p {
    margin: 0;
    line-height: 1.3;
  }

  .sticky-promo-btn {
    display: inline-block;
    padding: 6px 16px;
    background-color: {{ section.settings.btn_bg_color }};
    color: {{ section.settings.btn_text_color }};
    text-decoration: none;
    border-radius: 4px;
    font-size: 13px;
    font-weight: 600;
    white-space: nowrap;
  }

  @media screen and (max-width: 749px) {
    .sticky-promo-bar {
      padding: 8px 12px;
    }
    .sticky-promo-text {
      font-size: 12px;
    }
  }
</style>

<script>
  (function() {
    function initStickyBanner() {
      const wrapper = document.getElementById('sticky-promo-wrapper-{{ section.id }}');
      const banner = document.getElementById('promo-banner-{{ section.id }}');
      const placeholder = document.getElementById('promo-placeholder-{{ section.id }}');

      if (!wrapper || !banner || !placeholder) return;

      function checkScrollPosition() {
        const wrapperRect = wrapper.getBoundingClientRect();
        const bannerHeight = banner.offsetHeight;
        const viewportHeight = window.innerHeight;

        // Dynamic Position Trigger: Jab section ka actual spot viewport me bottom se enter kare
        if (wrapperRect.top <= (viewportHeight - bannerHeight)) {
          // Section apne real place par pohnch gaya -> Normal Section ban jaye
          banner.classList.remove('is-fixed');
          banner.classList.add('is-static');
          placeholder.style.display = 'none';
        } else {
          // Page abhi upar hai -> Bottom Sticky rahe
          banner.classList.add('is-fixed');
          banner.classList.remove('is-static');
          placeholder.style.height = bannerHeight + 'px';
          placeholder.style.display = 'block';
        }
      }

      window.addEventListener('scroll', checkScrollPosition, { passive: true });
      window.addEventListener('resize', checkScrollPosition);
      checkScrollPosition(); // Initial load check
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initStickyBanner);
    } else {
      initStickyBanner();
    }
  })();
</script>

{% schema %}
{
  "name": "Sticky Scroll-To Banner",
  "settings": [
    {
      "type": "richtext",
      "id": "banner_text",
      "label": "Banner Text",
      "default": "<p>Hansø Labor Day Offers. Up to 35% OFF on Pergolas & Awnings + FREE Gift.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Claim Offer"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#8B6B58"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "btn_bg_color",
      "label": "Button Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "btn_text_color",
      "label": "Button Text Color",
      "default": "#000000"
    }
  ],
  "presets": [
    {
      "name": "Sticky Scroll-To Banner"
    }
  ]
}
{% endschema %}