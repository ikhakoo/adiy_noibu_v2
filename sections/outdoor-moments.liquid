{%- liquid
  assign section_id = 'outdoor-moments-' | append: section.id
-%}

<section
  id="{{ section_id }}"
  class="om-section"
  style="
    --om-bg: {{ section.settings.bg_color }};
    --om-card-bg: {{ section.settings.card_bg }};
    --om-card-border: {{ section.settings.card_border }};
    --om-title-color: {{ section.settings.title_color }};
    --om-subtitle-color: {{ section.settings.subtitle_color }};
    --om-card-title-color: {{ section.settings.card_title_color }};
    --om-card-text-color: {{ section.settings.card_text_color }};
    --om-accent: {{ section.settings.accent_color }};
    --om-pt-d: {{ section.settings.padding_top }}px;
    --om-pb-d: {{ section.settings.padding_bottom }}px;
    --om-pt-m: {{ section.settings.padding_top_mobile }}px;
    --om-pb-m: {{ section.settings.padding_bottom_mobile }}px;
  "
>
  <div class="page-width om-container">

    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="om-header">
        {%- if section.settings.heading != blank -%}
          <h2 class="om-title">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="om-subtitle">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="om-grid om-grid--{{ section.settings.columns_desktop }}">
        {%- for block in section.blocks -%}
          {%- if block.type == 'card' -%}
            <article class="om-card" {{ block.shopify_attributes }}>
              <div class="om-card__media">
                {%- assign om_card_image_alt = block.settings.image.alt | default: block.settings.title -%}
                {%- if block.settings.video != blank -%}
                  {{
                    block.settings.video
                    | video_tag:
                      autoplay: true,
                      loop: true,
                      muted: true,
                      controls: false,
                      playsinline: true,
                      webkit-playsinline: true,
                      preload: 'metadata',
                      class: 'om-card__video'
                  }}

                {%- elsif block.settings.image != blank -%}
                  {{
                    block.settings.image
                    | image_url: width: 1200
                    | image_tag:
                      loading: 'lazy',
                      class: 'om-card__img',
                      widths: '300, 480, 600, 800, 1000, 1200',
                      sizes: '(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw',
                      alt: om_card_image_alt
                  }}

                {%- else -%}
                  <div class="om-card__placeholder">
                    {{ 'image' | placeholder_svg_tag: 'om-card__placeholder-svg' }}
                  </div>
                {%- endif -%}
              </div>

              {%- if block.settings.title != blank -%}
                <h3 class="om-card__title">{{ block.settings.title }}</h3>
              {%- endif -%}

              {%- if block.settings.description != blank -%}
                <p class="om-card__desc">{{ block.settings.description }}</p>
              {%- endif -%}
            </article>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

  </div>
</section>

{% stylesheet %}
  .om-section {
    background: var(--om-bg, #f9f9f9);
    padding: var(--om-pt-d, 70px) 0 var(--om-pb-d, 70px);
    position: relative;
    overflow: hidden;
    font-family: inherit;
  }

  .om-container {
    max-width: 1440px;
    margin: 0 auto;
    position: relative;
  }

  /* Header */
  .om-header {
    text-align: center;
    max-width: 880px;
    margin: 0 auto 30px;
  }

  .om-title {
    line-height: 1.2;
    color: var(--om-title-color, #000000);
    margin: 0 0 20px;
    letter-spacing: -0.02em;
  }

  .om-subtitle {
    font-size: clamp(15px, 1.3vw, 20px);
    line-height: 1.65;
    color: var(--om-subtitle-color, #4a4a4a);
    margin: 0;
    font-weight: 400;
  }

  /* Grid */
  .om-grid {
    display: grid;
    gap: 15px;
  }

  .om-grid--3 { grid-template-columns: repeat(3, 1fr); }
  .om-grid--2 { grid-template-columns: repeat(2, 1fr); }
  .om-grid--4 { grid-template-columns: repeat(4, 1fr); }

  /* Card */
  .om-card {
    background: var(--om-card-bg, #f5f5f5);
    border: 1px solid var(--om-card-border, #e5e5e5);
    border-radius: 20px;
    text-align: center;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    display: flex;
    flex-direction: column;
    gap: 15px;
  }

  .om-card__media {
    width: 100%;
    aspect-ratio: 10 / 15;
    overflow: hidden;
    border-radius: 20px;
    background: #eaeaea;
    margin-bottom: 10px;
    position: relative;
  }

  .om-card__img,
  .om-card__video {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  .om-card__title {
    font-size: clamp(17px, 1.5vw, 18px);
    font-weight: 600;
    color: var(--om-card-title-color, #111111);
    margin: 0;
    line-height: 24px;
    padding: 0 10px;
  }

  .om-card__desc {
    font-size: 14px;
    line-height: 22px;
    color: var(--om-card-text-color, #555);
    font-weight: 400;
    padding: 0 10px;
    margin-bottom:20px;
    margin-top: 0;
  }

  /* Tablet */
  @media (max-width: 1240px) {
    .om-grid--3,
    .om-grid--4 { grid-template-columns: repeat(2, 1fr); padding: 0 36px;}
  }

  /* Mobile Responsive SLIDER Logic */
  @media (max-width: 640px) {
    .om-section {
      padding: var(--om-pt-m, 50px) 0 var(--om-pb-m, 50px);
    }
    
    .om-container { 
      padding: 0; 
    }
    
    .om-header {
      padding: 0 20px;
      margin-bottom: 28px;
    }

    .om-grid {
      display: flex;
      flex-wrap: nowrap;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      scroll-snap-type: x mandatory;
      gap: 16px;
      padding: 0 20px 20px;
      scrollbar-width: none;
    }

    .om-grid::-webkit-scrollbar {
      display: none;
    }

    .om-card {
      flex: 0 0 90%;
      scroll-snap-align: center;
      padding:0;
    }

    .om-card__desc { font-size: 13.5px; }
  }
{% endstylesheet %}

<script>
  (function() {
    const SECTION_ID = '{{ section_id }}';

    function initIOSAutoplay() {
      const section = document.getElementById(SECTION_ID);
      if (!section) return;

      const videos = section.querySelectorAll('video.om-card__video');
      
      videos.forEach(function(video) {
        // iOS Safari ke zaroori HTML attributes enforce karein
        video.muted = true;
        video.defaultMuted = true;
        video.playsInline = true;
        video.setAttribute('playsinline', '');
        video.setAttribute('webkit-playsinline', '');
        video.setAttribute('muted', '');

        // IntersectionObserver: Jab video viewport mein aye tabhi play kare (iOS Autoplay Policy bypass)
        if ('IntersectionObserver' in window) {
          const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
              if (entry.isIntersecting) {
                const promise = video.play();
                if (promise !== undefined) {
                  promise.catch(() => {
                    // Touch fallback agar browser policy block kare
                    const playOnTouch = () => {
                      video.play();
                      document.removeEventListener('touchstart', playOnTouch);
                    };
                    document.addEventListener('touchstart', playOnTouch, { once: true });
                  });
                }
              } else {
                video.pause();
              }
            });
          }, { threshold: 0.2 });

          observer.observe(video);
        } else {
          video.play().catch(() => {});
        }
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initIOSAutoplay);
    } else {
      initIOSAutoplay();
    }

    // Shopify Theme Editor / Dynamic Render Support
    document.addEventListener('shopify:section:load', function(e) {
      if (e.detail.sectionId === '{{ section.id }}') {
        initIOSAutoplay();
      }
    });
  })();
</script>

{% schema %}
{
  "name": "Outdoor Moments",
  "tag": "section",
  "class": "section-outdoor-moments",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Designed for Every Outdoor Moment"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Craft a space that fits your lifestyle—whether it's hosting guests, unwinding in peace, or creating a functional outdoor retreat."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Desktop columns",
      "options": [
        { "value": "2", "label": "2 columns" },
        { "value": "3", "label": "3 columns" },
        { "value": "4", "label": "4 columns" }
      ],
      "default": "3"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Heading color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "subtitle_color",
      "label": "Subheading color",
      "default": "#5a5a5a"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card background",
      "default": "#f5f5f5"
    },
    {
      "type": "color",
      "id": "card_border",
      "label": "Card border",
      "default": "#e5e5e5"
    },
    {
      "type": "color",
      "id": "card_title_color",
      "label": "Card title color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "card_text_color",
      "label": "Card description color",
      "default": "#6b6b6b"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top (desktop)",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 70
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom (desktop)",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 70
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding top (mobile)",
      "min": 0,
      "max": 120,
      "step": 5,
      "unit": "px",
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding bottom (mobile)",
      "min": 0,
      "max": 120,
      "step": 5,
      "unit": "px",
      "default": 50
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        {
          "type": "video",
          "id": "video",
          "label": "Video"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Backyard Family Lounge"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Turn your backyard into a comfortable outdoor living space where everyone can unwind."
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Outdoor Moments",
      "blocks": [
        { "type": "card" },
        { "type": "card" },
        { "type": "card" }
      ]
    }
  ]
}
{% endschema %}