{%- comment -%}
  Never the first section on any template that uses it, so this is below the
  fold and does not need to block first paint.
{%- endcomment -%}
<link rel="stylesheet" href="{{ 'component-image-with-text.css' | asset_url }}" media="print" onload="this.media='all'">
<noscript>{{ 'component-image-with-text.css' | asset_url | stylesheet_tag }}</noscript>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  /* Custom Styles for Dual Buttons & Stats */
  .image-with-text__buttons {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    margin-top: 4rem;
    width: 100%;
  }

  .image-with-text__stats {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin: 3rem 0 0;
    width: 100%;
  }

  .image-with-text__stat-item {
    display: flex;
    flex-direction: column;
    width: 48%;
  }

  .image-with-text__stat-number {
    font-weight: bold;
    line-height: 1;
    font-size: 39px;
    color: #000;
  }

  .image-with-text__stat-label {
    font-size: 13px;
    margin-top: 0.5rem;
    color: #000;
  }

  .image-with-text__stat-divider {
    width: 1px;
    height: 40px;
    background-color: currentColor;
    opacity: 0.2;
  }

  /* Custom Styles for Icon Text Block */
  .image-with-text__icons-row {
    display: flex;
    gap: 2rem;
    margin: 3rem 0 0;
    width: 100%;
  }

  .image-with-text__icon-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex: 1;
  }

  .image-with-text__icon-wrapper {
    width: 50px;
    height: 50px;
    border-radius: 50%;
    background-color: #EEF4EE;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .image-with-text__icon-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .image-with-text__icon-content {
    display: flex;
    flex-direction: column;
  }

  .image-with-text__icon-title {
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: #194636;
    margin: 0 0 0.3rem 0;
  }

  .image-with-text__icon-desc {
    font-size: 11px;
    color: #333333;
    margin: 0;
    line-height: 1.3;
  }

  .image-with-text__media video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 8px;
    position: unset !important;
  }

  .image-with-text__buttons .button {
    border-radius: 8px;
    font-size: 16px;
    border: 1px solid #194636;
    transition: background-color .3s ease, color .3s ease, box-shadow .3s ease, transform .3s ease;
    width: 48%;
  }

  .image-with-text__buttons .button--primary {
    background: #194636;
  }

  .image-with-text__buttons .button--secondary {
    background: #EFF9F5;
    color: #000;
  }

  .image-with-text__buttons .button:hover {
    background: #000;
    box-shadow: 0 0 10px #2b4f42, 
                0 0 2px #000, 
                0 0 30px rgba(43, 79, 66, 0.6);
    transform: translateY(-2px);
    color: #fff;
  }

  @media screen and (max-width:1300px) {
    .image-with-text__stat-number { font-size: 34px; }
    .image-with-text__stat-label { font-size: 12px; }
    .image-with-text__buttons .button { font-size: 15px; }
  }

  @media screen and (max-width:1100px) {
    .image-with-text__stats { margin: 3rem 0; }
    .image-with-text__stat-number { font-size: 28px; }
    .image-with-text__stat-label { font-size: 11px; }
  }

  @media screen and (max-width:989px) {
    .image-with-text__stat-number,
    .image-with-text__stat-label { text-align: center; }
    .image-with-text__media video {
      position: unset !important;
      border-radius: 15px;
    }
  }

  @media screen and (max-width: 628px) {
    .image-with-text__buttons .button {
      font-size: 15px;
      padding: 0;
      width: 49%;
    }
    .image-with-text__buttons {
      gap: 0;
      justify-content: space-between;
    }
    .image-with-text__icons-row {
      flex-direction: column;
      gap: 1.5rem;
    }
    .image-with-text__icon-item{
      flex-direction: column;
    }
    .image-with-text-matrix .image-with-text__text-item .image-with-text__content{
      padding: 2rem 10px;
    }
  }

  @media screen and (min-width: 990px) {
    .image-with-text-matrix .image-with-text__content {
      padding: 6rem 4rem 7rem;
    }
  }

{%- comment -%}
  Mobile readability floor. These selectors are declared once for all viewports,
  so they are overridden here rather than edited - desktop keeps its current size.
{%- endcomment -%}
@media screen and (max-width: 749px) {
    .image-with-text__icon-desc { font-size: 13px; }
}
{%- endstyle -%}

{%- liquid
  assign fetch_priority = 'auto'
  if section.index == 1
    assign fetch_priority = 'high'
  endif

  comment
    Fallback alt so the section image is not shipped with alt="" when nobody set
    one in the Files admin. The paired icons keep alt="" on purpose - each sits
    next to its own visible title, so naming them would just duplicate that text.
  endcomment
  assign iwt_alt_fallback = ''
  for block in section.blocks
    if block.type == 'heading' and block.settings.heading != blank
      assign iwt_alt_fallback = block.settings.heading | strip_html
      break
    endif
  endfor
  assign iwt_alt_fallback = iwt_alt_fallback | default: shop.name
  assign iwt_image_alt = section.settings.image.alt | default: iwt_alt_fallback
  if section.settings.color_scheme == section.settings.section_color_scheme and section.settings.content_layout == 'no-overlap'
    assign remove_color_classes = true
  endif
-%}

<div class="{{ section.settings.custom_class }} section-{{ section.id }}-padding gradient color-{{ section.settings.section_color_scheme }}">
  <div class="page-width">
    <div class="image-with-text image-with-text--{{ section.settings.content_layout }} isolate{% if settings.text_boxes_border_thickness > 0 and settings.text_boxes_border_opacity > 0 and settings.media_border_thickness > 0 and settings.media_border_opacity > 0 %} collapse-borders{% endif %}{% unless section.settings.color_scheme == section.settings.section_color_scheme and settings.media_border_thickness > 0 and settings.text_boxes_shadow_opacity == 0 and settings.text_boxes_border_thickness == 0 or settings.text_boxes_border_opacity == 0 %} collapse-corners{% endunless %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
      <div class="image-with-text__grid grid grid--gapless grid--1-col grid--{% if section.settings.desktop_image_width == 'medium' %}2-col-tablet{% else %}3-col-tablet{% endif %}{% if section.settings.layout == 'text_first' %} image-with-text__grid--reverse{% endif %}">
        
        <!-- Media Container -->
        <div class="image-with-text__media-item image-with-text__media-item--{{ section.settings.desktop_image_width }} image-with-text__media-item--{{ section.settings.desktop_content_position }} grid__item">
          <div
            class="image-with-text__media image-with-text__media--{{ section.settings.height }} global-media-settings{% unless remove_color_classes %} gradient color-{{ section.settings.color_scheme }}{% else %} background-transparent{% endunless %}{% if section.settings.image != blank or section.settings.video != blank %} media{% else %} image-with-text__media--placeholder placeholder{% endif %}{% if section.settings.image_behavior != 'none' %} animate--{{ section.settings.image_behavior }}{% endif %}"
            {% if section.settings.height == 'adapt' and section.settings.image != blank and section.settings.video == blank %}
              style="padding-bottom: {{ 1 | divided_by: section.settings.image.aspect_ratio | times: 100 }}%;"
            {% endif %}
          >
            {%- if section.settings.video != blank -%}
              {{ section.settings.video | video_tag: autoplay: true, loop: true, controls: true, muted: true }}
            {%- elsif section.settings.image != blank -%}
              {%- if section.settings.image_behavior == 'ambient' or section.settings.image_behavior == 'zoom-in' -%}
                {%- assign widths = '198, 432, 642, 900, 1284, 1800' -%}
                {%- capture sizes -%}
                  (min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 100 | divided_by: 1.6667 }}px,
                  (min-width: 750px) calc((100vw - 130px) / 1.667), calc((100vw - 50px) / 1.667)
                {%- endcapture -%}
              {%- else -%}
                {%- assign widths = '165, 360, 535, 750, 1070, 1500' -%}
                {%- capture sizes -%}
                  (min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 100 | divided_by: 2 }}px,
                  (min-width: 750px) calc((100vw - 130px) / 2), calc((100vw - 50px) / 2)
                {%- endcapture -%}
              {%- endif -%}
              {{
                section.settings.image
                | image_url: width: 1500
                | image_tag: alt: iwt_image_alt, sizes: sizes, widths: widths, fetchpriority: fetch_priority
              }}
            {%- else -%}
              {{ 'detailed-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </div>
        </div>

        <!-- Content Item -->
        <div class="image-with-text__text-item grid__item">
          <div
            id="ImageWithText--{{ section.id }}"
            class="image-with-text__content image-with-text__content--{{ section.settings.desktop_content_position }} image-with-text__content--desktop-{{ section.settings.desktop_content_alignment }} image-with-text__content--mobile-{{ section.settings.mobile_content_alignment }} image-with-text__content--{{ section.settings.height }} content-container{% unless remove_color_classes %} gradient color-{{ section.settings.color_scheme }}{% else %} background-transparent{% endunless %}"
          >
            {%- comment -%}Only the first heading block in a section may claim the page h1.{%- endcomment -%}
            {%- assign page_h1_used = false -%}
            {%- for block in section.blocks -%}
              {% case block.type %}
                {% comment %} {%- when 'heading' -%}
                  {% if block.settings.sub_heading != blank %}
                    <h2 class="image-with-text__sub-heading" {{ block.shopify_attributes }}>
                      {{ block.settings.sub_heading }}
                    </h2>
                  {% endif %}
                  
                  {%- if section.index == 1 and section.location == 'template' and page_h1_used == false -%}
                  {%- assign page_heading_tag = 'h1' -%}
                  {%- assign page_h1_used = true -%}
                  {%- else -%}
                  {%- assign page_heading_tag = 'h2' -%}
                  {%- endif -%}
            
                  <{{ page_heading_tag }} class="image-with-text__heading inline-richtext" {{ block.shopify_attributes }}>
                    {{ block.settings.heading }}
                  </{{ page_heading_tag }}> {% endcomment %}
                {%- when 'heading' -%}
                  {%- assign sub_header_tag = block.settings.sub_heading_tag | default: 'h2' -%}
                  
                  {% if block.settings.sub_heading != blank %}
                    <{{ sub_header_tag }}
                      id="SubHeading-{{ block.id }}"
                      class="{{ block.settings.class_sub_heading }} image-with-text__sub-heading"
                      {{ block.shopify_attributes }}
                    >
                      {{ block.settings.sub_heading }}
                    </{{ sub_header_tag }}>

                    {%- if block.settings.sub_font_size_desktop != blank or block.settings.sub_font_size_mobile != blank -%}
                      <style>
                        {%- if block.settings.sub_font_size_mobile != blank -%}
                          #SubHeading-{{ block.id }} {
                            font-size: {{ block.settings.sub_font_size_mobile | strip }}px !important;
                          }
                        {%- endif -%}

                        {%- if block.settings.sub_font_size_desktop != blank -%}
                          @media screen and (min-width: 750px) {
                            #SubHeading-{{ block.id }} {
                              font-size: {{ block.settings.sub_font_size_desktop | strip }}px !important;
                            }
                          }
                        {%- endif -%}
                      </style>
                    {%- endif -%}
                  {% endif %}
                  
                  {%- if block.settings.heading_tag != blank and block.settings.heading_tag != 'auto' -%}
                    {%- assign page_heading_tag = block.settings.heading_tag -%}
                  {%- elsif section.index == 1 and section.location == 'template' and page_h1_used == false -%}
                    {%- assign page_heading_tag = 'h1' -%}
                    {%- assign page_h1_used = true -%}
                  {%- else -%}
                    {%- assign page_heading_tag = 'h2' -%}
                  {%- endif -%}

                  {% if block.settings.heading != blank %}
                    <{{ page_heading_tag }}
                      id="ImageWithTextHeading-{{ block.id }}"
                      class="{{ block.settings.class_heading }} image-with-text__heading inline-richtext"
                      {{ block.shopify_attributes }}
                    >
                      {{ block.settings.heading }}
                    </{{ page_heading_tag }}>

                    {%- if block.settings.font_size_desktop != blank or block.settings.font_size_mobile != blank -%}
                      <style>
                        {%- if block.settings.font_size_mobile != blank -%}
                          #ImageWithTextHeading-{{ block.id }} {
                            font-size: {{ block.settings.font_size_mobile | strip }}px !important;
                          }
                        {%- endif -%}

                        {%- if block.settings.font_size_desktop != blank -%}
                          @media screen and (min-width: 750px) {
                            #ImageWithTextHeading-{{ block.id }} {
                              font-size: {{ block.settings.font_size_desktop | strip }}px !important;
                            }
                          }
                        {%- endif -%}
                      </style>
                    {%- endif -%}
                  {% endif %}

                {%- when 'caption' -%}
                  <p class="image-with-text__text image-with-text__text--caption {{ block.settings.text_style }} {{ block.settings.text_style }}--{{ block.settings.text_size }}" {{ block.shopify_attributes }}>
                    {{ block.settings.caption | escape }}
                  </p>

                {%- when 'text' -%}
                  <div class="image-with-text__text rte {{ block.settings.text_style }}" {{ block.shopify_attributes }}>
                    {{ block.settings.text }}
                  </div>

                {%- when 'icon_text_row' -%}
                  <div class="image-with-text__icons-row" {{ block.shopify_attributes }}>
                    {%- if block.settings.icon_1 != blank or block.settings.title_1 != blank -%}
                      <div class="image-with-text__icon-item">
                        {%- if block.settings.icon_1 != blank -%}
                          <div class="image-with-text__icon-wrapper">
                            {{ block.settings.icon_1 | image_url: width: 100 | image_tag: loading: 'lazy' }}
                          </div>
                        {%- endif -%}
                        <div class="image-with-text__icon-content">
                          {%- if block.settings.title_1 != blank -%}
                            <p class="image-with-text__icon-title small">{{ block.settings.title_1 }}</p>
                          {%- endif -%}
                          {%- if block.settings.desc_1 != blank -%}
                            <p class="image-with-text__icon-desc">{{ block.settings.desc_1 }}</p>
                          {%- endif -%}
                        </div>
                      </div>
                    {%- endif -%}

                    {%- if block.settings.icon_2 != blank or block.settings.title_2 != blank -%}
                      <div class="image-with-text__icon-item">
                        {%- if block.settings.icon_2 != blank -%}
                          <div class="image-with-text__icon-wrapper">
                            {{ block.settings.icon_2 | image_url: width: 100 | image_tag: loading: 'lazy' }}
                          </div>
                        {%- endif -%}
                        <div class="image-with-text__icon-content">
                          {%- if block.settings.title_2 != blank -%}
                            <p class="image-with-text__icon-title small">{{ block.settings.title_2 }}</p>
                          {%- endif -%}
                          {%- if block.settings.desc_2 != blank -%}
                            <p class="image-with-text__icon-desc">{{ block.settings.desc_2 }}</p>
                          {%- endif -%}
                        </div>
                      </div>
                    {%- endif -%}
                  </div>

                {%- when 'stats' -%}
                  <div class="image-with-text__stats" {{ block.shopify_attributes }}>
                    {%- if block.settings.stat_1_number != blank -%}
                      <div class="image-with-text__stat-item">
                        <span 
                          class="image-with-text__stat-number" 
                          data-enable-counter="{{ block.settings.enable_stat_1_counter }}" 
                          data-counter-increment="{{ block.settings.stat_1_increment }}" 
                          data-counter-speed="{{ block.settings.stat_1_speed }}"
                          data-counter-value="{{ block.settings.stat_1_number }}"
                        >
                          {{ block.settings.stat_1_number }}
                        </span>
                        {%- if block.settings.stat_1_label != blank -%}
                          <span class="image-with-text__stat-label">{{ block.settings.stat_1_label }}</span>
                        {%- endif -%}
                      </div>
                    {%- endif -%}

                    {%- if block.settings.stat_1_number != blank and block.settings.stat_2_number != blank -%}
                      <div class="image-with-text__stat-divider"></div>
                    {%- endif -%}

                    {%- if block.settings.stat_2_number != blank -%}
                      <div class="image-with-text__stat-item">
                        <span 
                          class="image-with-text__stat-number" 
                          data-enable-counter="{{ block.settings.enable_stat_2_counter }}" 
                          data-counter-increment="{{ block.settings.stat_2_increment }}" 
                          data-counter-speed="{{ block.settings.stat_2_speed }}"
                          data-counter-value="{{ block.settings.stat_2_number }}"
                        >
                          {{ block.settings.stat_2_number }}
                        </span>
                        {%- if block.settings.stat_2_label != blank -%}
                          <span class="image-with-text__stat-label">{{ block.settings.stat_2_label }}</span>
                        {%- endif -%}
                      </div>
                    {%- endif -%}
                  </div>

                {%- when 'button' -%}
                  <div class="image-with-text__buttons" {{ block.shopify_attributes }}>
                    {%- if block.settings.button_label != blank -%}
                      <a
                        {% if block.settings.button_link == blank %}role="link" aria-disabled="true"{% else %}href="{{ block.settings.button_link }}"{% endif %}
                        class="button{% if block.settings.button_style_secondary %} button--secondary{% else %} button--primary{% endif %}"
                      >
                        {{ block.settings.button_label | escape }}
                      </a>
                    {%- endif -%}

                    {%- if block.settings.button_label_2 != blank -%}
                      <a
                        {% if block.settings.button_link_2 == blank %}role="link" aria-disabled="true"{% else %}href="{{ block.settings.button_link_2 }}"{% endif %}
                        class="button{% if block.settings.button_style_secondary_2 %} button--secondary{% else %} button--primary{% endif %}"
                      >
                        {{ block.settings.button_label_2 | escape }}
                      </a>
                    {%- endif -%}
                  </div>

              {%- endcase -%}
            {%- endfor -%}
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const FIXED_GLOBAL_START_TIME = new Date('2026-07-21T00:00:00Z').getTime();
    const counterElements = document.querySelectorAll('#ImageWithText--{{ section.id }} [data-counter-value]');

    counterElements.forEach(function (el) {
      const isCounterEnabled = el.getAttribute('data-enable-counter') === 'true';

      if (isCounterEnabled) {
        const rawText = el.getAttribute('data-counter-value');
        const incrementVal = parseInt(el.getAttribute('data-counter-increment'), 10) || 1;
        const speedMs = parseInt(el.getAttribute('data-counter-speed'), 10) || 200;
        
        const baseNumber = parseInt(rawText.replace(/[^0-9]/g, ''), 10);
        const suffix = rawText.replace(/[0-9,]/g, '');

        if (!isNaN(baseNumber)) {
          function getGlobalSyncedValue() {
            const now = Date.now();
            const timeDifference = now - FIXED_GLOBAL_START_TIME;
            const intervalsPassed = Math.floor(timeDifference / speedMs);
            return baseNumber + (intervalsPassed * incrementVal);
          }

          let currentNumber = getGlobalSyncedValue();
          el.innerText = currentNumber.toLocaleString('en-US') + suffix;

          setInterval(function () {
            currentNumber += incrementVal;
            el.innerText = currentNumber.toLocaleString('en-US') + suffix;
          }, speedMs);
        }
      }
    });
  });
</script>

{% schema %}
{
  "name": "t:sections.image-with-text.name",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "custom_class",
      "label": "Add Class"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.image-with-text.settings.image.label"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video (Overrides Image)"
    },
    {
      "type": "select",
      "id": "height",
      "options": [
        { "value": "adapt", "label": "t:sections.image-with-text.settings.height.options__1.label" },
        { "value": "small", "label": "t:sections.image-with-text.settings.height.options__2.label" },
        { "value": "medium", "label": "t:sections.image-with-text.settings.height.options__3.label" },
        { "value": "large", "label": "t:sections.image-with-text.settings.height.options__4.label" }
      ],
      "default": "adapt",
      "label": "t:sections.image-with-text.settings.height.label"
    },
    {
      "type": "select",
      "id": "desktop_image_width",
      "options": [
        { "value": "small", "label": "t:sections.image-with-text.settings.desktop_image_width.options__1.label" },
        { "value": "medium", "label": "t:sections.image-with-text.settings.desktop_image_width.options__2.label" },
        { "value": "large", "label": "t:sections.image-with-text.settings.desktop_image_width.options__3.label" }
      ],
      "default": "medium",
      "label": "t:sections.image-with-text.settings.desktop_image_width.label"
    },
    {
      "type": "select",
      "id": "layout",
      "options": [
        { "value": "image_first", "label": "t:sections.image-with-text.settings.layout.options__1.label" },
        { "value": "text_first", "label": "t:sections.image-with-text.settings.layout.options__2.label" }
      ],
      "default": "image_first",
      "label": "t:sections.image-with-text.settings.layout.label"
    },
    {
      "type": "select",
      "id": "image_behavior",
      "options": [
        { "value": "none", "label": "t:sections.all.animation.image_behavior.options__1.label" },
        { "value": "ambient", "label": "t:sections.all.animation.image_behavior.options__2.label" },
        { "value": "zoom-in", "label": "t:sections.all.animation.image_behavior.options__4.label" }
      ],
      "default": "none",
      "label": "t:sections.all.animation.image_behavior.label"
    },
    {
      "type": "header",
      "content": "t:sections.image-with-text.settings.header.content"
    }, 
    {
      "type": "select",
      "id": "content_layout",
      "options": [
        { "value": "no-overlap", "label": "t:sections.image-with-text.settings.content_layout.options__1.label" },
        { "value": "overlap", "label": "t:sections.image-with-text.settings.content_layout.options__2.label" }
      ],
      "default": "no-overlap",
      "label": "t:sections.image-with-text.settings.content_layout.label"
    },      
    {
      "type": "select",
      "id": "desktop_content_position",
      "options": [
        { "value": "top", "label": "t:sections.image-with-text.settings.desktop_content_position.options__1.label" },
        { "value": "middle", "label": "t:sections.image-with-text.settings.desktop_content_position.options__2.label" },
        { "value": "bottom", "label": "t:sections.image-with-text.settings.desktop_content_position.options__3.label" }
