{{ 'sdp.css' | asset_url | stylesheet_tag }}
<script src="{{ 'sdp.js' | asset_url }}" defer="defer"></script>

{%- comment -%}
  Size deck page · Five layers. Centered header, then the exploded-kit image on the left
  with one numbered label per `layer` block on the right. Each block places a pin on the
  image (percent coordinates); sdp.js draws the dashed leader from pin to badge on
  desktop and hides the lines on narrow screens, where the list simply stacks under
  the image.
{%- endcomment -%}

{%- assign sdp = page.metafields.custom.deck_size.value -%}
<div class="sdp sdp-layers sdp--white" data-sdp-layers{% if section.settings.anchor_id != blank %} id="{{ section.settings.anchor_id | handle }}"{% endif %}>
  <div class="sdp__inner sdp-layers__inner">
    <div class="sdp-header sdp-header--center">
      {%- if section.settings.eyebrow != blank -%}
        <p class="sdp-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- capture t_heading -%}{%- render 'sdp-t', text: section.settings.heading, sdp: sdp -%}{%- endcapture -%}
      {%- capture t_intro -%}{%- render 'sdp-t', text: section.settings.intro, sdp: sdp -%}{%- endcapture -%}
      {%- if t_heading != blank -%}
        <h2 class="sdp-h2">{{ t_heading | escape }}</h2>
      {%- endif -%}
      {%- if t_intro != blank -%}
        <p class="sdp-intro">{{ t_intro | escape }}</p>
      {%- endif -%}
    </div>

    <div class="sdp-layers__diagram">
      <div class="sdp-media sdp-layers__media">
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 1200 | image_tag: widths: '400, 600, 800, 1200', sizes: '(min-width: 990px) 550px, calc(100vw - 48px)', loading: 'lazy', alt: section.settings.image_alt | default: section.settings.heading }}
        {%- else -%}
          {{ 'image' | placeholder_svg_tag }}
        {%- endif -%}
        {%- for block in section.blocks -%}
          <span class="sdp-pin" data-for="{{ block.id }}" data-n="{{ forloop.index }}" style="left: {{ block.settings.pin_x | default: 85 }}%; top: {{ block.settings.pin_y | default: 50 }}%;"></span>
        {%- endfor -%}
      </div>

      <ol class="sdp-layers__list">
        {%- for block in section.blocks -%}
          <li class="sdp-layer" data-layer="{{ block.id }}" {{ block.shopify_attributes }}>
            <span class="sdp-layer__badge">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
            <span class="sdp-layer__body">
              <h3 class="sdp-layer__title">{{ block.settings.title | escape }}</h3>
              <p class="sdp-layer__text">{%- render 'sdp-t', text: block.settings.text, sdp: sdp -%}</p>
            </span>
          </li>
        {%- endfor -%}
      </ol>

      <svg class="sdp-layers__leaders" aria-hidden="true"></svg>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "SDP · Five layers",
  "tag": "section",
  "class": "section",
  "enabled_on": { "templates": ["product", "collection", "page"] },
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "anchor_id", "label": "Anchor ID" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "What’s under a deck matters more than what’s on top" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The five layers of a 12x12 A-DIY deck" },
    { "type": "textarea", "id": "intro", "label": "Intro", "default": "A floor that bounces, a rail that sways, a corner that sinks, the problem is always underneath. Every layer below ships in the crate, engineered to fit." },
    { "type": "image_picker", "id": "image", "label": "Exploded kit image" },
    { "type": "text", "id": "image_alt", "label": "Image alt text (SEO)", "default": "Exploded view of the A-DIY 12x12 wood deck kit: decking, frame, joists, beams and Tuff Block footings" }
  ],
  "blocks": [
    {
      "type": "layer",
      "name": "Layer",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Decking" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Premium Grade 1 Southern Yellow Pine & Kiln Dried" },
        { "type": "range", "id": "pin_x", "label": "Pin position · left (%)", "min": 0, "max": 100, "step": 1, "default": 85 },
        { "type": "range", "id": "pin_y", "label": "Pin position · top (%)", "min": 0, "max": 100, "step": 1, "default": 50 }
      ]
    }
  ],
  "presets": [
    {
      "name": "SDP · Five layers",
      "blocks": [
        { "type": "layer", "settings": { "title": "Decking", "text": "Premium Grade 1 Southern Yellow Pine & Kiln Dried", "pin_x": 83, "pin_y": 16 } },
        { "type": "layer", "settings": { "title": "Frame", "text": "Rim that keeps it square", "pin_x": 86, "pin_y": 33 } },
        { "type": "layer", "settings": { "title": "Joists", "text": "2×8, set 13–14\" apart", "pin_x": 85, "pin_y": 51 } },
        { "type": "layer", "settings": { "title": "Beams", "text": "6×6, notched for joists", "pin_x": 88, "pin_y": 61 } },
        { "type": "layer", "settings": { "title": "Footings", "text": "Tuff Block foundation. You have flexibility to use in ground footings, sono tubes, helical piles.", "pin_x": 86, "pin_y": 73 } }
      ]
    }
  ]
}
{% endschema %}
