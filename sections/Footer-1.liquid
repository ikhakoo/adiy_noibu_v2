{% comment %}theme-check-disable UndefinedObject{% endcomment %}
{{ 'section-footer.css' | asset_url | stylesheet_tag }}
{{ 'component-newsletter.css' | asset_url | stylesheet_tag }}
{{ 'component-list-menu.css' | asset_url | stylesheet_tag }}
{{ 'component-list-payment.css' | asset_url | stylesheet_tag }}
{{ 'component-list-social.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .footer {
    margin-top: {{ section.settings.margin_top | times: 0.75 | round: 0 }}px;
    background-color: #000000;
    color: #ffffff;
  }

  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  /* Custom Layout CSS for New Design */
  .footer__layout-custom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 40px;
  }

  .footer__left-col {
    flex: 1 1 400px;
    max-width: 500px;
    display: flex;
    flex-direction: column;
    gap: 25px;
  }

  .footer__right-col {
    flex: 1 1 500px;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    gap: 30px;
  }

  .footer__right-top-blocks {
    display: flex;
    flex-wrap: wrap;
    gap: 30px;
    justify-content: space-between;
  }

  .footer-block__contact-item {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 10px;
    font-size: 14px;
  }

  .footer-block__contact-item svg {
    width: 16px;
    height: 16px;
    fill: currentColor;
  }

  .footer-block__contact-icon-img {
    width: 18px;
    height: 18px;
    object-fit: contain;
    display: block;
  }

  /* Custom Social Icons CSS */
  .footer__custom-social-list {
    display: flex;
    align-items: center;
    gap: 12px;
    list-style: none;
    padding: 0;
    margin: 15px 0 0 0;
  }

  .footer__custom-social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: opacity 0.3s ease;
  }

  .footer__custom-social-link:hover {
    opacity: 0.8;
  }

  .footer__custom-social-icon {
    width: auto;
    height: {{ section.settings.social_icon_height }}px;
    object-fit: contain;
    display: block;
  }

  .footer__newsletter-subtext {
    font-size: 12px;
    line-height: 1.4;
    opacity: 0.8;
    margin-top: 10px;
  }

  .footer__payment-section {
    margin-top: 10px;
  }

  .footer__payment-title {
    font-size: 14px;
    font-weight: 600;
    margin-bottom: 12px;
  }

  .footer__payment-image-wrapper img {
    max-width: 100%;
    height: auto;
    display: block;
  }

  .footer__big-logo-wrapper {
    width: 100%;
    margin-top: 20px;
  }

  .footer__big-logo-wrapper img {
    width: 100%;
    height: auto;
    display: block;
  }

  .footer__copyright-custom {
    display: flex;
    flex-wrap: wrap;
    gap: 15px;
    font-size: 12px;
    opacity: 0.8;
    margin-top: 15px;
  }

  .footer__copyright-custom a {
    color: inherit;
    text-decoration: none;
  }

  .footer__policy-menu {
    display: flex;
    flex-wrap: wrap;
    gap: 15px;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .footer__layout-custom .field:before,
  .footer__layout-custom .field:after {
    display:none;
  }
  .footer__layout-custom .field__input:focus{
    box-shadow: none;
  }
  .footer__layout-custom .field__input{
    padding-left: 0;
  }
  .footer__layout-custom .field__label,
  .footer__layout-custom .field__input:focus~.field__label {
    left:0;
  }

  @media screen and (min-width: 750px) {
    .footer {
      margin-top: {{ section.settings.margin_top }}px;
    }
    
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
  @media screen and (max-width: 749px) {
    .footer__layout-custom{
      justify-content:center;
    }
    .footer__payment-title{
      text-align: center;
    }
    .footer__payment-image-wrapper img{
      display: block;
      margin: auto;
    }
    .footer__copyright-custom{
      justify-content: center;
    }
    .footer-block.grid__item{
      width: auto;
      margin: 0;
    }
    .footer__policy-menu{
      justify-content: center;
    }
  }
  @media screen and (max-width: 580px){
    .footer-block.grid__item.footer-block-contact_info{
      width:100%;
    }
    .footer-block.grid__item.footer-block-link_list{
      width:45%;
      margin-top:4rem;
    }
    .footer-block__heading{
      text-align: center;
    }
    .footer-block__contact-item,
    .footer__custom-social-list{
      justify-content: center;
    }
    .footer__right-top-blocks{
      justify-content: center;
    }
    .footer-block__details-content .list-menu__item--link{
      justify-content: center;
    }
  }
{%- endstyle -%}

<footer class="footer color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
  <div class="page-width">
    <div class="footer__layout-custom">
      
      <!-- LEFT COLUMN (Newsletter, Payment, Copyright) -->
      <div class="footer__left-col">
        {%- if section.settings.newsletter_enable -%}
          <div class="footer-block__newsletter">
            {%- if section.settings.newsletter_heading != blank -%}
              <h2 class="footer-block__heading inline-richtext" style="font-size: 28px; font-weight: 700; margin-bottom: 8px;">
                {{ section.settings.newsletter_heading }}
              </h2>
            {%- endif -%}
            
            {%- if section.settings.newsletter_subheading != blank -%}
              <p style="font-size: 14px; margin-bottom: 20px;">{{ section.settings.newsletter_subheading }}</p>
            {%- endif -%}

            {%- form 'customer', id: 'ContactFooter', class: 'footer__newsletter newsletter-form' -%}
              <input type="hidden" name="contact[tags]" value="newsletter">
              <div class="newsletter-form__field-wrapper">
                <div class="field" style="border-bottom: 1px solid #ffffff; background: transparent;">
                  <input
                    id="NewsletterForm--{{ section.id }}"
                    type="email"
                    name="contact[email]"
                    class="field__input"
                    value="{{ form.email }}"
                    aria-required="true"
                    autocorrect="off"
                    autocapitalize="off"
                    autocomplete="email"
                    placeholder="Email"
                    style="background: transparent; border: none; color: #fff;"
                    required
                  >
                  <label class="field__label" for="NewsletterForm--{{ section.id }}" style="color: #ccc;">
                    Email
                  </label>
                  <button
                    type="submit"
                    class="newsletter-form__button field__button"
                    name="commit"
                    id="Subscribe"
                    aria-label="{{ 'newsletter.button_label' | t }}"
                    style="color: #fff;"
                  >
                    <span class="svg-wrapper" style="border: 1px solid #fff; border-radius: 50%; padding: 5px; display: flex;">
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                    </span>
                  </button>
                </div>
              </div>
            {%- endform -%}

            {%- if section.settings.newsletter_disclaimer != blank -%}
              <div class="footer__newsletter-subtext">
                {{ section.settings.newsletter_disclaimer }}
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}

        <!-- Custom Payment Image Section -->
        {%- if section.settings.payment_enable -%}
          <div class="footer__payment-section">
            {%- if section.settings.payment_heading != blank -%}
              <div class="footer__payment-title">{{ section.settings.payment_heading }}</div>
            {%- endif -%}
            {%- if section.settings.payment_image != blank -%}
              <div class="footer__payment-image-wrapper">
                <img 
                  src="{{ section.settings.payment_image | image_url: width: 800 }}" 
                  alt="Payment Methods" 
                  loading="lazy" 
                  width="{{ section.settings.payment_image.width }}" 
                  height="{{ section.settings.payment_image.height }}"
                  style="max-width: {{ section.settings.payment_image_width }}px;"
                >
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}

        <!-- Left Copyright & Policy Menu Info -->
        <div class="footer__copyright-custom">
          {%- if section.settings.copyright_text != blank -%}
            <span>{{ section.settings.copyright_text }}</span>
          {%- else -%}
            <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}</span>
          {%- endif -%}

          {%- if section.settings.policy_menu != blank -%}
            <ul class="footer__policy-menu">
              {%- for link in section.settings.policy_menu.links -%}
                <li>
                  <a href="{{ link.url }}">{{ link.title | escape }}</a>
                </li>
              {%- endfor -%}
            </ul>
          {%- endif -%}
        </div>
      </div>

      <!-- RIGHT COLUMN (Links, Contact, Big Logo) -->
      <div class="footer__right-col">
        <div class="footer__right-top-blocks">
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when 'contact_info' -%}
                <div class="footer-block grid__item footer-block-contact_info" {{ block.shopify_attributes }}>
                  {%- if block.settings.heading != blank -%}
                    <h2 class="footer-block__heading inline-richtext" style="font-size: 16px; font-weight: 600;">{{ block.settings.heading }}</h2>
                  {%- endif -%}
                  
                  {%- if block.settings.phone != blank -%}
                    <div class="footer-block__contact-item">
                      {%- if block.settings.phone_icon != blank -%}
                        <img src="{{ block.settings.phone_icon | image_url: width: 100 }}" alt="Phone" class="footer-block__contact-icon-img" width="{{ block.settings.phone_icon.width }}" height="{{ block.settings.phone_icon.height }}" loading="lazy">
                      {%- else -%}
                        <svg viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
                      {%- endif -%}
                      <a href="tel:{{ block.settings.phone }}" style="color: inherit; text-decoration: none;">{{ block.settings.phone }}</a>
                    </div>
                  {%- endif -%}

                  {%- if block.settings.email_text != blank -%}
                    <div class="footer-block__contact-item">
                      {%- if block.settings.email_icon != blank -%}
                        <img src="{{ block.settings.email_icon | image_url: width: 100 }}" alt="Email" class="footer-block__contact-icon-img" width="{{ block.settings.email_icon.width }}" height="{{ block.settings.email_icon.height }}" loading="lazy">
                      {%- else -%}
                        <svg viewBox="0 0 24 24"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
                      {%- endif -%}
                      <a href="{{ block.settings.email_link }}" style="color: inherit; text-decoration: none;">{{ block.settings.email_text }}</a>
                    </div>
                  {%- endif -%}

                  <!-- Custom Social Icons rendering -->
                  {%- if section.settings.show_social -%}
                    <ul class="footer__custom-social-list">
                      {%- if section.settings.social_icon_1 != blank -%}
                        <li>
                          <a href="{{ section.settings.social_link_1 | default: '#' }}" class="footer__custom-social-link" target="_blank" aria-label="Social Link 1">
                            <img src="{{ section.settings.social_icon_1 | image_url: width: 100 }}" alt="Social Icon" class="footer__custom-social-icon" width="{{ section.settings.social_icon_1.width }}" height="{{ section.settings.social_icon_1.height }}" loading="lazy">
                          </a>
                        </li>
                      {%- endif -%}

                      {%- if section.settings.social_icon_2 != blank -%}
                        <li>
                          <a href="{{ section.settings.social_link_2 | default: '#' }}" class="footer__custom-social-link" target="_blank" aria-label="Social Link 2">
                            <img src="{{ section.settings.social_icon_2 | image_url: width: 100 }}" alt="Social Icon" class="footer__custom-social-icon" width="{{ section.settings.social_icon_2.width }}" height="{{ section.settings.social_icon_2.height }}" loading="lazy">
                          </a>
                        </li>
                      {%- endif -%}

                      {%- if section.settings.social_icon_3 != blank -%}
                        <li>
                          <a href="{{ section.settings.social_link_3 | default: '#' }}" class="footer__custom-social-link" target="_blank" aria-label="Social Link 3">
                            <img src="{{ section.settings.social_icon_3 | image_url: width: 100 }}" alt="Social Icon" class="footer__custom-social-icon" width="{{ section.settings.social_icon_3.width }}" height="{{ section.settings.social_icon_3.height }}" loading="lazy">
                          </a>
                        </li>
                      {%- endif -%}

                      {%- if section.settings.social_icon_4 != blank -%}
                        <li>
                          <a href="{{ section.settings.social_link_4 | default: '#' }}" class="footer__custom-social-link" target="_blank" aria-label="Social Link 4">
                            <img src="{{ section.settings.social_icon_4 | image_url: width: 100 }}" alt="Social Icon" class="footer__custom-social-icon" width="{{ section.settings.social_icon_4.width }}" height="{{ section.settings.social_icon_4.height }}" loading="lazy">
                          </a>
                        </li>
                      {%- endif -%}

                      {%- if section.settings.social_icon_5 != blank -%}
                        <li>
                          <a href="{{ section.settings.social_link_5 | default: '#' }}" class="footer__custom-social-link" target="_blank" aria-label="Social Link 5">
                            <img src="{{ section.settings.social_icon_5 | image_url: width: 100 }}" alt="Social Icon" class="footer__custom-social-icon" width="{{ section.settings.social_icon_5.width }}" height="{{ section.settings.social_icon_5.height }}" loading="lazy">
                          </a>
                        </li>
                      {%- endif -%}
                    </ul>
                  {%- endif -%}
                </div>

              {%- when 'link_list' -%}
                <div class="footer-block grid__item footer-block-link_list" {{ block.shopify_attributes }}>
                  {%- if block.settings.heading != blank -%}
                    <h2 class="footer-block__heading inline-richtext" style="font-size: 16px; font-weight: 600;">{{ block.settings.heading }}</h2>
                  {%- endif -%}
                  {%- if block.settings.menu != blank -%}
                    <ul class="footer-block__details-content list-unstyled">
                      {%- for link in block.settings.menu.links -%}
                        <li style="margin-bottom: 8px;">
                          <a href="{{ link.url }}" class="link link--text list-menu__item list-menu__item--link{% if link.active %} list-menu__item--active{% endif %}" style="padding: 0; font-size: 14px;">
                            {{ link.title | escape }}
                          </a>
                        </li>
                      {%- endfor -%}
                    </ul>
                  {%- endif -%}
                </div>
            {%- endcase -%}
          {%- endfor -%}
        </div>

        <!-- Big Branding Banner Logo at Bottom Right -->
        {%- for block in section.blocks -%}
          {%- if block.type == 'large_logo' -%}
            <div class="footer__big-logo-wrapper" {{ block.shopify_attributes }}>
              {%- if block.settings.image != blank -%}
                <img src="{{ block.settings.image | image_url: width: 1200 }}" alt="{{ block.settings.image.alt }}" loading="lazy" width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}">
              {%- elsif block.settings.text_logo != blank -%}
                <h1 style="font-size: 80px; font-weight: 900; letter-spacing: 2px; margin: 0; color: #ffffff; text-transform: uppercase;">
                  {{ block.settings.text_logo }}
                </h1>
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}

      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "t:sections.footer.name",
  "blocks": [
    {
      "type": "link_list",
      "name": "Navigation Menu",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "heading",
          "default": "Quick links",
          "label": "Heading"
        },
        {
          "type": "link_list",
          "id": "menu",
          "default": "footer",
          "label": "Menu"
        }
      ]
    },
    {
      "type": "contact_info",
      "name": "Contact Information",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "heading",
          "default": "Contact Us",
          "label": "Heading"
        },
        {
          "type": "image_picker",
          "id": "phone_icon",
          "label": "Custom Phone Icon"
        },
        {
          "type": "text",
          "id": "phone",
          "default": "+1 (786) 358-2872",
          "label": "Phone Number"
        },
        {
          "type": "image_picker",
          "id": "email_icon",
          "label": "Custom Email Icon"
        },
        {
          "type": "text",
          "id": "email_text",
          "default": "Contact Us Page",
          "label": "Email / Link Text"
        },
        {
          "type": "url",
          "id": "email_link",
          "label": "Link URL"
        }
      ]
    },
    {
      "type": "large_logo",
      "name": "Large Logo / Text",
      "limit": 1,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Large Logo Image"
        },
        {
          "type": "text",
          "id": "text_logo",
          "default": "A-DIY",
          "label": "Large Text (If image not added)"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Newsletter"
    },
    {
      "type": "checkbox",
      "id": "newsletter_enable",
      "default": true,
      "label": "Enable Newsletter"
    },
    {
      "type": "inline_richtext",
      "id": "newsletter_heading",
      "default": "Reach out to Us!",
      "label": "Heading"
    },
    {
      "type": "text",
      "id": "newsletter_subheading",
      "default": "Get 25% off your Starter Kit when you sign up",
      "label": "Subheading"
    },
    {
      "type": "richtext",
      "id": "newsletter_disclaimer",
      "default": "<p>You can unsubscribe by using the unsubscribe link.</p>",
      "label": "Disclaimer Text"
    },
    {
      "type": "header",
      "content": "Payment Methods"
    },
    {
      "type": "checkbox",
      "id": "payment_enable",
      "default": true,
      "label": "Show Payment Methods"
    },
    {
      "type": "text",
      "id": "payment_heading",
      "default": "Safe & Secure payment",
      "label": "Payment Heading Text"
    },
    {
      "type": "image_picker",
      "id": "payment_image",
      "label": "Payment Icons Image"
    },
    {
      "type": "range",
      "id": "payment_image_width",
      "min": 100,
      "max": 500,
      "step": 10,
      "unit": "px",
      "label": "Payment Image Max Width",
      "default": 350
    },
    {
      "type": "header",
      "content": "Custom Social Icons"
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "default": true,
      "label": "Show Social Icons"
    },
    {
      "type": "range",
      "id": "social_icon_height",
      "min": 16,
      "max": 50,
      "step": 2,
      "unit": "px",
      "label": "Social Icons Height",
      "default": 24
    },
    {
      "type": "image_picker",
      "id": "social_icon_1",
      "label": "Social Icon 1"
    },
    {
      "type": "url",
      "id": "social_link_1",
      "label": "Social Link 1"
    },
    {
      "type": "image_picker",
      "id": "social_icon_2",
      "label": "Social Icon 2"
    },
    {
      "type": "url",
      "id": "social_link_2",
      "label": "Social Link 2"
    },
    {
      "type": "image_picker",
      "id": "social_icon_3",
      "label": "Social Icon 3"
    },
    {
      "type": "url",
      "id": "social_link_3",
      "label": "Social Link 3"
    },
    {
      "type": "image_picker",
      "id": "social_icon_4",
      "label": "Social Icon 4"
    },
    {
      "type": "url",
      "id": "social_link_4",
      "label": "Social Link 4"
    },
    {
      "type": "image_picker",
      "id": "social_icon_5",
      "label": "Social Icon 5"
    },
    {
      "type": "url",
      "id": "social_link_5",
      "label": "Social Link 5"
    },
    {
      "type": "header",
      "content": "Copyright & Policies"
    },
    {
      "type": "text",
      "id": "copyright_text",
      "default": "© 2026 A-DIY",
      "label": "Copyright Text"
    },
    {
      "type": "link_list",
      "id": "policy_menu",
      "label": "Policies / Copyright Menu",
      "info": "Select menu containing policy pages (e.g., Privacy, Refund, Terms)."
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Margin Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 36
    }
  ]
}
{% endschema %}