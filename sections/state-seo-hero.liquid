{{ 'state-seo.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  State SEO landing page · Hero. Figma "SEO Strategy New York" › hero group (1464:1312).
  Holds the page's only H1. The intro is written as a direct answer to the search question
  so answer engines can lift it. Optionally emits Article JSON-LD for the page.
{%- endcomment -%}

<div class="ss ss--white ss-hero"{% if section.settings.anchor_id != blank %} id="{{ section.settings.anchor_id | handle }}"{% endif %}>
  <div class="ss__inner ss__inner--wide ss-hero__row">
    <div class="ss-hero__copy">
      <h1 class="ss-hero__title">{{ section.settings.heading | default: page.title | escape }}</h1>
      {%- if section.settings.intro != blank -%}
        <div class="ss-hero__lede">{{ section.settings.intro }}</div>
      {%- endif -%}
      <div class="ss-btns">
        {%- render 'state-seo-button', label: section.settings.primary_label, link: section.settings.primary_link -%}
        {%- render 'state-seo-button', label: section.settings.secondary_label, link: section.settings.secondary_link, style: 'dark' -%}
      </div>
    </div>
    {%- render 'state-seo-image',
      image: section.settings.image,
      alt: section.settings.image_alt,
      class: 'ss-hero__media',
      sizes: '(min-width: 1920px) 906px, (min-width: 990px) 50vw, calc(100vw - 40px)',
      position: section.settings.image_position,
      eager: true
    -%}
  </div>
</div>

{%- if section.settings.article_schema -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Article",
      "headline": {{ section.settings.heading | default: page.title | json }},
      "description": {{ page.metafields.global.description_tag | default: section.settings.intro | strip_html | truncate: 300 | json }},
      "mainEntityOfPage": { "@type": "WebPage", "@id": {{ shop.url | append: page.url | json }} },
      {%- if section.settings.image != blank -%}
        "image": {{ section.settings.image | image_url: width: 1200 | prepend: 'https:' | json }},
      {%- endif -%}
      "author": { "@type": "Organization", "name": {{ shop.name | json }}, "url": {{ shop.url | json }} },
      "publisher": { "@type": "Organization", "name": {{ shop.name | json }}, "url": {{ shop.url | json }} },
      "datePublished": {{ page.published_at | date: '%Y-%m-%d' | json }},
      "dateModified": {{ page.updated_at | default: page.published_at | date: '%Y-%m-%d' | json }}
      {%- if section.settings.region_name != blank -%},
        "about": { "@type": "Place", "name": {{ section.settings.region_name | json }} },
        "spatialCoverage": { "@type": "Place", "name": {{ section.settings.region_name | json }} }
      {%- endif -%}
    }
  </script>
{%- endif -%}

{% schema %}
{
  "name": "State SEO · Hero",
  "tag": "section",
  "class": "section",
  "enabled_on": { "templates": ["page"] },
  "settings": [
    { "type": "text", "id": "anchor_id", "label": "Anchor ID" },
    { "type": "text", "id": "heading", "label": "Heading (H1)", "default": "Building a Deck in New York: Contractors, Costs, Permits and Deck Kit Options" },
    { "type": "richtext", "id": "intro", "label": "Intro", "default": "<p>Planning a deck in New York usually begins with a few big questions: Should you hire a deck builder, purchase the materials yourself or use a professionally engineered system that arrives prepared for assembly?</p><p>This guide explains the main options, what affects the cost, how permits work, what to ask a contractor and how to choose between pressure-treated wood and composite decking.</p><p>A-DIY offers a third way to complete the project: a professionally engineered deck system delivered with coordinated components prepared for assembly. You can build it yourself or hire a local handyman, carpenter or contractor to help.</p>" },
    { "type": "header", "content": "Buttons" },
    { "type": "text", "id": "primary_label", "label": "Primary label", "default": "Explore Deck Options" },
    { "type": "url", "id": "primary_link", "label": "Primary link" },
    { "type": "text", "id": "secondary_label", "label": "Secondary label", "default": "See How A-DIY Works" },
    { "type": "url", "id": "secondary_link", "label": "Secondary link", "info": "Use #chat to open live chat, or #how-it-works to jump down the page." },
    { "type": "header", "content": "Image" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "image_alt", "label": "Image alt text (SEO)", "default": "A-DIY pressure-treated wood deck with outdoor seating in a New York backyard" },
    { "type": "select", "id": "image_position", "label": "Image crop focus", "default": "50% 50%", "options": [
      { "value": "50% 20%", "label": "Top" },
      { "value": "50% 35%", "label": "Upper middle" },
      { "value": "50% 50%", "label": "Center" },
      { "value": "50% 65%", "label": "Lower middle" },
      { "value": "50% 80%", "label": "Bottom" }
    ] },
    { "type": "header", "content": "SEO" },
    { "type": "checkbox", "id": "article_schema", "label": "Output Article schema", "default": true },
    { "type": "text", "id": "region_name", "label": "Region name for schema", "default": "New York, United States" }
  ],
  "presets": [{ "name": "State SEO · Hero" }]
}
{% endschema %}
