{{ 'dvp-landing.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  Deck vs Patio · Real backyards gallery. Figma › Section - Real A-DIY Backyards (6980:1425):
  header + rating badge, a 3-column photo grid (gallery from the homepage "A-DIY, in real life"),
  and a reviews CTA. Tick "Wide" on a photo to span two columns.
{%- endcomment -%}

<div class="dvp dvp--sand dvp-gallery"{% if section.settings.anchor_id != blank %} id="{{ section.settings.anchor_id | handle }}"{% endif %}>
  <div class="dvp__inner dvp-gallery__inner">
    <div class="dvp-gallery__head">
      <div class="dvp-gallery__head-copy">
        {%- if section.settings.eyebrow != blank -%}
          <p class="dvp-eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        <h2 class="dvp-h2">{{ section.settings.heading | escape }}</h2>
      </div>
      {%- if section.settings.rating_text != blank -%}
        <p class="dvp-rating">
          <span class="dvp-rating__stars" aria-hidden="true">★★★★★</span>
          <span class="dvp-rating__text">{{ section.settings.rating_text | escape }}</span>
        </p>
      {%- endif -%}
    </div>

    <ul class="dvp-gallery__grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign item_class = 'dvp-gallery__item'
          assign item_sizes = '(min-width: 1920px) 467px, (min-width: 750px) 31vw, 48vw'
          if block.settings.wide
            assign item_class = 'dvp-gallery__item dvp-gallery__item--wide'
            assign item_sizes = '(min-width: 1920px) 954px, (min-width: 750px) 64vw, 100vw'
          endif
        -%}
        <li class="dvp-gallery__cell" {{ block.shopify_attributes }}>
          {%- render 'dvp-image', image: block.settings.image, alt: block.settings.image_alt, class: item_class, sizes: item_sizes -%}
        </li>
      {%- endfor -%}
    </ul>

    {%- if section.settings.button_label != blank -%}
      <div class="dvp-btns">
        {%- render 'dvp-button', label: section.settings.button_label, link: section.settings.button_link -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Deck vs Patio · Gallery",
  "tag": "section",
  "class": "section",
  "enabled_on": { "templates": ["page"] },
  "max_blocks": 24,
  "settings": [
    { "type": "text", "id": "anchor_id", "label": "Anchor ID" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Built by homeowners" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Real A-DIY decks in real backyards" },
    { "type": "text", "id": "rating_text", "label": "Rating badge text", "default": "4.8 customer rating" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Read Customer Reviews" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "blocks": [
    {
      "type": "photo",
      "name": "Photo",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "image_alt", "label": "Image alt text" },
        { "type": "checkbox", "id": "wide", "label": "Wide (spans two columns)", "default": false }
      ]
    }
  ],
  "presets": [{ "name": "Deck vs Patio · Gallery", "blocks": [{ "type": "photo" }] }]
}
{% endschema %}
