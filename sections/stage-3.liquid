    },
    {
      "type": "text",
      "id": "cta_button_text",
      "label": "CTA Button Text",
      "default": "CHAT NOW"
    },
    {
      "type": "url",
      "id": "cta_button_url",
      "label": "CTA Button URL"
    },
    {
      "type": "header",
      "content": "Delivery Guide Content"
    },
    {
      "type": "text",
      "id": "delivery_title",
      "label": "Delivery Section Title",
      "default": "Get ready for delivery day"
    },
    {
      "type": "text",
      "id": "delivery_subtitle",
      "label": "Delivery Subtitle",
      "default": "Your deck ships by LTL freight. Here's what to expect once it's on the way."
    },
    {
      "type": "header",
      "content": "Footer Question Box"
    },
    {
      "type": "text",
      "id": "question_title",
      "label": "Question Label",
      "default": "GOT A QUESTION?"
    },
    {
      "type": "text",
      "id": "question_button_text",
      "label": "Question Button Text",
      "default": "MESSAGE US"
    },
    {
      "type": "url",
      "id": "question_button_url",
      "label": "Question Button URL"
    }
  ],
  "blocks": [
    {
      "type": "delivery_step",
      "name": "Delivery Step",
      "settings": [
        {
          "type": "text",
          "id": "number",
          "label": "Step Number",
          "default": "01"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Step Title",
          "default": "Track it live"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Step Description",
          "default": "Follow your shipment and delivery progress from the moment it leaves our facility."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Stage 3",
      "blocks": [
        {
          "type": "delivery_step",
          "settings": {
            "number": "01",
            "title": "Track it live",
            "description": "Follow your shipment and delivery progress from the moment it leaves our facility."
          }
        },
        {
          "type": "delivery_step",
          "settings": {
            "number": "02",
            "title": "The carrier will call you",
            "description": "Once your deck reaches the local terminal, the delivery team will contact you to schedule a delivery time. They should arrive with the equipment needed to unload your order. If they don't, do not arrange equipment yourself. Contact us and we'll coordinate a safe delivery."
          }
        },
        {
          "type": "delivery_step",
          "settings": {
            "number": "03",
            "title": "Delivered curbside",
            "description": "Your deck will be delivered to the curb or driveway at your property."
          }
        },
        {
          "type": "delivery_step",
          "settings": {
            "number": "04",
            "title": "Check everything within 14 days",
            "description": "Once delivered, please make sure all parts arrived safely and nothing is missing. If you need more than 14 days to inspect your order, just let our team know."
          }
        }
      ]
    }
  ]
}
{% endschema %}
