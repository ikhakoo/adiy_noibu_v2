{%- comment -%}
  Fallback alt for gallery images whose alt was never set in the Files admin.
{%- endcomment -%}
{%- assign gallery_alt_fallback = section.settings.title | default: 'A-DIY deck gallery image' | strip_html -%}
<div class="custom-gallery-wrapper-main mobile-layout-{{ section.settings.mobile_layout }}" style="background-color: {{ section.settings.bg_color | default: '#f7f7f7' }};">
    <div class="custom-gallery-wrapper page-width">
        {% if section.settings.title != blank or section.settings.subtitle != blank %}
            <div class="gallery-header">
            {% if section.settings.title != blank %}
                <h2>{{ section.settings.title }}</h2>
            {% endif %}
            {% if section.settings.subtitle != blank %}
                <p>{{ section.settings.subtitle }}</p>
            {% endif %}
            </div>
        {% endif %}

        <div class="gallery-blocks-container" id="GalleryBlocksContainer-{{ section.id }}">
            {% for block in section.blocks %}
            <div 
                class="gallery-grid-block featured-pos-{{ block.settings.featured_position | default: 'left' }} {% if forloop.index > 2 %}is-hidden{% endif %}" 
                data-gallery-block 
                {{ block.shopify_attributes }}
            >
                {% comment %} Image 1 - Large Featured Image {% endcomment %}
                {% if block.settings.image_1 != blank %}
                <div class="gallery-item item-featured">
                    <img 
                    src="{{ block.settings.image_1 | image_url: width: 800 }}" 
                    data-full-src="{{ block.settings.image_1 | image_url: width: 1600 }}"
                    alt="{{ block.settings.image_1.alt | default: gallery_alt_fallback | escape }}" 
                    loading="lazy" 
                    width="{{ block.settings.image_1.width }}" 
                    height="{{ block.settings.image_1.height }}"
                    class="gallery-lightbox-trigger"
                    >
                </div>
                {% endif %}

                {% comment %} Images 2 to 7 - Smaller Grid Images {% endcomment %}
                {% for i in (2..7) %}
                {% capture img_key %}image_{{ i }}{% endcapture %}
                {% assign img_val = block.settings[img_key] %}
                {% if img_val != blank %}
                    <div class="gallery-item item-small">
                    <img 
                        src="{{ img_val | image_url: width: 400 }}" 
                        data-full-src="{{ img_val | image_url: width: 1600 }}"
                        alt="{{ img_val.alt | default: gallery_alt_fallback | escape }}" 
                        loading="lazy" 
                        width="{{ img_val.width }}" 
                        height="{{ img_val.height }}"
                        class="gallery-lightbox-trigger"
                    >
                    </div>
                {% endif %}
                {% endfor %}
            </div>
            {% endfor %}
        </div>

        {% if section.blocks.size > 1 %}
            <div class="gallery-load-more-btn-wrap">
              <button type="button" class="btn gallery-btn is-hidden" id="ShowLessGallery-{{ section.id }}">
                SHOW LESS
              </button>
              <button type="button" class="btn gallery-btn" id="LoadMoreGallery-{{ section.id }}">
                  LOAD MORE
              </button>
            </div>
        {% endif %}
    </div>
</div>

<!-- Fixed Frame Professional Lightbox -->
<div class="gallery-lightbox" id="GalleryLightbox-{{ section.id }}" aria-hidden="true" role="dialog">
  <div class="lightbox-overlay"></div>
  <button type="button" class="lightbox-close" id="LightboxClose-{{ section.id }}" aria-label="Close">&times;</button>
  
  <div class="lightbox-stage">
    <button type="button" class="lightbox-nav lightbox-prev" id="LightboxPrev-{{ section.id }}" aria-label="Previous">&lsaquo;</button>
    
    <!-- Fixed Square / Universal Frame Container -->
    <div class="lightbox-frame">
      <img src="" id="LightboxImage-{{ section.id }}" alt="">
    </div>

    <button type="button" class="lightbox-nav lightbox-next" id="LightboxNext-{{ section.id }}" aria-label="Next">&rsaquo;</button>
  </div>
</div>

<style>
  .custom-gallery-wrapper {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .gallery-header {
    text-align: left;
    margin-bottom: 24px;
  }

  .gallery-header h2 {
    margin: 0 0 0.5rem 0;
    line-height: 1.2;
    color: #111;
  }

  .gallery-header p {
    font-size: 1.2rem;
    color: #666;
    margin: 0;
    letter-spacing: 0.5px;
    text-transform: uppercase;
  }

  .gallery-blocks-container {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .gallery-grid-block {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    grid-auto-rows: minmax(180px, auto);
    gap: 12px;
    transition: all 0.3s ease;
  }

  .gallery-grid-block.is-hidden {
    display: none;
  }

  .gallery-item {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    border-radius: 4px;
  }

  .gallery-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    cursor: pointer;
    transition: transform 0.3s ease;
    aspect-ratio: 1;
  }

  .gallery-item img:hover {
    transform: scale(1.03);
  }

  /* Desktop Grid Template Areas (Proper Alignment Fix) */
  @media screen and (min-width: 769px) {
    .gallery-grid-block.featured-pos-left {
      grid-template-areas:
        "feat feat img2 img3 img4"
        "feat feat img5 img6 img7";
    }

    .gallery-grid-block.featured-pos-right {
      grid-template-areas:
        "img2 img3 img4 feat feat"
        "img5 img6 img7 feat feat";
    }

    .gallery-item.item-featured {
      grid-area: feat;
    }

    .gallery-item:nth-child(2) { grid-area: img2; }
    .gallery-item:nth-child(3) { grid-area: img3; }
    .gallery-item:nth-child(4) { grid-area: img4; }
    .gallery-item:nth-child(5) { grid-area: img5; }
    .gallery-item:nth-child(6) { grid-area: img6; }
    .gallery-item:nth-child(7) { grid-area: img7; }
  }

  .gallery-load-more-btn-wrap {
    display: flex;
    justify-content: center;
    gap: 12px;
    margin-top: 32px;
  }

  .gallery-btn {
    padding: 12px 32px;
    cursor: pointer;
    border-radius: 8px;
    font-size: 14px;
    border: 1px solid #194636;
    transition: background-color .3s ease, color .3s ease, box-shadow .3s ease, transform .3s ease;
    background: #EFF9F5;
    color: #000;
  }

  .gallery-btn:hover {
    border-color: #000;
    background: #000;
    color: #fff;
  }

  .gallery-btn.is-hidden {
    display: none;
  }

  /* =======================================
     FIXED FRAME PROFESSIONAL LIGHTBOX STYLES
     ======================================= */
  .gallery-lightbox {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    z-index: 999999;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.25s ease, visibility 0.25s ease;
  }

  .gallery-lightbox.active {
    opacity: 1;
    visibility: visible;
    background: #000000c9;
  }

  .lightbox-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.75);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  .lightbox-close {
    position: absolute;
    top: 20px;
    right: 25px;
    background: transparent;
    border: none;
    color: #fff;
    font-size: 32px;
    cursor: pointer;
    z-index: 10;
    line-height: 1;
    opacity: 0.8;
    transition: opacity 0.2s;
  }

  .lightbox-close:hover {
    opacity: 1;
  }

  .lightbox-stage {
    position: relative;
    z-index: 5;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    max-width: 1200px;
    padding: 0 80px;
  }

  .lightbox-frame {
    width: 100%;
    max-width: 900px;
    height: 90vh;
    max-height: 900px;
    border-radius: 12px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .lightbox-frame img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  .lightbox-nav {
    background: rgba(255, 255, 255, 0.25);
    border: 1px solid rgba(255, 255, 255, 0.3);
    color: #fff;
    font-size: 28px;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 6;
    transition: all 0.2s ease;
  }

  .lightbox-nav:hover {
    background: rgba(255, 255, 255, 0.8);
    color: #000;
  }

  .lightbox-prev {
    left: 15px;
  }

  .lightbox-next {
    right: 15px;
  }

  /* Mobile Responsive Adjustments */
  @media screen and (max-width: 768px) {
    .gallery-grid-block {
      grid-template-columns: repeat(2, 1fr);
      grid-auto-rows: minmax(150px, auto);
      gap: 8px;
    }

    .gallery-item.item-featured {
      grid-column: span 2 !important;
      grid-row: span 2 !important;
    }

    /* Seamless 2-Column Grid Across Blocks */
    .mobile-layout-grid_2_col .gallery-blocks-container {
      display: grid !important;
      grid-template-columns: repeat(2, 1fr) !important;
      gap: 8px !important;
    }

    .mobile-layout-grid_2_col .gallery-grid-block {
      display: contents !important;
    }

    .mobile-layout-grid_2_col .gallery-grid-block.is-hidden {
      display: none !important;
    }

    .mobile-layout-grid_2_col .gallery-item.item-featured,
    .mobile-layout-grid_2_col .gallery-item.item-small {
      grid-column: span 1 !important;
      grid-row: span 1 !important;
      height: 100% !important;
    }

    .mobile-layout-grid_2_col .gallery-item img {
      aspect-ratio: 1 / 1;
      object-fit: cover;
    }

    .lightbox-stage {
      padding: 0 10px;
    }

    .lightbox-frame {
      height: 60vh;
      max-width: 90vw;
      border-radius: 8px;
    }

    .lightbox-nav {
      width: 38px;
      height: 38px;
      font-size: 22px;
      background: rgba(0, 0, 0, 0.5);
    }

    .lightbox-prev {
      left: 20px;
    }

    .lightbox-next {
      right: 20px;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const sectionId = '{{ section.id }}';
    const container = document.getElementById(`GalleryBlocksContainer-${sectionId}`);
    const loadMoreBtn = document.getElementById(`LoadMoreGallery-${sectionId}`);
    const showLessBtn = document.getElementById(`ShowLessGallery-${sectionId}`);

    const lightbox = document.getElementById(`GalleryLightbox-${sectionId}`);
    const lightboxImg = document.getElementById(`LightboxImage-${sectionId}`);
    const closeBtn = document.getElementById(`LightboxClose-${sectionId}`);
    const prevBtn = document.getElementById(`LightboxPrev-${sectionId}`);
    const nextBtn = document.getElementById(`LightboxNext-${sectionId}`);

    let galleryImages = [];
    let currentIndex = 0;

    // --- 1. Load More / Show Less ---
    if (loadMoreBtn && showLessBtn && container) {
      const blocks = Array.from(container.querySelectorAll('.gallery-grid-block'));

      function updateButtons() {
        const hiddenBlocks = blocks.filter(b => b.classList.contains('is-hidden'));
        const visibleBlocks = blocks.filter(b => !b.classList.contains('is-hidden'));

        if (hiddenBlocks.length === 0) {
          loadMoreBtn.classList.add('is-hidden');
        } else {
          loadMoreBtn.classList.remove('is-hidden');
        }

        if (visibleBlocks.length > 1) {
          showLessBtn.classList.remove('is-hidden');
        } else {
          showLessBtn.classList.add('is-hidden');
        }
      }

      loadMoreBtn.addEventListener('click', function() {
        const firstHidden = blocks.find(b => b.classList.contains('is-hidden'));
        if (firstHidden) {
          firstHidden.classList.remove('is-hidden');
          updateButtons();
        }
      });

      showLessBtn.addEventListener('click', function() {
        const visibleBlocks = blocks.filter(b => !b.classList.contains('is-hidden'));
        if (visibleBlocks.length > 1) {
          const lastVisible = visibleBlocks[visibleBlocks.length - 1];
          lastVisible.classList.add('is-hidden');
          updateButtons();
        }
      });
    }

    // --- 2. Lightbox Logic ---
    function refreshGalleryImages() {
      galleryImages = Array.from(container.querySelectorAll('.gallery-lightbox-trigger'));
    }

    function openLightbox(index) {
      refreshGalleryImages();
      if (index < 0 || index >= galleryImages.length) return;
      
      currentIndex = index;
      const targetImg = galleryImages[currentIndex];
      const fullSrc = targetImg.getAttribute('data-full-src') || targetImg.src;

      lightboxImg.src = fullSrc;
      lightboxImg.alt = targetImg.getAttribute('alt') || '';
      lightbox.classList.add('active');
      lightbox.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }

    function closeLightbox() {
      lightbox.classList.remove('active');
      lightbox.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }

    function showNext() {
      refreshGalleryImages();
      currentIndex = (currentIndex + 1) % galleryImages.length;
      openLightbox(currentIndex);
    }

    function showPrev() {
      refreshGalleryImages();
      currentIndex = (currentIndex - 1 + galleryImages.length) % galleryImages.length;
      openLightbox(currentIndex);
    }

    container.addEventListener('click', function(e) {
      if (e.target.classList.contains('gallery-lightbox-trigger')) {
        refreshGalleryImages();
        const index = galleryImages.indexOf(e.target);
        if (index !== -1) {
          openLightbox(index);
        }
      }
    });

    if (closeBtn) closeBtn.addEventListener('click', closeLightbox);
    if (nextBtn) nextBtn.addEventListener('click', showNext);
    if (prevBtn) prevBtn.addEventListener('click', showPrev);

    if (lightbox) {
      lightbox.addEventListener('click', function(e) {
        if (!e.target.closest('.lightbox-frame') && !e.target.closest('.lightbox-nav')) {
          closeLightbox();
        }
      });
    }

    document.addEventListener('keydown', function(e) {
      if (!lightbox.classList.contains('active')) return;
      if (e.key === 'Escape') closeLightbox();
      if (e.key === 'ArrowRight') showNext();
      if (e.key === 'ArrowLeft') showPrev();
    });
  });
</script>

{% schema %}
{
  "name": "A-DIY Real Life Gallery",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Poly & Bark, in real life"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subheading",
      "default": "USE #POLYANDBARK AND TAG US @POLYANDBARK"
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "Mobile Layout Style",
      "default": "featured",
      "options": [
        {
          "value": "featured",
          "label": "Featured Layout (1 Big Image + Small Images)"
        },
        {
          "value": "grid_2_col",
          "label": "Equal 2-Column Grid (Standard 2x2)"
        }
      ]
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background Color",
      "default": "#f4f4f4"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top Padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "gallery_set",
      "name": "7 Image Block Set",
      "settings": [
        {
          "type": "select",
          "id": "featured_position",
          "label": "Featured Image Position (Desktop)",
          "default": "left",
          "options": [
            {
              "value": "left",
              "label": "Left Side"
            },
            {
              "value": "right",
              "label": "Right Side"
            }
          ]
        },
        {
          "type": "image_picker",
          "id": "image_1",
          "label": "Image 1 (Large Featured)"
        },
        {
          "type": "image_picker",
          "id": "image_2",
          "label": "Image 2"
        },
        {
          "type": "image_picker",
          "id": "image_3",
          "label": "Image 3"
        },
        {
          "type": "image_picker",
          "id": "image_4",
          "label": "Image 4"
        },
        {
          "type": "image_picker",
          "id": "image_5",
          "label": "Image 5"
        },
        {
          "type": "image_picker",
          "id": "image_6",
          "label": "Image 6"
        },
        {
          "type": "image_picker",
          "id": "image_7",
          "label": "Image 7"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "A-DIY Real Life Gallery",
      "blocks": [
        {
          "type": "gallery_set"
        }
      ]
    }
  ]
}
{% endschema %}