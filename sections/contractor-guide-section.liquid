{%- style -%}
  .contractor-guide-{{ section.id }} {
    background-color: {{ section.settings.section_bg }};
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }

  @media screen and (min-width: 750px) {
    .contractor-guide-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_desktop }}px;
      padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
    }
  }

  .contractor-guide-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }

  /* Header Styles */
  .contractor-guide-header {
    text-align: center;
    max-width: 800px;
    margin: 0 auto 3rem auto;
  }

  .contractor-guide-title {
    font-size: 1.75rem;
    font-weight: 700;
    color: #1a1a1a;
    line-height: 1.25;
    margin: 0 0 1rem 0;
  }

  @media screen and (min-width: 750px) {
    .contractor-guide-title {
      font-size: 2.35rem;
    }
  }

  .contractor-guide-subtitle {
    font-size: 14px;
    line-height: 1.5;
    color: #000;
    margin: 0;
  }

  /* Mobile Slider & Desktop Grid */
  .contractor-cards-wrapper-{{ section.id }} {
    width: 100%;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none; /* Firefox */
    -ms-overflow-style: none; /* IE/Edge */
    padding-bottom: 8px;
  }

  .contractor-cards-wrapper-{{ section.id }}::-webkit-scrollbar {
    display: none; /* Chrome, Safari, Opera */
  }

  .contractor-cards-grid {
    display: flex;
    gap: 16px;
  }

  @media screen and (min-width: 990px) {
    .contractor-cards-wrapper-{{ section.id }} {
      overflow: visible;
      scroll-snap-type: none;
    }
    .contractor-cards-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
      align-items: stretch;
    }
  }

  /* Card Styling */
  .contractor-card {
    flex: 0 0 85%;
    max-width: 85%;
    scroll-snap-align: center;
    background-color: #ffffff;
    border-radius: 12px;
    padding: 28px 24px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    border: 1px solid rgba(0, 0, 0, 0.04);
    box-sizing: border-box;
  }

  @media screen and (min-width: 576px) and (max-width: 989px) {
    .contractor-card {
      flex: 0 0 55%;
      max-width: 55%;
    }
  }

  @media screen and (min-width: 990px) {
    .contractor-card {
      flex: initial;
      max-width: 100%;
      scroll-snap-align: none;
    }
  }

  .contractor-card.is-dark {
    background-color: #1d1e1a;
    color: #ffffff;
    border: none;
  }

  .contractor-card-title {
    font-size: 14px;
    font-weight: 500;
    color: #000;
    margin: 0 0 20px 0;
    line-height: 1.35;
  }

  .contractor-card.is-dark .contractor-card-title {
    color: #dfd3b7; /* Soft gold/tan accent */
  }

  /* Checklist Items */
  .contractor-checklist {
    list-style: none;
    padding: 0;
    margin: 0 0 20px 0;
    flex-grow: 1;
  }

  .contractor-check-item {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 12px;
    line-height: 1.4;
    color: #333333;
    margin-bottom: 14px;
  }

  .contractor-card.is-dark .contractor-check-item {
    color: #e5e5e5;
  }

  .contractor-check-icon {
    flex-shrink: 0;
    width: 18px;
    height: 18px;
  }

  .contractor-card:not(.is-dark) .contractor-check-icon circle {
    fill: #eaf3ed;
  }
  .contractor-card:not(.is-dark) .contractor-check-icon path {
    stroke: #2e5a43;
  }

  .contractor-card.is-dark .contractor-check-icon circle {
    fill: rgba(255, 255, 255, 0.1);
  }
  .contractor-card.is-dark .contractor-check-icon path {
    stroke: #cccccc;
  }

  /* Notice Box */
  .contractor-notice-box {
    background-color: #f2f0eb;
    border-radius: 8px;
    padding: 14px 16px;
    font-size: 11px;
    line-height: 1.5;
    color: #444444;
    margin-top: auto;
  }

  /* Mobile Custom Scrollbar Indicator */
  .contractor-scrollbar-nav-{{ section.id }} {
    display: flex;
    margin-top: 1.5rem;
    padding: 0 1rem;
  }

  @media screen and (min-width: 990px) {
    .contractor-scrollbar-nav-{{ section.id }} {
      display: none;
    }
  }

  .contractor-scrollbar-track-{{ section.id }} {
    position: relative;
    width: 100%;
    height: 6px;
    background-color: rgba(0, 0, 0, 0.08);
    border-radius: 9999px;
    cursor: pointer;
    display: flex;
    align-items: center;
  }

  .contractor-scrollbar-thumb-{{ section.id }} {
    position: absolute;
    top: 0;
    height: 100%;
    min-width: 35px;
    background-color: #2b4f42;
    border-radius: 9999px;
    border: none;
    padding: 0;
    outline: none;
    touch-action: none;
  }

  .contractor-scrollbar-thumb-hitbox {
    position: absolute;
    top: -15px;
    bottom: -15px;
    left: 0;
    right: 0;
  }

  /* Bottom CTA Button Container */
  .contractor-cta-wrapper {
    text-align: center;
    margin-top: 3rem;
  }

  .contractor-cta-button {
    display: inline-block;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 16px 32px;
    text-decoration: none;
    box-shadow: 0 4px 12px rgba(53, 82, 67, 0.2);
    background: #2b4f42;
    color: #fff;
    border-radius: 8px;
    font-weight: 500;
    font-size: 14px;
    transition: background-color .3s ease, color .3s ease, box-shadow .3s ease, transform .3s ease;
  }

  .contractor-cta-button:hover {
    background: #000;
    box-shadow: 0 0 10px #2b4f42, 
                0 0 2px #000, 
                0 0 30px rgba(43, 79, 66, 0.6);
    transform: translateY(-2px);
    color: #fff;
  }
{%- endstyle -%}

<div class="contractor-guide-{{ section.id }}">
  <div class="contractor-guide-container page-width">
    
    {%- if section.settings.heading != blank or section.settings.subtitle != blank -%}
      <div class="contractor-guide-header">
        {%- if section.settings.heading != blank -%}
          <h2 class="contractor-guide-title">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.subtitle != blank -%}
          <p class="contractor-guide-subtitle">{{ section.settings.subtitle }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="contractor-cards-wrapper-{{ section.id }} js-contractor-cards-wrapper-{{ section.id }}">
      <div class="contractor-cards-grid">
        {%- for block in section.blocks -%}
          <div class="contractor-card {% if block.settings.is_dark %}is-dark{% endif %}" {{ block.shopify_attributes }}>
            <div>
              {%- if block.settings.title != blank -%}
                <h3 class="contractor-card-title">{{ block.settings.title }}</h3>
              {%- endif -%}

              {%- assign items = block.settings.checklist_items | newline_to_br | split: '<br />' -%}
              {%- if items.size > 0 -%}
                <ul class="contractor-checklist">
                  {%- for item in items -%}
                    {%- assign clean_item = item | strip -%}
                    {%- if clean_item != blank -%}
                      <li class="contractor-check-item">
                        <svg class="contractor-check-icon" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                          <circle cx="10" cy="10" r="10"/>
                          <path d="M6 10L9 13L14 7" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                        <span>{{ clean_item }}</span>
                      </li>
                    {%- endif -%}
                  {%- endfor -%}
                </ul>
              {%- endif -%}
            </div>

            {%- if block.settings.notice_text != blank -%}
              <div class="contractor-notice-box">
                {{ block.settings.notice_text }}
              </div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    </div>

    <!-- Scrollbar Navigation for Mobile -->
    <div class="contractor-scrollbar-nav-{{ section.id }}">
      <div class="contractor-scrollbar-track-{{ section.id }} js-scroll-track-{{ section.id }}">
        <div class="contractor-scrollbar-thumb-{{ section.id }} js-scroll-thumb-{{ section.id }}">
          <div class="contractor-scrollbar-thumb-hitbox"></div>
        </div>
      </div>
    </div>

    {%- if section.settings.button_label != blank -%}
      <div class="contractor-cta-wrapper">
        <a href="{{ section.settings.button_link | default: '#' }}" class="contractor-cta-button">
          {{ section.settings.button_label }}
        </a>
      </div>
    {%- endif -%}

  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const sectionContainer = document.querySelector('.contractor-guide-{{ section.id }}');
    if (!sectionContainer) return;

    const cardsWrapper = sectionContainer.querySelector('.js-contractor-cards-wrapper-{{ section.id }}');
    const scrollTrack = sectionContainer.querySelector('.js-scroll-track-{{ section.id }}');
    const scrollThumb = sectionContainer.querySelector('.js-scroll-thumb-{{ section.id }}');

    if (!cardsWrapper || !scrollTrack || !scrollThumb) return;

    let isThumbDragging = false;
    let dragStartX = 0;
    let initialScrollLeft = 0;
    let rAFId = null;

    function updateThumbUI() {
      const scrollWidth = cardsWrapper.scrollWidth;
      const clientWidth = cardsWrapper.clientWidth;
      const maxScrollLeft = scrollWidth - clientWidth;

      if (maxScrollLeft <= 0) {
        scrollThumb.style.width = '100%';
        scrollThumb.style.left = '0%';
        return;
      }

      const thumbWidthRatio = clientWidth / scrollWidth;
      const thumbWidthPercent = Math.max(thumbWidthRatio * 100, 20);
      const maxThumbLeftPercent = 100 - thumbWidthPercent;
      
      const currentScrollRatio = cardsWrapper.scrollLeft / maxScrollLeft;
      const currentLeftPercent = Math.min(Math.max(currentScrollRatio * maxThumbLeftPercent, 0), maxThumbLeftPercent);

      scrollThumb.style.width = thumbWidthPercent + '%';
      scrollThumb.style.left = currentLeftPercent + '%';
    }

    cardsWrapper.addEventListener('scroll', function() {
      if (!isThumbDragging) {
        if (rAFId) cancelAnimationFrame(rAFId);
        rAFId = requestAnimationFrame(updateThumbUI);
      }
    }, { passive: true });

    window.addEventListener('resize', updateThumbUI);
    updateThumbUI();

    /* Dragging Logic */
    scrollThumb.addEventListener('pointerdown', (e) => {
      e.stopPropagation();
      e.preventDefault();

      isThumbDragging = true;
      dragStartX = e.clientX;
      initialScrollLeft = cardsWrapper.scrollLeft;

      cardsWrapper.style.scrollSnapType = 'none';
      cardsWrapper.style.scrollBehavior = 'auto';
      scrollThumb.setPointerCapture(e.pointerId);
    });

    scrollThumb.addEventListener('pointermove', (e) => {
      if (!isThumbDragging) return;

      const deltaX = e.clientX - dragStartX;
      const trackWidth = scrollTrack.clientWidth;
      const thumbWidth = scrollThumb.offsetWidth;
      const maxThumbMove = trackWidth - thumbWidth;
      const maxContainerScroll = cardsWrapper.scrollWidth - cardsWrapper.clientWidth;

      if (maxThumbMove > 0) {
        const scrollDelta = (deltaX / maxThumbMove) * maxContainerScroll;
        cardsWrapper.scrollLeft = initialScrollLeft + scrollDelta;
        updateThumbUI();
      }
    });

    const releasePointer = (e) => {
      if (isThumbDragging) {
        isThumbDragging = false;
        cardsWrapper.style.scrollSnapType = 'x mandatory';
        cardsWrapper.style.scrollBehavior = 'smooth';

        try {
          scrollThumb.releasePointerCapture(e.pointerId);
        } catch(err) {}
      }
    };

    scrollThumb.addEventListener('pointerup', releasePointer);
    scrollThumb.addEventListener('pointercancel', releasePointer);

    /* Track Click Navigation */
    scrollTrack.addEventListener('click', (e) => {
      if (e.target.closest('.js-scroll-thumb-{{ section.id }}')) return;

      const trackRect = scrollTrack.getBoundingClientRect();
      const clickX = e.clientX - trackRect.left;
      const thumbWidth = scrollThumb.offsetWidth;
      
      let targetLeft = clickX - (thumbWidth / 2);
      const maxThumbMove = trackRect.width - thumbWidth;

      if (targetLeft < 0) targetLeft = 0;
      if (targetLeft > maxThumbMove) targetLeft = maxThumbMove;

      const clickRatio = targetLeft / maxThumbMove;
      const maxContainerScroll = cardsWrapper.scrollWidth - cardsWrapper.clientWidth;

      cardsWrapper.style.scrollBehavior = 'smooth';
      cardsWrapper.scrollTo({
        left: clickRatio * maxContainerScroll,
        behavior: 'smooth'
      });
    });
  });
</script>

{% schema %}
{
  "name": "Contractor Guide Section",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "How Do You Find and Hire a Deck Contractor in New York?"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle / Description",
      "default": "Start by defining the project before collecting estimates. Contractors cannot provide directly comparable quotes when each is pricing a different size, material, height or scope of work."
    },
    {
      "type": "header",
      "content": "Button Settings"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "VIEW THE COMPLETE CONTRACTOR-HIRING CHECKLIST"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Section Styling"
    },
    {
      "type": "color",
      "id": "section_bg",
      "label": "Background Color",
      "default": "#f5f2eb"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Desktop Padding Top",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Desktop Padding Bottom",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Mobile Padding Top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Mobile Padding Bottom",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "guide_card",
      "name": "Guide Card",
      "settings": [
        {
          "type": "checkbox",
          "id": "is_dark",
          "label": "Dark Background Theme",
          "default": false
        },
        {
          "type": "text",
          "id": "title",
          "label": "Card Title",
          "default": "Prepare a short written description containing:"
        },
        {
          "type": "textarea",
          "id": "checklist_items",
          "label": "Checklist Items (One per line)",
          "default": "Approximate deck dimensions\nPreferred material\nProposed height\nAttached or freestanding design\nStairs and railings\nExisting deck removal\nSite conditions\nPermit responsibility"
        },
        {
          "type": "textarea",
          "id": "notice_text",
          "label": "Bottom Notice Box Text (Leave blank if none)",
          "default": "Then collect multiple written estimates and compare the same scope. The New York Attorney General recommends obtaining multiple estimates, checking references, confirming insurance and understanding permit responsibilities before hiring a home-improvement contractor."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Contractor Guide Section",
      "blocks": [
        {
          "type": "guide_card",
          "settings": {
            "is_dark": false,
            "title": "Prepare a short written description containing:",
            "checklist_items": "Approximate deck dimensions\nPreferred material\nProposed height\nAttached or freestanding design\nStairs and railings\nExisting deck removal\nSite conditions\nPermit responsibility",
            "notice_text": "Then collect multiple written estimates and compare the same scope. The New York Attorney General recommends obtaining multiple estimates, checking references, confirming insurance and understanding permit responsibilities before hiring a home-improvement contractor."
          }
        },
        {
          "type": "guide_card",
          "settings": {
            "is_dark": false,
            "title": "What Should You Verify?",
            "checklist_items": "Business identity and address\nRequired license or registration\nLiability and workers' compensation coverage\nRecent references and completed projects\nWritten project scope\nPayment schedule\nWarranty terms\nExpected start and completion dates",
            "notice_text": "Home-improvement contractor licensing requirements apply in certain New York jurisdictions, including New York City and several counties and municipalities. Confirm current requirements with the applicable local authority."
          }
        },
        {
          "type": "guide_card",
          "settings": {
            "is_dark": true,
            "title": "What Should a Written Deck Quote Include?",
            "checklist_items": "Deck dimensions and layout\nLumber grade and framing dimensions\nSurface material and brand\nHardware and connectors\nFootings, posts and bracing\nStairs and railings\nPermit and engineering responsibility\nDemolition, disposal and cleanup\nSchedule, payments and warranty\nAll exclusions and allowances",
            "notice_text": ""
          }
        }
      ]
    }
  ]
}
{% endschema %}