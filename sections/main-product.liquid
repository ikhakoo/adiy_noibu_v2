  <script>
    (function() {
      const containerId = 'custom-price-{{ section.id }}';

      function initCustomPriceLogic() {
        const container = document.getElementById(containerId);
        if (!container) return;

        // Copy Button Handler
        const copyBtn = container.querySelector('.js-copy-promo-btn');
        if (copyBtn && !copyBtn.dataset.bound) {
          copyBtn.dataset.bound = "true";
          copyBtn.addEventListener('click', function(e) {
            e.preventDefault();
            const codeText = this.getAttribute('data-code');
            const tooltip = this.nextElementSibling;

            if (navigator.clipboard && navigator.clipboard.writeText) {
              navigator.clipboard.writeText(codeText).then(() => showTooltip(tooltip));
            } else {
              const tempInput = document.createElement('input');
              tempInput.value = codeText;
              document.body.appendChild(tempInput);
              tempInput.select();
              document.execCommand('copy');
              document.body.removeChild(tempInput);
              showTooltip(tooltip);
            }
          });
        }

        function showTooltip(tooltip) {
          if (tooltip) {
            tooltip.style.display = 'block';
            setTimeout(() => { tooltip.style.display = 'none'; }, 1500);
          }
        }

        // Price recalculation based on updated rendered DOM
        function recalculateDiscount() {
          const mainPriceElem = container.querySelector('.price-item--regular, .price-item--sale');
          const discountAmountElem = container.querySelector('.discount-amount');
          
          if (!mainPriceElem || !discountAmountElem) return;

          // Extract digits and decimals from the updated main price element
          const priceText = mainPriceElem.textContent.replace(/[^0-9.,]/g, '');
          if (!priceText) return;

          // Parse float safely handling comma/dot
          let cleanedPrice = priceText;
          if (cleanedPrice.includes(',') && cleanedPrice.includes('.')) {
            cleanedPrice = cleanedPrice.replace(/,/g, '');
          } else if (cleanedPrice.includes(',') && !cleanedPrice.includes('.')) {
            cleanedPrice = cleanedPrice.replace(',', '.');
          }

          const currentPrice = parseFloat(cleanedPrice);
          if (isNaN(currentPrice)) return;

          const discountType = container.getAttribute('data-discount-type');
          const discountVal = parseFloat(container.getAttribute('data-discount-val')) || 0;

          let finalPrice = currentPrice;
          if (discountType === 'percentage') {
            finalPrice = currentPrice - (currentPrice * (discountVal / 100));
          } else {
            finalPrice = currentPrice - discountVal;
          }

          if (finalPrice < 0) finalPrice = 0;

          // Format output matching original currency symbol
          const symbolMatch = mainPriceElem.textContent.match(/[^0-9.,\s]+/);
          const symbol = symbolMatch ? symbolMatch[0] : '$';
          
          discountAmountElem.textContent = symbol + finalPrice.toFixed(2);
        }

        // Dynamic DOM mutation observer (Triggers immediately when Dawn updates HTML price via AJAX)
        const priceWrapper = container.querySelector('.price-wrapper');
        if (priceWrapper && !priceWrapper.dataset.observed) {
          priceWrapper.dataset.observed = "true";
          const observer = new MutationObserver(function() {
            recalculateDiscount();
          });
          observer.observe(priceWrapper, { childList: true, subtree: true, characterData: true });
        }

        // Global fallback event listeners for variant pickers
        document.addEventListener('change', function(e) {
          if (e.target.matches('variant-selects input, variant-selects select, variant-radios input')) {
            setTimeout(recalculateDiscount, 100);
            setTimeout(recalculateDiscount, 300);
          }
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initCustomPriceLogic);
      } else {
        initCustomPriceLogic();
      }
    })();
  </script>
                {%- when 'countdown_timer' -%}
                  <div 
                    id="countdown-block-{{ section.id }}-{{ block.id }}" 
                    class="custom-countdown-banner"
                    {{ block.shopify_attributes }}
                    style="background-color: {{ block.settings.bg_color }}; color: {{ block.settings.text_color }};"
                  >
                    <div style="display: flex; align-items: center; gap: 10px;">
                      {% comment %} Badge % Icon {% endcomment %}
                      <span style="display: inline-flex; align-items: center; justify-content: center; background: #ffffff; color: {{ block.settings.bg_color }}; border-radius: 50%; width: 26px; height: 26px; font-weight: bold; font-size: 13px;">
                        %
                      </span>
                      <span class="count-down-title" style="font-weight: 400; font-size: 14px; letter-spacing: 0.2px;">
                        {{ block.settings.heading }}
                      </span>
                    </div>

                    <div class="timer-display" style="font-size: 15px; font-weight: 600; white-space: nowrap;">
                      <span class="js-timer-days">0d</span> : 
                      <span class="js-timer-hours">00h</span> : 
                      <span class="js-timer-mins">00m</span> : 
                      <span class="js-timer-secs">00s</span>
                    </div>
                  </div>

                  <script>
                    (function() {
                      const container = document.getElementById('countdown-block-{{ section.id }}-{{ block.id }}');
                      if (!container) return;

                      const endDateStr = "{{ block.settings.end_date }}T{{ block.settings.end_time }}";
                      const targetDate = new Date(endDateStr).getTime();

                      if (isNaN(targetDate)) {
                        console.warn('Invalid Countdown Date Format');
                        return;
                      }

                      const daysEl = container.querySelector('.js-timer-days');
                      const hoursEl = container.querySelector('.js-timer-hours');
                      const minsEl = container.querySelector('.js-timer-mins');
                      const secsEl = container.querySelector('.js-timer-secs');

                      function updateTimer() {
                        const now = new Date().getTime();
                        const difference = targetDate - now;

                        if (difference <= 0) {
                          daysEl.textContent = '0d';
                          hoursEl.textContent = '00h';
                          minsEl.textContent = '00m';
                          secsEl.textContent = '00s';
                          clearInterval(timerInterval);
                          return;
                        }

                        const days = Math.floor(difference / (1000 * 60 * 60 * 24));
                        const hours = Math.floor((difference % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
                        const minutes = Math.floor((difference % (1000 * 60 * 60)) / (1000 * 60));
                        const seconds = Math.floor((difference % (1000 * 60)) / 1000);

                        daysEl.textContent = days + 'd';
                        hoursEl.textContent = (hours < 10 ? '0' : '') + hours + 'h';
                        minsEl.textContent = (minutes < 10 ? '0' : '') + minutes + 'm';
                        secsEl.textContent = (seconds < 10 ? '0' : '') + seconds + 's';
                      }

                      updateTimer();
                      const timerInterval = setInterval(updateTimer, 1000);
                    })();
                  </script>

