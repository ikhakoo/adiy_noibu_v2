{%- comment -%}
  Right-Aligned Floating Sticky ATC Box
  Usage: {% render 'custom-sticky-atc-bar' %}
{%- endcomment -%}

<div id="right-aligned-sticky-box" class="right-aligned-sticky-box">
  <div class="rac-content">
    <div class="rac-header">
      <span class="rac-title">{{ product.title }}</span>
      <span class="rac-price">{{ product.selected_or_first_available_variant.price | money }}</span>
    </div>

    <div class="rac-action">
      {%- form 'product', product, id: 'rac-sticky-form', class: 'sticky-product-form' -%}
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" id="rac-variant-input">
        <button type="submit" name="add" class="rac-btn" {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %}>
          <span>{% if product.selected_or_first_available_variant.available %}Add To Cart{% else %}Sold Out{% endif %}</span>
        </button>
      {%- endform -%}
    </div>
  </div>
</div>

<style>
  #right-aligned-sticky-box.right-aligned-sticky-box {
    position: fixed !important;
    bottom: 20px !important;
    /* Yeh right side se exact wahi space lega jo aapke right column ki hai */
    right: max(20px, calc((100vw - 1200px) / 2 + 20px)) !important;
    width: 380px !important;
    background-color: #ffffff !important;
    box-shadow: 0 5px 25px rgba(0, 0, 0, 0.15) !important;
    padding: 16px !important;
    border-radius: 8px !important;
    z-index: 999999 !important;
    border: 1px solid #e5e5e5 !important;
    box-sizing: border-box;
    display: none !important;
    transform: translateY(15px);
    opacity: 0;
    transition: all 0.3s ease-in-out;
  }

  #right-aligned-sticky-box.right-aligned-sticky-box.is-visible {
    display: block !important;
    transform: translateY(0) !important;
    opacity: 1 !important;
  }

  .rac-content {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .rac-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
  }

  .rac-title {
    font-size: 13px;
    font-weight: 600;
    color: #121212;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 220px;
  }

  .rac-price {
    font-size: 15px;
    font-weight: 700;
    color: #121212;
    white-space: nowrap;
  }

  .rac-action .rac-btn {
    background-color: #8b7355; /* Apne theme ke button color ke mutabiq match kar lein */
    color: #fff;
    border: none;
    width: 100%;
    padding: 12px 20px;
    font-size: 15px;
    font-weight: 600;
    border-radius: 4px;
    cursor: pointer;
    transition: background-color 0.2s ease;
  }

  .rac-btn:hover {
    background-color: #725d43;
  }

  .rac-btn:disabled {
    background-color: #ccc;
    cursor: not-allowed;
  }

  /* Tablets aur Mobile ke liye responsive adjustment */
  @media screen and (max-width: 1024px) {
    #right-aligned-sticky-box.right-aligned-sticky-box {
      right: 20px !important;
      left: auto !important;
      width: 340px !important;
    }
  }

  @media screen and (max-width: 768px) {
    #right-aligned-sticky-box.right-aligned-sticky-box {
      left: 15px !important;
      right: 15px !important;
      width: auto !important;
    }
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    const stickyBox = document.getElementById("right-aligned-sticky-box");
    const mainAddToCartBtn = document.querySelector(".product-form__submit, form[action*='/cart/add'] button[type='submit']");
    const productSection = document.querySelector(".product, .product-section, section[id*='product']");

    if (!stickyBox || !mainAddToCartBtn) return;

    // Body ke end mein append kar dete hain taake fixed positioning hamesha screen par right side par rahay
    document.body.appendChild(stickyBox);

    function checkVisibility() {
      const btnRect = mainAddToCartBtn.getBoundingClientRect();
      const windowHeight = window.innerHeight || document.documentElement.clientHeight;

      let isProductInView = true;
      if (productSection) {
        const sectionRect = productSection.getBoundingClientRect();
        isProductInView = (sectionRect.top <= windowHeight && sectionRect.bottom >= 0);
      }

      // Main button screen view se bahar nikal gaya ho (upar ya neeche)
      const isBtnOutOfView = (btnRect.top > windowHeight) || (btnRect.bottom < 0);

      // Box sirf tabhi show hoga jab user product section ke andar ho AUR main button screen par na ho
      if (isProductInView && isBtnOutOfView) {
        stickyBox.classList.add("is-visible");
      } else {
        stickyBox.classList.remove("is-visible");
      }
    }

    window.addEventListener("scroll", checkVisibility, { passive: true });
    window.addEventListener("resize", checkVisibility, { passive: true });
    checkVisibility();
  });
</script>