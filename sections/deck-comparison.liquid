<script>
  document.addEventListener('DOMContentLoaded', function() {
    const sectionContainer = document.querySelector('.section-{{ section.id }}-padding');
    if (!sectionContainer) return;

    const trackWrapper = sectionContainer.querySelector('.collection .js-comparison-wrapper');
    const scrollBarTrack = sectionContainer.querySelector('.collection .js-scroll-bar');
    const scrollThumb = sectionContainer.querySelector('.collection .js-scroll-thumb');

    if (!trackWrapper || !scrollBarTrack || !scrollThumb) return;

    let isThumbDragging = false;
    let dragStartX = 0;
    let initialScrollLeft = 0;
    let rAFId = null;

    /* 1. Dynamic Thumb Sync (Ultra Fast via rAF) */
    function updateThumbUI() {
      const scrollWidth = trackWrapper.scrollWidth;
      const clientWidth = trackWrapper.clientWidth;
      const maxScrollLeft = scrollWidth - clientWidth;

      if (maxScrollLeft <= 0) {
        scrollThumb.style.width = '100%';
        scrollThumb.style.left = '0%';
        return;
      }

      const thumbWidthRatio = clientWidth / scrollWidth;
      const thumbWidthPercent = Math.max(thumbWidthRatio * 100, 10);
      const maxThumbLeftPercent = 100 - thumbWidthPercent;
      
      const currentScrollRatio = trackWrapper.scrollLeft / maxScrollLeft;
      const currentLeftPercent = currentScrollRatio * maxThumbLeftPercent;

      scrollThumb.style.width = thumbWidthPercent + '%';
      scrollThumb.style.left = currentLeftPercent + '%';
    }

    function onScroll() {
      if (!isThumbDragging) {
        requestAnimationFrame(updateThumbUI);
      }
    }

    trackWrapper.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', updateThumbUI);
    updateThumbUI();

    /* 2. Ultra-Smooth Pointer Capture Dragging for Green Bar */
    scrollThumb.addEventListener('pointerdown', (e) => {
      e.stopPropagation();
      e.preventDefault();

      isThumbDragging = true;
      dragStartX = e.clientX;
      initialScrollLeft = trackWrapper.scrollLeft;

      trackWrapper.style.scrollBehavior = 'auto';
      scrollThumb.classList.add('is-dragging');
      scrollThumb.setPointerCapture(e.pointerId);
    });

    scrollThumb.addEventListener('pointermove', (e) => {
      if (!isThumbDragging) return;

      const deltaX = e.clientX - dragStartX;
      const trackWidth = scrollBarTrack.clientWidth;
      const thumbWidth = scrollThumb.offsetWidth;
      const maxThumbMove = trackWidth - thumbWidth;
      const maxContainerScroll = trackWrapper.scrollWidth - trackWrapper.clientWidth;

      if (maxThumbMove > 0) {
        const scrollDelta = (deltaX / maxThumbMove) * maxContainerScroll;
        const targetScrollLeft = initialScrollLeft + scrollDelta;

        if (rAFId) cancelAnimationFrame(rAFId);
        rAFId = requestAnimationFrame(() => {
          trackWrapper.scrollLeft = targetScrollLeft;
          updateThumbUI();
        });
      }
    });

    const releasePointer = (e) => {
      if (isThumbDragging) {
        isThumbDragging = false;
        trackWrapper.style.scrollBehavior = 'smooth';
        scrollThumb.classList.remove('is-dragging');
        
        if (rAFId) cancelAnimationFrame(rAFId);

        try {
          scrollThumb.releasePointerCapture(e.pointerId);
        } catch(err) {}
      }
    };

    scrollThumb.addEventListener('pointerup', releasePointer);
    scrollThumb.addEventListener('pointercancel', releasePointer);

    /* 3. Smooth Track Click */
    scrollBarTrack.addEventListener('click', (e) => {
      if (e.target.closest('.js-scroll-thumb')) return;

      const trackRect = scrollBarTrack.getBoundingClientRect();
      const clickX = e.clientX - trackRect.left;
      const thumbWidth = scrollThumb.offsetWidth;
      
      let targetLeft = clickX - (thumbWidth / 2);
      const maxThumbMove = trackRect.width - thumbWidth;

      if (targetLeft < 0) targetLeft = 0;
      if (targetLeft > maxThumbMove) targetLeft = maxThumbMove;

      const clickRatio = targetLeft / maxThumbMove;
      const maxContainerScroll = trackWrapper.scrollWidth - trackWrapper.clientWidth;

      trackWrapper.style.scrollBehavior = 'smooth';
      trackWrapper.scrollTo({
        left: clickRatio * maxContainerScroll,
        behavior: 'smooth'
      });
    });

    /* 4. Mouse Dragging on Content Area */
    let isTrackDragging = false;
    let startX, scrollLeftPos;

    trackWrapper.addEventListener('mousedown', (e) => {
      if (scrollBarTrack.contains(e.target) || e.target.closest('.deck-card__btn')) return;
      isTrackDragging = true;
      trackWrapper.style.scrollBehavior = 'auto';
      trackWrapper.classList.add('is-dragging');
      startX = e.pageX - trackWrapper.offsetLeft;
      scrollLeftPos = trackWrapper.scrollLeft;
    });

    document.addEventListener('mouseup', () => {
      if (isTrackDragging) {
        isTrackDragging = false;
        trackWrapper.style.scrollBehavior = 'smooth';
        trackWrapper.classList.remove('is-dragging');
      }
    });

    trackWrapper.addEventListener('mousemove', (e) => {
      if (!isTrackDragging) return;
      e.preventDefault();
      const x = e.pageX - trackWrapper.offsetLeft;
      const walk = (x - startX) * 1.5;
      trackWrapper.scrollLeft = scrollLeftPos - walk;
    });

  });
</script>


{% schema %}
{
  "name": "Deck Comparison Vertical",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "PROFESSIONAL DIY DECK KITS"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Section Subheading",
      "default": "Professional-grade deck systems engineered for homeowners. Precision-prepared, built with contractor-grade materials."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Comparison Card",
      "settings": [
        {
          "type": "text",
          "id": "custom_class",
          "label": "Custom Class"
        },
        {
          "type": "color",
          "id": "bg_color",
          "label": "Card Background Color",
          "default": "#f7f7f7"
        },
        {
          "type": "product",
          "id": "product",
          "label": "Select Product (Auto Price & Image)"
        },
        {
          "type": "text",
          "id": "badge_text",
          "label": "Badge Text",
          "default": "BEST SELLER"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Card Title",
          "default": "Pressure-Treated Wood Deck Kit",
          "info": "Leave empty to use Product Title"
        },
        {
          "type": "header",
          "content": "Manual Price (Fallback if Product empty)"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Custom Price",
          "default": "$3,599"
        },
        {
          "type": "text",
          "id": "compare_at_price",
          "label": "Custom Compare Price",
          "default": "$4,200"
        },
        {
          "type": "text",
          "id": "discount_tag",
          "label": "Custom Discount Tag",
          "default": "15% Off"
        },
        {
          "type": "textarea",
