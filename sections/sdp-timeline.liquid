{{ 'sdp.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  Size deck page · Timeline. Centered header and one `step` block per column: icon in a
  green disc, "Step N" kicker, two-line title, short text.
{%- endcomment -%}

{%- liquid
  assign sdp = page.metafields.custom.deck_size.value
  if template.name == 'collection'
    assign sdp = collection.metafields.custom.deck_size.value
    if template.suffix == 'deck-size-seo' and collection.metafields.custom.deck_size_seo.value != blank
      assign sdp = collection.metafields.custom.deck_size_seo.value
    endif
  endif
-%}
<div class="sdp sdp-timeline sdp--white"{% if section.settings.anchor_id != blank %} id="{{ section.settings.anchor_id | handle }}"{% endif %}>
  <div class="sdp__inner sdp-timeline__inner">
    <div class="sdp-header sdp-header--center">
      {%- if section.settings.eyebrow != blank -%}
        <p class="sdp-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        {%- capture t_heading -%}{%- render 'sdp-t', text: section.settings.heading, sdp: sdp -%}{%- endcapture -%}
        <h2 class="sdp-h2">{{ t_heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.intro != blank -%}
        {%- capture t_intro -%}{%- render 'sdp-t', text: section.settings.intro, sdp: sdp -%}{%- endcapture -%}
        <p class="sdp-intro">{{ t_intro | escape }}</p>
      {%- endif -%}
    </div>

    <ol class="sdp-timeline__grid" style="--sdp-steps: {{ section.blocks.size | at_least: 1 | at_most: 4 }};">
      {%- for block in section.blocks -%}
        <li class="sdp-step" {{ block.shopify_attributes }}>
          <span class="sdp-step__icon">
            {%- if block.settings.icon_image != blank -%}
              {{ block.settings.icon_image | image_url: width: 48 | image_tag: loading: 'lazy', alt: '', widths: '24, 48' }}
            {%- else -%}
              {%- render 'sdp-icon', name: block.settings.icon -%}
            {%- endif -%}
          </span>
          <span class="sdp-step__kicker">{{ section.settings.step_word | default: 'Step' | escape }} {{ forloop.index }}</span>
          {%- capture t_title -%}{%- render 'sdp-t', text: block.settings.title, sdp: sdp -%}{%- endcapture -%}
          {%- capture t_text -%}{%- render 'sdp-t', text: block.settings.text, sdp: sdp -%}{%- endcapture -%}
          <h3 class="sdp-step__title">{{ t_title | escape }}</h3>
          <p class="sdp-step__text">{{ t_text | escape }}</p>
        </li>
      {%- endfor -%}
    </ol>
  </div>
</div>

{% schema %}
{
  "name": "SDP · Timeline",
  "tag": "section",
  "class": "section",
  "enabled_on": { "templates": ["product", "collection", "page"] },
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "anchor_id", "label": "Anchor ID" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "From order to first evening outside" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Order today. Build it the weekend it arrives." },
    { "type": "textarea", "id": "intro", "label": "Intro text", "info": "Optional. Shown under the heading." },
    { "type": "text", "id": "step_word", "label": "Step kicker word", "default": "Step" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "options": [ { "value": "cart", "label": "Cart" }, { "value": "truck", "label": "Truck" }, { "value": "drill", "label": "Drill" }, { "value": "shield", "label": "Shield" }, { "value": "chat", "label": "Chat" }, { "value": "phone", "label": "Phone" } ], "default": "cart" },
        { "type": "image_picker", "id": "icon_image", "label": "Custom icon (optional)" },
        { "type": "textarea", "id": "title", "label": "Title", "info": "Press Enter to force a line break.", "default": "Order &\nconfirmation" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Pay in full, reserve for $250 or pick a payment plan. You get a tracking page and live order status from day one." }
      ]
    }
  ],
  "presets": [
    {
      "name": "SDP · Timeline",
      "blocks": [
        { "type": "step", "settings": { "icon": "cart", "title": "Order &\nconfirmation", "text": "Pay in full, reserve for $250 or pick a payment plan. You get a tracking page and live order status from day one." } },
        { "type": "step", "settings": { "icon": "truck", "title": "Delivered in 10–14\nbusiness days", "text": "Ships by LTL ground freight. The carrier calls to schedule curbside delivery of one crate, packed in order of use." } },
        { "type": "step", "settings": { "icon": "drill", "title": "Build in\n8–16 hours", "text": "A drill, the included bit and the 3D app. Most people finish in one weekend; many in an afternoon." } },
        { "type": "step", "settings": { "icon": "shield", "title": "Covered for\n5 years", "text": "Every wood kit carries a 5-year structural warranty, with A-DIY specialists a call or chat away." } }
      ]
    }
  ]
}
{% endschema %}
