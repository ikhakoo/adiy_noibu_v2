{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .iwt-2-wrapper {
    background-color: {{ section.settings.container_bg_color }};
    border-radius: 16px;
    padding: 40px 24px;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  @media screen and (min-width: 990px) {
    .iwt-2-wrapper {
      flex-direction: row;
      align-items: center;
      padding: 60px 50px;
      gap: 60px;
    }

    .iwt-2-wrapper.desktop-image-first {
      flex-direction: row-reverse;
    }
  }

  .iwt-2-content {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .iwt-2-subheading {
    font-size: 13px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    font-weight: 700;
    color: {{ section.settings.subheading_color }};
    margin: 0 0 12px 0;
  }

  .iwt-2-heading {
    line-height: 1.2;
    color: {{ section.settings.heading_color }};
    margin: 0 0 32px 0;
  }

  @media screen and (min-width: 750px) {
    .iwt-2-heading {
    }
  }

  .iwt-2-blocks {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .iwt-2-feature-item {
    display: flex;
    gap: 16px;
    align-items: flex-start;
  }

  .iwt-2-icon {
    width: 24px;
    height: 24px;
    flex-shrink: 0;
    margin-top: 2px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .iwt-2-icon svg, .iwt-2-icon img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .iwt-2-feature-title {
    font-size: 18px;
    font-weight: 600;
    color: {{ section.settings.heading_color }};
    margin: 0 0 8px 0;
  }

  .iwt-2-feature-desc {
    font-size: 15px;
    line-height: 1.5;
    color: {{ section.settings.text_color }};
    margin: 0;
  }

  .iwt-2-media {
    flex: 1;
    width: 100%;
    border-radius: 12px;
    overflow: hidden;
    position: relative;
    min-height: 350px;
  }

  .iwt-2-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .iwt-2-placeholder {
    width: 100%;
    height: 100%;
    min-height: 350px;
    background-color: #e0e0e0;
    display: flex;
    align-items: center;
    justify-content: center;
  }
{%- endstyle -%}

<div class="page-width section-{{ section.id }}-padding">
  <div class="iwt-2-wrapper {% if section.settings.layout == 'image_first' %}desktop-image-first{% endif %}">
    
    <!-- Content Left Side -->
    <div class="iwt-2-content">
      {%- if section.settings.subheading != blank -%}
        <p class="iwt-2-subheading">{{ section.settings.subheading | escape }}</p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="iwt-2-heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}

      <div class="iwt-2-blocks">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'feature' -%}
              <div class="iwt-2-feature-item" {{ block.shopify_attributes }}>
                <div class="iwt-2-icon">
                  {%- if block.settings.custom_icon != blank -%}
                    <img src="{{ block.settings.custom_icon | image_url: width: 48 }}" alt="{{ block.settings.title | escape }}" loading="lazy" width="24" height="24">
                  {%- else -%}
                    {%- case block.settings.icon -%}
                      {%- when 'wrench' -%}
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75a4.5 4.5 0 0 1-4.884 4.484c-1.076-.091-2.264.071-2.95.904l-7.152 8.684a2.54 2.54 0 0 1-3.58 0 2.54 2.54 0 0 1 0-3.58l8.684-7.152c.833-.686.995-1.874.904-2.95a4.5 4.5 0 0 1 6.32-5.028l-2.8 2.8a.75.75 0 0 0 1.06 1.06l2.8-2.802A4.5 4.5 0 0 1 21.75 6.75Z" /></svg>
                      {%- when 'location' -%}
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" /><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" /></svg>
                      {%- when 'shield' -%}
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z" /></svg>
                      {%- when 'star' -%}
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M11.48 3.499a.562.562 0 0 1 1.04 0l2.125 5.111a.563.563 0 0 0 .475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 0 0-.182.557l1.285 5.385c.116.488-.42.87-.837.618l-4.66-2.825a.563.563 0 0 0-.586 0l-4.66 2.825c-.417.252-.953-.13-.837-.618l1.285-5.386a.562.562 0 0 0-.182-.557l-4.204-3.602c-.38-.325-.178-.948.32-.988l5.518-.442a.563.563 0 0 0 .475-.345L11.48 3.5Z" /></svg>
                    {%- endcase -%}
                  {%- endif -%}
                </div>
                <div>
                  {%- if block.settings.title != blank -%}
                    <h3 class="iwt-2-feature-title">{{ block.settings.title | escape }}</h3>
                  {%- endif -%}
                  {%- if block.settings.description != blank -%}
                    <p class="iwt-2-feature-desc">{{ block.settings.description }}</p>
                  {%- endif -%}
                </div>
              </div>
          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>

    <!-- Image Right Side -->
    <div class="iwt-2-media">
      {%- if section.settings.image != blank -%}
        <img
          src="{{ section.settings.image | image_url: width: 1000 }}"
          alt="{{ section.settings.image.alt | default: section.settings.heading | escape }}"
          loading="lazy"
          width="{{ section.settings.image.width }}"
          height="{{ section.settings.image.height }}"
        >
      {%- else -%}
        <div class="iwt-2-placeholder">
          {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
        </div>
      {%- endif -%}
    </div>

  </div>
</div>

{% schema %}
{
  "name": "Image with text 2",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "OUR MISSION"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Effortless to Build.\nBuilt to Bring You Together."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "layout",
      "options": [
        {
          "value": "text_first",
          "label": "Image on right"
        },
        {
          "value": "image_first",
          "label": "Image on left"
        }
      ],
      "default": "text_first",
      "label": "Desktop image placement"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "container_bg_color",
      "label": "Container Background",
      "default": "#F7F6F2"
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Subheading Color",
      "default": "#9C7C5D"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Description Color",
      "default": "#555555"
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top Padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature Point",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Preset Icon",
          "options": [
            {
              "value": "wrench",
              "label": "Wrench / Tools"
            },
            {
              "value": "location",
              "label": "Location Pin"
            },
            {
              "value": "shield",
              "label": "Shield"
            },
            {
              "value": "star",
              "label": "Star"
            }
          ],
          "default": "wrench"
        },
        {
          "type": "image_picker",
          "id": "custom_icon",
          "label": "Custom Icon Image (Optional)",
          "info": "Overrides preset icon"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Feature Title"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Feature description text goes here."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Image with text 2",
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "icon": "wrench",
            "title": "No Tools, No Guesswork",
            "description": "Our pre-engineered systems eliminate the complexity of traditional construction. If you can use a wrench, you can build an A-DIY deck."
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "location",
            "title": "USA-Made Quality",
            "description": "Every component is sourced and manufactured in the USA, ensuring the highest structural standards and local reliability."
          }
        }
      ]
    }
  ]
}
{% endschema %}