{%- comment -%}
  "Why Do Customers Choose A-DIY" landing page.

  Ported from the pre-refresh version of this page, which lived as a 45KB
  `custom_liquid` string inside templates/page.why-customers-choose-adiy.json and
  carried its own off-brand design system (Barlow Condensed, #F5A623 yellow,
  emoji CTAs). The narrative is unchanged; the design language, voice and claims
  now match sections/how-to-build-deck.liquid, which is the same argument in the
  current brand.

  Everything here is scoped under `.wcc`. Deliberately NOT copied from
  how-to-build-deck.liquid: its unscoped `h1`, `p` and `ol, ul` rules, which
  escape the section and restyle the whole document.

  Typography is the theme's own Outfit, taken from --font-heading-family /
  --font-body-family and the weights layout/theme.liquid has already emitted
  @font-face rules for (300/400/500/600/700). The sibling LP loads DM Serif
  Display + DM Sans from Google Fonts; this page deliberately does not, so it
  matches the site and adds no third-party font request at all.
{%- endcomment -%}
<style>
  /* ── RESET ── */
  .wcc *, .wcc *::before, .wcc *::after { box-sizing: border-box; margin: 0; padding: 0; }
  .wcc {
    font-family: var(--font-body-family, 'Outfit', sans-serif);
    font-size: 17px; line-height: 1.65;
    color: #1c1c19; background: #fff;
    -webkit-font-smoothing: antialiased;
  }

  /* ── TOKENS (value-identical to sections/how-to-build-deck.liquid) ── */
  .wcc {
    --green:        #396958;
    --green-dark:   #2b5244;
    --green-light:  #eaf3ef;
    --green-mid:    #c2ddd6;
    --blue:         #4177AD;
    --blue-dark:    #305d8a;
    --blue-light:   #e8f0f8;
    --bg:           #F6F4F2;
    --bg-dark:      #1c2620;
    --bg-ink:       #111810;
    --dark:         #1c1c19;
    --mid:          #4c4c47;
    --muted:        #7c7c74;
    --border:       #e0deda;
    --border-strong:#c8c4be;
    --tp-green:     #00b67a;
    --radius:       8px;
    --radius-lg:    14px;
    --shadow-sm:    0 1px 8px rgba(0,0,0,0.06);
    --shadow:       0 3px 18px rgba(0,0,0,0.08);
    --shadow-lg:    0 8px 40px rgba(0,0,0,0.12);
  }

  /* ── LAYOUT ── */
  .wcc-wrap        { max-width: 1100px; margin: 0 auto; padding: 0 24px; }
  .wcc-wrap--mid   { max-width: 900px;  margin: 0 auto; padding: 0 24px; }
  .wcc-wrap--narrow{ max-width: 720px;  margin: 0 auto; padding: 0 24px; }

  /* ── TYPOGRAPHY ── */
  .wcc-eyebrow {
    display: inline-block; font-family: var(--font-body-family, 'Outfit', sans-serif);
    font-size: 11px; font-weight: 600;
    letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--green); margin-bottom: 14px;
  }
  .wcc-eyebrow--light { color: rgba(255,255,255,0.5); }

  .wcc-h1 {
    font-family: var(--font-heading-family, 'Outfit', sans-serif);
    font-size: clamp(38px, 5vw, 62px);
    line-height: 1.05; letter-spacing: -0.03em; color: #fff;
    font-weight: var(--font-weight-h1, 700);
  }
  /* Outfit ships no italic here, so the emphasised line steps down in weight and
     colour instead of leaning - a synthesised oblique would look broken at 62px. */
  .wcc-h1 em { font-style: normal; font-weight: var(--font-weight-h3, 500); color: rgba(255,255,255,0.6); }

  .wcc-h2 {
    font-family: var(--font-heading-family, 'Outfit', sans-serif);
    font-size: clamp(27px, 3.4vw, 42px);
    line-height: 1.15; letter-spacing: -0.02em; color: var(--dark);
    font-weight: var(--font-weight-h2, 600);
  }
  .wcc-h3 {
    font-family: var(--font-heading-family, 'Outfit', sans-serif);
    font-size: clamp(20px, 2.4vw, 26px);
    line-height: 1.2; letter-spacing: -0.01em; color: var(--dark);
    font-weight: var(--font-weight-h2, 600);
  }
  .wcc-lead { font-size: clamp(16px, 1.8vw, 19px); color: var(--mid); line-height: 1.7; }
  .wcc-body { font-size: 15px; color: var(--mid); line-height: 1.7; }

  /* ── BUTTONS ── */
  .wcc-btn {
    display: inline-flex; align-items: center; gap: 10px;
    font-family: var(--font-body-family, 'Outfit', sans-serif); font-weight: 600; font-size: 15px;
    letter-spacing: 0.01em; padding: 14px 28px;
    border-radius: 5px; border: 1.5px solid transparent;
    cursor: pointer; text-decoration: none;
    transition: transform 0.15s, box-shadow 0.15s, background 0.15s, border-color 0.15s;
    white-space: nowrap; line-height: 1;
  }
  .wcc-btn:hover  { transform: translateY(-2px); }
  .wcc-btn:active { transform: translateY(0); }

  .wcc-btn--primary {
    background: var(--green); color: #fff;
    box-shadow: 0 3px 16px rgba(57,105,88,0.3);
  }
  .wcc-btn--primary:hover { background: var(--green-dark); box-shadow: 0 5px 24px rgba(57,105,88,0.4); }

  .wcc-btn--blue {
    background: var(--blue); color: #fff;
    box-shadow: 0 3px 16px rgba(65,119,173,0.28);
  }
  .wcc-btn--blue:hover { background: var(--blue-dark); box-shadow: 0 5px 24px rgba(65,119,173,0.38); }

  .wcc-btn--ghost {
    background: transparent; color: var(--dark);
    border-color: var(--border-strong);
  }
  .wcc-btn--ghost:hover { border-color: var(--dark); background: var(--bg); }

  .wcc-btn--ghost-white {
    background: transparent; color: #fff;
    border-color: rgba(255,255,255,0.4);
  }
  .wcc-btn--ghost-white:hover { border-color: #fff; background: rgba(255,255,255,0.08); }

  .wcc-btn--lg { padding: 17px 36px; font-size: 17px; }

  .wcc-btn__arrow { display: inline-block; transition: transform 0.15s; }
  .wcc-btn:hover .wcc-btn__arrow { transform: translateX(3px); }

  .wcc-cta-row { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; }

  /* ── SECTIONS ── */
  .wcc-section     { padding: 88px 0; }
  .wcc-section--sm { padding: 56px 0; }
  .wcc-section--bg { background: var(--bg); }

  /* ── TRUST BAR ── */
  .wcc-trustbar {
    background: var(--bg-ink); padding: 10px 24px;
    text-align: center; font-size: 12px; font-weight: 500;
    color: rgba(255,255,255,0.5); letter-spacing: 0.03em;
    display: flex; align-items: center; justify-content: center; gap: 18px;
    flex-wrap: wrap;
  }
  .wcc-trustbar__item { display: flex; align-items: center; gap: 7px; }
  .wcc-trustbar__dot  { width: 4px; height: 4px; border-radius: 50%; background: rgba(255,255,255,0.25); }

  /* ── HERO ── */
  .wcc-hero { background: var(--bg-dark); position: relative; overflow: hidden; }
  .wcc-hero__bg {
    position: absolute; inset: 0;
    background-image: url('https://a-diy.com/cdn/shop/files/pressure-treated-kiln-dried-wood-deck-kit-648657.jpg?width=1200');
    background-size: cover; background-position: center 45%;
    opacity: 0.22;
  }
  .wcc-hero__grad {
    position: absolute; inset: 0;
    background: linear-gradient(115deg, rgba(28,38,32,0.97) 0%, rgba(28,38,32,0.75) 50%, rgba(28,38,32,0.5) 100%);
  }
  .wcc-hero__inner {
    position: relative; z-index: 1;
    padding: 96px 0 88px;
    display: grid; grid-template-columns: 1fr 420px;
    gap: 60px; align-items: center;
  }
  .wcc-hero__tag {
    display: inline-flex; align-items: center; gap: 8px;
    border: 1px solid rgba(255,255,255,0.18); border-radius: 40px;
    padding: 7px 14px; font-size: 13px; font-weight: 500;
    color: rgba(255,255,255,0.7); margin-bottom: 24px;
  }
  .wcc-hero__tag-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--tp-green); flex-shrink: 0; }
  .wcc-hero__sub {
    font-size: clamp(16px, 1.9vw, 19px); color: rgba(255,255,255,0.7);
    max-width: 540px; margin: 22px 0 36px; line-height: 1.65;
  }
  .wcc-hero__sub strong { color: #fff; font-weight: 600; }
  .wcc-hero__micro { margin-top: 16px; font-size: 12px; color: rgba(255,255,255,0.35); letter-spacing: 0.02em; }

  .wcc-hero__card {
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: var(--radius-lg); padding: 32px;
  }
  .wcc-hero__card-title {
    font-size: 11px; color: rgba(255,255,255,0.5);
    margin-bottom: 20px; font-weight: 600;
    text-transform: uppercase; letter-spacing: 0.1em;
  }
  .wcc-stat-list { display: flex; flex-direction: column; gap: 16px; }
  .wcc-stat-row {
    display: flex; justify-content: space-between; align-items: center; gap: 16px;
    padding-bottom: 16px; border-bottom: 1px solid rgba(255,255,255,0.08);
  }
  .wcc-stat-row:last-child { border-bottom: none; padding-bottom: 0; }
  .wcc-stat-row__label { font-size: 13px; color: rgba(255,255,255,0.5); }
  .wcc-stat-row__val {
    font-family: var(--font-heading-family, 'Outfit', sans-serif); font-size: 20px;
    color: #fff; font-weight: 600; text-align: right; letter-spacing: -0.01em;
  }
  .wcc-stat-row__val--green { color: #7ecfb5; }

  /* ── SPEC BAND (replaces the old yellow stat band) ── */
  .wcc-band { background: var(--bg); border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }
  .wcc-band__grid { display: grid; grid-template-columns: repeat(4, 1fr); }
  .wcc-band__cell { padding: 32px 20px; text-align: center; border-right: 1px solid var(--border); }
  .wcc-band__cell:last-child { border-right: none; }
  .wcc-band__num {
    font-family: var(--font-heading-family, 'Outfit', sans-serif);
    font-size: 36px; line-height: 1; letter-spacing: -0.03em;
    color: var(--green); font-weight: 700; margin-bottom: 8px;
  }
  .wcc-band__label { font-size: 13px; color: var(--muted); letter-spacing: 0.02em; }

  /* ── SPLIT INTRO (contractor vs traditional DIY) ── */
  .wcc-split-intro { display: grid; grid-template-columns: 1fr 1fr; gap: 2px; }
  .wcc-split-intro__panel { padding: 56px 48px; position: relative; }
  .wcc-split-intro__panel--left  { background: #fff; border-right: 1px solid var(--border); }
  .wcc-split-intro__panel--right { background: var(--bg); }
  .wcc-split-intro__label {
    font-size: 11px; font-weight: 700; letter-spacing: 0.12em;
    text-transform: uppercase; margin-bottom: 16px; display: block;
    color: #b03a2e;
  }
  .wcc-split-intro__h {
    font-family: var(--font-heading-family, 'Outfit', sans-serif);
    font-size: clamp(21px, 2.6vw, 27px); color: var(--dark);
    margin-bottom: 14px; font-weight: 600; line-height: 1.25; letter-spacing: -0.01em;
  }
  .wcc-split-intro__body { font-size: 15px; color: var(--mid); line-height: 1.7; margin-bottom: 24px; }
  .wcc-pain-list { list-style: none; display: flex; flex-direction: column; gap: 16px; }
  .wcc-pain-list li { display: flex; gap: 12px; align-items: flex-start; }
  .wcc-pain-list__x {
    width: 20px; height: 20px; border-radius: 50%; flex-shrink: 0;
    background: #fee; border: 1px solid #f5c0bc; margin-top: 2px;
    display: flex; align-items: center; justify-content: center;
    font-size: 11px; font-weight: 700; color: #b03a2e;
  }
  .wcc-pain-list__title { display: block; font-weight: 600; font-size: 15px; color: var(--dark); margin-bottom: 3px; }
  .wcc-pain-list__body  { display: block; font-size: 14px; color: var(--mid); line-height: 1.6; }

  /* ── PULL STATEMENT ── */
  .wcc-pull {
    background: var(--green-light); border-left: 3px solid var(--green);
    padding: 32px 36px; border-radius: 0 var(--radius) var(--radius) 0;
  }
  .wcc-pull p {
    font-family: var(--font-heading-family, 'Outfit', sans-serif);
    font-size: clamp(18px, 2vw, 23px); line-height: 1.45;
    color: var(--dark); font-weight: 500; letter-spacing: -0.01em;
  }

  /* ── COMPARISON TABLE ── */
  .wcc-tablewrap { overflow-x: auto; margin-top: 44px; border-radius: var(--radius-lg); border: 1px solid var(--border); }
  .wcc-comparison { width: 100%; border-collapse: collapse; min-width: 660px; background: #fff; font-size: 14px; }
  .wcc-comparison th, .wcc-comparison td { padding: 16px 18px; text-align: left; border-bottom: 1px solid var(--border); }
  .wcc-comparison thead th {
    font-size: 11px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--muted); background: var(--bg); border-bottom: 1px solid var(--border);
  }
  .wcc-comparison thead th.wcc-col--winner { background: var(--green); color: #fff; }
  .wcc-comparison td.wcc-col--winner { background: var(--green-light); color: var(--green-dark); font-weight: 600; }
  .wcc-comparison td.wcc-col--bad { color: var(--muted); }
  .wcc-comparison tbody tr:last-child th, .wcc-comparison tbody tr:last-child td { border-bottom: none; }
  .wcc-comparison tbody th { font-weight: 600; color: var(--dark); }

  /* ── INLINE CTA BAND ── */
  .wcc-ctaband { background: var(--green); padding: 28px 0; }
  .wcc-ctaband__inner { display: flex; align-items: center; justify-content: space-between; gap: 24px; flex-wrap: wrap; }
  .wcc-ctaband__text {
    font-family: var(--font-heading-family, 'Outfit', sans-serif);
    font-size: clamp(18px, 2.4vw, 24px); color: #fff; font-weight: 600; letter-spacing: -0.01em;
  }
  .wcc-ctaband__text em { font-style: normal; font-weight: 400; opacity: 0.75; }
  .wcc-ctaband__sub { font-size: 13px; color: rgba(255,255,255,0.65); margin-top: 4px; }

  /* ── STEPS ── */
  .wcc-steps { display: grid; grid-template-columns: repeat(5, 1fr); margin-top: 48px; position: relative; }
  .wcc-steps::before {
    content: ''; position: absolute;
    top: 28px; left: 56px; right: 56px; height: 2px;
    background: linear-gradient(to right, var(--green), var(--blue));
    z-index: 0;
  }
  .wcc-step { text-align: center; padding: 0 12px; position: relative; z-index: 1; }
  .wcc-step__num {
    width: 56px; height: 56px; border-radius: 50%;
    background: var(--green); color: #fff;
    font-family: var(--font-heading-family, 'Outfit', sans-serif);
    font-size: 19px; font-weight: 600;
    display: flex; align-items: center; justify-content: center;
    margin: 0 auto 16px;
    /* The ring is the section background punching through the connector line. */
    box-shadow: 0 0 0 4px #fff, 0 0 0 6px rgba(57,105,88,0.2);
  }
  .wcc-step__title { font-weight: 700; font-size: 14px; color: var(--dark); margin-bottom: 6px; }
  .wcc-step__body  { font-size: 13px; color: var(--muted); line-height: 1.55; }

  /* ── BENEFIT GRID ── */
  .wcc-specs__grid {
    display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px;
    background: var(--border); border: 1px solid var(--border);
    border-radius: var(--radius-lg); overflow: hidden;
    margin-top: 48px;
  }
  .wcc-spec { background: #fff; padding: 28px 24px; }
  .wcc-spec__label { font-weight: 700; font-size: 15px; color: var(--dark); margin-bottom: 8px; line-height: 1.3; }
  .wcc-spec__desc  { font-size: 13px; color: var(--muted); line-height: 1.6; }

  /* ── REVIEWS ── */
  .wcc-tp-header { display: flex; align-items: center; gap: 24px; flex-wrap: wrap; margin-bottom: 48px; }
  .wcc-tp-score-block { display: flex; flex-direction: column; align-items: flex-start; gap: 6px; }
  .wcc-tp-score-num {
    font-family: var(--font-heading-family, 'Outfit', sans-serif);
    font-size: 58px; line-height: 1; letter-spacing: -0.03em;
    color: var(--dark); font-weight: 700;
  }
  .wcc-tp-stars-row { display: flex; gap: 4px; }
  .wcc-tp-star-icon {
    width: 28px; height: 28px; border-radius: 3px;
    background: var(--tp-green);
    display: flex; align-items: center; justify-content: center;
  }
  .wcc-tp-star-icon svg { width: 16px; height: 16px; fill: #fff; }
  .wcc-tp-star-icon--half { background: linear-gradient(to right, var(--tp-green) 50%, #ccc 50%); }
  .wcc-tp-meta { font-size: 13px; color: var(--muted); margin-top: 4px; }
  .wcc-tp-divider { width: 1px; height: 80px; background: var(--border); }
  .wcc-tp-breakdown { flex: 1; min-width: 200px; }
  .wcc-tp-bar-row { display: flex; align-items: center; gap: 10px; margin-bottom: 7px; }
  .wcc-tp-bar-label { font-size: 12px; color: var(--muted); width: 32px; text-align: right; flex-shrink: 0; }
  .wcc-tp-bar-track { flex: 1; height: 8px; background: var(--border); border-radius: 4px; overflow: hidden; }
  .wcc-tp-bar-fill  { display: block; height: 100%; background: var(--tp-green); border-radius: 4px; }
  .wcc-tp-bar-pct   { font-size: 12px; color: var(--muted); width: 30px; flex-shrink: 0; }

  .wcc-tp-quotes { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .wcc-tp-quote {
    background: #fff; border: 1px solid var(--border);
    border-radius: var(--radius-lg); padding: 28px;
    display: flex; flex-direction: column; gap: 14px;
    transition: box-shadow 0.2s, transform 0.2s;
  }
  .wcc-tp-quote:hover { box-shadow: var(--shadow-lg); transform: translateY(-3px); }
  .wcc-tp-quote__stars { display: flex; gap: 3px; }
  .wcc-tp-quote__star {
    width: 18px; height: 18px; border-radius: 2px;
    background: var(--tp-green);
    display: flex; align-items: center; justify-content: center;
  }
  .wcc-tp-quote__star svg { width: 11px; height: 11px; fill: #fff; }
  .wcc-tp-quote__title { font-weight: 700; font-size: 15px; color: var(--dark); }
  .wcc-tp-quote__text  { font-size: 14px; color: var(--mid); line-height: 1.65; flex: 1; }
  .wcc-tp-quote__name  { font-weight: 600; font-size: 13px; color: var(--dark); }
  .wcc-tp-quote__source{ font-size: 11px; color: var(--muted); margin-top: 2px; }

  .wcc-badges { display: flex; flex-wrap: wrap; gap: 10px; justify-content: center; margin-top: 44px; }
  .wcc-badge {
    background: #fff; border: 1px solid var(--border); border-radius: 40px;
    padding: 9px 18px; font-size: 13px; font-weight: 500; color: var(--mid);
  }

  /* ── DECISION SPLIT ── */
  .wcc-decide { background: var(--bg-ink); padding: 88px 0; }
  .wcc-decide__header { text-align: center; margin-bottom: 48px; }
  .wcc-decide__header .wcc-h2 { color: #fff; }
  .wcc-decide__header p { font-size: 17px; color: rgba(255,255,255,0.55); margin-top: 12px; max-width: 480px; margin-left: auto; margin-right: auto; }
  .wcc-decide__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
  .wcc-decide__card { border-radius: var(--radius-lg); padding: 40px 36px; display: flex; flex-direction: column; }
  .wcc-decide__card--a { background: var(--green); }
  .wcc-decide__card--b { background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.12); }
  .wcc-decide__card__tag {
    font-size: 11px; font-weight: 700; letter-spacing: 0.12em;
    text-transform: uppercase; opacity: 0.55; color: #fff; margin-bottom: 14px;
  }
  .wcc-decide__card__h {
    font-family: var(--font-heading-family, 'Outfit', sans-serif);
    font-size: clamp(19px, 2.3vw, 25px); color: #fff; font-weight: 600;
    line-height: 1.25; letter-spacing: -0.01em; margin-bottom: 16px;
  }
  .wcc-decide__card__body { font-size: 15px; color: rgba(255,255,255,0.75); line-height: 1.65; flex: 1; margin-bottom: 28px; }
  .wcc-decide__card__micro { font-size: 12px; color: rgba(255,255,255,0.38); margin-top: 12px; }
  .wcc-decide__btn-a, .wcc-decide__btn-b {
    display: inline-flex; align-items: center; gap: 10px; align-self: flex-start;
    font-family: var(--font-body-family, 'Outfit', sans-serif); font-weight: 700; font-size: 15px;
    padding: 14px 24px; border-radius: 5px;
    text-decoration: none; transition: transform 0.15s, background 0.15s;
  }
  .wcc-decide__btn-a { background: #fff; color: var(--green); }
  .wcc-decide__btn-a:hover { background: #f0f8f5; transform: translateY(-2px); }
  .wcc-decide__btn-b { background: var(--blue); color: #fff; box-shadow: 0 4px 16px rgba(65,119,173,0.35); }
  .wcc-decide__btn-b:hover { background: var(--blue-dark); transform: translateY(-2px); }

  /* ── FAQ ── */
  .wcc-faq {
    display: flex; flex-direction: column;
    border: 1px solid var(--border); border-radius: var(--radius-lg);
    overflow: hidden; margin-top: 48px;
  }
  .wcc-faq__item { border-bottom: 1px solid var(--border); }
  .wcc-faq__item:last-child { border-bottom: none; }
  .wcc-faq__q {
    display: flex; justify-content: space-between; align-items: center;
    width: 100%; text-align: left; gap: 16px;
    padding: 20px 24px; cursor: pointer; background: #fff;
    border: 0; font-family: inherit; font-weight: 600; font-size: 16px; color: var(--dark);
    transition: background 0.15s;
  }
  .wcc-faq__q:hover { background: var(--bg); }
  .wcc-faq__q:focus-visible { outline: 2px solid var(--green); outline-offset: -2px; }
