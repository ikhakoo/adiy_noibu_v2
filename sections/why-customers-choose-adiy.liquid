<script>
  (function () {
    var elems = document.querySelectorAll('.wcc-anim');
    if ('IntersectionObserver' in window) {
      var obs = new IntersectionObserver(
        function (entries) {
          entries.forEach(function (e) {
            if (e.isIntersecting) {
              e.target.classList.add('in');
              obs.unobserve(e.target);
            }
          });
        },
        { threshold: 0.08 }
      );
      elems.forEach(function (el) {
        obs.observe(el);
      });
    } else {
      elems.forEach(function (el) {
        el.classList.add('in');
      });
    }

    // Single-open accordion. The trigger is a real <button>, so keyboard
    // activation and screen-reader state come for free via aria-expanded.
    var questions = document.querySelectorAll('.wcc-faq__q');
    questions.forEach(function (q) {
      q.addEventListener('click', function () {
        var wasOpen = q.getAttribute('aria-expanded') === 'true';
        questions.forEach(function (other) {
          other.setAttribute('aria-expanded', 'false');
          var panel = document.getElementById(other.getAttribute('aria-controls'));
          if (panel) panel.hidden = true;
        });
        if (!wasOpen) {
          q.setAttribute('aria-expanded', 'true');
          var own = document.getElementById(q.getAttribute('aria-controls'));
          if (own) own.hidden = false;
        }
      });
    });
  })();
</script>

