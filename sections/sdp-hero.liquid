{{ 'sdp.css' | asset_url | stylesheet_tag }}
<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'sdp.js' | asset_url }}" defer="defer"></script>

{%- comment -%}
  Size deck page · Hero. Replaces main-product on the SEO size templates: copy + live
  price/discount/financing on the left, one hero image on the right, and the theme's own
  <product-form> underneath so Add to cart opens the cart drawer like every other PDP.

  Prices come from the product: regular price is the selected variant's price, the "with
  code" price subtracts the variant's custom.discount_value metafield (dollars) or, when
  that is empty, the section's fallback discount. Monthly figures are derived from the
  sale price. Every payment row/card is a block so the customizer can reorder or drop them.
{%- endcomment -%}

{%- liquid
  comment
    Deck size pages (page.deck-size template): the page's "Deck size page" metaobject entry
    supplies the main product, the size variant(s) to sell and the size-specific copy.
    On product templates there is no entry and everything below works as before.
  endcomment
  assign sdp = page.metafields.custom.deck_size.value
  if template.name == 'collection'
    assign sdp = collection.metafields.custom.deck_size.value
    if template.suffix == 'deck-size-seo' and collection.metafields.custom.deck_size_seo.value != blank
      assign sdp = collection.metafields.custom.deck_size_seo.value
    endif
  endif
  assign sdp_variants = ''
  if sdp != blank
    assign product = sdp.product.value
    assign sdp_variants = sdp.variants.value
  endif

  comment
    Size collections (collection.deck-size): the collection metafield custom.seo_variant_id
    pins the variant this page sells; its product is the one in the add-to-cart form.
  endcomment
  assign pinned_variant = nil
  if template.name == 'collection'
    assign pinned_variant = collection.metafields.custom.seo_variant_id.value
    if pinned_variant != blank
      assign product = pinned_variant.product
      if sdp_variants == blank
        assign sdp_variants = product.variants | where: 'id', pinned_variant.id
      endif
    endif
  endif

  comment
    The page is for one size. Unless the URL already selects a variant, use the variant
    whose option matches the "Size variant" setting (e.g. "16 x 20") for pricing, the
    add-to-cart form and structured data; otherwise fall back to the first available.
  endcomment
  assign variant = product.selected_variant
  if pinned_variant != blank
    assign variant = pinned_variant
  elsif sdp != blank
    assign variant = sdp_variants | first
    for candidate in sdp_variants
      if candidate.available
        assign variant = candidate
        break
      endif
    endfor
  elsif variant == blank
    assign variant = product.selected_or_first_available_variant
    if section.settings.size_option != blank
      for candidate in product.variants
        if candidate.option1 == section.settings.size_option or candidate.option2 == section.settings.size_option
          assign variant = candidate
          break
        endif
      endfor
    endif
  endif
  assign product_form_id = 'sdp-product-form-' | append: section.id

  assign promo_code = section.settings.promo_code
  if product.metafields.custom.promo_code != blank
    assign promo_code = product.metafields.custom.promo_code.value | default: product.metafields.custom.promo_code
  endif

  assign discount_dollars = section.settings.discount_amount | default: 0
  assign variant_discount = variant.metafields.custom.discount_value.value | default: variant.metafields.custom.discount_value
  assign variant_discount_num = variant_discount | plus: 0
  if variant_discount_num > 0
    assign discount_dollars = variant_discount_num
  endif
  assign discount_cents = discount_dollars | times: 100 | round

  assign regular_price = variant.price
  assign sale_price = regular_price | minus: discount_cents
  if sale_price < 0 or discount_cents <= 0
    assign sale_price = regular_price
  endif
  assign has_discount = false
  if discount_cents > 0 and promo_code != blank and sale_price < regular_price
    assign has_discount = true
  endif

  assign financing_months = section.settings.financing_months | default: 24
  assign monthly_sale = sale_price | divided_by: financing_months | divided_by: 100.0 | round | times: 100
  assign monthly_regular = regular_price | divided_by: financing_months | divided_by: 100.0 | round | times: 100

  assign sale_str = sale_price | money_without_trailing_zeros
  assign regular_str = regular_price | money_without_trailing_zeros
  assign monthly_str = monthly_sale | money_without_trailing_zeros
  assign monthly_regular_str = monthly_regular | money_without_trailing_zeros
  capture monthly_html
    echo '<span data-sdp-monthly>' | append: monthly_str | append: '</span>'
  endcapture

  comment
    Sibling products for the plan cards. The split-payments and $250 reserve products
    are separate SKUs per material (handle convention: "<handle>-split-payments" and
    "250-<handle>"), so when a block has no product picked and no URL, we derive the
    sibling from the current product's handle. Both products are unlisted, which is
    fine for a direct link.
  endcomment
  assign split_handle = product.handle | append: '-split-payments'
  assign reserve_handle = '250-' | append: product.handle
  assign split_product = all_products[split_handle]
  assign reserve_product = all_products[reserve_handle]

  capture heading
    render 'sdp-t', text: section.settings.heading, sdp: sdp
  endcapture
  assign heading = heading | strip
  if heading == blank
    assign heading = page.title | default: collection.title | default: product.title
  endif
  capture t_eyebrow
    render 'sdp-t', text: section.settings.eyebrow, sdp: sdp
  endcapture
  capture t_lede
    render 'sdp-t', text: section.settings.lede, sdp: sdp
  endcapture
  assign t_financing = section.settings.financing_text
  assign t_fineprint = section.settings.fineprint
  unless has_discount
    if section.settings.fineprint_no_code != blank
      assign t_fineprint = section.settings.fineprint_no_code
    endif
    assign t_financing = t_financing | remove: ', with code [code]' | remove: ' with code [code]'
  endunless
  assign t_eyebrow = t_eyebrow | strip
  assign t_lede = t_lede | strip

  assign hero_variants = product.variants
  if sdp != blank or pinned_variant != blank
    assign hero_variants = sdp_variants
  endif
-%}

<div class="sdp sdp-hero sdp--sand" data-sdp-hero data-section-id="{{ section.id }}"{% if section.settings.anchor_id != blank %} id="{{ section.settings.anchor_id | handle }}"{% endif %}>
  <div class="sdp__inner sdp-hero__wrap">
    <div class="sdp-hero__copy">
      {%- if t_eyebrow != blank -%}
        <p class="sdp-eyebrow">{{ t_eyebrow | escape }}</p>
      {%- endif -%}

      <h1 class="sdp-hero__title">{{ heading | escape }}</h1>

      {%- if t_lede != blank -%}
        <p class="sdp-hero__lede">
          {{- t_lede | escape
            | replace: '[sale_price]', sale_str
            | replace: '[price]', regular_str
            | replace: '[code]', promo_code
          -}}
        </p>
      {%- endif -%}

      {%- if section.settings.show_variant_picker and product.has_only_default_variant == false and hero_variants.size > 1 -%}
        <div class="sdp-hero__variants">
          <label for="sdp-variant-{{ section.id }}">{{ section.settings.variant_label | default: 'Choose your option' | escape }}</label>
          <select id="sdp-variant-{{ section.id }}" data-sdp-variant-select>
            {%- for v in hero_variants -%}
              {%- liquid
                assign v_label = v.title
                if sdp != blank
                  for opt in v.options
                    unless opt contains ' x '
                      assign v_label = opt
                    endunless
                  endfor
                endif
              -%}
              <option value="{{ v.id }}"{% if v.id == variant.id %} selected{% endif %}{% unless v.available %} disabled{% endunless %}>
                {{ v_label }}{% unless v.available %} — {{ 'products.product.sold_out' | t }}{% endunless %}
              </option>
            {%- endfor -%}
          </select>
        </div>
        <script type="application/json" data-sdp-variants>
          {
            "fallbackDiscount": {{ section.settings.discount_amount | default: 0 }},
            "months": {{ financing_months }},
            "variants": [
              {%- for v in hero_variants -%}
                {%- assign vd = v.metafields.custom.discount_value.value | default: v.metafields.custom.discount_value | default: 0 -%}
                { "id": {{ v.id }}, "price": {{ v.price }}, "discount": {{ vd | plus: 0 }}, "available": {{ v.available }} }{% unless forloop.last %},{% endunless %}
              {%- endfor -%}
            ]
          }
        </script>
      {%- endif -%}

      <div class="sdp-price">
        {%- if section.settings.price_label != blank -%}
          <p class="sdp-price__label">{{ section.settings.price_label | escape }}</p>
        {%- endif -%}
        <p class="sdp-price__amount" data-sdp-regular>{{ regular_price | money }}</p>

        <div class="sdp-price__promo" data-sdp-promo{% unless has_discount %} hidden{% endunless %}>
          <span>{{ section.settings.promo_prefix | default: 'or' | escape }} <span data-sdp-sale>{{ sale_price | money }}</span> {{ section.settings.promo_suffix | default: 'with code' | escape }}</span>
          <button type="button" class="sdp-code" data-sdp-copy="{{ promo_code | escape }}" aria-label="Copy code {{ promo_code | escape }}">
            <span>{{ promo_code | escape }}</span>
            {%- render 'sdp-icon', name: 'copy' -%}
            <span class="sdp-code__done" aria-hidden="true">Copied</span>
          </button>
        </div>

        {%- if t_financing != blank -%}
          <p class="sdp-price__financing">
            {{- t_financing
              | escape
              | replace: '[monthly]', monthly_html
              | replace: '[months]', financing_months
              | replace: '[code]', promo_code
            -}}
          </p>
        {%- endif -%}

        {%- if section.blocks.size > 0 -%}
          <button type="button" class="sdp-toggle" data-sdp-toggle aria-expanded="{{ section.settings.payments_open }}" aria-controls="sdp-payments-{{ section.id }}">
            <span class="sdp-toggle__open">{{ section.settings.toggle_hide | default: 'Hide payment options' | escape }}</span>
            <span class="sdp-toggle__closed">{{ section.settings.toggle_show | default: 'See payment options' | escape }}</span>
            {%- render 'sdp-icon', name: 'chevron-up' -%}
          </button>

          <div class="sdp-payments" id="sdp-payments-{{ section.id }}"{% unless section.settings.payments_open %} hidden{% endunless %}>
            {%- for block in section.blocks -%}
              {%- case block.type -%}
                {%- when 'pay_row' -%}
                  {%- if block.settings.link != blank -%}
                    <a class="sdp-payrow" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>
                  {%- else -%}
                    <div class="sdp-payrow" {{ block.shopify_attributes }}>
                  {%- endif -%}
                    <span class="sdp-payrow__logo{% if block.settings.logo != blank %} sdp-payrow__logo--image{% endif %}"{% if block.settings.logo_background != blank %} style="background: {{ block.settings.logo_background }}; border-color: {{ block.settings.logo_background }};"{% endif %}>
                      {%- if block.settings.logo != blank -%}
                        {{ block.settings.logo | image_url: width: 288 | image_tag: loading: 'lazy', alt: block.settings.text, widths: '96, 192, 288', sizes: '96px' }}
                      {%- else -%}
                        <span>{{ block.settings.logo_text | escape }}</span>
                      {%- endif -%}
                    </span>
                    <span>{{ block.settings.text | escape }}</span>
                  {%- if block.settings.link != blank -%}</a>{%- else -%}</div>{%- endif -%}

                {%- when 'payment_plan' -%}
                  {%- liquid
                    assign plan_base = sale_price
                    if block.settings.base_on_regular
                      assign plan_base = regular_price
                    endif
                    assign n1 = block.settings.payments_1 | default: 4
                    assign n2 = block.settings.payments_2 | default: 6
                    assign n3 = block.settings.payments_3 | default: 8
                    assign amt1 = plan_base | divided_by: n1 | divided_by: 100.0 | round | times: 100
                    assign amt2 = plan_base | divided_by: n2 | divided_by: 100.0 | round | times: 100
                    assign amt3 = plan_base | divided_by: n3 | divided_by: 100.0 | round | times: 100
                  -%}
                  <div class="sdp-plan" data-sdp-plan{% if block.settings.base_on_regular %} data-sdp-plan-regular{% endif %} {{ block.shopify_attributes }}>
                    <div class="sdp-plan__head">
                      <span class="sdp-payrow__logo sdp-payrow__logo--brand{% if block.settings.logo != blank %} sdp-payrow__logo--image{% endif %}">
                        {%- if block.settings.logo != blank -%}
                          {{ block.settings.logo | image_url: width: 288 | image_tag: loading: 'lazy', alt: 'A-DIY', widths: '96, 192, 288', sizes: '96px' }}
                        {%- else -%}
                          <span>A-DIY</span>
                        {%- endif -%}
                      </span>
                      <div class="sdp-plan__title">
                        {%- liquid
                          assign plan_title = block.settings.title
                          assign plan_kicker = block.settings.kicker
                          unless has_discount
                            assign plan_title = plan_title | replace: '[sale_price] sale price', '[regular_price] price'
                            assign plan_kicker = plan_kicker | remove: ' · Code [code]'
                          endunless
                        -%}
                        <strong>{{ plan_title | escape | replace: '[sale_price]', sale_str | replace: '[regular_price]', regular_str }}</strong>
                        {%- if plan_kicker != blank -%}
                          <span>{{ plan_kicker | escape | replace: '[code]', promo_code }}</span>
                        {%- endif -%}
                      </div>
                    </div>
                    <div class="sdp-plan__tiles">
                      <div class="sdp-tile{% if block.settings.highlight == '1' %} sdp-tile--highlight{% endif %}">
                        <span class="sdp-tile__label">{{ n1 }} payments</span>
                        <span class="sdp-tile__value" data-sdp-plan-amount="{{ n1 }}">{{ amt1 | money_without_trailing_zeros }}</span>
                        <span class="sdp-tile__sub">{{ block.settings.sub_1 | default: 'per month' | escape }}</span>
                      </div>
                      <div class="sdp-tile{% if block.settings.highlight == '2' %} sdp-tile--highlight{% endif %}">
                        <span class="sdp-tile__label">{{ n2 }} payments</span>
                        <span class="sdp-tile__value" data-sdp-plan-amount="{{ n2 }}">{{ amt2 | money_without_trailing_zeros }}</span>
                        <span class="sdp-tile__sub">{{ block.settings.sub_2 | default: 'per month' | escape }}</span>
                      </div>
                      <div class="sdp-tile{% if block.settings.highlight == '3' %} sdp-tile--highlight{% endif %}">
                        <span class="sdp-tile__label">{{ n3 }} payments</span>
                        <span class="sdp-tile__value" data-sdp-plan-amount="{{ n3 }}">{{ amt3 | money_without_trailing_zeros }}</span>
                        <span class="sdp-tile__sub">{{ block.settings.sub_3 | default: 'per month · lowest' | escape }}</span>
                      </div>
                    </div>
                    {%- liquid
                      assign plan_url = block.settings.link
                      if block.settings.product != blank
                        assign plan_url = block.settings.product.url
                      elsif plan_url == blank and split_product != blank
                        assign plan_url = split_product.url
                      endif
                    -%}
                    {%- if block.settings.how != blank or block.settings.link_label != blank -%}
                      <p class="sdp-plan__how">
                        {%- capture how_text -%}{%- render 'sdp-t', text: block.settings.how, sdp: sdp -%}{%- endcapture -%}
                        {{ how_text | escape }}
                        {%- if block.settings.link_label != blank and plan_url != blank %} <a href="{{ plan_url }}">{{ block.settings.link_label | escape }} →</a>{% endif -%}
                      </p>
                    {%- endif -%}
                  </div>

                {%- when 'reserve' -%}
                  <div class="sdp-plan sdp-plan--reserve" {{ block.shopify_attributes }}>
                    <div class="sdp-plan__head">
                      <span class="sdp-payrow__logo sdp-payrow__logo--brand{% if block.settings.logo != blank %} sdp-payrow__logo--image{% endif %}">
                        {%- if block.settings.logo != blank -%}
                          {{ block.settings.logo | image_url: width: 288 | image_tag: loading: 'lazy', alt: 'A-DIY', widths: '96, 192, 288', sizes: '96px' }}
                        {%- else -%}
                          <span>A-DIY</span>
                        {%- endif -%}
                      </span>
                      <div class="sdp-plan__title">
                        <strong>{{ block.settings.title | escape }}</strong>
                        {%- if block.settings.kicker != blank -%}
                          <span>{{ block.settings.kicker | escape }}</span>
                        {%- endif -%}
                      </div>
                    </div>
                    <div class="sdp-plan__tiles">
                      {%- for i in (1..3) -%}
                        {%- assign label_key = 'label_' | append: i -%}
                        {%- assign value_key = 'value_' | append: i -%}
                        {%- assign sub_key = 'sub_' | append: i -%}
                        {%- if block.settings[value_key] != blank -%}
                          <div class="sdp-tile">
                            <span class="sdp-tile__label">{{ block.settings[label_key] | escape }}</span>
                            <span class="sdp-tile__value">{{ block.settings[value_key] | escape }}</span>
                            <span class="sdp-tile__sub">{{ block.settings[sub_key] | escape }}</span>
                          </div>
                        {%- endif -%}
                      {%- endfor -%}
                    </div>
                    {%- liquid
                      assign reserve_url = block.settings.link
                      if block.settings.product != blank
                        assign reserve_url = block.settings.product.url
                      elsif reserve_url == blank and reserve_product != blank
                        assign reserve_url = reserve_product.url
                      endif
                    -%}
                    {%- if block.settings.how != blank or block.settings.link_label != blank -%}
                      <p class="sdp-plan__how">
                        {%- capture how_text -%}{%- render 'sdp-t', text: block.settings.how, sdp: sdp -%}{%- endcapture -%}
                        {{ how_text | escape }}
                        {%- if block.settings.link_label != blank and reserve_url != blank %} <a href="{{ reserve_url }}">{{ block.settings.link_label | escape }} →</a>{% endif -%}
                      </p>
                    {%- endif -%}
                  </div>
              {%- endcase -%}
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- if t_fineprint != blank -%}
          <p class="sdp-price__fineprint">
            {{- t_fineprint
              | escape
              | replace: '[sale_price]', sale_str
              | replace: '[regular_price]', regular_str
              | replace: '[monthly_regular]', monthly_regular_str
              | replace: '[monthly]', monthly_str
              | replace: '[months]', financing_months
              | replace: '[code]', promo_code
            -}}
          </p>
        {%- endif -%}
      </div>

      <div class="sdp-hero__ctas">
        <product-form class="product-form" data-hide-errors="false" data-section-id="{{ section.id }}">
          <div class="product-form__error-message-wrapper" role="alert" hidden>
            <span class="svg-wrapper">{{- 'icon-error.svg' | inline_asset_content -}}</span>
            <span class="product-form__error-message"></span>
          </div>
          {%- form 'product', product, id: product_form_id, class: 'form', novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
            <input type="hidden" name="id" value="{{ variant.id }}" class="product-variant-id" data-sdp-variant-id{% if variant == null or variant.available == false %} disabled{% endif %}>
            <input type="hidden" name="quantity" value="1">
            <div class="product-form__buttons">
              <button
                id="ProductSubmitButton-{{ section.id }}"
                type="submit"
                name="add"
                class="sdp-add product-form__submit"
                {% if variant == null or variant.available == false %}disabled{% endif %}
              >
                {%- render 'sdp-icon', name: 'cart' -%}
                <span>
                  {%- if variant == null -%}
                    {{ 'products.product.unavailable' | t }}
                  {%- elsif variant.available == false -%}
                    {{ 'products.product.sold_out' | t }}
                  {%- else -%}
                    {{ section.settings.add_label | default: 'Add to cart' | escape }}{% if section.settings.add_show_price %} · <span data-sdp-cta-price>{{ regular_price | money }}</span>{% endif %}
                  {%- endif -%}
                </span>
                {%- render 'loading-spinner' -%}
              </button>
            </div>
          {%- endform -%}
        </product-form>

        {%- if section.settings.secondary_label != blank -%}
          <a class="sdp-link" href="{{ section.settings.secondary_link | default: '#sizes' }}">
            {{ section.settings.secondary_label | escape }}
            {%- render 'sdp-icon', name: 'arrow-right' -%}
          </a>
        {%- endif -%}
      </div>
    </div>

    {%- liquid
      capture hero_alt
        render 'sdp-t', text: section.settings.image_alt, sdp: sdp
      endcapture
      assign hero_alt = hero_alt | strip | default: heading
      comment
        Main image = the product's first photo (so each size product shows its own
        gallery lead), unless "Use the custom image" is ticked.
      endcomment
      assign hero_image = product.featured_media.preview_image
      if section.settings.use_custom_image and section.settings.image != blank
        assign hero_image = section.settings.image
      endif
      if hero_image == blank
        assign hero_image = section.settings.image
      endif
      if sdp != blank
        comment
          Deck size page: the entry's hero image, else the size variant's own image.
        endcomment
        assign hero_image = sdp.hero_image.value | default: variant.featured_media.preview_image | default: hero_image
        if sdp.hero_image_alt != blank
          assign hero_alt = sdp.hero_image_alt.value
        endif
      endif
    -%}
    {%- render 'sdp-image',
      image: hero_image,
      class: 'sdp-hero__media',
      sizes: '(min-width: 990px) 591px, calc(100vw - 48px)',
      eager: true,
      focal: section.settings.image_focal,
      alt: hero_alt
    -%}
  </div>
</div>

{%- if template.name == 'collection' and pinned_variant != blank -%}
  {%- render 'sdp-collection-schema', sdp: sdp, product: product, variant: pinned_variant, heading: heading, image: hero_image -%}
{%- elsif sdp != blank -%}
  {%- render 'sdp-page-schema', sdp: sdp, product: product, variants: hero_variants, heading: heading, description: t_lede, image: hero_image, promo_price: sale_price, has_discount: has_discount -%}
{%- else -%}
  {% render 'structured-data-product', product: product %}
{%- endif -%}

{% schema %}
{
  "name": "SDP · Hero (product)",
  "tag": "section",
  "class": "section",
  "enabled_on": { "templates": ["product", "page", "collection"] },
  "settings": [
    { "type": "text", "id": "anchor_id", "label": "Anchor ID" },
    { "type": "header", "content": "Copy" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "12 × 12 Pressure-treated wood deck · 144 sq ft" },
    { "type": "textarea", "id": "heading", "label": "Heading (H1)", "info": "Leave blank to use the product title.", "default": "12x12 Deck — build it yourself, delivered as a pressure treated kit" },
    { "type": "textarea", "id": "lede", "label": "Intro paragraph", "info": "Placeholders: [price], [sale_price], [code] are filled from the product so the copy always matches the live price.", "default": "A 12x12 deck from A-DIY costs [price]. That one price covers a professionally engineered, pressure treated deck kit in which every part goes together seamlessly. It is delivered in 10–14 business days, assembles in 8–16 hours with a drill as the only tool, and is backed by a 5-year structural warranty." },
    { "type": "text", "id": "size_option", "label": "Size variant", "info": "The variant option value for this page's size, e.g. \"12 x 12\". Used for the price and Add to cart when the URL doesn't pick a variant.", "default": "12 x 12" },
    { "type": "checkbox", "id": "show_variant_picker", "label": "Show variant dropdown", "info": "Off by default: the page is for one size, so the product's first available variant is sold. Turn on for products with several sizes/colours.", "default": false },
    { "type": "text", "id": "variant_label", "label": "Variant dropdown label", "default": "Choose your option" },
    { "type": "header", "content": "Image" },
    { "type": "paragraph", "content": "The main image is the product's first photo. Pick an image below and tick the box to override it." },
    { "type": "image_picker", "id": "image", "label": "Custom image" },
    { "type": "checkbox", "id": "use_custom_image", "label": "Use the custom image instead of the product photo", "default": false },
    { "type": "text", "id": "image_focal", "label": "Image focal point (CSS object-position)", "default": "50% 40%" },
    { "type": "text", "id": "image_alt", "label": "Image alt text (SEO)", "default": "12x12 pressure-treated wood deck kit from A-DIY set up as an outdoor lounge" },
    { "type": "header", "content": "Price & promo code" },
    { "type": "text", "id": "price_label", "label": "Price label", "default": "Regular price" },
