    {
      "type": "range",
      "id": "star_4_percent",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "4 Stars Percentage",
      "default": 9
    },
    {
      "type": "range",
      "id": "star_3_percent",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "3 Stars Percentage",
      "default": 3
    },
    {
      "type": "range",
      "id": "star_2_percent",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "2 Stars Percentage",
      "default": 2
    },
    {
      "type": "range",
      "id": "star_1_percent",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "1 Star Percentage",
      "default": 2
