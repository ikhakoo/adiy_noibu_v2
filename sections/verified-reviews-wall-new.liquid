                    <div class="user-header">
                      <div class="user-info">
                        {%- if block.settings.author_image != blank -%}
                          <img src="{{ block.settings.author_image | image_url: width: 80 }}" class="avatar" alt="{{ block.settings.author_name }}">
                        {%- endif -%}
                        <div class="user-meta">
                          <span class="user-name">{{ block.settings.author_name }}</span>
                          {%- if block.settings.author_handle != blank -%}
                            <span class="user-handle">{{ block.settings.author_handle }}</span>
                          {%- endif -%}
                        </div>
                      </div>
                      {%- if block.settings.social_icon != 'none' -%}
                        <div class="social-icon{% if block.settings.social_icon == 'trustpilot' %} trustpilot{% endif %}">
                          {%- case block.settings.social_icon -%}
                            {%- when 'facebook' -%}<svg viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
                            {%- when 'x' -%}<svg viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
                            {%- when 'instagram' -%}<svg viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
                            {%- when 'youtube' -%}<svg viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
                            {%- when 'google' -%}<img src="https://cdn.shopify.com/s/files/1/0456/9638/5046/files/image_8602.png?v=1787786455" alt="Google" width="24">
                            {%- when 'trustpilot' -%}<img src="https://cdn.shopify.com/s/files/1/0456/9638/5046/files/image_4.png?v=1787847498" alt="Trustpilot" width="100%">
                          {%- endcase -%}
                        </div>
                      {%- endif -%}
                    </div>
                    {%- if block.settings.is_5_star -%}<div class="card-stars">★★★★★</div>{%- endif -%}
                    {%- if block.settings.is_4_star -%}<div class="card-stars">★★★★</div>{%- endif -%}
                    {%- if block.settings.is_3_star -%}<div class="card-stars">★★★</div>{%- endif -%}
                    {%- if block.settings.headline != blank -%}<div class="review-headline">{{ block.settings.headline }}</div>{%- endif -%}
                    {%- if block.settings.review_text != blank -%}<p class="review-text">{{ block.settings.review_text }}</p>{%- endif -%}
                  </div>
                {%- endif -%}
                <div class="media-wrapper aspect-{{ block.settings.aspect_ratio }}">
                  <img src="{{ block.settings.review_image | image_url: width: 800 }}" class="review-main-image" alt="{{ block.settings.author_name | escape }}" loading="lazy">
                </div>

              {%- when 'text_review' -%}
                <div class="review-details">
                  <div class="user-header">
                    <div class="user-info">
                      {%- if block.settings.author_image != blank -%}
                        <img src="{{ block.settings.author_image | image_url: width: 80 }}" class="avatar" alt="{{ block.settings.author_name }}">
                      {%- endif -%}
                      <div class="user-meta">
                        <span class="user-name">{{ block.settings.author_name }}</span>
                        {%- if block.settings.author_handle != blank -%}
                          <span class="user-handle">{{ block.settings.author_handle }}</span>
                        {%- endif -%}
                      </div>
                    </div>
                    {%- if block.settings.social_icon != 'none' -%}
                      <div class="social-icon{% if block.settings.social_icon == 'trustpilot' %} trustpilot{% endif %}">
                        {%- case block.settings.social_icon -%}
                          {%- when 'facebook' -%}<svg viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
                          {%- when 'x' -%}<svg viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
                          {%- when 'instagram' -%}<svg viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
                          {%- when 'youtube' -%}<svg viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
                          {%- when 'google' -%}<img src="https://cdn.shopify.com/s/files/1/0456/9638/5046/files/image_8602.png?v=1787786455" alt="Google" width="24">
                          {%- when 'trustpilot' -%}<img src="https://cdn.shopify.com/s/files/1/0456/9638/5046/files/image_4.png?v=1787847498" alt="Trustpilot" width="100%">
                        {%- endcase -%}
                      </div>
                    {%- endif -%}
                  </div>
                  {%- if block.settings.is_5_star -%}<div class="card-stars">★★★★★</div>{%- endif -%}
                  {%- if block.settings.is_4_star -%}<div class="card-stars">★★★★</div>{%- endif -%}
                  {%- if block.settings.is_3_star -%}<div class="card-stars">★★★</div>{%- endif -%}
                  {%- if block.settings.headline != blank -%}<div class="review-headline">{{ block.settings.headline }}</div>{%- endif -%}
                  {%- if block.settings.review_text != blank -%}<p class="review-text">{{ block.settings.review_text }}</p>{%- endif -%}
                </div>
            {%- endcase -%}
          </div>
        {%- endfor -%}
      </div>

      <!-- Truncate Read More Button Overlay -->
      {%- unless section.settings.show_full_section -%}
        <div class="reviews-fade-overlay">
          {%- if section.settings.button_link != blank -%}
            <a href="{{ section.settings.button_link }}" class="read-more-btn">
              {{ section.settings.button_label | default: 'Read More' }}
            </a>
          {%- else -%}
            <button type="button" class="read-more-btn js-expand-reviews">
              {{ section.settings.button_label | default: 'Read More' }}
            </button>
          {%- endif -%}
        </div>
      {%- endunless -%}
    </div>

  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const sectionContainer = document.querySelector('.reviews-wall-scroll-{{ section.id }}');
    if (!sectionContainer) return;

    const gridElem = sectionContainer.querySelector('.reviews-isotope-grid');
    const relativeWrapper = sectionContainer.querySelector('.reviews-wrapper-relative');
    const expandBtn = sectionContainer.querySelector('.js-expand-reviews');
    let iso;

    if (gridElem) {
      imagesLoaded(gridElem, function() {
        iso = new Isotope(gridElem, {
          itemSelector: '.card-box',
          percentPosition: true,
          masonry: {
            columnWidth: '.grid-sizer',
            gutter: 14
          }
        });
      });
    }

    if (expandBtn && relativeWrapper) {
      expandBtn.addEventListener('click', function() {
        relativeWrapper.classList.remove('is-truncated');
        if (iso) {
          iso.layout();
        }
      });
    }

    const videoCards = sectionContainer.querySelectorAll('.card-box.is-video .media-wrapper');
    videoCards.forEach(wrapper => {
      const video = wrapper.querySelector('video');
      const muteBtn = wrapper.querySelector('.mute-badge-icon');
      if (!video) return;

      wrapper.addEventListener('mouseenter', function() {
        video.play().catch(() => {});
      });

      wrapper.addEventListener('mouseleave', function() {
        video.pause();
        video.currentTime = 0;
      });

      if (muteBtn) {
        muteBtn.addEventListener('click', function(e) {
          e.stopPropagation();
          if (video.muted) {
            video.muted = false;
            muteBtn.classList.add('is-unmuted');
          } else {
            video.muted = true;
            muteBtn.classList.remove('is-unmuted');
          }
        });
      }
    });
  });
</script>

{% schema %}
{
  "name": "Verified Reviews Wall New",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Sleep you can't stop talking about"
    },
    {
      "type": "text",
      "id": "class_heading",
      "label": "Heading Add Class"
    },
    {
      "type": "text",
      "id": "sub_heading",
      "label": "Sub Heading"
    },
    {
      "type": "text",
      "id": "rating_score",
      "label": "Rating Score",
      "default": "4.8"
    },
    {
