      "id": "total_reviews",
      "label": "Total Reviews Count",
      "default": "1,751"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "checkbox",
