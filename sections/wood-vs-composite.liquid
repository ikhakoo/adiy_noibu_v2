{%- style -%}
  .wood-vs-comp-{{ section.id }} {
    background-color: {{ section.settings.section_bg }};
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }

  @media screen and (min-width: 750px) {
    .wood-vs-comp-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_desktop }}px;
      padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
    }
  }

  /* Header Section */
  .wood-vs-comp-header-{{ section.id }} {
    text-align: center;
    max-width: 800px;
    margin: 0 auto 2.5rem auto;
  }

  .wood-vs-comp-main-title-{{ section.id }} {
    font-size: 1.85rem;
    font-weight: 700;
    color: #1a1a1a;
    line-height: 1.25;
    margin: 0 0 1rem 0;
  }

  @media screen and (min-width: 750px) {
    .wood-vs-comp-main-title-{{ section.id }} {
      font-size: 2.25rem;
    }
  }

  .wood-vs-comp-subhead-{{ section.id }} {
    font-size: 14px;
    font-weight: 600;
    color: #333333;
    margin-bottom: 0.75rem;
  }

  .wood-vs-comp-desc-{{ section.id }} {
    font-size: 14px;
    line-height: 1.6;
    color: #555555;
    margin: 0;
  }

  /* Cards Wrapper (Mobile Drag & Desktop Dynamic Grid) */
  .wood-vs-comp-cards-{{ section.id }} {
    display: flex;
    gap: 20px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    padding-bottom: 12px;
  }

  .wood-vs-comp-cards-{{ section.id }}::-webkit-scrollbar {
    display: none;
  }

  @media screen and (min-width: 850px) {
    .wood-vs-comp-cards-{{ section.id }} {
      display: grid;
      grid-template-columns: repeat({{ section.blocks.size | default: 2 }}, minmax(0, 1fr));
      gap: 24px;
      overflow-x: visible;
      padding-bottom: 0;
    }
  }

  /* Card Item */
  .wood-vs-comp-card-{{ section.id }} {
    flex: 0 0 85%;
    max-width: 85%;
    scroll-snap-align: center;
    border-radius: 12px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
  }

  @media screen and (min-width: 850px) {
    .wood-vs-comp-card-{{ section.id }} {
      flex: 1 1 auto;
      max-width: 100%;
    }
  }

  /* Card Image */
  .wood-vs-comp-card-media-{{ section.id }} {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    background-color: #e0e0e0;
  }

  .wood-vs-comp-card-img-{{ section.id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Card Body */
  .wood-vs-comp-card-body-{{ section.id }} {
    padding: 24px 20px;
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .wood-vs-comp-card-tag-{{ section.id }} {
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    margin-bottom: 8px;
    opacity: 0.8;
  }

  .wood-vs-comp-card-title-{{ section.id }} {
    font-size: 1.5rem;
    font-weight: 700;
    margin: 0 0 20px 0;
    line-height: 1.3;
  }

  .wood-vs-comp-features-{{ section.id }} {
    list-style: none;
    padding: 0;
    margin: 0 0 24px 0;
    width: 100%;
  }

  .wood-vs-comp-feature-item-{{ section.id }} {
    font-size: 14px;
    line-height: 1.5;
    margin-bottom: 10px;
    opacity: 0.85;
  }

  .wood-vs-comp-card-btn-{{ section.id }} {
    margin-top: auto;
    width: 100%;
    padding: 12px 20px;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    border-radius: 4px;
    text-decoration: none;
    text-align: center;
    transition: all 0.2s ease;
    display: inline-block;
  }

  /* Custom Scrollbar for Mobile */
  .wood-vs-comp-scroll-track-{{ section.id }} {
    width: 200px;
    height: 4px;
    background-color: #e0e0e0;
    border-radius: 2px;
    margin: 20px auto 2.5rem auto;
    overflow: hidden;
    position: relative;
  }

  .wood-vs-comp-scroll-bar-{{ section.id }} {
    height: 100%;
    width: 50%;
    background-color: #1c4b37;
    border-radius: 2px;
    transition: transform 0.1s ease-out;
  }

  @media screen and (min-width: 850px) {
    .wood-vs-comp-scroll-track-{{ section.id }} {
      display: none;
    }
  }

  /* Bottom Summary Block */
  .wood-vs-comp-summary-{{ section.id }} {
    max-width: 850px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 20px;
    text-align: center;
  }

  .wood-vs-comp-summary-item-{{ section.id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .wood-vs-comp-summary-title-{{ section.id }} {
    font-size: 14px;
    font-weight: 700;
    color: #1a1a1a;
    margin: 0 0 6px 0;
  }

  .wood-vs-comp-summary-desc-{{ section.id }} {
    font-size: 14px;
    line-height: 1.6;
    color: #555555;
    margin: 0 0 12px 0;
  }

  .wood-vs-comp-summary-btn-{{ section.id }} {
    padding: 10px 24px;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    border-radius: 4px;
    text-decoration: none;
    display: inline-block;
  }

  .wood-vs-comp-summary-btn-outline {
    border: 1px solid #1a1a1a;
    color: #1a1a1a;
    background: transparent;
  }

  .wood-vs-comp-summary-btn-solid {
    background-color: #1c4b37;
    color: #ffffff;
    border: 1px solid #1c4b37;
  }
{%- endstyle -%}

<div class="wood-vs-comp-{{ section.id }}">
  <div class="page-width">
    
    {%- comment -%} Header {%- endcomment -%}
    <div class="wood-vs-comp-header-{{ section.id }}">
      {%- if section.settings.main_title != blank -%}
        <h2 class="wood-vs-comp-main-title-{{ section.id }}">{{ section.settings.main_title }}</h2>
      {%- endif -%}
      {%- if section.settings.subtitle != blank -%}
        <div class="wood-vs-comp-subhead-{{ section.id }}">{{ section.settings.subtitle }}</div>
      {%- endif -%}
      {%- if section.settings.description != blank -%}
        <p class="wood-vs-comp-desc-{{ section.id }}">{{ section.settings.description }}</p>
      {%- endif -%}
    </div>

    {%- comment -%} Dynamic Blocks Loop {%- endcomment -%}
    <div class="wood-vs-comp-cards-{{ section.id }}" id="CardSlider-{{ section.id }}">
      {%- for block in section.blocks -%}
        <div class="wood-vs-comp-card-{{ section.id }}" {{ block.shopify_attributes }}>
          
          <div class="wood-vs-comp-card-media-{{ section.id }}">
            {%- if block.settings.image != blank -%}
              {%- assign img_class = 'wood-vs-comp-card-img-' | append: section.id -%}
              {{ block.settings.image 
                | image_url: width: 800 
                | image_tag: loading: 'lazy', class: img_class, alt: block.settings.title 
              }}
            {%- endif -%}
          </div>

          <div class="wood-vs-comp-card-body-{{ section.id }}" style="background-color: {{ block.settings.card_bg }}; color: {{ block.settings.text_color }};">
            {%- if block.settings.tag != blank -%}
              <span class="wood-vs-comp-card-tag-{{ section.id }}">{{ block.settings.tag }}</span>
            {%- endif -%}
            
            {%- if block.settings.title != blank -%}
              <h3 class="wood-vs-comp-card-title-{{ section.id }}" style="color: {{ block.settings.text_color }};">{{ block.settings.title }}</h3>
            {%- endif -%}
            
            {%- assign features = block.settings.features | newline_to_br | split: '<br />' -%}
            <ul class="wood-vs-comp-features-{{ section.id }}">
              {%- for feat in features -%}
                {%- assign clean_feat = feat | strip -%}
                {%- if clean_feat != blank -%}
                  <li class="wood-vs-comp-feature-item-{{ section.id }}">{{ clean_feat }}</li>
                {%- endif -%}
              {%- endfor -%}
            </ul>

            {%- if block.settings.btn_text != blank -%}
              <a href="{{ block.settings.btn_link }}" class="wood-vs-comp-card-btn-{{ section.id }}" style="background-color: {{ block.settings.btn_bg }}; color: {{ block.settings.btn_text_color }}; border: 1px solid {{ block.settings.btn_border_color }};">
                {{ block.settings.btn_text }}
              </a>
            {%- endif -%}
          </div>

        </div>
      {%- endfor -%}
    </div>

    {%- comment -%} Mobile Custom Scroll Bar {%- endcomment -%}
    <div class="wood-vs-comp-scroll-track-{{ section.id }}">
      <div class="wood-vs-comp-scroll-bar-{{ section.id }}" id="ScrollBar-{{ section.id }}"></div>
    </div>

    {%- comment -%} Bottom Summary Section {%- endcomment -%}
    <div class="wood-vs-comp-summary-{{ section.id }}">
      <div class="wood-vs-comp-summary-item-{{ section.id }}">
        <h4 class="wood-vs-comp-summary-title-{{ section.id }}">{{ section.settings.sum_1_title }}</h4>
        <p class="wood-vs-comp-summary-desc-{{ section.id }}">{{ section.settings.sum_1_desc }}</p>
        {%- if section.settings.sum_1_btn_text != blank -%}
          <a href="{{ section.settings.sum_1_btn_link }}" class="wood-vs-comp-summary-btn-{{ section.id }} wood-vs-comp-summary-btn-outline">
            {{ section.settings.sum_1_btn_text }}
          </a>
        {%- endif -%}
      </div>

      <div class="wood-vs-comp-summary-item-{{ section.id }}">
        <h4 class="wood-vs-comp-summary-title-{{ section.id }}">{{ section.settings.sum_2_title }}</h4>
        <p class="wood-vs-comp-summary-desc-{{ section.id }}">{{ section.settings.sum_2_desc }}</p>
        {%- if section.settings.sum_2_btn_text != blank -%}
          <a href="{{ section.settings.sum_2_btn_link }}" class="wood-vs-comp-summary-btn-{{ section.id }} wood-vs-comp-summary-btn-solid">
            {{ section.settings.sum_2_btn_text }}
          </a>
        {%- endif -%}
      </div>
    </div>

  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const slider = document.getElementById('CardSlider-{{ section.id }}');
    const scrollBar = document.getElementById('ScrollBar-{{ section.id }}');

    if (slider && scrollBar) {
      slider.addEventListener('scroll', function() {
        const maxScroll = slider.scrollWidth - slider.clientWidth;
        if (maxScroll > 0) {
          const percentage = (slider.scrollLeft / maxScroll) * 50; // 50% max movement range for bar width
          scrollBar.style.transform = `translateX(${percentage * 2}%)`;
        }
      });
    }
  });
</script>

{% schema %}
{
  "name": "Wood vs Composite",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "main_title",
      "label": "Main Heading",
      "default": "Pressure-Treated Wood vs. Composite Decking"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subheading",
      "default": "The best deck material depends on your budget, preferred appearance and maintenance expectations."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "New York decks may experience rain, snow, ice, humidity, summer heat, freeze-and-thaw cycles and coastal moisture. Neither pressure-treated wood nor composite is automatically best for every property."
    },
    {
      "type": "header",
      "content": "Bottom Summary - Wood"
    },
    {
      "type": "text",
      "id": "sum_1_title",
      "label": "Summary 1 Title",
      "default": "Choose Pressure-Treated Wood When:"
    },
    {
      "type": "textarea",
      "id": "sum_1_desc",
      "label": "Summary 1 Text",
      "default": "You want a lower initial cost, natural wood appearance and the ability to stain or refinish the surface. It generally requires more routine care as it ages."
    },
    {
      "type": "text",
      "id": "sum_1_btn_text",
      "label": "Summary 1 Button Text",
      "default": "Explore Pressure-Treated Options"
    },
    {
      "type": "url",
      "id": "sum_1_btn_link",
      "label": "Summary 1 Button Link"
    },
    {
      "type": "header",
      "content": "Bottom Summary - Composite"
    },
    {
      "type": "text",
      "id": "sum_2_title",
      "label": "Summary 2 Title",
      "default": "Choose Composite When:"
    },
    {
      "type": "textarea",
      "id": "sum_2_desc",
      "label": "Summary 2 Text",
      "default": "You want a modern, consistent surface with less routine maintenance and no regular staining or sealing. Composite generally has a higher initial cost."
    },
    {
      "type": "text",
      "id": "sum_2_btn_text",
      "label": "Summary 2 Button Text",
      "default": "Explore Composite Options"
    },
    {
      "type": "url",
      "id": "sum_2_btn_link",
      "label": "Summary 2 Button Link"
    },
    {
      "type": "header",
      "content": "Section Styling"
    },
    {
      "type": "color",
      "id": "section_bg",
      "label": "Background Color",
      "default": "#f5f5f3"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Desktop Padding Top",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Desktop Padding Bottom",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Mobile Padding Top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Mobile Padding Bottom",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Comparison Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Card Image"
        },
        {
          "type": "text",
          "id": "tag",
          "label": "Tagline",
          "default": "THE CLASSIC"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Card Title",
          "default": "Pressure-Treated Wood"
        },
        {
          "type": "textarea",
          "id": "features",
          "label": "Features List (One per line)",
          "default": "Generally lower\nNatural wood grain and variation\nMay require cleaning, staining or sealing\nMay develop over time"
        },
        {
          "type": "text",
          "id": "btn_text",
          "label": "Button Text",
          "default": "SHOP CLASSIC"
        },
        {
          "type": "url",
          "id": "btn_link",
          "label": "Button Link"
        },
        {
          "type": "header",
          "content": "Card Styling"
        },
        {
          "type": "color",
          "id": "card_bg",
          "label": "Card Background Color",
          "default": "#ffffff"
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Card Text Color",
          "default": "#1a1a1a"
        },
        {
          "type": "color",
          "id": "btn_bg",
          "label": "Button Background Color",
          "default": "transparent"
        },
        {
          "type": "color",
          "id": "btn_text_color",
          "label": "Button Text Color",
          "default": "#1a1a1a"
        },
        {
          "type": "color",
          "id": "btn_border_color",
          "label": "Button Border Color",
          "default": "#1a1a1a"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Wood vs Composite",
      "blocks": [
        {
          "type": "card",
          "settings": {
            "tag": "THE CLASSIC",
            "title": "Pressure-Treated Wood",
            "card_bg": "#ffffff",
            "text_color": "#1a1a1a",
            "btn_bg": "transparent",
            "btn_text_color": "#1a1a1a",
            "btn_border_color": "#1a1a1a"
          }
        },
        {
          "type": "card",
          "settings": {
            "tag": "THE MODERNIST",
            "title": "Advanced Composite",
            "card_bg": "#000000",
            "text_color": "#ffffff",
            "btn_bg": "#1c4b37",
            "btn_text_color": "#ffffff",
            "btn_border_color": "#1c4b37"
          }
        }
      ]
    }
  ]
}
{% endschema %}