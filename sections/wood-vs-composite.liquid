{%- style -%}
  .wood-vs-comp-{{ section.id }} {
    background-color: {{ section.settings.section_bg }};
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }

  @media screen and (min-width: 750px) {
    .wood-vs-comp-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_desktop }}px;
      padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
    }
  }


  /* Header Section */
  .wood-vs-comp-header {
    text-align: center;
    margin: 0 auto 3rem auto;
  }

  .wood-vs-comp-main-title {
    font-size: 1.75rem;
    font-weight: 600;
    color: #000;
    line-height: 1.25;
    margin: 0 0 1rem 0;
  }

  @media screen and (min-width: 750px) {
    .wood-vs-comp-main-title {
      font-size: 36px;
    }
  }

  .wood-vs-comp-subhead {
    font-size: 14px;
    font-weight: 600;
    color: #1a1a1a;
    margin-bottom: 0.75rem;
  }

  .wood-vs-comp-desc {
    font-size: 16px;
    line-height: 1.6;
    color: #000;
    margin: 0;
  }

  /* Cards Wrapper & Mobile Slider */
  .wood-vs-comp-cards-wrapper-{{ section.id }} {
    width: 100%;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding-bottom: 4rem;
  }

  .wood-vs-comp-cards-wrapper-{{ section.id }}::-webkit-scrollbar {
    display: none;
  }

  .wood-vs-comp-cards-grid {
    display: flex;
    gap: 16px;
  }

  @media screen and (min-width: 850px) {
    .wood-vs-comp-cards-wrapper-{{ section.id }} {
      overflow: visible;
      scroll-snap-type: none;
    }
    .wood-vs-comp-cards-grid {
      display: grid;
      grid-template-columns: repeat({{ section.blocks.size | default: 2 }}, minmax(0, 1fr));
      gap: 24px;
      align-items: stretch;
    }
  }

  /* Card Item */
  .wood-vs-comp-card {
    flex: 0 0 85%;
    max-width: 85%;
    scroll-snap-align: center;
    border-radius: 12px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
    box-sizing: border-box;
  }

  @media screen and (min-width: 576px) and (max-width: 849px) {
    .wood-vs-comp-card {
      flex: 0 0 65%;
      max-width: 65%;
    }
  }

  @media screen and (min-width: 850px) {
    .wood-vs-comp-card {
      flex: initial;
      max-width: 100%;
      scroll-snap-align: none;
    }
  }

  /* Card Image */
  .wood-vs-comp-card-media {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    background-color: #e0e0e0;
  }

  .wood-vs-comp-card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Card Body */
  .wood-vs-comp-card-body {
    padding: 28px 24px;
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .wood-vs-comp-card-tag {
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    margin-bottom: 8px;
    opacity: 0.85;
  }

  .wood-vs-comp-card-title {
    font-size: 1.5rem;
    font-weight: 700;
    margin: 0 0 20px 0;
    line-height: 1.3;
  }

  .wood-vs-comp-features {
    list-style: none;
    padding: 0;
    margin: 0 0 24px 0;
    width: 100%;
    flex-grow: 1;
  }

  .wood-vs-comp-feature-item {
    font-size: 14px;
    line-height: 1.5;
    margin-bottom: 10px;
    opacity: 0.85;
  }

  .wood-vs-comp-card-btn {
    margin-top: auto;
    width: 100%;
    padding: 14px 20px;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    border-radius: 4px;
    text-decoration: none;
    text-align: center;
    transition: all 0.2s ease;
    display: inline-block;
    box-sizing: border-box;
  }

  /* Mobile Custom Scrollbar Indicator */
  .wood-vs-comp-scrollbar-nav-{{ section.id }} {
    display: flex;
    margin-top: 1.5rem;
    margin-bottom: 2.5rem;
    padding: 0 1rem;
  }

  @media screen and (min-width: 850px) {
    .wood-vs-comp-scrollbar-nav-{{ section.id }} {
      display: none;
    }
  }

  .wood-vs-comp-scrollbar-track-{{ section.id }} {
    position: relative;
    width: 100%;
    height: 6px;
    background-color: rgba(0, 0, 0, 0.08);
    border-radius: 9999px;
    cursor: pointer;
    display: flex;
    align-items: center;
  }

  .wood-vs-comp-scrollbar-thumb-{{ section.id }} {
    position: absolute;
    top: 0;
    height: 100%;
    min-width: 35px;
    background-color: #2b4f42;
    border-radius: 9999px;
    border: none;
    padding: 0;
    outline: none;
    touch-action: none;
  }

  .wood-vs-comp-scrollbar-thumb-hitbox {
    position: absolute;
    top: -15px;
    bottom: -15px;
    left: 0;
    right: 0;
  }

  /* Bottom Summary Block */
  .wood-vs-comp-summary {
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 4rem;
    text-align: center;
  }

  .wood-vs-comp-summary-item {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .wood-vs-comp-summary-title {
    font-size: 20px;
    font-weight: 500;
    color: #0000;
    margin: 0 0 10px 0;
  }

  .wood-vs-comp-summary-desc {
    font-size: 14px;
    line-height: 1.6;
    color: #555555;
    margin: 0 0 12px 0;
  }

  .wood-vs-comp-summary-btn {
    padding: 12px 28px;
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 1px;
    text-transform: uppercase;
    border-radius: 4px;
    text-decoration: none;
    display: inline-block;
  }

  .wood-vs-comp-summary-btn-outline {
    border: 1px solid #1a1a1a;
    color: #1a1a1a;
    background: transparent;
  }

  .wood-vs-comp-summary-btn-solid {
    background-color: #1c4b37;
    color: #ffffff;
    border: 1px solid #1c4b37;
  }
{%- endstyle -%}

<div class="wood-vs-comp-{{ section.id }}">
  <div class="wood-vs-comp-container page-width">
    
    {%- comment -%} Header {%- endcomment -%}
    {%- if section.settings.main_title != blank or section.settings.subtitle != blank or section.settings.description != blank -%}
      <div class="wood-vs-comp-header">
        {%- if section.settings.main_title != blank -%}
          <h2 class="wood-vs-comp-main-title">{{ section.settings.main_title }}</h2>
        {%- endif -%}
        {%- if section.settings.subtitle != blank -%}
          <div class="wood-vs-comp-subhead">{{ section.settings.subtitle }}</div>
        {%- endif -%}
        {%- if section.settings.description != blank -%}
          <p class="wood-vs-comp-desc">{{ section.settings.description }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- comment -%} Mobile Cards Slider & Grid {%- endcomment -%}
    <div class="wood-vs-comp-cards-wrapper-{{ section.id }} js-wood-cards-wrapper-{{ section.id }}">
      <div class="wood-vs-comp-cards-grid">
        {%- for block in section.blocks -%}
          <div class="wood-vs-comp-card" {{ block.shopify_attributes }}>
            
            <div class="wood-vs-comp-card-media">
              {%- if block.settings.image != blank -%}
                {{ block.settings.image 
                  | image_url: width: 800 
                  | image_tag: loading: 'lazy', class: 'wood-vs-comp-card-img', alt: block.settings.title 
                }}
              {%- endif -%}
            </div>

            <div class="wood-vs-comp-card-body" style="background-color: {{ block.settings.card_bg }}; color: {{ block.settings.text_color }};">
              {%- if block.settings.tag != blank -%}
                <span class="wood-vs-comp-card-tag">{{ block.settings.tag }}</span>
              {%- endif -%}
              
              {%- if block.settings.title != blank -%}
                <h3 class="wood-vs-comp-card-title" style="color: {{ block.settings.text_color }};">{{ block.settings.title }}</h3>
              {%- endif -%}
              
              {%- assign features = block.settings.features | newline_to_br | split: '<br />' -%}
              {%- if features.size > 0 -%}
                <ul class="wood-vs-comp-features">
                  {%- for feat in features -%}
                    {%- assign clean_feat = feat | strip -%}
                    {%- if clean_feat != blank -%}
                      <li class="wood-vs-comp-feature-item">{{ clean_feat }}</li>
                    {%- endif -%}
                  {%- endfor -%}
                </ul>
              {%- endif -%}

              {%- if block.settings.btn_text != blank -%}
                <a href="{{ block.settings.btn_link }}" class="wood-vs-comp-card-btn" style="background-color: {{ block.settings.btn_bg }}; color: {{ block.settings.btn_text_color }}; border: 1px solid {{ block.settings.btn_border_color }};">
                  {{ block.settings.btn_text }}
                </a>
              {%- endif -%}
            </div>

          </div>
        {%- endfor -%}
      </div>
    </div>

    {%- comment -%} Custom Scrollbar Navigation for Mobile {%- endcomment -%}
    <div class="wood-vs-comp-scrollbar-nav-{{ section.id }}">
      <div class="wood-vs-comp-scrollbar-track-{{ section.id }} js-scroll-track-{{ section.id }}">
        <div class="wood-vs-comp-scrollbar-thumb-{{ section.id }} js-scroll-thumb-{{ section.id }}">
          <div class="wood-vs-comp-scrollbar-thumb-hitbox"></div>
        </div>
      </div>
    </div>

    {%- comment -%} Bottom Summary Section {%- endcomment -%}
    {%- if section.settings.sum_1_title != blank or section.settings.sum_2_title != blank -%}
      <div class="wood-vs-comp-summary">
        {%- if section.settings.sum_1_title != blank -%}
          <div class="wood-vs-comp-summary-item">
            <h4 class="wood-vs-comp-summary-title">{{ section.settings.sum_1_title }}</h4>
            <p class="wood-vs-comp-summary-desc">{{ section.settings.sum_1_desc }}</p>
            {%- if section.settings.sum_1_btn_text != blank -%}
              <a href="{{ section.settings.sum_1_btn_link }}" class="wood-vs-comp-summary-btn wood-vs-comp-summary-btn-outline">
                {{ section.settings.sum_1_btn_text }}
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if section.settings.sum_2_title != blank -%}
          <div class="wood-vs-comp-summary-item">
            <h4 class="wood-vs-comp-summary-title">{{ section.settings.sum_2_title }}</h4>
            <p class="wood-vs-comp-summary-desc">{{ section.settings.sum_2_desc }}</p>
            {%- if section.settings.sum_2_btn_text != blank -%}
              <a href="{{ section.settings.sum_2_btn_link }}" class="wood-vs-comp-summary-btn wood-vs-comp-summary-btn-solid">
                {{ section.settings.sum_2_btn_text }}
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const sectionContainer = document.querySelector('.wood-vs-comp-{{ section.id }}');
    if (!sectionContainer) return;

    const cardsWrapper = sectionContainer.querySelector('.js-wood-cards-wrapper-{{ section.id }}');
    const scrollTrack = sectionContainer.querySelector('.js-scroll-track-{{ section.id }}');
    const scrollThumb = sectionContainer.querySelector('.js-scroll-thumb-{{ section.id }}');

    if (!cardsWrapper || !scrollTrack || !scrollThumb) return;

    let isThumbDragging = false;
    let dragStartX = 0;
    let initialScrollLeft = 0;
    let rAFId = null;

    function updateThumbUI() {
      const scrollWidth = cardsWrapper.scrollWidth;
      const clientWidth = cardsWrapper.clientWidth;
      const maxScrollLeft = scrollWidth - clientWidth;

      if (maxScrollLeft <= 0) {
        scrollThumb.style.width = '100%';
        scrollThumb.style.left = '0%';
        return;
      }

      const thumbWidthRatio = clientWidth / scrollWidth;
      const thumbWidthPercent = Math.max(thumbWidthRatio * 100, 20);
      const maxThumbLeftPercent = 100 - thumbWidthPercent;
      
      const currentScrollRatio = cardsWrapper.scrollLeft / maxScrollLeft;
      const currentLeftPercent = Math.min(Math.max(currentScrollRatio * maxThumbLeftPercent, 0), maxThumbLeftPercent);

      scrollThumb.style.width = thumbWidthPercent + '%';
      scrollThumb.style.left = currentLeftPercent + '%';
    }

    cardsWrapper.addEventListener('scroll', function() {
      if (!isThumbDragging) {
        if (rAFId) cancelAnimationFrame(rAFId);
        rAFId = requestAnimationFrame(updateThumbUI);
      }
    }, { passive: true });

    window.addEventListener('resize', updateThumbUI);
    updateThumbUI();

    /* Dragging Logic */
    scrollThumb.addEventListener('pointerdown', (e) => {
      e.stopPropagation();
      e.preventDefault();

      isThumbDragging = true;
      dragStartX = e.clientX;
      initialScrollLeft = cardsWrapper.scrollLeft;

      cardsWrapper.style.scrollSnapType = 'none';
      cardsWrapper.style.scrollBehavior = 'auto';
      scrollThumb.setPointerCapture(e.pointerId);
    });

    scrollThumb.addEventListener('pointermove', (e) => {
      if (!isThumbDragging) return;

      const deltaX = e.clientX - dragStartX;
      const trackWidth = scrollTrack.clientWidth;
      const thumbWidth = scrollThumb.offsetWidth;
      const maxThumbMove = trackWidth - thumbWidth;
      const maxContainerScroll = cardsWrapper.scrollWidth - cardsWrapper.clientWidth;

      if (maxThumbMove > 0) {
        const scrollDelta = (deltaX / maxThumbMove) * maxContainerScroll;
        cardsWrapper.scrollLeft = initialScrollLeft + scrollDelta;
        updateThumbUI();
      }
    });

    const releasePointer = (e) => {
      if (isThumbDragging) {
        isThumbDragging = false;
        cardsWrapper.style.scrollSnapType = 'x mandatory';
        cardsWrapper.style.scrollBehavior = 'smooth';

        try {
          scrollThumb.releasePointerCapture(e.pointerId);
        } catch(err) {}
      }
    };

    scrollThumb.addEventListener('pointerup', releasePointer);
    scrollThumb.addEventListener('pointercancel', releasePointer);

    /* Track Click Navigation */
    scrollTrack.addEventListener('click', (e) => {
      if (e.target.closest('.js-scroll-thumb-{{ section.id }}')) return;

      const trackRect = scrollTrack.getBoundingClientRect();
      const clickX = e.clientX - trackRect.left;
      const thumbWidth = scrollThumb.offsetWidth;
      
      let targetLeft = clickX - (thumbWidth / 2);
      const maxThumbMove = trackRect.width - thumbWidth;

      if (targetLeft < 0) targetLeft = 0;
      if (targetLeft > maxThumbMove) targetLeft = maxThumbMove;

      const clickRatio = targetLeft / maxThumbMove;
      const maxContainerScroll = cardsWrapper.scrollWidth - cardsWrapper.clientWidth;

      cardsWrapper.style.scrollBehavior = 'smooth';
      cardsWrapper.scrollTo({
        left: clickRatio * maxContainerScroll,
        behavior: 'smooth'
      });
    });
  });
</script>

{% schema %}
{
  "name": "Wood vs Composite",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "main_title",
      "label": "Main Heading",
      "default": "Pressure-Treated Wood vs. Composite Decking"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subheading",
      "default": "The best deck material depends on your budget, preferred appearance and maintenance expectations."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "New York decks may experience rain, snow, ice, humidity, summer heat, freeze-and-thaw cycles and coastal moisture. Neither pressure-treated wood nor composite is automatically best for every property."
    },
    {
      "type": "header",
      "content": "Bottom Summary - Wood"
    },
    {
      "type": "text",
      "id": "sum_1_title",
      "label": "Summary 1 Title",
      "default": "Choose Pressure-Treated Wood When:"
    },
    {
      "type": "textarea",
      "id": "sum_1_desc",
      "label": "Summary 1 Text",
      "default": "You want a lower initial cost, natural wood appearance and the ability to stain or refinish the surface. It generally requires more routine care as it ages."
    },
    {
      "type": "text",
      "id": "sum_1_btn_text",
      "label": "Summary 1 Button Text",
      "default": "Explore Pressure-Treated Options"
    },
    {
      "type": "url",
      "id": "sum_1_btn_link",
      "label": "Summary 1 Button Link"
    },
    {
      "type": "header",
      "content": "Bottom Summary - Composite"
    },
    {
      "type": "text",
      "id": "sum_2_title",
      "label": "Summary 2 Title",
      "default": "Choose Composite When:"
    },
    {
      "type": "textarea",
      "id": "sum_2_desc",
      "label": "Summary 2 Text",
      "default": "You want a modern, consistent surface with less routine maintenance and no regular staining or sealing. Composite generally has a higher initial cost."
    },
    {
      "type": "text",
      "id": "sum_2_btn_text",
      "label": "Summary 2 Button Text",
      "default": "Explore Composite Options"
    },
    {
      "type": "url",
      "id": "sum_2_btn_link",
      "label": "Summary 2 Button Link"
    },
    {
      "type": "header",
      "content": "Section Styling"
    },
    {
      "type": "color",
      "id": "section_bg",
      "label": "Background Color",
      "default": "#f5f5f3"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Desktop Padding Top",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Desktop Padding Bottom",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Mobile Padding Top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Mobile Padding Bottom",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Comparison Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Card Image"
        },
        {
          "type": "text",
          "id": "tag",
          "label": "Tagline",
          "default": "THE CLASSIC"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Card Title",
          "default": "Pressure-Treated Wood"
        },
        {
          "type": "textarea",
          "id": "features",
          "label": "Features List (One per line)",
          "default": "Generally lower\nNatural wood grain and variation\nMay require cleaning, staining or sealing\nMay develop over time"
        },
        {
          "type": "text",
          "id": "btn_text",
          "label": "Button Text",
          "default": "SHOP CLASSIC"
        },
        {
          "type": "url",
          "id": "btn_link",
          "label": "Button Link"
        },
        {
          "type": "header",
          "content": "Card Styling"
        },
        {
          "type": "color",
          "id": "card_bg",
          "label": "Card Background Color",
          "default": "#ffffff"
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Card Text Color",
          "default": "#1a1a1a"
        },
        {
          "type": "color",
          "id": "btn_bg",
          "label": "Button Background Color",
          "default": "transparent"
        },
        {
          "type": "color",
          "id": "btn_text_color",
          "label": "Button Text Color",
          "default": "#1a1a1a"
        },
        {
          "type": "color",
          "id": "btn_border_color",
          "label": "Button Border Color",
          "default": "#1a1a1a"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Wood vs Composite",
      "blocks": [
        {
          "type": "card",
          "settings": {
            "tag": "THE CLASSIC",
            "title": "Pressure-Treated Wood",
            "card_bg": "#ffffff",
            "text_color": "#1a1a1a",
            "btn_bg": "transparent",
            "btn_text_color": "#1a1a1a",
            "btn_border_color": "#1a1a1a"
          }
        },
        {
          "type": "card",
          "settings": {
            "tag": "THE MODERNIST",
            "title": "Advanced Composite",
            "card_bg": "#000000",
            "text_color": "#ffffff",
            "btn_bg": "#1c4b37",
            "btn_text_color": "#ffffff",
            "btn_border_color": "#1c4b37"
          }
        }
      ]
    }
  ]
}
{% endschema %}