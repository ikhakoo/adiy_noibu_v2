<style>
  .pd-section-{{ section.id }} {
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px 0;
    background-color: {{ section.settings.bg_color }};
    font-family: inherit;
    color: #1a1a1a;
  }
  .pd-section-{{ section.id }} .page-width{
    max-width:100%;
  }


  /* Main Heading */
  .pd-main-heading {
        text-align: center;
    margin-bottom: 0;
    letter-spacing: 0;
  }

  .pd-divider {
    border: none;
    border-top: 1px solid #d5d4d4;
    margin-bottom: 30px;
    margin-top: 30px;
  }

  /* Subheadings */
  .pd-subheading {
    margin-bottom: 16px;
  }

  /* Specs Card Box */
  .pd-specs-card {
    background-color: {{ section.settings.specs_bg_color }};
    border-radius: 20px;
    overflow: hidden;
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 30px;
    align-items: center;
    margin-bottom: 40px;
    padding: {{ section.settings.specs_padding }}px;
  }

  .pd-specs-image-wrapper {
    width: 100%;
    height: 100%;
    min-height: 280px;
    position: relative;
    border-radius: 14px;
    overflow: hidden;
  }

  .pd-specs-image-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .pd-specs-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px 30px;
    padding-right: 15px;
  }

  .pd-spec-item-title {
    font-size: 15px;
    margin: 0 0 4px 0;
    letter-spacing: 0;
    font-weight: 400;
    color: #000;
  }

  .pd-spec-item-desc {
    font-size: 13px;
    color: #555;
    margin: 0;
    line-height: 1.4;
  }

  /* What's Included Grid */
  .pd-included-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 15px;
  }

  .pd-included-card {
    background: #ffffff;
    border-radius: 12px;
    padding: 16px;
    display: flex;
    align-items: center;
    gap: 12px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.04);
  }

  .pd-included-icon {
    width: 48px;
    height: 48px;
    flex-shrink: 0;
    border-radius: 8px;
    overflow: hidden;
    background: #f9f9f9;
  }

  .pd-included-icon img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .pd-included-content {
    flex-grow: 1;
  }

  .pd-included-title {
    font-size: 14px;
    font-weight: 400;
    margin: 0 0 4px 0;
    line-height: 1.2;
    letter-spacing:0;
  }

  .pd-included-desc {
    font-size: 11px;
    color: #666;
    margin: 0;
    line-height: 1.3;
  }

  /* Responsive Media Queries */
  @media (max-width: 991px) {
    .pd-specs-card {
      grid-template-columns: 1fr;
    }
    
    .pd-specs-grid {
      padding: 0 20px 20px;
    }
    .pd-specs-image-wrapper{
      border-radius: 0;
    }

    .pd-included-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (max-width:628px){
    .pd-included-desc{
      font-size: 10px;
    }
    .pd-included-title {
      font-size: 13px;
    }
    .pd-included-card{
      gap:8px;
    }
    .pd-included-card{
      padding: 10px;
    }
  }
  
</style>

<section class="pd-section-{{ section.id }}">
  <div class="pd-container page-width">
    {% if section.settings.main_title != blank %}
      <h2 class="pd-main-heading">{{ section.settings.main_title }}</h2>
      <hr class="pd-divider">
    {% endif %}

    <!-- Product Specs Section -->
    {% if section.settings.specs_title != blank %}
      <h3 class="pd-subheading">{{ section.settings.specs_title }}</h3>
    {% endif %}

    <div class="pd-specs-card">
      <div class="pd-specs-image-wrapper">
        {% if section.settings.specs_image != blank %}
          <img src="{{ section.settings.specs_image | image_url: width: 800 }}" alt="{{ section.settings.specs_title }}" loading="lazy">
        {% else %}
          {{ 'product-1' | placeholder_svg_tag }}
        {% endif %}
      </div>

      <div class="pd-specs-grid">
        {% for block in section.blocks %}
          {% if block.type == 'spec_item' %}
            <div class="pd-spec-item" {{ block.shopify_attributes }}>
              <h4 class="pd-spec-item-title">{{ block.settings.title }}</h4>
              <p class="pd-spec-item-desc">{{ block.settings.description }}</p>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>

    <!-- What's Included Section -->
    {% if section.settings.included_title != blank %}
      <h3 class="pd-subheading">{{ section.settings.included_title }}</h3>
    {% endif %}

    <div class="pd-included-grid">
      {% for block in section.blocks %}
        {% if block.type == 'included_item' %}
          <div class="pd-included-card" {{ block.shopify_attributes }}>
            <div class="pd-included-icon">
              {% if block.settings.icon != blank %}
                <img src="{{ block.settings.icon | image_url: width: 100 }}" alt="{{ block.settings.title }}" loading="lazy">
              {% else %}
                {{ 'image' | placeholder_svg_tag }}
              {% endif %}
            </div>
            <div class="pd-included-content">
              <h4 class="pd-included-title">{{ block.settings.title }}</h4>
              <p class="pd-included-desc">{{ block.settings.description }}</p>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Product Details Specs",
  "settings": [
    {
      "type": "text",
      "id": "main_title",
      "label": "Main Heading",
      "default": "Product Details"
    },
    {
      "type": "header",
      "content": "Product Specs Settings"
    },
    {
      "type": "text",
      "id": "specs_title",
      "label": "Specs Subheading",
      "default": "Product Specs"
    },
    {
      "type": "image_picker",
      "id": "specs_image",
      "label": "Specs Main Image"
    },
    {
      "type": "color",
      "id": "specs_bg_color",
      "label": "Specs Box Background",
      "default": "#f5f3ef"
    },
    {
      "type": "range",
      "id": "specs_padding",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Specs Card Inner Padding",
      "default": 16
    },
    {
      "type": "header",
      "content": "What's Included Settings"
    },
    {
      "type": "text",
      "id": "included_title",
      "label": "Included Subheading",
      "default": "What's Included"
    },
    {
      "type": "header",
      "content": "Section Layout Settings"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background Color",
      "default": "#eeeeee"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "spec_item",
      "name": "Spec Item",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Spec Title",
          "default": "Kiln Dried Pressure Treated Wood"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Spec Description",
          "default": "Resistant to warping, cracking, and moisture damage for a long-lasting, sturdy deck."
        }
      ]
    },
    {
      "type": "included_item",
      "name": "Included Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Item Icon/Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Item Title",
          "default": "Engineered Lumber Parts"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Item Description",
          "default": "Premium Grade 1, kiln-dried and pressure-treated for maximum strength and longevity."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Details & Specs",
      "blocks": [
        {
          "type": "spec_item",
          "settings": {
            "title": "Kiln Dried Pressure Treated Wood",
            "description": "Resistant to warping, cracking, and moisture damage."
          }
        },
        {
          "type": "spec_item",
          "settings": {
            "title": "Pre-Sealed Deck Boards",
            "description": "5.5-inch wide boards ensure a polished finish."
          }
        },
        {
          "type": "spec_item",
          "settings": {
            "title": "6 x 6 Beams",
            "description": "Heavy-duty beams provide superior strength."
          }
        },
        {
          "type": "spec_item",
          "settings": {
            "title": "2 x 8 Joists",
            "description": "Strategically spaced 13 to 14 inches on center."
          }
        },
        {
          "type": "included_item",
          "settings": {
            "title": "Engineered Lumber Parts",
            "description": "Premium Grade 1, kiln-dried."
          }
        },
        {
          "type": "included_item",
          "settings": {
            "title": "Screw & Metal Brackets",
            "description": "Galvanized ports for superior durability."
          }
        },
        {
          "type": "included_item",
          "settings": {
            "title": "Tuff Blocks",
            "description": "Lightweight and easy-to-install deck foundation."
          }
        },
        {
          "type": "included_item",
          "settings": {
            "title": "3D Instructional App",
            "description": "Assemble with confidence using our 3D app."
          }
        }
      ]
    }
  ]
}
{% endschema %}