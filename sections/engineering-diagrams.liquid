{%- style -%}
  .eng-diagrams-{{ section.id }} {
    background-color: {{ section.settings.section_bg }};
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }

  @media screen and (min-width: 750px) {
    .eng-diagrams-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_desktop }}px;
      padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
    }
  }

  .eng-diagrams-heading-{{ section.id }} {
    text-align: center;
    font-size: 1.75rem;
    font-weight: 600;
    color: #000;
    line-height: 1.25;
    margin: 0 0 2.5rem 0;
  }

  @media screen and (min-width: 750px) {
    .eng-diagrams-heading-{{ section.id }} {
      font-size: 36px;
      margin-bottom: 3.5rem;
    }
  }

  .eng-diagrams-grid-{{ section.id }} {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  @media screen and (min-width: 990px) {
    .eng-diagrams-grid-{{ section.id }} {
      display: grid;
      grid-template-columns: 0.9fr 1.1fr;
      gap: 56px;
      align-items: center;
    }
  }

  /* Left Image Styling */
  .eng-diagrams-image-wrapper-{{ section.id }} {
    width: 100%;
    position: relative;
    border-radius: 12px;
    overflow: hidden;
  }

  .eng-diagrams-image-{{ section.id }} {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }

  /* Right Content Styling */
  .eng-diagrams-subtitle-{{ section.id }} {
    font-size: 18px;
    font-weight: 500;
    color: #000;
    margin: 0 0 1rem 0;
  }

  .eng-diagrams-list-{{ section.id }} {
    list-style: none;
    padding: 0;
    margin: 0 0 1.75rem 0;
  }

  .eng-diagrams-list-item-{{ section.id }} {
    position: relative;
    padding-left: 14px;
    font-size: 16px;
    line-height: 1.6;
    color: #000;
    margin-bottom: 6px;
  }

  .eng-diagrams-list-item-{{ section.id }}::before {
    content: "•";
    position: absolute;
    left: 0;
    top: 0;
    color: #555555;
  }

  .eng-diagrams-body-{{ section.id }} {
    font-size: 13px;
    line-height: 1.65;
    color: #444444;
  }

  .eng-diagrams-body-{{ section.id }} p {
    margin: 0 0 1.25rem 0;
    font-size: 16px;
  }

  .eng-diagrams-body-{{ section.id }} p:last-child {
    margin-bottom: 0;
  }
{%- endstyle -%}

<div class="eng-diagrams-{{ section.id }}">
  <div class="page-width">
    
    {%- if section.settings.heading != blank -%}
      <h2 class="eng-diagrams-heading-{{ section.id }}">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <div class="eng-diagrams-grid-{{ section.id }}">
      
      {%- comment -%} Left Image {%- endcomment -%}
      <div class="eng-diagrams-media-{{ section.id }}">
        {%- if section.settings.image != blank -%}
          <div class="eng-diagrams-image-wrapper-{{ section.id }}">
            {%- assign image_class = 'eng-diagrams-image-' | append: section.id -%}
            {%- assign alt_text = section.settings.heading | default: 'Engineering diagrams' | escape -%}
            {{ section.settings.image 
              | image_url: width: 1000 
              | image_tag: loading: 'lazy', class: image_class, alt: alt_text 
            }}
          </div>
        {%- endif -%}
      </div>

      {%- comment -%} Right Content {%- endcomment -%}
      <div class="eng-diagrams-content-{{ section.id }}">
        {%- if section.settings.list_heading != blank -%}
          <h3 class="eng-diagrams-subtitle-{{ section.id }}">{{ section.settings.list_heading }}</h3>
        {%- endif -%}

        {%- assign items = section.settings.list_items | newline_to_br | split: '<br />' -%}
        {%- if items.size > 0 -%}
          <ul class="eng-diagrams-list-{{ section.id }}">
            {%- for item in items -%}
              {%- assign clean_item = item | strip -%}
              {%- if clean_item != blank -%}
                <li class="eng-diagrams-list-item-{{ section.id }}">{{ clean_item }}</li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- if section.settings.body_text != blank -%}
          <div class="eng-diagrams-body-{{ section.id }}">
            {{ section.settings.body_text }}
          </div>
        {%- endif -%}
      </div>

    </div>
  </div>
</div>

{% schema %}
{
  "name": "Engineering Diagrams",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Main Heading",
      "default": "What Do A-DIY Engineering Diagrams Show?"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Section Image"
    },
    {
      "type": "text",
      "id": "list_heading",
      "label": "List Title",
      "default": "Diagrams for an applicable A-DIY configuration may show:"
    },
    {
      "type": "textarea",
      "id": "list_items",
      "label": "List Items (One per line)",
      "default": "Overall dimensions and structural layout\nBeam and joist locations\nPost locations\nLumber dimensions\nMajor connections\nAssembly configuration"
    },
    {
      "type": "richtext",
      "id": "body_text",
      "label": "Paragraph Text",
      "default": "<p>The building department may still request property-specific information, such as a survey, site plan, setbacks, foundation details, stairs, railings, attachment details or professionally stamped documents.</p><p>Requirements vary by municipality, and the local building department has final authority. A-DIY diagrams can support a permit application but do not guarantee approval.</p>"
    },
    {
      "type": "header",
      "content": "Section Styling"
    },
    {
      "type": "color",
      "id": "section_bg",
      "label": "Background Color",
      "default": "#f5f5f3"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Desktop Padding Top",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Desktop Padding Bottom",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Mobile Padding Top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Mobile Padding Bottom",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "Engineering Diagrams"
    }
  ]
}
{% endschema %}