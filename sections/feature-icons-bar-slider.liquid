{%- style -%}
  .feature-bar-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    width: 100%;
    overflow: hidden;
  }

  .feature-bar-{{ section.id }} .feature-bar__container {
    max-width: {{ section.settings.page_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .feature-bar-{{ section.id }} .feature-bar__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
    gap: 30px;
    align-items: center;
  }

  .feature-bar-{{ section.id }} .feature-block {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 15px;
    white-space: nowrap;
  }

  .feature-bar-{{ section.id }} .feature-block__icon-wrapper {
    flex-shrink: 0;
    width: {{ section.settings.icon_width }}px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .feature-bar-{{ section.id }} .feature-block__icon {
    width: 100%;
    height: auto;
    object-fit: contain;
  }

  .feature-bar-{{ section.id }} .feature-block__content {
    display: flex;
    flex-direction: column;
  }

  .feature-bar-{{ section.id }} .feature-block__title {
    font-size: {{ section.settings.title_font_size }}px;
    font-weight: 400;
    color: {{ section.settings.title_color }};
    margin: 0 0 2px 0;
    line-height: 1.2;
  }

  .feature-bar-{{ section.id }} .feature-block__subtitle {
    font-size: {{ section.settings.subtitle_font_size }}px;
    font-weight: 400;
    color: {{ section.settings.subtitle_color }};
    margin: 0;
    line-height: 1.3;
  }

  /* Dots Styling */
  .feature-bar-{{ section.id }} .slider-dots {
    display: none;
  }

  /* Responsive & Desktop tweaks */
  @media screen and (max-width: 1100px) {
    .feature-bar-{{ section.id }} .feature-bar__grid {
      gap: 20px;
    }
    .feature-bar-{{ section.id }} .feature-block__title {
      font-size: 13px;
    }
    .feature-bar-{{ section.id }} .feature-block__subtitle {
      font-size: 11px;
    }
  }

  /* MOBILE SINGLE ITEM SLIDER WITH DOTS */
  {%- if section.settings.enable_mobile_slider -%}
    @media screen and (max-width: 950px) {
      .feature-bar-{{ section.id }} .feature-bar__container {
        padding: 0 15px;
      }

      .feature-bar-{{ section.id }} .feature-bar__grid {
        display: flex;
        overflow-x: auto;
        scroll-snap-type: x mandatory;
        scroll-behavior: smooth;
        -webkit-overflow-scrolling: touch;
        gap: 0;
        padding-bottom: 5px;
        scrollbar-width: none;
        -ms-overflow-style: none;
      }

      .feature-bar-{{ section.id }} .feature-bar__grid::-webkit-scrollbar {
        display: none;
      }

      .feature-bar-{{ section.id }} .feature-block {
        flex: 0 0 100%; /* Ek waqt me sirf 1 block 100% width le ga */
        width: 100%;
        scroll-snap-align: center;
        scroll-snap-stop: always;
        box-sizing: border-box;
      }

      /* Dots Display on Mobile */
      .feature-bar-{{ section.id }} .slider-dots {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 8px;
        margin-top: 15px;
      }

      .feature-bar-{{ section.id }} .dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background-color: {{ section.settings.title_color }};
        opacity: 0.25;
        border: none;
        padding: 0;
        cursor: pointer;
        transition: all 0.3s ease;
      }

      .feature-bar-{{ section.id }} .dot.active {
        opacity: 1;
        width: 20px; /* Active dot pill style ban jayega */
        border-radius: 10px;
      }
      .section-feature-icons-bar .feature-bar__container .slider-dots{
        display:none;
      }
    }
  {%- else -%}
    @media screen and (max-width: 989px) {
      .feature-bar-{{ section.id }} .feature-bar__grid {
        grid-template-columns: repeat(2, 1fr);
        gap: 24px;
      }
    }
    @media screen and (max-width: 575px) {
      .feature-bar-{{ section.id }} .feature-bar__grid {
        grid-template-columns: {{ section.settings.mobile_layout }};
        gap: 20px;
      }
    }
  {%- endif -%}
  @media screen and (max-width: 768px){
    .feature-bar-{{ section.id }}{
      padding-top: 20px;
      padding-bottom: 20px;
    }
  }
{%- endstyle -%}

<div class="feature-bar-{{ section.id }}">
  <div class="feature-bar__container">
    <div class="feature-bar__grid js-slider-grid-{{ section.id }}">
      {%- for block in section.blocks -%}
        <div class="feature-block" data-index="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
          {%- if block.settings.icon_image != blank -%}
            <div class="feature-block__icon-wrapper">
              <img
                src="{{ block.settings.icon_image | image_url: width: 200 }}"
                alt="{{ block.settings.title | escape }}"
                loading="lazy"
                width="{{ block.settings.icon_image.width }}"
                height="{{ block.settings.icon_image.height }}"
                class="feature-block__icon"
              >
            </div>
          {%- endif -%}

          <div class="feature-block__content">
            {%- if block.settings.title != blank -%}
              <h3 class="feature-block__title">{{ block.settings.title }}</h3>
            {%- endif -%}

            {%- if block.settings.subtitle != blank -%}
              <p class="feature-block__subtitle">{{ block.settings.subtitle }}</p>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>

    {%- if section.settings.enable_mobile_slider and section.blocks.size > 1 -%}
      <div class="slider-dots js-slider-dots-{{ section.id }}">
        {%- for block in section.blocks -%}
          <button 
            type="button" 
            class="dot{% if forloop.first %} active{% endif %}" 
            data-slide="{{ forloop.index0 }}" 
            aria-label="Go to slide {{ forloop.index }}"
          ></button>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{%- if section.settings.enable_mobile_slider -%}
<script>
  document.addEventListener('DOMContentLoaded', function() {
    const grid = document.querySelector('.js-slider-grid-{{ section.id }}');
    const dotsContainer = document.querySelector('.js-slider-dots-{{ section.id }}');
    if (!grid) return;

    const dots = dotsContainer ? dotsContainer.querySelectorAll('.dot') : [];
    const items = grid.querySelectorAll('.feature-block');

    let autoSlideTimer = null;
    let isInteracting = false;
    let autoSlideInterval = {{ section.settings.slider_delay | default: 3 }} * 1000;

    function updateDots(activeIndex) {
      dots.forEach((dot, index) => {
        if (index === activeIndex) {
          dot.classList.add('active');
        } else {
          dot.classList.remove('active');
        }
      });
    }

    function slideTo(index) {
      if (items[index]) {
        const itemWidth = items[0].offsetWidth;
        grid.scrollTo({ left: itemWidth * index, behavior: 'smooth' });
        updateDots(index);
      }
    }

    function slideNext() {
      if (window.innerWidth > 950 || isInteracting) return;
      
      const itemWidth = items[0].offsetWidth;
      const currentIndex = Math.round(grid.scrollLeft / itemWidth);
      let nextIndex = currentIndex + 1;

      if (nextIndex >= items.length) {
        nextIndex = 0;
      }

      slideTo(nextIndex);
    }

    // Scroll Observer: Jab user haath se swipe karega to active dot change hoga
    grid.addEventListener('scroll', function() {
      if (items.length > 0) {
        const itemWidth = items[0].offsetWidth;
        const activeIndex = Math.round(grid.scrollLeft / itemWidth);
        updateDots(activeIndex);
      }
    });

    // Dots Click Functionality
    dots.forEach((dot) => {
      dot.addEventListener('click', function() {
        const slideIndex = parseInt(this.getAttribute('data-slide'));
        isInteracting = true;
        slideTo(slideIndex);
        setTimeout(() => { isInteracting = false; }, 1000);
      });
    });

    function startTimer() {
      stopTimer();
      autoSlideTimer = setInterval(slideNext, autoSlideInterval);
    }

    function stopTimer() {
      if (autoSlideTimer) clearInterval(autoSlideTimer);
    }

    // Touch interaction to pause timer
    grid.addEventListener('touchstart', () => {
      isInteracting = true;
      stopTimer();
    }, { passive: true });

    grid.addEventListener('touchend', () => {
      isInteracting = false;
      startTimer();
    }, { passive: true });

    startTimer();
  });
</script>
{%- endif -%}

{% schema %}
{
  "name": "Feature Icons Bar Slider",
  "tag": "section",
  "class": "section-feature-icons-bar",
  "settings": [
    {
      "type": "header",
      "content": "Layout Settings"
    },
    {
      "type": "range",
      "id": "page_width",
      "min": 1000,
      "max": 1600,
      "step": 50,
      "unit": "px",
      "label": "Max Container Width",
      "default": 1400
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "label": "Desktop Columns per Row",
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "enable_mobile_slider",
      "label": "Enable Mobile Auto-Slider",
      "default": true,
      "info": "Mobile par step-by-step slider chalega dots ke saath."
    },
    {
      "type": "range",
      "id": "slider_delay",
      "min": 2,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "Auto-Slide Delay",
      "default": 3,
      "info": "Kinki der baad me agli slide par shift hoga."
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "Mobile Grid Layout (If Slider Disabled)",
      "options": [
        {
          "value": "1fr",
          "label": "1 Column"
        },
        {
          "value": "repeat(2, 1fr)",
          "label": "2 Columns"
        }
      ],
      "default": "1fr"
    },
    {
      "type": "range",
      "id": "icon_width",
      "min": 20,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Icon Image Width",
      "default": 40
    },
    {
      "type": "header",
      "content": "Style & Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "subtitle_color",
      "label": "Subtitle Color",
      "default": "#666666"
    },
    {
      "type": "header",
      "content": "Typography Sizes"
    },
    {
      "type": "range",
      "id": "title_font_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Title Font Size",
      "default": 14
    },
    {
      "type": "range",
      "id": "subtitle_font_size",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Subtitle Font Size",
      "default": 12
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 25
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 25
    }
  ],
  "blocks": [
    {
      "type": "feature_item",
      "name": "Feature Block",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon_image",
          "label": "Icon Image (PNG/SVG)"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "1,746+ Reviews"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle / Content",
          "default": "Sold in America"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Feature Icons Bar Slider",
      "blocks": [
        {
          "type": "feature_item",
          "settings": {
            "title": "1,746+ Reviews",
            "subtitle": "Sold in America"
          }
        },
        {
          "type": "feature_item",
          "settings": {
            "title": "Made in USA",
            "subtitle": "100% made in America"
          }
        },
        {
          "type": "feature_item",
          "settings": {
            "title": "A-DIY Patented Deck System",
            "subtitle": "Not made engineered DIY"
          }
        },
        {
          "type": "feature_item",
          "settings": {
            "title": "5 Years Structural warranty",
            "subtitle": "25 Years Composite warranty"
          }
        }
      ]
    }
  ]
}
{% endschema %}