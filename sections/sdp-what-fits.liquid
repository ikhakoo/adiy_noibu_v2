{{ 'sdp.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  Size deck page · "What fits" use cases: section header, one image card per `use`
  block, and an optional customer quote block underneath.
{%- endcomment -%}

<div class="sdp sdp-fits sdp--white"{% if section.settings.anchor_id != blank %} id="{{ section.settings.anchor_id | handle }}"{% endif %}>
  <div class="sdp__inner sdp-fits__inner">
    <div class="sdp-header">
      {%- if section.settings.eyebrow != blank -%}
        <p class="sdp-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="sdp-h2">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.intro != blank -%}
        <p class="sdp-intro">{{ section.settings.intro | escape }}</p>
      {%- endif -%}
    </div>

    {%- assign uses = section.blocks | where: 'type', 'use' -%}
    {%- if uses.size > 0 -%}
      <div class="sdp-fits__grid">
        {%- for block in uses -%}
          <article class="sdp-use" {{ block.shopify_attributes }}>
            {%- assign use_alt = block.settings.image_alt | default: block.settings.title -%}
            {%- render 'sdp-image',
              image: block.settings.image,
              class: 'sdp-use__media',
              sizes: '(min-width: 990px) 406px, calc(100vw - 48px)',
              focal: block.settings.image_focal,
              alt: use_alt
            -%}
            <h3 class="sdp-use__title">{{ block.settings.title | escape }}</h3>
            <p class="sdp-use__text">{{ block.settings.text | escape }}</p>
          </article>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- for block in section.blocks -%}
      {%- if block.type == 'quote' -%}
        {%- comment -%}
          Rendered as a review card (name, stars, source mark, verified label) so it reads
          as the real review it is, matching the cards in the reviews wall.
        {%- endcomment -%}
        <figure class="sdp-review{% if block.settings.photo != blank %} sdp-review--with-photo{% endif %}" {{ block.shopify_attributes }}>
          {%- if block.settings.photo != blank -%}
            {%- assign review_alt = block.settings.photo_alt | default: block.settings.name -%}
            {%- render 'sdp-image', image: block.settings.photo, class: 'sdp-review__photo', sizes: '(min-width: 990px) 320px, calc(100vw - 48px)', focal: block.settings.photo_focal, alt: review_alt -%}
          {%- endif -%}
          <div class="sdp-review__body">
            <div class="sdp-review__head">
              <div class="sdp-review__who">
                {%- if block.settings.name != blank -%}
                  <span class="sdp-review__name">{{ block.settings.name | escape }}</span>
                {%- endif -%}
                {%- if block.settings.role != blank -%}
                  <span class="sdp-review__role">{{ block.settings.role | escape }}</span>
                {%- endif -%}
              </div>
              {%- case block.settings.source -%}
                {%- when 'google' -%}
                  <img class="sdp-review__source" src="https://cdn.shopify.com/s/files/1/0456/9638/5046/files/image_8602.png?v=1787786455&width=40" alt="Google review" width="20" height="20" loading="lazy">
                {%- when 'trustpilot' -%}
                  <img class="sdp-review__source sdp-review__source--wide" src="https://cdn.shopify.com/s/files/1/0456/9638/5046/files/image_4.png?v=1787847498&width=140" alt="Trustpilot review" width="70" height="20" loading="lazy">
                {%- when 'facebook' -%}
                  <svg class="sdp-review__source" viewBox="0 0 24 24" aria-label="Facebook review" role="img"><path fill="#1877f2" d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
              {%- endcase -%}
            </div>
            {%- if block.settings.stars > 0 -%}
              <div class="sdp-review__stars" aria-label="{{ block.settings.stars }} out of 5 stars">
                {%- for i in (1..block.settings.stars) -%}★{%- endfor -%}
              </div>
            {%- endif -%}
            {%- if block.settings.headline != blank -%}
              <p class="sdp-review__headline">{{ block.settings.headline | escape }}</p>
            {%- endif -%}
            <blockquote class="sdp-review__text">{{ block.settings.quote | escape }}</blockquote>
            {%- if block.settings.cite != blank -%}
              <figcaption class="sdp-review__cite sdp-label">{{ block.settings.cite | escape }}</figcaption>
            {%- endif -%}
          </div>
        </figure>
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "SDP · What fits",
  "tag": "section",
  "class": "section",
  "enabled_on": { "templates": ["product", "collection", "page"] },
  "settings": [
    { "type": "text", "id": "anchor_id", "label": "Anchor ID" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Space planning" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What fits on a 12x12 deck?" },
    { "type": "textarea", "id": "intro", "label": "Intro", "default": "144 square feet is the sweet spot for a backyard that works hard without taking over the lawn. Here is what A-DIY customers actually put on theirs." }
  ],
  "blocks": [
    {
      "type": "use",
      "name": "Use case",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "image_focal", "label": "Image focal point (CSS object-position)", "default": "50% 50%" },
        { "type": "text", "id": "image_alt", "label": "Image alt text (SEO)", "info": "Defaults to the title." },
        { "type": "text", "id": "title", "label": "Title", "default": "Outdoor lounge" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "A sofa set or four Adirondack chairs with side tables, with a fire pit in the middle and room to walk around it." }
      ]
    },
    {
      "type": "quote",
      "name": "Customer review",
      "limit": 1,
      "settings": [
        { "type": "paragraph", "content": "Use a real review from the reviews page, word for word." },
        { "type": "text", "id": "name", "label": "Reviewer name", "default": "Sandra" },
        { "type": "text", "id": "role", "label": "Label under the name", "default": "Verified Buyer" },
        { "type": "select", "id": "source", "label": "Source", "options": [ { "value": "trustpilot", "label": "Trustpilot" }, { "value": "google", "label": "Google" }, { "value": "facebook", "label": "Facebook" }, { "value": "none", "label": "None" } ], "default": "trustpilot" },
        { "type": "range", "id": "stars", "label": "Stars", "min": 0, "max": 5, "step": 1, "default": 5 },
        { "type": "text", "id": "headline", "label": "Review headline (optional)" },
        { "type": "textarea", "id": "quote", "label": "Review text", "default": "12' x 12' is large enough for 4 Adirondack chairs, 2 footstools, 2 small tables and a small square firepit." },
        { "type": "text", "id": "cite", "label": "Caption", "default": "Trustpilot review · 12×12 deck" },
        { "type": "image_picker", "id": "photo", "label": "Customer photo (optional)" },
        { "type": "text", "id": "photo_focal", "label": "Photo focal point (CSS object-position)", "default": "50% 50%" },
        { "type": "text", "id": "photo_alt", "label": "Photo alt text" }
      ]
    }
  ],
  "presets": [
    {
      "name": "SDP · What fits",
      "blocks": [
        { "type": "use", "settings": { "title": "Outdoor lounge", "text": "A sofa set or four Adirondack chairs with side tables, with a fire pit in the middle and room to walk around it." } },
        { "type": "use", "settings": { "title": "Bistro dining & family time", "text": "A table for four to six, a grill at the edge and still enough floor for the kids to move." } },
        { "type": "use", "settings": { "title": "Sauna or hot tub platform", "text": "Engineered to hold 15,000 lbs, so a barrel sauna, hot tub or pergola sits on it with confidence." } },
        { "type": "quote" }
      ]
    }
  ]
}
{% endschema %}
