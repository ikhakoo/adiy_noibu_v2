<script>
  document.addEventListener('DOMContentLoaded', function() {
    const menuItems = document.querySelectorAll('.hanso-menu-wrapper[data-menu-handle]');
    const popups = document.querySelectorAll('.hanso-mega-menu-popup[data-menu-popup]');
    let timer;

    menuItems.forEach(item => {
      const handle = item.getAttribute('data-menu-handle');
      const targetPopup = document.getElementById('hanso-mega-menu-' + handle);

      if (targetPopup) {
        item.addEventListener('mouseenter', () => {
          clearTimeout(timer);
          popups.forEach(p => p.classList.remove('open'));
          targetPopup.classList.add('open');
        });

        item.addEventListener('mouseleave', () => {
          timer = setTimeout(() => {
            if (!targetPopup.matches(':hover')) {
              targetPopup.classList.remove('open');
            }
          }, 150);
        });

        targetPopup.addEventListener('mouseleave', () => {
          targetPopup.classList.remove('open');
        });

        targetPopup.addEventListener('mouseenter', () => {
          clearTimeout(timer);
        });
      }
    });
  });

  // Hover/Active Class management in your JS snippet:
  item.addEventListener('mouseenter', () => {
    clearTimeout(timer);
    menuItems.forEach(i => i.classList.remove('is-active'));
    popups.forEach(p => p.classList.remove('open'));
    
    item.classList.add('is-active');
    targetPopup.classList.add('open');
  });

  item.addEventListener('mouseleave', () => {
    timer = setTimeout(() => {
      if (!targetPopup.matches(':hover')) {
        item.classList.remove('is-active');
        targetPopup.classList.remove('open');
      }
    }, 150);
  });

  targetPopup.addEventListener('mouseleave', () => {
    item.classList.remove('is-active');
    targetPopup.classList.remove('open');
  });
</script>


