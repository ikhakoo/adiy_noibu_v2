{%- style -%}
  .scrolling-marquee-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    overflow: hidden;
    white-space: nowrap;
    display: flex;
    user-select: none;
    width: 100%;
  }

  .scrolling-marquee__wrapper-{{ section.id }} {
    display: flex;
    width: max-content;
    animation: marquee-scroll-{{ section.id }} {{ section.settings.speed }}s linear infinite;
  }

  {% if section.settings.pause_on_hover %}
    .scrolling-marquee-{{ section.id }}:hover .scrolling-marquee__wrapper-{{ section.id }} {
      animation-play-state: paused;
    }
  {% endif %}

  .scrolling-marquee__track {
    display: flex;
    align-items: center;
    gap: {{ section.settings.item_gap }}px;
    padding-right: {{ section.settings.item_gap }}px;
    flex-shrink: 0;
  }

  .scrolling-marquee__item {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-size: {{ section.settings.font_size }}px;
    font-weight: {{ section.settings.font_weight }};
    letter-spacing: 0.05em;
    text-transform: uppercase;
    flex-shrink: 0;
  }

  .scrolling-marquee__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .scrolling-marquee__icon img {
    width: {{ section.settings.icon_size }}px;
    height: {{ section.settings.icon_size }}px;
    object-fit: contain;
  }

  .scrolling-marquee__icon svg {
    width: {{ section.settings.icon_size }}px;
    height: {{ section.settings.icon_size }}px;
    fill: currentColor;
  }

  @keyframes marquee-scroll-{{ section.id }} {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

@media screen and (max-width: 749px) {

  /* This section had no mobile handling at all: identical type, icon and gap
     sizes at 1920px and 390px. Used by every landing page. */
  .scrolling-marquee__item {
    font-size: 13px;
    gap: 8px;
  }
  .scrolling-marquee__track {
    gap: 28px;
    padding-right: 28px;
  }
  .scrolling-marquee__icon img,
  .scrolling-marquee__icon svg {
    width: 20px;
    height: 20px;
  }
}
{%- endstyle -%}

<div class="scrolling-marquee-{{ section.id }}">
  <div class="scrolling-marquee__wrapper-{{ section.id }}">
    {%- comment -%} Smooth continuous infinite loop k liye 2 identical tracks {%- endcomment -%}
    {% for i in (1..2) %}
      <div class="scrolling-marquee__track" {% if i == 2 %}aria-hidden="true"{% endif %}>
        {% for block in section.blocks %}
          <div class="scrolling-marquee__item" {{ block.shopify_attributes }}>
            {% if block.settings.image_icon != blank %}
              <div class="scrolling-marquee__icon">
                {{ block.settings.image_icon | image_url: width: 100 | image_tag: loading: 'lazy' }}
              </div>
            {% elsif block.settings.custom_svg != blank %}
              <div class="scrolling-marquee__icon">
                {{ block.settings.custom_svg }}
              </div>
            {% endif %}

            {% if block.settings.text != blank %}
              <span class="scrolling-marquee__text">{{ block.settings.text }}</span>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Icon Scrolling Marquee",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Colors & Layout"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#f4f3ef"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text & Icon Color",
      "default": "#4a554a"
    },
    {
      "type": "range",
      "id": "speed",
      "min": 5,
      "max": 60,
      "step": 1,
      "unit": "s",
      "label": "Scrolling Speed",
      "default": 20
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pause on Hover",
      "default": true
    },
    {
      "type": "range",
      "id": "item_gap",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Gap Between Items",
      "default": 50
    },
    {
      "type": "header",
      "content": "Typography & Icon Settings"
    },
    {
      "type": "range",
      "id": "font_size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Text Size",
      "default": 14
    },
    {
      "type": "select",
      "id": "font_weight",
      "label": "Font Weight",
      "options": [
        { "value": "400", "label": "Normal" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semi Bold" },
        { "value": "700", "label": "Bold" }
      ],
      "default": "600"
    },
    {
      "type": "range",
      "id": "icon_size",
      "min": 14,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Icon Size",
      "default": 20
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Top Padding",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 16
    }
  ],
  "blocks": [
    {
      "type": "marquee_item",
      "name": "Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "image_icon",
          "label": "Icon Image"
        },
        {
          "type": "html",
          "id": "custom_svg",
          "label": "Custom SVG Code",
          "info": "Used if no image icon is uploaded."
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "FEATURE TEXT HERE"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Icon Scrolling Marquee",
      "blocks": [
        {
          "type": "marquee_item",
          "settings": { "text": "Professionally Engineered System" }
        },
        {
          "type": "marquee_item",
          "settings": { "text": "Pressure-Treated and Composite Options" }
        },
        {
          "type": "marquee_item",
          "settings": { "text": "Engineering Diagrams Available" }
        },
        {
          "type": "marquee_item",
          "settings": { "text": "Five-Year Structural Warranty" }
        }
      ]
    }
  ]
}
{% endschema %}