{{ 'rv-landing.css' | asset_url | stylesheet_tag }}
<script src="{{ 'rv-landing.js' | asset_url }}" defer="defer"></script>

{%- comment -%}
  RV landing page · Customer story with build video. Figma › Section - Reviews & Build Video
  (6630:431). The video is click-to-play: a YouTube/Vimeo link becomes an embed, otherwise
  the Shopify-hosted video plays. Up to four `photo` blocks form the strip underneath.
{%- endcomment -%}

{%- liquid
  assign video_box_id = 'RvVideo-' | append: section.id
  assign embed = ''
  assign provider = ''
  if section.settings.video_url != blank
    if section.settings.video_url.type == 'youtube'
      assign provider = 'youtube'
      assign embed = 'https://www.youtube.com/embed/' | append: section.settings.video_url.id | append: '?autoplay=1&rel=0&playsinline=1&modestbranding=1'
    elsif section.settings.video_url.type == 'vimeo'
      assign provider = 'vimeo'
      assign embed = 'https://player.vimeo.com/video/' | append: section.settings.video_url.id | append: '?autoplay=1'
    endif
  endif
  assign poster = section.settings.poster
  if poster == blank and section.settings.video != blank
    assign poster = section.settings.video.preview_image
  endif
  assign has_video = false
  if embed != blank or section.settings.video != blank
    assign has_video = true
  endif
-%}

<div class="rv rv--mist rv-story"{% if section.settings.anchor_id != blank %} id="{{ section.settings.anchor_id | handle }}"{% endif %}>
  <div class="rv__inner rv-story__inner">
    <div class="rv-story__head">
      {%- if section.settings.heading != blank -%}
        <h2 class="rv-h2">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.intro != blank -%}
        <p class="rv-body">{{ section.settings.intro | escape }}</p>
      {%- endif -%}
    </div>

    <div class="rv-story__card">
      <div
        class="rv-video"
        id="{{ video_box_id }}"
        {% if embed != blank %}data-embed="{{ embed }}" data-provider="{{ provider }}"{% endif %}
        data-title="{{ section.settings.video_title | escape }}"
      >
        {%- if has_video -%}
          <button type="button" class="rv-video__play" aria-label="Play video: {{ section.settings.video_title | escape }}">
        {%- else -%}
          <div class="rv-video__play" aria-hidden="true">
        {%- endif -%}
          {%- if poster != blank -%}
            {{ poster | image_url: width: 1400 | image_tag: widths: '480, 720, 1000, 1400', sizes: '(min-width: 990px) 700px, calc(100vw - 72px)', loading: 'lazy', alt: '' }}
          {%- else -%}
            {{ 'image' | placeholder_svg_tag }}
          {%- endif -%}
          {%- if has_video -%}
            <span class="rv-video__icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 4.5v15l12.5-7.5z"/></svg></span>
            <span class="rv-video__spinner" aria-hidden="true"></span>
          </button>
        {%- else -%}
          </div>
        {%- endif -%}
        {%- if embed == blank and section.settings.video != blank -%}
          <template>
            {{ section.settings.video | video_tag: controls: true, playsinline: true, preload: 'metadata', image_size: '1400x' }}
          </template>
        {%- endif -%}
      </div>

      <div class="rv-story__copy">
        {%- if section.settings.eyebrow != blank -%}
          <p class="rv-eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.card_heading != blank -%}
          <h3 class="rv-story__title">{{ section.settings.card_heading | escape }}</h3>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="rv-body">{{ section.settings.text }}</div>
        {%- endif -%}
        <div class="rv-btns">
          {%- liquid
            assign watch_link = section.settings.watch_link
            if watch_link == blank and section.settings.video_url != blank
              assign watch_link = section.settings.video_url
            endif
          -%}
          {%- if section.settings.watch_label != blank -%}
            {%- if watch_link != blank -%}
              <a class="rv-btn" href="{{ watch_link }}" target="_blank" rel="noopener">
                {{- section.settings.watch_label | escape -}}
                <span class="visually-hidden"> (opens YouTube in a new tab)</span>
              </a>
            {%- elsif has_video -%}
              <button type="button" class="rv-btn" data-rv-play="{{ video_box_id }}">{{ section.settings.watch_label | escape }}</button>
            {%- endif -%}
          {%- endif -%}
          {%- render 'rv-button', label: section.settings.reviews_label, link: section.settings.reviews_link, style: 'outline' -%}
        </div>
      </div>
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="rv-story__photos">
        {%- for block in section.blocks -%}
          {%- render 'rv-image', image: block.settings.image, alt: block.settings.alt, sizes: '(min-width: 1920px) 345px, (min-width: 990px) calc((100vw - 140px) / 4), calc((100vw - 52px) / 2)', attrs: block.shopify_attributes -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{%- if section.settings.video_url != blank or section.settings.video != blank -%}
  {%- assign ld_thumb = poster | image_url: width: 1280 -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "VideoObject",
      "name": {{ section.settings.video_title | default: section.settings.card_heading | json }},
      "description": {{ section.settings.intro | default: section.settings.card_heading | json }},
      {%- if poster != blank %}"thumbnailUrl": {{ ld_thumb | prepend: 'https:' | json }},{% endif %}
      {%- if section.settings.upload_date != blank %}"uploadDate": {{ section.settings.upload_date | json }},{% endif %}
      {%- if embed != blank %}"embedUrl": {{ embed | split: '?' | first | json }}{% else %}"contentUrl": {{ section.settings.video.sources.last.url | json }}{% endif %}
    }
  </script>
{%- endif -%}

{% schema %}
{
  "name": "RV · Customer story video",
  "tag": "section",
  "class": "section",
  "enabled_on": { "templates": ["page"] },
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "anchor_id", "label": "Anchor ID" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "From RV Living to Outdoor Living." },
    { "type": "textarea", "id": "intro", "label": "Intro", "default": "The couple behind Sin City Country Homestead, transformed the space outside their RV in rural Tennessee with an A-DIY deck kit." },
    { "type": "header", "content": "Video" },
    { "type": "video_url", "id": "video_url", "accept": ["youtube", "vimeo"], "label": "YouTube or Vimeo link", "info": "Takes priority over the Shopify video." },
    { "type": "video", "id": "video", "label": "Or a Shopify-hosted video" },
    { "type": "image_picker", "id": "poster", "label": "Poster image" },
    { "type": "text", "id": "video_title", "label": "Video title (accessibility and SEO)", "default": "Sin City Country builds an A-DIY RV deck" },
    { "type": "text", "id": "upload_date", "label": "Video upload date (YYYY-MM-DD, SEO)" },
    { "type": "header", "content": "Story card" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Sin City Country on YouTube" },
    { "type": "text", "id": "card_heading", "label": "Heading", "default": "Nader & Alena's A-DIY RV Deck" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Nader and Alena decided to transform the space outside their RV with an A-DIY deck kit, creating a dedicated outdoor area to relax, gather, and enjoy life beyond the camper walls.</p><p>Their RV deck project shows how a thoughtfully designed deck can turn an ordinary RV or camper setup into a more inviting outdoor living space, without the complexity of traditional deck construction.</p>" },
    { "type": "text", "id": "watch_label", "label": "Watch button label", "default": "Watch the Build Video" },
    { "type": "url", "id": "watch_link", "label": "Watch button link", "info": "Opens in a new tab. Leave blank to use the YouTube or Vimeo link above." },
    { "type": "text", "id": "reviews_label", "label": "Second button label", "default": "Read Customer Reviews" },
    { "type": "url", "id": "reviews_link", "label": "Second button link" }
  ],
  "blocks": [
    {
      "type": "photo",
      "name": "Photo",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "alt", "label": "Alt text (SEO)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "RV · Customer story video",
      "blocks": [{ "type": "photo" }, { "type": "photo" }, { "type": "photo" }, { "type": "photo" }]
    }
  ]
}
{% endschema %}
