{{ 'state-seo.css' | asset_url | stylesheet_tag }}
{{ 'city-seo.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  City SEO landing page · What's included in every kit. Same for every city (blocks + settings).
{%- endcomment -%}

<div class="ss ss--cream cs-included" id="{{ section.settings.anchor_id | default: 'included' | handle }}">
  <div class="ss__inner">
    <div class="cs-head cs-head--center">
      <h2 class="ss-h2">{{ section.settings.heading | escape }}</h2>
      <span class="ss-bar" aria-hidden="true"></span>
      {%- if section.settings.intro != blank -%}<p class="ss-lead">{{ section.settings.intro | escape }}</p>{%- endif -%}
    </div>
    <div class="cs-included__grid">
      {%- for block in section.blocks -%}
        <div class="cs-included__item" {{ block.shopify_attributes }}>
          <span class="cs-iconbox">{% render 'city-seo-icon', name: block.settings.icon %}</span>
          <h3>{{ block.settings.title | escape }}</h3>
          <p>{{ block.settings.text | escape }}</p>
        </div>
      {%- endfor -%}
    </div>
    <div class="cs-addons">
      <div class="cs-addons__media">
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 1100 | image_tag: widths: '400, 700, 1100', sizes: '(min-width: 990px) 520px, 100vw', loading: 'lazy', alt: section.settings.image_alt }}
        {%- endif -%}
      </div>
      <div class="cs-addons__body">
        <h3 class="ss-h3">{{ section.settings.addons_heading | escape }}</h3>
        <p class="ss-body">{{ section.settings.addons_text | escape }}</p>
        <div class="ss-btns">{%- render 'state-seo-button', label: section.settings.button_label, link: section.settings.button_link, style: 'ink' -%}</div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "City SEO · What's included",
  "tag": "section",
  "class": "section",
  "enabled_on": { "templates": ["page"] },
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "anchor_id", "label": "Anchor ID", "default": "included" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What’s Included in Every A-DIY Deck Kit" },
    { "type": "textarea", "id": "intro", "label": "Intro" },
    { "type": "image_picker", "id": "image", "label": "Diagram image" },
    { "type": "text", "id": "image_alt", "label": "Diagram alt text", "default": "Exploded diagram of an A-DIY deck kit showing decking, joists, beams and footings" },
    { "type": "text", "id": "addons_heading", "label": "Add-ons heading", "default": "Make It Yours: Steps, Railings and Custom Sizes" },
    { "type": "textarea", "id": "addons_text", "label": "Add-ons text" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop Deck Kits" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "blocks": [
    { "type": "item", "name": "Item", "settings": [
      { "type": "select", "id": "icon", "label": "Icon", "default": "pin", "options": [
        { "value": "pin", "label": "Footing" }, { "value": "layers", "label": "Layers" }, { "value": "grid", "label": "Boards" },
        { "value": "bolt", "label": "Hardware" }, { "value": "tag", "label": "Label" }, { "value": "book", "label": "Instructions" },
        { "value": "file", "label": "Diagram" }, { "value": "chat", "label": "Support" }, { "value": "truck", "label": "Delivery" }, { "value": "cube", "label": "Kit" } ] },
      { "type": "text", "id": "title", "label": "Title" },
      { "type": "textarea", "id": "text", "label": "Text" }
    ] }
  ],
  "presets": [{ "name": "City SEO · What's included" }]
}
{% endschema %}
