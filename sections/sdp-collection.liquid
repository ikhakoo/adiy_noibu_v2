{{ 'sdp.css' | asset_url | stylesheet_tag }}
{{ 'sdp-collection.css' | asset_url | stylesheet_tag }}
<script src="{{ 'sdp-collection.js' | asset_url }}" defer="defer"></script>

{%- comment -%}
  Deck Kits by Size: collection header, USP strip (blocks), material tabs, sort and a
  grid of size cards (snippets/sdp-collection-card), one per deck size page. Tabs and sort run client-side
  on the rendered cards, so the page stays one crawlable list of every size.
{%- endcomment -%}
{%- liquid
  comment
    The grid lists the deck size pages: one "Deck size page" metaobject entry per size,
    in the order of the "Sizes" setting (handles such as wood-12x12). Each card links to
    that entry's page and prices from the entry's product variants.
  endcomment
  assign count_all = 0
  assign count_wood = 0
  assign count_composite = 0
  assign count_compact = 0
  assign entry_handles = section.settings.sizes | strip_newlines | remove: ' ' | split: ','
  for h in entry_handles
    assign e = shop.metaobjects.deck_size_page[h]
    if e == blank or e.page.value == blank
      continue
    endif
    assign count_all = count_all | plus: 1
    if e.material.value == 'composite'
      assign count_composite = count_composite | plus: 1
    else
      assign count_wood = count_wood | plus: 1
      assign ew = e.width.value | plus: 0
      if ew < 12
        assign count_compact = count_compact | plus: 1
      endif
    endif
  endfor
-%}
  <div
    class="sdp sdpc sdp--{{ section.settings.background }}"
    data-sdpc
    style="--sdpc-cols: {{ section.settings.columns_desktop }}; --sdpc-cols-mobile: {{ section.settings.columns_mobile }};"
  >
    <div class="sdp__inner">
      <header class="sdpc__header">
        <div class="sdpc__intro">
          {%- if section.settings.eyebrow != blank -%}
            <p class="sdp-eyebrow">{{ section.settings.eyebrow | escape }}</p>
          {%- endif -%}
          <h1 class="sdpc__title">{{ section.settings.heading | default: collection.title | escape }}</h1>
          {%- if section.settings.show_description and collection.description != blank -%}
            <div class="sdpc__desc">{{ collection.description }}</div>
          {%- endif -%}
        </div>

        {%- assign usps = section.blocks | where: 'type', 'usp' -%}
        {%- if usps.size > 0 -%}
          <ul class="sdpc__usps">
            {%- for block in usps -%}
              <li class="sdpc__usp" {{ block.shopify_attributes }}>
                <span class="sdpc__usp-icon">{%- render 'sdp-icon', name: block.settings.icon -%}</span>
                <span>
                  <strong>{{ block.settings.title | escape }}</strong>
                  {%- if block.settings.text != blank -%}<span>{{ block.settings.text | escape }}</span>{%- endif -%}
                </span>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </header>

      <div class="sdpc__toolbar">
        <div class="sdpc__tabs" role="tablist" aria-label="Filter deck kits">
          <button type="button" class="sdpc__tab is-active" role="tab" aria-selected="true" data-sdpc-filter="all">
            {{ section.settings.tab_all | escape }} <span>{{ count_all }}</span>
          </button>
          {%- if count_wood > 0 -%}
            <button type="button" class="sdpc__tab" role="tab" aria-selected="false" data-sdpc-filter="wood">
              {{ section.settings.tab_wood | escape }} <span>{{ count_wood }}</span>
            </button>
          {%- endif -%}
          {%- if count_composite > 0 -%}
            <button type="button" class="sdpc__tab" role="tab" aria-selected="false" data-sdpc-filter="composite">
              {{ section.settings.tab_composite | escape }} <span>{{ count_composite }}</span>
            </button>
          {%- endif -%}
          {%- if count_compact > 0 -%}
            <button type="button" class="sdpc__tab" role="tab" aria-selected="false" data-sdpc-filter="compact">
              {{ section.settings.tab_compact | escape }} <span>{{ count_compact }}</span>
            </button>
          {%- endif -%}
        </div>

        <label class="sdpc__sort">
          <span class="visually-hidden">Sort by</span>
          <select data-sdpc-sort>
            <option value="featured">Sort: Featured</option>
            <option value="area-asc">Size: small to large</option>
            <option value="area-desc">Size: large to small</option>
            <option value="price-asc">Price: low to high</option>
            <option value="price-desc">Price: high to low</option>
          </select>
        </label>
      </div>

      <p class="sdpc__count" aria-live="polite"><span data-sdpc-count>{{ count_all }}</span> deck kits</p>

      <div class="sdpc__grid" data-sdpc-grid>
        {%- assign card_index = 0 -%}
        {%- for h in entry_handles -%}
          {%- assign e = shop.metaobjects.deck_size_page[h] -%}
          {%- if e == blank or e.page.value == blank -%}{%- continue -%}{%- endif -%}
          {%- assign card_index = card_index | plus: 1 -%}
          {%- render 'sdp-collection-card', entry: e, promo_code: section.settings.promo_code, index: card_index, heading_tag: 'h2' -%}
        {%- endfor -%}
      </div>

      {%- if count_all == 0 -%}
        <p class="sdpc__empty">No deck kits to show yet.</p>
      {%- endif -%}
    </div>
  </div>

{%- comment -%} ItemList structured data for the size grid {%- endcomment -%}
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    "name": {{ collection.title | json }},
    "itemListElement": [
      {%- assign ld_i = 0 -%}
      {%- for h in entry_handles -%}
        {%- assign e = shop.metaobjects.deck_size_page[h] -%}
        {%- if e == blank or e.page.value == blank -%}{%- continue -%}{%- endif -%}
        {%- assign ld_i = ld_i | plus: 1 -%}
        {%- if ld_i > 1 -%},{%- endif -%}
        {
          "@type": "ListItem",
          "position": {{ ld_i }},
          "url": {{ shop.url | append: e.page.value.url | json }},
          "name": {{ e.page.value.title | json }}
        }
      {%- endfor -%}
    ]
  }
</script>

{% schema %}
{
  "name": "SDP · Deck kits grid",
  "tag": "section",
  "class": "section",
  "enabled_on": { "templates": ["collection"] },
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Shop by size" },
    { "type": "text", "id": "heading", "label": "Heading (H1)", "info": "Leave blank to use the collection title." },
    { "type": "textarea", "id": "sizes", "label": "Sizes", "info": "Comma-separated Deck size page handles (Content > Metaobjects > Deck size page), in display order.", "default": "wood-12x12,wood-12x18,wood-12x20,wood-12x24,wood-12x28,wood-16x16,wood-16x20,wood-16x24,wood-16x28,composite-12x12,composite-12x16,composite-12x20,composite-12x24,composite-12x28,composite-16x16,composite-16x20,composite-16x24,composite-16x28,wood-6x12,wood-6x16,wood-6x20,wood-8x12,wood-8x16,wood-8x20" },
    { "type": "checkbox", "id": "show_description", "label": "Show collection description", "default": true },
    { "type": "text", "id": "promo_code", "label": "Promo code shown with sale prices", "info": "Sale price = price minus each variant's custom.discount_value. Leave blank to show regular prices only.", "default": "FALL1500" },
    { "type": "header", "content": "Tabs" },
    { "type": "text", "id": "tab_all", "label": "All", "default": "All sizes" },
    { "type": "text", "id": "tab_wood", "label": "Wood", "default": "Pressure-treated wood" },
    { "type": "text", "id": "tab_composite", "label": "Composite", "default": "Composite" },
    { "type": "text", "id": "tab_compact", "label": "Compact", "default": "Compact series" },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "columns_desktop", "label": "Cards per row (desktop)", "min": 2, "max": 5, "step": 1, "default": 4 },
    { "type": "select", "id": "columns_mobile", "label": "Cards per row (mobile)", "options": [ { "value": "1", "label": "1" }, { "value": "2", "label": "2" } ], "default": "1" },
    { "type": "select", "id": "background", "label": "Background", "options": [ { "value": "sand", "label": "Sand" }, { "value": "white", "label": "White" }, { "value": "cloud", "label": "Cloud" } ], "default": "sand" }
  ],
  "blocks": [
    {
      "type": "usp",
      "name": "Benefit",
      "limit": 4,
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "options": [ { "value": "truck", "label": "Truck" }, { "value": "drill", "label": "Drill" }, { "value": "shield", "label": "Shield" }, { "value": "chat", "label": "Chat" }, { "value": "phone", "label": "Phone" }, { "value": "cart", "label": "Cart" } ], "default": "truck" },
        { "type": "text", "id": "title", "label": "Title", "default": "Delivered in 10–14 days" },
        { "type": "text", "id": "text", "label": "Text", "default": "Packed in order of use" }
      ]
    }
  ],
  "presets": [
    {
      "name": "SDP · Deck kits grid",
      "blocks": [
        { "type": "usp", "settings": { "icon": "truck", "title": "Delivered in 10–14 days", "text": "Packed in order of use" } },
        { "type": "usp", "settings": { "icon": "drill", "title": "Built with just a drill", "text": "No cutting, no measuring" } },
        { "type": "usp", "settings": { "icon": "shield", "title": "Engineered to fit", "text": "Footings and hardware included" } },
        { "type": "usp", "settings": { "icon": "chat", "title": "Free design help", "text": "Talk to a deck specialist" } }
      ]
    }
  ]
}
{% endschema %}
