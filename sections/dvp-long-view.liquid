{{ 'dvp-landing.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  Deck vs Patio · 10 years later. Figma › Section - 10 Years Later: Deck vs Patio (7246:146).
  `tile` blocks go in the patio or deck column by their Column setting.
{%- endcomment -%}

{%- capture patio_tiles -%}
  {%- for block in section.blocks -%}
    {%- if block.settings.column == 'patio' -%}
      {%- render 'dvp-long-tile', block: block -%}
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}
{%- capture deck_tiles -%}
  {%- for block in section.blocks -%}
    {%- if block.settings.column == 'deck' -%}
      {%- render 'dvp-long-tile', block: block -%}
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}

<div class="dvp dvp--white dvp-long"{% if section.settings.anchor_id != blank %} id="{{ section.settings.anchor_id | handle }}"{% endif %}>
  <div class="dvp__inner dvp-long__inner">
    <div class="dvp-head">
      {%- if section.settings.eyebrow != blank -%}
        <p class="dvp-eyebrow dvp-eyebrow--tan dvp-eyebrow--center">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h2 class="dvp-h2">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.intro != blank -%}
        <p class="dvp-lede">{{ section.settings.intro | escape }}</p>
      {%- endif -%}
    </div>

    <div class="dvp-long__cols">
      <div class="dvp-long__col dvp-long__col--patio">
        <div class="dvp-long__col-head">
          <span class="dvp-long__tag">{{ section.settings.patio_tag | escape }}</span>
          <h3 class="dvp-long__col-title">{{ section.settings.patio_title | escape }}</h3>
        </div>
        <ul class="dvp-long__tiles">{{ patio_tiles }}</ul>
      </div>
      <div class="dvp-long__col dvp-long__col--deck">
        <div class="dvp-long__col-head">
          <span class="dvp-long__tag">{{ section.settings.deck_tag | escape }}</span>
          <h3 class="dvp-long__col-title">{{ section.settings.deck_title | escape }}</h3>
        </div>
        <ul class="dvp-long__tiles">{{ deck_tiles }}</ul>
      </div>
    </div>

    {%- if section.settings.cta_title != blank -%}
      <div class="dvp-bottomline">
        {%- if section.settings.cta_texture != blank -%}
          {%- render 'dvp-image', image: section.settings.cta_texture, alt: '', class: 'dvp-bottomline__texture', sizes: '1440px' -%}
        {%- endif -%}
        <div class="dvp-bottomline__copy">
          <p class="dvp-bottomline__label">{{ section.settings.cta_label | escape }}</p>
          <p class="dvp-bottomline__title">{{ section.settings.cta_title | escape | newline_to_br }}</p>
          <p class="dvp-bottomline__text">{{ section.settings.cta_text | escape }}</p>
        </div>
        <div class="dvp-bottomline__btns">
          {%- render 'dvp-button', label: section.settings.primary_label, link: section.settings.primary_link, style: 'white' -%}
          {%- render 'dvp-button', label: section.settings.secondary_label, link: section.settings.secondary_link, style: 'outline-dark' -%}
        </div>
      </div>
    {%- endif -%}

    {%- if section.settings.sources != blank -%}
      <p class="dvp-long__sources">{{ section.settings.sources | escape }}</p>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Deck vs Patio · 10 years",
  "tag": "section",
  "class": "section",
  "enabled_on": { "templates": ["page"] },
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "anchor_id", "label": "Anchor ID" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The long view" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "10 Years Later: Deck vs. Patio" },
    { "type": "textarea", "id": "intro", "label": "Intro" },
    { "type": "text", "id": "patio_tag", "label": "Patio column tag", "default": "Common by year 10" },
    { "type": "text", "id": "patio_title", "label": "Patio column title", "default": "The patio at year 10" },
    { "type": "text", "id": "deck_tag", "label": "Deck column tag", "default": "With routine care" },
    { "type": "text", "id": "deck_title", "label": "Deck column title", "default": "The deck at year 10" },
    { "type": "header", "content": "Bottom line" },
    { "type": "text", "id": "cta_label", "label": "Label", "default": "The bottom line" },
    { "type": "textarea", "id": "cta_title", "label": "Title" },
    { "type": "textarea", "id": "cta_text", "label": "Text" },
    { "type": "image_picker", "id": "cta_texture", "label": "Background texture" },
    { "type": "text", "id": "primary_label", "label": "Primary button label", "default": "Explore Composite Deck Kits" },
    { "type": "url", "id": "primary_link", "label": "Primary button link" },
    { "type": "text", "id": "secondary_label", "label": "Secondary button label", "default": "Explore Wood Deck Kits" },
    { "type": "url", "id": "secondary_link", "label": "Secondary button link" },
    { "type": "textarea", "id": "sources", "label": "Sources note" }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        { "type": "select", "id": "column", "label": "Column", "default": "patio", "options": [
          { "value": "patio", "label": "Patio" },
          { "value": "deck", "label": "Deck" }
        ] },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "image_alt", "label": "Image alt text" },
        { "type": "text", "id": "title", "label": "Title", "default": "Sinking, uneven pavers" },
        { "type": "textarea", "id": "text", "label": "Text" }
      ]
    }
  ],
  "presets": [{ "name": "Deck vs Patio · 10 years", "blocks": [{ "type": "tile" }] }]
}
{% endschema %}
