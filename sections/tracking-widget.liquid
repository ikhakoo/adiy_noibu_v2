<script>
window.currentActiveOrderData = null;

function calculateWorkingDays(startDate, endDate) {
  let count = 0;
  let curDate = new Date(startDate.getTime());
  curDate.setHours(0,0,0,0);
  
  let targetDate = new Date(endDate.getTime());
  targetDate.setHours(0,0,0,0);

  while (curDate <= targetDate) {
    const dayOfWeek = curDate.getDay();
    if (dayOfWeek !== 0 && dayOfWeek !== 6) {
      count++;
    }
    curDate.setDate(curDate.getDate() + 1);
  }
  return count;
}

function setChecked(elementId, isChecked) {
  const el = document.getElementById(elementId);
  if (!el) return;
  const iconContainer = el.querySelector('.stage-1__check-icon');
  if (isChecked) {
    iconContainer.classList.add('completed');
    iconContainer.innerHTML = `<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>`;
  } else {
    iconContainer.classList.remove('completed');
    iconContainer.innerHTML = `<span class="stage-1__unchecked-circle"></span>`;
  }
}

async function handleTrackingSubmit(event) {
  event.preventDefault();
  
  const sectionId = "{{ section.id }}";
  const inputEl = document.getElementById(`TrackingInput-${sectionId}`);
  const submitBtn = document.getElementById("trackSubmitBtn");
  const resultContainer = document.getElementById("trackingResultContainer");
  const orderNumber = inputEl.value.trim();

  if (!orderNumber) return;

  const originalBtnText = submitBtn.innerText;
  submitBtn.innerText = "Searching...";
  submitBtn.disabled = true;
  resultContainer.style.display = "none";

  try {
    const response = await fetch(`https://adiy-order-tracker.a-diy.workers.dev/track?order=${encodeURIComponent(orderNumber)}`);
    const data = await response.json();

    if (data.success && data.order) {
      const order = data.order;
      
      window.currentActiveOrderData = { order: order, delivery: data.delivery };
      try {
        localStorage.setItem('lastFetchedOrderData', JSON.stringify(window.currentActiveOrderData));
      } catch (e) {
        console.warn('LocalStorage error', e);
      }

      const formattedDate = new Date(order.date).toLocaleDateString('en-US', {
        year: 'numeric',
        month: 'short',
        day: 'numeric',
        hour: '2-digit',
        minute: '2-digit'
      });

      const tagsText = (order.tags && order.tags.length > 0) ? order.tags.join(', ') : 'None';
      const fulfillmentText = order.fulfillmentStatus ? order.fulfillmentStatus.replace(/_/g, ' ') : 'N/A';
      const deliveryText = data.delivery ? (typeof data.delivery === 'object' ? JSON.stringify(data.delivery) : data.delivery) : 'N/A';

      resultContainer.innerHTML = `
        <div class="tracking-result-header">
          <h3 style="margin:0; font-size: 18px; color: #002B49;">Order #${order.number}</h3>
          <span class="status-badge">${fulfillmentText}</span>
        </div>
        <div class="tracking-result-grid">
          <div><strong>Date:</strong> ${formattedDate}</div>
          <div><strong>Financial Status:</strong> ${order.financialStatus}</div>
          <div><strong>Fulfillment Status:</strong> ${fulfillmentText}</div>
          <div><strong>Delivery:</strong> ${deliveryText}</div>
          <div><strong>Cancelled:</strong> ${order.cancelled ? 'Yes' : 'No'}</div>
          <div><strong>Tags:</strong> ${tagsText}</div>
        </div>
        <button type="button" class="stage-1__view-progress-btn" onclick="showLiveProgressStage()">
          View Live Progress &rarr;
        </button>
      `;
      
      resultContainer.style.display = "block";

    } else {
      resultContainer.innerHTML = `<p style="color: #dc2626; margin: 0; text-align: center;">Order not found. Please check your order number.</p>`;
      resultContainer.style.display = "block";
    }
  } catch (error) {
    console.error("Error:", error);
    resultContainer.innerHTML = `<p style="color: #dc2626; margin: 0; text-align: center;">Failed to fetch order details. Please try again.</p>`;
    resultContainer.style.display = "block";
  } finally {
    submitBtn.innerText = originalBtnText;
    submitBtn.disabled = false;
  }
}

function showLiveProgressStage() {
  if (!window.currentActiveOrderData || !window.currentActiveOrderData.order) return;

  const order = window.currentActiveOrderData.order;

  const searchCardContainer = document.getElementById('tracking-search-container');
  if (searchCardContainer) searchCardContainer.style.display = 'none';

  const stageContainer = document.getElementById('dynamic-tracking-stage');
  if (stageContainer) stageContainer.style.display = 'block';

  const orderDate = new Date(order.date);
  const currentDate = new Date();
  const workingDays = calculateWorkingDays(orderDate, currentDate);

  const allCheckboxes = [
    'chk-order-confirmed',
    'chk-materials-selected',
    'chk-components-production',
    'chk-hardware-prep',
    'chk-deck-together',
    'chk-lines-up',
    'chk-connection-checked'
  ];

  let progress = 22;
  let checkedItems = [];

  if (workingDays <= 1) {
    progress = 22;
    checkedItems = ['chk-order-confirmed', 'chk-materials-selected', 'chk-components-production'];
  } else if (workingDays === 2) {
    progress = 40;
    checkedItems = ['chk-order-confirmed', 'chk-materials-selected', 'chk-components-production', 'chk-hardware-prep'];
  } else if (workingDays === 3) {
    progress = 80;
    checkedItems = [
      'chk-order-confirmed', 
      'chk-materials-selected', 
      'chk-components-production', 
      'chk-hardware-prep',
      'chk-deck-together',
      'chk-lines-up'
    ];
  } else {
    progress = 100;
    checkedItems = [...allCheckboxes];
  }

  const percentEl = document.getElementById('track-percent-val');
  const fillEl = document.getElementById('track-progress-fill');
  if (percentEl) percentEl.innerText = progress + '%';
  if (fillEl) fillEl.style.width = progress + '%';

  // Highlight icons based on progress thresholds
  const stepThresholds = [22, 35, 80, 100];
  for (let i = 1; i <= 4; i++) {
    const stepEl = document.getElementById(`flow-step-${i}`);
    if (stepEl) {
      if (progress >= stepThresholds[i - 1]) {
        stepEl.classList.add('active');
      } else {
        stepEl.classList.remove('active');
      }
    }
  }

  allCheckboxes.forEach(id => {
    setChecked(id, checkedItems.includes(id));
  });
}

function resetTrackingView() {
  const sectionId = "{{ section.id }}";
  const inputEl = document.getElementById(`TrackingInput-${sectionId}`);
  const resultContainer = document.getElementById("trackingResultContainer");
  const stageContainer = document.getElementById("dynamic-tracking-stage");
  const searchCardContainer = document.getElementById("tracking-search-container");

  if (inputEl) inputEl.value = "";
  if (resultContainer) resultContainer.style.display = "none";
  if (stageContainer) stageContainer.style.display = "none";
  if (searchCardContainer) searchCardContainer.style.display = "block";
}
</script>

