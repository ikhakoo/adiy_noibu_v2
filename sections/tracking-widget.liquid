    background: transparent;
    border: none;
    color: var(--accent-color);
    font-weight: 600;
    cursor: pointer;
    font-size: 1.4rem;
    margin-bottom: 1.5rem;
    padding: 0;
  }

  /* Search Container Styles - Styled to match Image 2 */
