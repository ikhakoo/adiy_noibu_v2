{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .tracking-widget-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
    font-family: inherit;
    text-align: center;
  }

  .tracking-widget__container {
    max-width: 680px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .tracking-widget__logo-wrapper {
    margin-bottom: 24px;
    display: flex;
    justify-content: center;
    width: 100%;
  }

  .tracking-widget__logo {
    display: block;
    height: auto;
    object-fit: contain;
  }

  .tracking-widget__subtext {
    font-size: 15px;
    line-height: 1.4;
    color: {{ section.settings.text_color }};
    margin-bottom: 28px;
    max-width: 500px;
  }

  .tracking-widget__subtext p {
    margin: 0;
  }

  .tracking-widget__form {
    width: 100%;
    max-width: 520px;
    margin-bottom: 80px;
  }

  .tracking-widget__input-group {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    width: 100%;
  }

  .tracking-widget__input {
    flex: 1;
    height: 44px;
    padding: 0 16px;
    border: 1px solid #103254;
    border-radius: 4px;
    font-size: 14px;
    color: #333333;
    outline: none;
    box-sizing: border-box;
    background-color: #ffffff;
    transition: border-color 0.2s ease;
  }

  .tracking-widget__input:focus {
    border-color: #002B49;
    box-shadow: 0 0 0 1px #002B49;
  }

  .tracking-widget__input::placeholder {
    color: #666666;
  }

  .tracking-widget__button {
    height: 44px;
    padding: 0 28px;
    background-color: {{ section.settings.btn_bg_color }};
    color: {{ section.settings.btn_text_color }};
    border: none;
    border-radius: 6px;
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
    white-space: nowrap;
    transition: background-color 0.2s ease, transform 0.1s ease;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .tracking-widget__button:hover {
    opacity: 0.92;
  }

  .tracking-widget__footer-text {
    font-size: 14px;
    line-height: 1.5;
    color: #555555;
    max-width: 600px;
    margin-top: 20px;
  }

  .tracking-widget__footer-text p {
    margin: 0;
  }

  /* Target all possible stage classes */
  .stage-1-section, .stage-2-section, .stage-3-section,
  .stage-1, .stage-2, .stage-3,
  [class*="stage-1"], [class*="stage-2"], [class*="stage-3"] {
    display: none !important;
  }

  /* Shown State Class */
  .active-stage-section {
    display: block !important;
    animation: fadeInStage 0.4s ease forwards;
  }

  @keyframes fadeInStage {
    from { opacity: 0; transform: translateY(15px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .tracking-widget-container.hide-widget {
    display: none !important;
  }

  /* Fixed Corner Back Button */
  .stage-back-btn {
    position: fixed;
    top: 24px;
    left: 24px;
    z-index: 99999;
    background: #ffffff;
    color: #111827;
    border: 1px solid #d1d5db;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.12);
    border-radius: 30px;
    padding: 10px 20px;
    font-size: 13px;
    font-weight: 700;
    cursor: pointer;
    display: none;
    align-items: center;
    gap: 8px;
    transition: all 0.2s ease;
  }

  .stage-back-btn.show-btn {
    display: inline-flex !important;
  }

  .stage-back-btn:hover {
    background: #f3f4f6;
    transform: translateY(-2px);
  }

  @media screen and (max-width: 480px) {
    .tracking-widget__input-group {
      flex-direction: column;
      gap: 10px;
    }
    .tracking-widget__input,
    .tracking-widget__button {
      width: 100%;
    }
  }
{%- endstyle -%}

<!-- Floating Back Button -->
<button id="stageBackBtn" class="stage-back-btn" type="button" onclick="resetTrackingView()">
  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
    <path d="M19 12H5M12 19l-7-7 7-7"/>
  </svg>
  Back to Search
</button>

<div id="trackingWidgetContainer" class="tracking-widget tracking-widget-{{ section.id }} section-{{ section.id }}-padding tracking-widget-container">
  <div class="page-width page-width--narrow">
    <div class="tracking-widget__container">
      {%- if section.settings.logo != blank -%}
        <div class="tracking-widget__logo-wrapper">
          <img
            src="{{ section.settings.logo | image_url: width: 600 }}"
            alt="{{ section.settings.logo.alt | escape }}"
            loading="lazy"
            width="{{ section.settings.logo_width }}"
            height="auto"
            class="tracking-widget__logo"
            style="max-width: {{ section.settings.logo_width }}px;"
          >
        </div>
      {%- endif -%}

      {%- if section.settings.subtext != blank -%}
        <div class="tracking-widget__subtext">
          {{ section.settings.subtext }}
        </div>
      {%- endif -%}

      <form id="TrackingForm-{{ section.id }}" class="tracking-widget__form" action="javascript:void(0);" onsubmit="return handleTrackingSubmit(event)">
        <div class="tracking-widget__input-group">
          <input
            type="text"
            id="TrackingInput-{{ section.id }}"
            class="tracking-widget__input"
            placeholder="{{ section.settings.placeholder_text }}"
            required
            aria-label="{{ section.settings.placeholder_text }}"
          >
          <button type="submit" class="tracking-widget__button">
            {{ section.settings.button_text }}
          </button>
        </div>
      </form>

      {%- if section.settings.footer_text != blank -%}
        <div class="tracking-widget__footer-text">
          {{ section.settings.footer_text }}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

<script>
  function hideAllStages() {
    // Stage sections ke saare possible selectors hide kar do
    const allStageElements = document.querySelectorAll('.stage-1-section, .stage-2-section, .stage-3-section, .stage-1, .stage-2, .stage-3, [class*="stage-1"], [class*="stage-2"], [class*="stage-3"]');
    allStageElements.forEach(el => {
      el.classList.remove('active-stage-section');
      el.style.display = 'none';
    });
  }

  function resetTrackingView() {
    hideAllStages();
    const widget = document.getElementById('trackingWidgetContainer');
    const backBtn = document.getElementById('stageBackBtn');
    
    if (widget) widget.classList.remove('hide-widget');
    if (backBtn) backBtn.classList.remove('show-btn');
  }

  function showStage(stageNum) {
    hideAllStages();
    
    const widget = document.getElementById('trackingWidgetContainer');
    const backBtn = document.getElementById('stageBackBtn');
    
    // Stage element ko locate karo
    let targetStage = document.querySelector(`.stage-${stageNum}-section`) 
                   || document.querySelector(`.stage-${stageNum}`)
                   || document.querySelector(`[class*="stage-${stageNum}"]`);

    if (targetStage) {
      if (widget) widget.classList.add('hide-widget');
      if (backBtn) backBtn.classList.add('show-btn');
      
      targetStage.style.display = 'block';
      targetStage.classList.add('active-stage-section');
    } else {
      alert(`Stage ${stageNum} section customizer/page me nahi mil rahi. Kindly check ke Shopify Editor me Stage ${stageNum} add hai.`);
      resetTrackingView();
    }
  }

  function handleTrackingSubmit(e) {
    if (e) {
      e.preventDefault();
      e.stopPropagation();
    }

    const input = document.getElementById('TrackingInput-{{ section.id }}');
    const orderNumber = input ? input.value.trim() : '';

    if (!orderNumber) {
      alert('Please enter an order number.');
      return false;
    }

    // Direct API attempt with fallback logic for testing:
    fetch(`/apps/order-tracker/status?order=${encodeURIComponent(orderNumber)}`)
      .then(res => {
        if (!res.ok) throw new Error("API not active");
        return res.json();
      })
      .then(data => {
        const daysOld = parseInt(data.daysOld, 10);
        processDaysToStage(daysOld);
      })
      .catch(err => {
        // BACKEND API FALLBACK / TEST LOGIC:
        // Agar backend setup nahi hua, toh order number digits se test range calculate kar lega
        console.warn('Backend API endpoint offline. Running test demo logic based on order value...');
        
        let mockDays = 4; // Default Stage 1
        const lastDigit = parseInt(orderNumber.slice(-1), 10);

        if (!isNaN(lastDigit)) {
          if (lastDigit >= 0 && lastDigit <= 3) mockDays = 4;    // 0-7 days -> Stage 1
          else if (lastDigit >= 4 && lastDigit <= 6) mockDays = 10; // 7-14 days -> Stage 2
          else mockDays = 18;                                      // 14-21 days -> Stage 3
        }
        
        processDaysToStage(mockDays);
      });

    return false;
  }

  function processDaysToStage(daysOld) {
    if (daysOld >= 0 && daysOld <= 7) {
      showStage(1);
    } else if (daysOld > 7 && daysOld <= 14) {
      showStage(2);
    } else if (daysOld > 14 && daysOld <= 21) {
      showStage(3);
    } else {
      alert('Order status not found or order is beyond 21 days.');
    }
  }
</script>

{% schema %}
{
  "name": "Tracking Widget",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo Image"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 100,
      "max": 400,
      "step": 10,
      "default": 260,
      "unit": "px",
      "label": "Logo Width"
    },
    {
      "type": "richtext",
      "id": "subtext",
      "label": "Subtext",
      "default": "<p>To view the most up-to-date status of your shipment, enter your tracking number below.</p>"
    },
    {
      "type": "text",
      "id": "placeholder_text",
      "label": "Input Placeholder",
      "default": "enter tracking number"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Track"
    },
    {
      "type": "richtext",
      "id": "footer_text",
      "label": "Footer Text",
      "default": "<p>For any questions, call A-DIY Control Tower at +1 (786) 358-2872 or email us at updates@a-diy.com</p>"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#002B49"
    },
    {
      "type": "color",
      "id": "btn_bg_color",
      "label": "Button Background",
      "default": "#002B49"
    },
    {
      "type": "color",
      "id": "btn_text_color",
      "label": "Button Text Color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top Padding",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "Tracking Widget"
    }
  ]
}
{% endschema %}