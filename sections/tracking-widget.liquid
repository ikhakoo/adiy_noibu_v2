                <h4>3D Instructional App</h4>
                <button type="button" class="workspace-btn" onclick="openResourceLink('${app3dUrl}')">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
                  Launch App
                </button>
              </div>
            ` : ''}
          </div>
        </div>
      `;
      outerWorkspaceEl.style.display = "block";

    } else {
      resultContainer.innerHTML = `<p style="color: #dc2626; margin: 0; text-align: center;">Order not found. Please check your order number.</p>`;
      resultContainer.style.display = "block";
    }
  } catch (error) {
    console.error("Error:", error);
    resultContainer.innerHTML = `<p style="color: #dc2626; margin: 0; text-align: center;">Failed to fetch order details. Please try again.</p>`;
    resultContainer.style.display = "block";
  } finally {
    submitBtn.innerText = originalBtnText;
    submitBtn.disabled = false;
  }
}

function showLiveProgressStage() {
  if (!window.currentActiveOrderData || !window.currentActiveOrderData.order) return;

  const order = window.currentActiveOrderData.order;

  const searchCardContainer = document.getElementById('tracking-search-container');
  if (searchCardContainer) searchCardContainer.style.display = 'none';

  const workspaceContainer = document.getElementById('digitalWorkspaceContainer');
  if (workspaceContainer) {
    workspaceContainer.style.display = 'none';
    workspaceContainer.classList.remove('is-search-result-stage');
  }

  const stageContainer = document.getElementById('dynamic-tracking-stage');
  if (stageContainer) stageContainer.style.display = 'block';

  const orderDate = new Date(order.date);
  const currentDate = new Date();
  const workingDays = calculateWorkingDays(orderDate, currentDate);

  const fulfillmentStatus = order.fulfillmentStatus ? order.fulfillmentStatus.toUpperCase() : 'UNFULFILLED';
  const isFulfillmentActive = (fulfillmentStatus === 'IN_PROGRESS' || fulfillmentStatus === 'FULFILLED' || fulfillmentStatus === 'PARTIALLY_FULFILLED');

  let isStage2 = false;
  if (workingDays > 3 && isFulfillmentActive) {
    isStage2 = true;
  }

  const stepPill = document.getElementById('dynamic-step-pill');
  const mainHeading = document.getElementById('dynamic-main-heading');
  const subheading = document.getElementById('dynamic-subheading');
  const etaText = document.getElementById('dynamic-eta-text');
  const percentEl = document.getElementById('track-percent-val');
  const percentLabel = document.getElementById('track-percent-label');
  const fillEl = document.getElementById('track-progress-fill');
  
  const stage1Block = document.getElementById('stage-1-details-block');
  const stage2Block = document.getElementById('stage-2-details-block');

  let progress = 22;

  const allCheckboxes = [
    'chk-order-confirmed', 'chk-materials-selected', 'chk-components-production',
    'chk-hardware-prep', 'chk-deck-together', 'chk-lines-up', 'chk-connection-checked'
  ];

  if (!isStage2) {
    stage1Block.style.display = 'block';
    stage2Block.style.display = 'none';

    stepPill.innerText = "Step 1 of 3";
    mainHeading.innerText = "Your deck is now in production.";
    subheading.innerText = "Every A-DIY deck is made just for you, nothing sits in a warehouse.";
    etaText.innerText = "Estimated: 3 business days";
    percentLabel.innerText = "of your deck is completed.";

    let checkedItems = [];

    if (workingDays <= 1) {
      progress = 22;
      checkedItems = ['chk-order-confirmed', 'chk-materials-selected', 'chk-components-production'];
    } else if (workingDays === 2) {
      progress = 45;
      checkedItems = ['chk-order-confirmed', 'chk-materials-selected', 'chk-components-production', 'chk-hardware-prep', 'chk-deck-together'];
    } else {
      progress = 62;
      checkedItems = [...allCheckboxes];
    }

    for (let i = 1; i <= 4; i++) {
      const stepEl = document.getElementById(`flow-step-${i}`);
      const lineEl = document.getElementById(`flow-line-${i}`);

      let maxActiveIcons = 1;
      if (workingDays === 2) {
        maxActiveIcons = 2;
      } else if (workingDays >= 3) {
        maxActiveIcons = 3;
      }

      if (stepEl) {
        if (i <= maxActiveIcons) {
          stepEl.classList.add('active');
        } else {
          stepEl.classList.remove('active');
        }
      }

      if (lineEl) {
        if (i < maxActiveIcons) {
          lineEl.classList.add('active');
        } else {
          lineEl.classList.remove('active');
        }
      }
    }

    allCheckboxes.forEach(id => {
      setChecked(id, checkedItems.includes(id));
    });

  } else {
    if (fulfillmentStatus === 'FULFILLED') {
      const cleanOrderNumber = order.number.toString().replace(/[^0-9]/g, '');
      const redirectUrl = `https://efwtrack.com/track/${cleanOrderNumber}`;
      window.location.href = redirectUrl;
      return;
    }

    stage1Block.style.display = 'none';
    stage2Block.style.display = 'block';

    stepPill.innerText = "Step 2 of 3";
    mainHeading.innerText = "Getting your deck ready to ship.";
    subheading.innerText = "We're packing and securing everything for its trip to you.";
    etaText.innerText = "Estimate: 3 to 4 business days";
    percentLabel.innerText = "of your deck is completed.";

    const stage2WorkingDays = workingDays - 3;

    if (stage2WorkingDays <= 1) {
      progress = 71;
    } else if (stage2WorkingDays === 2) {
      progress = 85;
    } else if (stage2WorkingDays === 3) {
      progress = 95;
    } else {
      progress = 100;
    }

    for (let i = 1; i <= 4; i++) {
      const stepEl = document.getElementById(`flow-step-${i}`);
      const lineEl = document.getElementById(`flow-line-${i}`);

      let isActive = false;
      if (i <= 3 && progress >= 71) isActive = true;
      if (i === 4 && progress >= 95) isActive = true;

      if (stepEl) {
        if (isActive) {
          stepEl.classList.add('active');
        } else {
          stepEl.classList.remove('active');
        }
      }

      if (lineEl) {
        if (i < 3 || (i === 3 && progress >= 95)) {
          lineEl.classList.add('active');
        } else {
          lineEl.classList.remove('active');
        }
      }
    }
  }

  if (percentEl) percentEl.innerText = progress + '%';
  if (fillEl) fillEl.style.width = progress + '%';

  if (isStage2 && progress >= 100 && fulfillmentStatus === 'FULFILLED') {
    const cleanOrderNumber = order.number.toString().replace(/[^0-9]/g, '');
    const redirectUrl = `https://efwtrack.com/track/${cleanOrderNumber}`;
    
    setTimeout(() => {
      window.location.href = redirectUrl;
    }, 150);
  }
}

window.addEventListener('pageshow', function (event) {
  if (event.persisted && window.currentActiveOrderData) {
    showLiveProgressStage();
  }
});

function resetTrackingView() {
  const sectionId = "{{ section.id }}";
  const inputEl = document.getElementById(`TrackingInput-${sectionId}`);
  const resultContainer = document.getElementById("trackingResultContainer");
  const stageContainer = document.getElementById("dynamic-tracking-stage");
  const searchCardContainer = document.getElementById("tracking-search-container");
  const searchSection = document.getElementById("searchQuerySection");
  const activeHeading = document.getElementById("searchActiveHeading");

  if (inputEl) inputEl.value = "";
  if (resultContainer) resultContainer.style.display = "none";
  if (stageContainer) stageContainer.style.display = "none";
  if (searchCardContainer) searchCardContainer.style.display = "block";
  if (searchSection) searchSection.style.display = "block";
  if (activeHeading) activeHeading.style.display = "none";
}
</script>

