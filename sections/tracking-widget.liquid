<script>
window.currentActiveOrderData = null;

function calculateWorkingDays(startDate, endDate) {
  let count = 0;
  let curDate = new Date(startDate.getTime());
  curDate.setHours(0,0,0,0);
  
  let targetDate = new Date(endDate.getTime());
  targetDate.setHours(0,0,0,0);

  while (curDate <= targetDate) {
    const dayOfWeek = curDate.getDay();
    if (dayOfWeek !== 0 && dayOfWeek !== 6) {
      count++;
    }
    curDate.setDate(curDate.getDate() + 1);
  }
  return count;
}

function setChecked(elementId, isChecked) {
  const el = document.getElementById(elementId);
  if (!el) return;
  const iconContainer = el.querySelector('.stage-1__check-icon');
  if (isChecked) {
    iconContainer.classList.add('completed');
    iconContainer.innerHTML = `<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>`;
  } else {
    iconContainer.classList.remove('completed');
    iconContainer.innerHTML = `<span class="stage-1__unchecked-circle"></span>`;
  }
}

// PDF Download Helper Function
function forceDownloadPdf(url, fileName) {
  if (!url) return;
  const a = document.createElement('a');
  a.href = url;
  a.download = fileName || 'download.pdf';
  a.target = '_blank';
  document.body.appendChild(a);
  a.click();
  document.body.removeChild(a);
}

// Open Links Helper Function
function openResourceLink(url) {
  if (!url) return;
  window.open(url, '_blank');
}

async function handleTrackingSubmit(event) {
  event.preventDefault();
  
  const sectionId = "{{ section.id }}";
  const inputEl = document.getElementById(`TrackingInput-${sectionId}`);
  const submitBtn = document.getElementById("trackSubmitBtn");
  const resultContainer = document.getElementById("trackingResultContainer");
  const workspaceContainer = document.getElementById("digitalWorkspaceContainer");
  const orderNumber = inputEl.value.trim();

  if (!orderNumber) return;

  const originalBtnText = submitBtn.innerText;
  submitBtn.innerText = "Searching...";
  submitBtn.disabled = true;
  resultContainer.style.display = "none";
  if (workspaceContainer) {
    workspaceContainer.style.display = "none";
    workspaceContainer.classList.remove("is-search-result-stage");
  }

  try {
    const response = await fetch(`https://adiy-order-tracker.a-diy.workers.dev/track?order=${encodeURIComponent(orderNumber)}`);
    const data = await response.json();

    if (data.success && data.order) {
      const order = data.order;
      
      window.currentActiveOrderData = { order: order, delivery: data.delivery, items: data.items };
      try {
        localStorage.setItem('lastFetchedOrderData', JSON.stringify(window.currentActiveOrderData));
      } catch (e) {
        console.warn('LocalStorage error', e);
      }

      // Hide Search Query Section and Show Active Heading
      document.getElementById('searchQuerySection').style.display = 'none';
      document.getElementById('searchActiveHeading').style.display = 'block';

      const formattedDate = new Date(order.date).toLocaleDateString('en-US', {
        year: 'numeric',
        month: 'short',
        day: 'numeric',
        hour: '2-digit',
        minute: '2-digit',
        timeZone: 'America/New_York'
      });

      const fulfillmentText = order.fulfillmentStatus ? order.fulfillmentStatus.replace(/_/g, ' ') : 'N/A';
      const customerName = data.customer && data.customer.name ? data.customer.name : 'N/A';

      document.getElementById('customer-name-display').innerText = customerName;

      const customerEmail = data.customer && data.customer.email ? data.customer.email : 'N/A';
      const customerPhone = data.customer && data.customer.phone ? data.customer.phone : 'N/A';
      
      // First Item Details
      const firstItem = (data.items && data.items.length > 0) ? data.items[0] : {};
      const productTitle = firstItem.productTitle || firstItem.title || 'N/A';
      const variantTitle = firstItem.variantTitle || 'N/A';

      // Metafield Links Extraction
      const manualPdf = firstItem.productManualsPdf || '';
      const footingPdf = firstItem.footingDiagramsPdf || '';
      const videoUrl = (firstItem.videoLinks && firstItem.videoLinks.length > 0) ? firstItem.videoLinks[0] : '';
      const app3dUrl = (firstItem.appLinks3d && firstItem.appLinks3d.length > 0) ? firstItem.appLinks3d[0] : '';

      const itemsHtml = (data.items && data.items.length > 0)
        ? data.items.map(item => `
            <div style="margin-bottom: 12px; padding-bottom: 8px; border-bottom: 1px solid #f0f0f0;">
              <div><strong>Product:</strong> ${item.productTitle || item.title || 'N/A'}</div>
              <div><strong>Variant:</strong> ${item.variantTitle || 'N/A'} ${item.quantity > 1 ? `(Qty: ${item.quantity})` : ''}</div>
            </div>
          `).join('')
        : '<div><strong>Product:</strong> N/A</div>';

