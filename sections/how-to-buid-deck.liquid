<script>
  // Load Google Fonts
  (function () {
    var l = document.createElement('link');
    l.rel = 'stylesheet';
    l.href = 'https://fonts.googleapis.com/css2?family=DM+Serif+Display&family=DM+Sans:wght@400;500;600&display=swap';
    document.head.appendChild(l);
  })();

  (function () {
    var elems = document.querySelectorAll('.ab2-anim');
    if ('IntersectionObserver' in window) {
      var obsOpts = { threshold: 0.08 };
      var obs = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          if (e.isIntersecting) {
            e.target.classList.add('in');
            obs.unobserve(e.target);
          }
        });
      }, obsOpts);
      elems.forEach(function (el) {
        obs.observe(el);
      });
    } else {
      elems.forEach(function (el) {
        el.classList.add('in');
      });
    }
    document.querySelectorAll('.ab2-faq__q').forEach(function (q) {
      q.addEventListener('click', function () {
        var item = q.closest('.ab2-faq__item');
        var wasOpen = item.classList.contains('open');
        document.querySelectorAll('.ab2-faq__item.open').forEach(function (o) {
          o.classList.remove('open');
        });
        if (!wasOpen) item.classList.add('open');
      });
    });
  })();
</script>

