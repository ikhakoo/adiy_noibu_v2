{{ 'dvp-landing.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  Deck vs Patio · Six reasons. Figma › Section - Six Reasons to Choose a Deck (6977:1453).
  One `reason` block per card; the number is generated from the block order.
{%- endcomment -%}

<div class="dvp dvp--green dvp-reasons"{% if section.settings.anchor_id != blank %} id="{{ section.settings.anchor_id | handle }}"{% endif %}>
  <div class="dvp__inner dvp-reasons__inner">
    <h2 class="dvp-h2">{{ section.settings.heading | escape }}</h2>
    {%- if section.settings.intro != blank -%}
      <p class="dvp-lede">{{ section.settings.intro | escape }}</p>
    {%- endif -%}
    <ul class="dvp-reasons__grid">
      {%- for block in section.blocks -%}
        <li class="dvp-reason" {{ block.shopify_attributes }}>
          {%- render 'dvp-image', image: block.settings.image, alt: block.settings.image_alt, class: 'dvp-reason__media', sizes: '(min-width: 1920px) 464px, (min-width: 990px) 30vw, (min-width: 750px) 47vw, calc(100vw - 40px)' -%}
          <div class="dvp-reason__body">
            <span class="dvp-reason__num" aria-hidden="true">{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</span>
            <h3 class="dvp-reason__title">{{ block.settings.title | escape }}</h3>
            <p class="dvp-reason__text">{{ block.settings.text | escape }}</p>
          </div>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "Deck vs Patio · Reasons",
  "tag": "section",
  "class": "section",
  "enabled_on": { "templates": ["page"] },
  "max_blocks": 9,
  "settings": [
    { "type": "text", "id": "anchor_id", "label": "Anchor ID" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Six reasons homeowners choose a deck over a patio" },
    { "type": "textarea", "id": "intro", "label": "Intro" }
  ],
  "blocks": [
    {
      "type": "reason",
      "name": "Reason",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "image_alt", "label": "Image alt text" },
        { "type": "text", "id": "title", "label": "Title", "default": "Level on any ground" },
        { "type": "textarea", "id": "text", "label": "Text" }
      ]
    }
  ],
  "presets": [{ "name": "Deck vs Patio · Reasons", "blocks": [{ "type": "reason" }] }]
}
{% endschema %}
