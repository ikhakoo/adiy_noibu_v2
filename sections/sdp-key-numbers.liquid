{{ 'sdp.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  Size deck page · Key numbers strip. One stat per block on a green band.
{%- endcomment -%}

{%- liquid
  assign sdp = page.metafields.custom.deck_size.value
  if template.name == 'collection'
    assign sdp = collection.metafields.custom.deck_size.value
  endif
-%}
<div class="sdp sdp-numbers sdp--green"{% if section.settings.anchor_id != blank %} id="{{ section.settings.anchor_id | handle }}"{% endif %}>
  <div class="sdp__inner">
    {%- capture t_heading -%}{%- render 'sdp-t', text: section.settings.heading, sdp: sdp -%}{%- endcapture -%}
    {%- if t_heading != blank -%}
      <h2 class="sdp-numbers__heading{% unless section.settings.show_heading %} visually-hidden{% endunless %}">{{ t_heading | escape }}</h2>
    {%- endif -%}
    <ul class="sdp-numbers__grid" style="--sdp-numbers-cols: {{ section.blocks.size | at_least: 1 | at_most: 4 }};">
      {%- for block in section.blocks -%}
        <li class="sdp-number" {{ block.shopify_attributes }}>
          <span class="sdp-number__value">{%- render 'sdp-t', text: block.settings.value, sdp: sdp -%}</span>
          <span class="sdp-number__label">{%- render 'sdp-t', text: block.settings.label, sdp: sdp -%}</span>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "SDP · Key numbers",
  "tag": "section",
  "class": "section",
  "enabled_on": { "templates": ["product", "collection", "page"] },
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "anchor_id", "label": "Anchor ID" },
    { "type": "text", "id": "heading", "label": "Heading (H2)", "info": "Kept in the page outline for SEO; shown on the page only when the box below is ticked.", "default": "The 12x12 wood deck kit at a glance" },
    { "type": "checkbox", "id": "show_heading", "label": "Show the heading", "default": false }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Number",
      "settings": [
        { "type": "text", "id": "value", "label": "Value", "default": "144 sq ft" },
        { "type": "text", "id": "label", "label": "Label", "default": "Finished deck area" }
      ]
    }
  ],
  "presets": [
    {
      "name": "SDP · Key numbers",
      "blocks": [
        { "type": "stat", "settings": { "value": "144 sq ft", "label": "Finished deck area" } },
        { "type": "stat", "settings": { "value": "8–16 hrs", "label": "Typical build, one weekend" } },
        { "type": "stat", "settings": { "value": "15,000 lbs", "label": "Engineered load capacity" } },
        { "type": "stat", "settings": { "value": "5 years", "label": "Structural warranty" } }
      ]
    }
  ]
}
{% endschema %}
