{{ 'state-seo.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  State SEO landing page · Essential questions to ask a contractor. Figma › FAQ Section (1474:1812).
  One row per line of the "Questions" setting (bind it to the page metafield
  state_seo.questions_items so every state page shares this one template).
{%- endcomment -%}

<div class="ss ss--cream ss-questions"{% if section.settings.anchor_id != blank %} id="{{ section.settings.anchor_id | handle }}"{% endif %}>
  <div class="ss__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="ss-h2 ss-center">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    <div class="ss-questions__list">
      {% capture nl %}
{% endcapture %}
{%- assign items = section.settings.items | replace: '<br/>', nl | replace: '<br />', nl | replace: '<br>', nl | replace: '</p>', nl | replace: '</li>', nl | strip_html | newline_to_br | split: '<br />' -%}
      {%- for item in items -%}
        {%- assign item_text = item | strip -%}
        {%- if item_text != blank -%}
          <div class="ss-questions__item">
            <p class="ss-questions__q">{{ item_text | escape }}</p>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "State SEO · Questions",
  "tag": "section",
  "class": "section",
  "enabled_on": { "templates": ["page"] },
  "settings": [
    { "type": "text", "id": "anchor_id", "label": "Anchor ID" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Essential Questions to Ask" },
    { "type": "richtext", "id": "items", "label": "Questions (one per line)", "default": "<p>Have you completed similar decks in this city or county?<br>Are you licensed or registered where required?<br>Can you provide current proof of insurance?</p>" }
  ],
  "presets": [{ "name": "State SEO · Questions" }]
}
{% endschema %}
