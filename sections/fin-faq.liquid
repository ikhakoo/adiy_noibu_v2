{{ 'rv-landing.css' | asset_url | stylesheet_tag }}
{{ 'fin-landing.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  Deck Financing page · FAQ (FAQPage). Figma › Section - FAQ (6666:638).
  Same accordion as the RV page (native <details>, works without JS), styled to the
  financing design. Emits FAQPage JSON-LD (keep one per page).

  Price token keeps answers matched to the live store price:
    [price]  live price of the product/variant set below, e.g. $4,899
{%- endcomment -%}

{%- liquid
  assign product_ref = section.settings.price_product
  assign price_text = ''
  if product_ref != blank
    assign size_key = section.settings.price_variant_title | remove: ' ' | downcase
    assign price_variant = product_ref.selected_or_first_available_variant
    for v in product_ref.variants
      assign vt = v.title | remove: ' ' | downcase
      if vt contains size_key
        assign price_variant = v
        break
      endif
    endfor
    assign price_text = price_variant.price | money_without_trailing_zeros
  endif
-%}

<div class="rv fin rv--white rv-faq fin-faq"{% if section.settings.anchor_id != blank %} id="{{ section.settings.anchor_id | handle }}"{% endif %}>
  <div class="rv__inner rv-faq__row">
    <div class="rv-faq__aside">
      {%- if section.settings.heading != blank -%}
        <h2 class="rv-h2">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.intro != blank -%}
        <p class="rv-body">{{ section.settings.intro | escape }}</p>
      {%- endif -%}
      {%- render 'rv-button', label: section.settings.button_label, link: section.settings.button_link, style: 'outline' -%}
    </div>
    <div class="rv-faq__list">
      {%- for block in section.blocks -%}
        {%- assign answer = block.settings.answer | replace: '[price]', price_text -%}
        <details class="rv-faq__item" {{ block.shopify_attributes }}{% if section.settings.open_first and forloop.first %} open{% endif %}>
          <summary class="rv-faq__q">
            <h3>{{ block.settings.question | escape }}</h3>
            <span class="rv-faq__sign" aria-hidden="true"></span>
          </summary>
          <div class="rv-faq__a">{{ answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</div>

{%- if section.settings.faq_schema and section.blocks.size > 0 -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {%- for block in section.blocks -%}
          {%- assign answer = block.settings.answer | replace: '[price]', price_text -%}
          {
            "@type": "Question",
            "name": {{ block.settings.question | json }},
            "acceptedAnswer": { "@type": "Answer", "text": {{ answer | strip_html | strip | json }} }
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Financing · FAQ",
  "tag": "section",
  "class": "section",
  "enabled_on": { "templates": ["page"] },
  "max_blocks": 30,
  "settings": [
    { "type": "text", "id": "anchor_id", "label": "Anchor ID", "default": "faq" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Deck Financing FAQs" },
    { "type": "textarea", "id": "intro", "label": "Intro", "default": "Still deciding? A deck specialist can walk you through every payment option." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Talk to a Deck Specialist" },
    { "type": "url", "id": "button_link", "label": "Button link", "info": "Use #chat to open live chat." },
    { "type": "checkbox", "id": "open_first", "label": "Open the first question", "default": true },
    { "type": "checkbox", "id": "faq_schema", "label": "Output FAQPage schema", "default": true, "info": "Keep on for one FAQ section per page only." },
    { "type": "header", "content": "Live price", "info": "Answers can use [price] for the live price of this product variant." },
    { "type": "product", "id": "price_product", "label": "Product" },
    { "type": "text", "id": "price_variant_title", "label": "Variant (size)", "default": "12 x 12" }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "Does A-DIY offer 0% APR financing?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Yes. Through Affirm, qualified buyers see offers as low as 0% APR.</p>" }
      ]
    }
  ],
  "presets": [{ "name": "Financing · FAQ", "blocks": [{ "type": "question" }] }]
}
{% endschema %}
