{{ 'state-seo.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  State SEO landing page · Customer quote. Figma › Success Story Section (1487:348).
{%- endcomment -%}

<div class="ss ss--white ss-quote"{% if section.settings.anchor_id != blank %} id="{{ section.settings.anchor_id | handle }}"{% endif %}>
  <div class="ss__inner">
    <blockquote>
      <div class="ss-quote__text ss-prose">{{ section.settings.quote }}</div>
      {%- if section.settings.attribution != blank -%}
        <cite class="ss-quote__cite">— {{ section.settings.attribution | escape }}</cite>
      {%- endif -%}
    </blockquote>
  </div>
</div>

{% schema %}
{
  "name": "State SEO · Quote",
  "tag": "section",
  "class": "section",
  "enabled_on": { "templates": ["page"] },
  "settings": [
    { "type": "text", "id": "anchor_id", "label": "Anchor ID" },
    { "type": "richtext", "id": "quote", "label": "Quote", "default": "<p>\"I'm just the person to prove this product is foolproof. Very easy to follow and build. I highly recommend using A-DIY.\"</p>" },
    { "type": "text", "id": "attribution", "label": "Attribution", "info": "Use a real customer review from the Reviews page.", "default": "Thomas, A-DIY customer" }
  ],
  "presets": [{ "name": "State SEO · Quote" }]
}
{% endschema %}
