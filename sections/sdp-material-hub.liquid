{{ 'sdp.css' | asset_url | stylesheet_tag }}
{{ 'sdp-collection.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  Deck Kits by Material (collection.deck-material-hub): header + one large card per material
  collection + a side-by-side comparison. Everything on the cards comes from the material
  entries ("Deck size page" entries with no width/length, e.g. wood-material,
  composite-material): name, intro, image (hero_image), starting price (first listed
  variant), number of sizes (entries of that material with a size page), and the rows of
  the entry's specs list ("Label | value").
{%- endcomment -%}
{%- liquid
  assign hub_handles = section.settings.materials | default: 'wood-material,composite-material' | strip_newlines | remove: ' ' | split: ','
  assign compare_rows = section.settings.compare_rows | newline_to_br | split: '<br />'
-%}
{%- paginate shop.metaobjects.deck_size_page.values by 100 -%}
{%- assign all_entries = shop.metaobjects.deck_size_page.values -%}
<div class="sdp sdpc sdpm sdp--{{ section.settings.background }}">
  <div class="sdp__inner">
    <header class="sdpc__header">
      <div class="sdpc__intro">
        {%- if section.settings.eyebrow != blank -%}
          <p class="sdp-eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        <h1 class="sdpc__title">{{ section.settings.heading | default: collection.title | escape }}</h1>
        {%- if section.settings.show_description and collection.description != blank -%}
          <div class="sdpc__desc">{{ collection.description }}</div>
        {%- endif -%}
      </div>

      {%- assign usps = section.blocks | where: 'type', 'usp' -%}
      {%- if usps.size > 0 -%}
        <ul class="sdpc__usps">
          {%- for block in usps -%}
            <li class="sdpc__usp" {{ block.shopify_attributes }}>
              <span class="sdpc__usp-icon">{%- render 'sdp-icon', name: block.settings.icon -%}</span>
              <span>
                <strong>{{ block.settings.title | escape }}</strong>
                {%- if block.settings.text != blank -%}<span>{{ block.settings.text | escape }}</span>{%- endif -%}
              </span>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </header>

    <div class="sdpm__grid">
      {%- assign card_i = 0 -%}
      {%- for h in hub_handles -%}
        {%- assign m = nil -%}
        {%- for candidate in all_entries -%}{%- if candidate.system.handle == h -%}{%- assign m = candidate -%}{%- break -%}{%- endif -%}{%- endfor -%}
        {%- if m == nil or m.collection.value.url == blank -%}{%- continue -%}{%- endif -%}
        {%- liquid
          assign card_i = card_i | plus: 1
          assign mat = m.material.value
          assign mcol = m.collection.value
          assign mproduct = m.product.value
          assign mv = m.variants.value | first
          assign media = m.hero_image.value | default: mv.featured_media | default: mproduct.featured_media
          assign size_count = 0
          for e in all_entries
            if e.material.value == mat and e.width.value != blank and e.collection.value.url != blank
              assign size_count = size_count | plus: 1
            endif
          endfor
          assign decking = ''
          assign warranty = ''
          for row in m.specs.value
            assign rk = row | split: '|' | first | strip
            assign rv = row | remove_first: rk | remove_first: '|' | strip
            if rk == 'Decking'
              assign decking = rv
            elsif rk == 'Warranty'
              assign warranty = rv
            endif
          endfor
        -%}
        <article class="sdpc-card sdpm-card">
          <div class="sdpc-card__media sdpm-card__media">
            {%- if media != blank -%}
              {%- assign img = media.preview_image | default: media -%}
              <img
                class="sdpc-card__img"
                src="{{ img | image_url: width: 1200 }}"
                srcset="{{ img | image_url: width: 600 }} 600w, {{ img | image_url: width: 900 }} 900w, {{ img | image_url: width: 1200 }} 1200w, {{ img | image_url: width: 1600 }} 1600w"
                sizes="(min-width: 990px) 620px, 100vw"
                width="{{ img.width }}"
                height="{{ img.height }}"
                alt="{{ m.hero_image_alt.value | default: media.alt | default: mcol.title | escape }}"
                loading="eager"
              >
            {%- else -%}
              {{ 'image' | placeholder_svg_tag: 'sdpc-card__img sdpc-card__img--placeholder' }}
            {%- endif -%}
            <div class="sdpc-card__badges">
              <span class="sdpc-badge">{{ size_count }} sizes</span>
            </div>
          </div>
          <div class="sdpc-card__body sdpm-card__body">
            <p class="sdpc-card__material sdp-label">{% if mat == 'composite' %}Composite{% else %}Pressure-treated wood{% endif %}</p>
            <h2 class="sdpc-card__title sdpm-card__title">
              <a href="{{ mcol.url }}" class="sdpc-card__link">{{ m.name.value | default: mcol.title | escape }}</a>
            </h2>
            {%- if m.hero_lede != blank -%}
              <p class="sdpm-card__lede">{{ m.hero_lede.value | escape }}</p>
            {%- endif -%}
            <ul class="sdpm-card__points">
              {%- if decking != blank -%}<li><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8.5l3.2 3L13 4.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg><span>{{ decking | escape }}</span></li>{%- endif -%}
              {%- if warranty != blank -%}<li><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8.5l3.2 3L13 4.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg><span>{{ warranty | escape }}</span></li>{%- endif -%}
            </ul>
            <div class="sdpc-card__foot">
              <div class="sdpc-card__price">
                <span class="sdpc-card__was">From</span>
                <span class="sdpc-card__now">{{ mv.price | money_without_trailing_zeros }}</span>
              </div>
              <span class="sdpm-card__button">
                {{ section.settings.card_button | default: 'Shop' | escape }}
                <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
            </div>
          </div>
        </article>
      {%- endfor -%}
    </div>

    {%- if section.settings.show_compare and compare_rows.size > 0 -%}
      <div class="sdpm__compare">
        {%- if section.settings.compare_heading != blank -%}
          <h2 class="sdp-h2 sdpm__compare-title">{{ section.settings.compare_heading | escape }}</h2>
        {%- endif -%}
        <div class="sdpm__table-wrap">
          <table class="sdpm__table">
            <thead>
              <tr>
                <th scope="col"><span class="visually-hidden">Feature</span></th>
                {%- for h in hub_handles -%}
                  {%- assign m = nil -%}
                  {%- for candidate in all_entries -%}{%- if candidate.system.handle == h -%}{%- assign m = candidate -%}{%- break -%}{%- endif -%}{%- endfor -%}
                  {%- if m == nil or m.collection.value.url == blank -%}{%- continue -%}{%- endif -%}
                  <th scope="col"><a href="{{ m.collection.value.url }}">{{ m.name.value | escape }}</a></th>
                {%- endfor -%}
              </tr>
            </thead>
            <tbody>
              {%- for line in compare_rows -%}
                {%- assign line = line | strip -%}
                {%- if line == blank -%}{%- continue -%}{%- endif -%}
                {%- assign row_label = line | split: '=' | first | strip -%}
                {%- assign row_keys = line | split: '=' | last | split: '/' -%}
                <tr>
                  <th scope="row">{{ row_label | escape }}</th>
                  {%- for h in hub_handles -%}
                    {%- assign m = nil -%}
                    {%- for candidate in all_entries -%}{%- if candidate.system.handle == h -%}{%- assign m = candidate -%}{%- break -%}{%- endif -%}{%- endfor -%}
                    {%- if m == nil or m.collection.value.url == blank -%}{%- continue -%}{%- endif -%}
                    {%- liquid
                      assign cell = ''
                      for key in row_keys
                        assign key = key | strip
                        if key == 'price'
                          assign fv = m.variants.value | first
                          assign cell = fv.price | money_without_trailing_zeros | prepend: 'From '
                        else
                          for row in m.specs.value
                            assign rk = row | split: '|' | first | strip
                            if rk == key
                              assign cell = row | remove_first: rk | remove_first: '|' | strip
                              break
                            endif
                          endfor
                        endif
                        if cell != blank
                          break
                        endif
                      endfor
                    -%}
                    <td>{{ cell | default: '—' | escape }}</td>
                  {%- endfor -%}
                </tr>
              {%- endfor -%}
            </tbody>
          </table>
        </div>
      </div>
    {%- endif -%}
  </div>
</div>

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    "name": {{ collection.title | json }},
    "itemListElement": [
      {%- assign ld_i = 0 -%}
      {%- for h in hub_handles -%}
        {%- assign m = nil -%}
        {%- for candidate in all_entries -%}{%- if candidate.system.handle == h -%}{%- assign m = candidate -%}{%- break -%}{%- endif -%}{%- endfor -%}
        {%- if m == nil or m.collection.value.url == blank -%}{%- continue -%}{%- endif -%}
        {%- assign ld_i = ld_i | plus: 1 -%}
        {%- if ld_i > 1 -%},{%- endif -%}
        {
          "@type": "ListItem",
          "position": {{ ld_i }},
          "url": {{ request.origin | append: m.collection.value.url | json }},
          "name": {{ m.collection.value.title | json }}
        }
      {%- endfor -%}
    ]
  }
</script>
{%- endpaginate -%}

{% schema %}
{
  "name": "SDP · Material cards",
  "tag": "section",
  "class": "section",
  "enabled_on": { "templates": ["collection"] },
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Shop by material" },
    { "type": "text", "id": "heading", "label": "Heading (H1)", "info": "Leave blank to use the collection title." },
    { "type": "checkbox", "id": "show_description", "label": "Show collection description", "default": true },
    { "type": "textarea", "id": "materials", "label": "Material cards", "info": "Comma-separated material entry handles (Content > Metaobjects > Deck size page), in display order. Each card links to the entry's collection.", "default": "wood-material,composite-material" },
    { "type": "text", "id": "card_button", "label": "Card button label", "default": "Shop all sizes" },
    { "type": "header", "content": "Comparison" },
    { "type": "checkbox", "id": "show_compare", "label": "Show comparison table", "default": true },
    { "type": "text", "id": "compare_heading", "label": "Comparison heading", "default": "Pressure-treated vs composite at a glance" },
    { "type": "textarea", "id": "compare_rows", "label": "Rows", "info": "One row per line: Label=Spec label from the entries' specs list. Use / for alternatives (e.g. Frame=Frame/Material). \"price\" shows the starting price.", "default": "Starting price=price\nSizes=Sizes\nDeck boards=Decking\nFrame=Frame/Material\nWarranty=Warranty\nDelivery=Delivery\nTools needed=Tools needed" },
    { "type": "select", "id": "background", "label": "Background", "options": [ { "value": "sand", "label": "Sand" }, { "value": "white", "label": "White" }, { "value": "cloud", "label": "Cloud" } ], "default": "sand" }
  ],
  "blocks": [
    {
      "type": "usp",
      "name": "Benefit",
      "limit": 4,
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "options": [ { "value": "truck", "label": "Truck" }, { "value": "drill", "label": "Drill" }, { "value": "shield", "label": "Shield" }, { "value": "chat", "label": "Chat" }, { "value": "phone", "label": "Phone" }, { "value": "cart", "label": "Cart" } ], "default": "truck" },
        { "type": "text", "id": "title", "label": "Title", "default": "Delivered in 10–14 days" },
        { "type": "text", "id": "text", "label": "Text", "default": "Packed in order of use" }
      ]
    }
  ],
  "presets": [ { "name": "SDP · Material cards" } ]
}
{% endschema %}
