{{ 'rv-landing.css' | asset_url | stylesheet_tag }}
{{ 'fin-landing.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  Deck Financing page · How to Finance (HowTo). Figma › Section - How to Finance (6666:574).
  One `step` block per card, numbered automatically. Emits HowTo JSON-LD.
{%- endcomment -%}

<div class="rv fin rv--mist fin-steps"{% if section.settings.anchor_id != blank %} id="{{ section.settings.anchor_id | handle }}"{% endif %}>
  <div class="rv__inner">
    <div class="fin-head">
      {%- if section.settings.eyebrow != blank -%}
        <p class="rv-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="rv-h2">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.intro != blank -%}
        <p class="fin-head__sub">{{ section.settings.intro | escape }}</p>
      {%- endif -%}
    </div>

    <ol class="fin-steps__list" role="list">
      {%- for block in section.blocks -%}
        <li class="fin-step" {{ block.shopify_attributes }}>
          <span class="fin-step__num" aria-hidden="true">{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</span>
          {%- if block.settings.title != blank -%}
            <h3 class="fin-step__title">{{ block.settings.title | escape }}</h3>
          {%- endif -%}
          {%- if block.settings.text != blank -%}
            <p class="fin-step__text">{{ block.settings.text | escape }}</p>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ol>
  </div>
</div>

{%- if section.settings.howto_schema and section.blocks.size > 0 -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "HowTo",
      "name": {{ section.settings.heading | json }},
      "description": {{ section.settings.intro | json }},
      "step": [
        {%- for block in section.blocks -%}
          {
            "@type": "HowToStep",
            "position": {{ forloop.index }},
            "name": {{ block.settings.title | json }},
            "text": {{ block.settings.text | json }}
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Financing · Steps",
  "tag": "section",
  "class": "section",
  "enabled_on": { "templates": ["page"] },
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "anchor_id", "label": "Anchor ID", "default": "how-it-works" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Step by step" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "How to Finance Your Deck in 5 Steps" },
    { "type": "textarea", "id": "intro", "label": "Intro", "default": "Most shoppers are done in a few minutes, right inside checkout." },
    { "type": "checkbox", "id": "howto_schema", "label": "Output HowTo schema", "default": true }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "title", "label": "Title (H3)", "default": "Choose your deck kit" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Pick pressure-treated wood or composite and your size." }
      ]
    }
  ],
  "presets": [{ "name": "Financing · Steps", "blocks": [{ "type": "step" }] }]
}
{% endschema %}
