{{ 'pavers-vs-decks.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign videos = section.blocks | where: 'type', 'video'
  assign reviews = section.blocks | where: 'type', 'review'
-%}

<div class="pvd pvd-reviews pvd--white"{% if section.settings.anchor_id != blank %} id="{{ section.settings.anchor_id | handle }}"{% endif %}>
  <div class="pvd__inner">
    <div class="pvd-reviews__top">
      {%- render 'pvd-header',
        eyebrow: section.settings.eyebrow,
        heading: section.settings.heading,
        intro: section.settings.intro
      -%}
      {%- if section.settings.rating != blank -%}
        <div class="pvd-rating">
          <p class="pvd-rating__score">
            {{- section.settings.rating | escape -}}
            <span class="pvd-rating__out"> / 5</span>
          </p>
          <div class="pvd-rating__details">
            <p class="pvd-rating__text">{{ section.settings.rating_text | escape }}</p>
            <div class="pvd-badges">
              {%- if section.settings.badge_1 != blank -%}<span class="pvd-badge">{{ section.settings.badge_1 | escape }}</span>{%- endif -%}
              {%- if section.settings.badge_2 != blank -%}<span class="pvd-badge">{{ section.settings.badge_2 | escape }}</span>{%- endif -%}
            </div>
          </div>
        </div>
      {%- endif -%}
    </div>

    {%- if videos.size > 0 -%}
      <div class="pvd-videos">
        {%- for block in videos -%}
          <div class="pvd-video" {{ block.shopify_attributes }}>
            <div class="pvd-media"{% if block.settings.video != blank %} data-pvd-video{% endif %}>
              {%- if block.settings.poster != blank -%}
                {{
                  block.settings.poster
                  | image_url: width: 800
                  | image_tag:
                    widths: '300, 400, 600, 800',
                    sizes: '(min-width: 1520px) 346px, (min-width: 990px) calc(25vw - 34px), (min-width: 750px) calc(50vw - 41px), 68vw',
                    loading: 'lazy',
                    alt: block.settings.poster.alt
                }}
              {%- elsif block.settings.video != blank -%}
                {{ block.settings.video.preview_image | image_url: width: 800 | image_tag: loading: 'lazy', alt: block.settings.title }}
              {%- else -%}
                {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}

              {%- if block.settings.video != blank -%}
                {%- comment -%}
                  Same behaviour as the reviews wall (sections/verified-reviews-wall-new.liquid):
                  muted loop, plays on hover, rewinds on leave. The poster attribute is dropped
                  so only the image above is downloaded up front.
                {%- endcomment -%}
                {%- capture pvd_video_markup -%}
                  {{ block.settings.video | video_tag: loop: true, muted: true, playsinline: true, preload: 'none' }}
                {%- endcapture -%}
                {{ pvd_video_markup | replace: ' poster="', ' data-unused-poster="' | replace: '<img src="', '<img data-unused-src="' }}
                <span class="pvd-video__play" aria-hidden="true">{%- render 'pvd-icon', name: 'play' -%}</span>
                <button type="button" class="pvd-video__mute" aria-label="Unmute video: {{ block.settings.title | escape }}" aria-pressed="false">
                  <svg class="pvd-video__icon-muted" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M16.5 12c0-1.77-1.02-3.29-2.5-4.03v2.21l2.45 2.45c.03-.2.05-.41.05-.63zm2.5 0c0 .94-.2 1.82-.54 2.64l1.51 1.51C20.63 14.91 21 13.5 21 12c0-4.28-2.99-7.86-7-8.77v2.06c2.89.86 5 3.54 5 6.71zM4.27 3L3 4.27 7.73 9H3v6h4l5 5v-6.73l4.25 4.25c-.67.52-1.42.93-2.25 1.18v2.06c1.38-.31 2.63-.95 3.69-1.81L19.73 21 21 19.73l-9-9L4.27 3zM12 4L9.91 6.09 12 8.18V4z"/></svg>
                  <svg class="pvd-video__icon-unmuted" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z"/></svg>
                </button>
              {%- else -%}
                <span class="pvd-video__play" aria-hidden="true">{%- render 'pvd-icon', name: 'play' -%}</span>
              {%- endif -%}
            </div>
            <p class="pvd-video__title">{{ block.settings.title | escape }}</p>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if reviews.size > 0 -%}
      <div class="pvd-grid pvd-grid--3">
        {%- for block in reviews -%}
          <blockquote class="pvd-review" {{ block.shopify_attributes }}>
            <p class="pvd-label">{{ block.settings.source | escape }}</p>
            <p class="pvd-review__text">{{ block.settings.text | escape }}</p>
            {%- if block.settings.author != blank -%}
              <footer class="pvd-review__author">{{ block.settings.author | escape }}</footer>
            {%- endif -%}
          </blockquote>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.settings.button_label != blank -%}
      <a class="pvd-btn pvd-btn--outline" href="{{ section.settings.button_link | default: '#' }}">{{ section.settings.button_label | escape }}</a>
    {%- endif -%}
  </div>
</div>

<script>
  (() => {
    const root = document.getElementById('shopify-section-{{ section.id }}');
    if (!root) return;

    const canHover = window.matchMedia('(hover: hover)').matches;

    const play = (wrapper, video) => {
      video.play().then(() => wrapper.classList.add('is-playing')).catch(() => {});
    };

    const stop = (wrapper, video) => {
      video.pause();
      video.currentTime = 0;
      wrapper.classList.remove('is-playing');
    };

    root.querySelectorAll('[data-pvd-video]').forEach((wrapper) => {
      const video = wrapper.querySelector('video');
      const muteBtn = wrapper.querySelector('.pvd-video__mute');
      if (!video) return;

      if (canHover) {
        wrapper.addEventListener('mouseenter', () => play(wrapper, video));
        wrapper.addEventListener('mouseleave', () => stop(wrapper, video));
      } else {
        // Touch screens have no hover: tap the card to start / stop.
        wrapper.addEventListener('click', (event) => {
          if (event.target.closest('.pvd-video__mute')) return;
          if (video.paused) {
            root.querySelectorAll('[data-pvd-video].is-playing').forEach((other) => {
              if (other !== wrapper) stop(other, other.querySelector('video'));
            });
            play(wrapper, video);
          } else {
            stop(wrapper, video);
          }
        });
      }

      if (muteBtn) {
        muteBtn.addEventListener('click', (event) => {
          event.stopPropagation();
          video.muted = !video.muted;
          muteBtn.classList.toggle('is-unmuted', !video.muted);
          muteBtn.setAttribute('aria-pressed', String(!video.muted));
          if (video.paused) play(wrapper, video);
        });
      }
    });
  })();
</script>

{% schema %}
{
  "name": "PvD · Customer confidence",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "anchor_id", "label": "Anchor ID" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "textarea", "id": "heading", "label": "Heading" },
    { "type": "textarea", "id": "intro", "label": "Intro" },
    { "type": "header", "content": "Rating" },
    { "type": "text", "id": "rating", "label": "Rating", "default": "4.8" },
    { "type": "text", "id": "rating_text", "label": "Rating text" },
    { "type": "text", "id": "badge_1", "label": "Badge 1", "default": "Trustpilot" },
    { "type": "text", "id": "badge_2", "label": "Badge 2", "default": "Google Reviews" },
    { "type": "header", "content": "Button" },
    { "type": "text", "id": "button_label", "label": "Label", "default": "See All Customer Reviews" },
    { "type": "url", "id": "button_link", "label": "Link" }
  ],
  "blocks": [
    {
      "type": "video",
      "name": "Customer video",
      "settings": [
        { "type": "image_picker", "id": "poster", "label": "Poster image" },
        { "type": "video", "id": "video", "label": "Video", "info": "Plays muted on hover (tap on mobile), like the reviews page" },
        { "type": "text", "id": "title", "label": "Title" }
      ]
    },
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "text", "id": "source", "label": "Label", "default": "★★★★★ · Trustpilot" },
        { "type": "textarea", "id": "text", "label": "Review text" },
        { "type": "text", "id": "author", "label": "Author" }
      ]
    }
  ],
  "presets": [{ "name": "PvD · Customer confidence" }]
}
{% endschema %}
