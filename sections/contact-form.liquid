{{ 'section-contact-form.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  /* Custom Layout Styles */
  .custom-contact-container {
    display: grid;
    grid-template-columns: 1fr;
    gap: 30px;
    max-width: 1200px;
    margin: 0 auto;
  }

  @media screen and (min-width: 990px) {
    .custom-contact-container {
      grid-template-columns: 1.2fr 0.8fr;
    }
  }

  .custom-contact-form-card {
    background: #ffffff;
    border-radius: 20px;
    padding: 40px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.03);
  }

  .custom-contact-form-card .title {
    margin-top: 0;
    margin-bottom: 30px;
  }

  .custom-contact-fields-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-bottom: 20px;
  }

  @media screen and (max-width: 749px) {
    .custom-contact-fields-grid {
      grid-template-columns: 1fr;
    }
  }

  .custom-input-group {
    display: flex;
    flex-direction: column;
    margin-bottom: 20px;
  }

  .custom-input-label {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: #888;
    margin-bottom: 8px;
    font-weight: 600;
  }

  .custom-input-field {
    background-color: #f7f7f7;
    border: 1px solid #f0f0f0;
    border-radius: 10px;
    padding: 14px 16px;
    font-size: 14px;
    color: #333;
    width: 100%;
    box-sizing: border-box;
    outline: none;
  }

  .custom-input-field:focus {
    border-color: #000;
  }

  .custom-submit-btn {
    background-color: #121212;
    color: #ffffff;
    border: none;
    border-radius: 12px;
    padding: 16px 32px;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.3s ease;
  }

  .custom-submit-btn:hover {
    background-color: #333333;
  }

  /* Right Side Info Cards */
  .custom-contact-info-list {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .custom-info-card {
    background: #ffffff;
    border-radius: 18px;
    padding: 24px;
    display: flex;
    align-items: flex-start;
    gap: 16px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.03);
    text-decoration: none;
    color: inherit;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .custom-info-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 35px rgba(0,0,0,0.06);
  }

  .custom-info-icon {
    width: 42px;
    height: 42px;
    background-color: #f7f7f7;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: background-color 0.2s ease;
  }

  .custom-info-card:hover .custom-info-icon {
    background-color: #ebebeb;
  }

  .custom-info-icon svg {
    width: 20px;
    height: 20px;
    stroke: #333;
  }

  .custom-info-content h3 {
    margin: 0 0 6px 0;
    font-size: 18px;
    font-weight: 600;
  }

  .custom-info-content p {
    margin: 0;
    font-size: 13px;
    color: #666;
    line-height: 1.5;
  }

  .custom-info-content strong {
    color: #000;
    font-weight: 600;
    transition: color 0.2s ease;
  }

  .custom-info-card:hover .custom-info-content strong {
    color: #0056b3;
  }

  /* .custom-info-card-address p {
    white-space: pre-line;
  } */

  /* Media Card Container */
  .custom-contact-media-card {
    position: relative;
    border-radius: 20px;
    overflow: hidden;
    height: 220px;
    background-color: #eee;
  }

  .custom-contact-media-card::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 60%;
    background: linear-gradient(to top, rgba(255, 255, 255, 0.95) 0%, rgba(255, 255, 255, 0.6) 48%, rgba(255, 255, 255, 0) 100%);
    pointer-events: none;
    z-index: 1;
  }

  .custom-contact-media-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .custom-media-overlay {
    position: absolute;
    bottom: 20px;
    left: 20px;
    right: 20px;
    color: #fff;
    font-size: 15px;
    font-weight: 400;
    z-index: 2;
    text-shadow: 2px 2px 10px rgb(0 0 0);
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="contact page-width section-{{ section.id }}-padding">
    <div class="custom-contact-container">
      
      <!-- LEFT COLUMN: Contact Form -->
      <div class="custom-contact-form-card">
        {%- if section.settings.heading != blank -%}
          <h2 class="title">
            {{ section.settings.heading }}
          </h2>
        {%- endif -%}

        {%- liquid
          assign contact_form_class = 'isolate'
          if settings.animations_reveal_on_scroll
            assign contact_form_class = 'isolate scroll-trigger animate--slide-in'
          endif
        -%}

        {%- form 'contact', id: 'ContactForm', class: contact_form_class -%}
          {%- if form.posted_successfully? -%}
            <h2 class="form-status form-status-list form__message" tabindex="-1" autofocus>
              {{- 'icon-success.svg' | inline_asset_content -}}
              {{ 'templates.contact.form.post_success' | t }}
            </h2>
          {%- elsif form.errors -%}
            <div class="form__message">
              <h2 class="form-status caption-large text-body" role="alert" tabindex="-1" autofocus>
                {{- 'icon-error.svg' | inline_asset_content -}}
                {{ 'templates.contact.form.error_heading' | t }}
              </h2>
            </div>
            <ul class="form-status-list caption-large" role="list">
              <li>
                <a href="#ContactForm-email" class="link">
                  {{ form.errors.translated_fields.email | capitalize }}
                  {{ form.errors.messages.email }}
                </a>
              </li>
            </ul>
          {%- endif -%}

          <div class="custom-contact-fields-grid">
            <div class="custom-input-group">
              <label class="custom-input-label" for="ContactForm-name">Full Name</label>
              <input
                class="custom-input-field"
                autocomplete="name"
                type="text"
                id="ContactForm-name"
                name="contact[Full Name]"
                value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
                placeholder="John Doe"
              >
            </div>

            <div class="custom-input-group">
              <label class="custom-input-label" for="ContactForm-email">Email Address</label>
              <input
                autocomplete="email"
                type="email"
                id="ContactForm-email"
                class="custom-input-field"
                name="contact[email]"
                spellcheck="false"
                autocapitalize="off"
                value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
                aria-required="true"
                placeholder="john@example.com"
              >
            </div>
          </div>

          <div class="custom-input-group">
            <label class="custom-input-label" for="ContactForm-phone">Phone Number</label>
            <input
              type="tel"
              id="ContactForm-phone"
              class="custom-input-field"
              autocomplete="tel"
              name="contact[Phone Number]"
              pattern="[0-9\-]*"
              value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
              placeholder="1(000) 000-0000"
            >
          </div>

          <div class="custom-input-group">
            <label class="custom-input-label" for="ContactForm-body">Message</label>
            <textarea
              rows="6"
              id="ContactForm-body"
              class="custom-input-field"
              name="contact[body]"
              placeholder="How can our specialists assist you today?"
            >{{- form.body -}}</textarea>
          </div>

          <div class="contact__button">
            <button type="submit" class="custom-submit-btn">
              Submit Inquiry
            </button>
          </div>
        {%- endform -%}
      </div>

      <!-- RIGHT COLUMN: Contact Info & Media Block -->
      <div class="custom-contact-info-list">
        
        <!-- Email Card -->
        {%- if section.settings.email_address != blank -%}
          <a href="mailto:{{ section.settings.email_address }}" class="custom-info-card">
            <div class="custom-info-icon">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
              </svg>
            </div>
            <div class="custom-info-content">
              <h3>Email Us</h3>
              <p><strong>{{ section.settings.email_address }}</strong></p>
              {%- if section.settings.email_subtext != blank -%}
                <p>{{ section.settings.email_subtext }}</p>
              {%- endif -%}
            </div>
          </a>
        {%- endif -%}

        <!-- Phone Card -->
        {%- if section.settings.phone_number != blank -%}
          {%- assign clean_phone = section.settings.phone_number | replace: ' ', '' | replace: '(', '' | replace: ')', '' | replace: '-', '' -%}
          <a href="tel:{{ clean_phone }}" class="custom-info-card">
            <div class="custom-info-icon">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-2.826-1.47-5.114-3.758-6.584-6.584l1.293-.97c.362-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
              </svg>
            </div>
            <div class="custom-info-content">
              <h3>Call Us</h3>
              <p><strong>{{ section.settings.phone_number }}</strong></p>
              {%- if section.settings.phone_subtext != blank -%}
                <p>{{ section.settings.phone_subtext }}</p>
              {%- endif -%}
            </div>
          </a>
        {%- endif -%}

        <!-- Address Card -->
        {%- if section.settings.address_text != blank -%}
          {%- liquid
            if section.settings.map_url != blank
              assign google_map_link = section.settings.map_url
            else
              assign google_map_link = 'https://maps.google.com/?q=' | append: section.settings.address_text | url_encode
            endif
          -%}
          <a href="{{ google_map_link }}" target="_blank" rel="noopener noreferrer" class="custom-info-card custom-info-card-address">
            <div class="custom-info-icon">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
              </svg>
            </div>
            <div class="custom-info-content">
              <h3>Studio Address</h3>
              <p>{{ section.settings.address_text }}</p>
            </div>
          </a>
        {%- endif -%}

        <!-- Media/Image Card -->
        {%- if section.settings.side_image != blank -%}
          <div class="custom-contact-media-card">
            <img src="{{ section.settings.side_image | image_url: width: 800 }}" alt="Studio Image" loading="lazy">
            {%- if section.settings.image_caption != blank -%}
              <div class="custom-media-overlay">
                {{ section.settings.image_caption }}
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}

      </div>

    </div>
  </div>
</div>

{% schema %}
{
  "name": "Custom Contact Form",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "default": "Send a Message",
      "label": "Heading"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Contact Info Settings"
    },
    {
      "type": "text",
      "id": "email_address",
      "label": "Email Address",
      "default": "support@a-diy.com"
    },
    {
      "type": "text",
      "id": "email_subtext",
      "label": "Email Subtext",
      "default": "Response within one business day"
    },
    {
      "type": "text",
      "id": "phone_number",
      "label": "Phone Number",
      "default": "1 (786) 358-2872"
    },
    {
      "type": "text",
      "id": "phone_subtext",
      "label": "Phone Subtext",
      "default": "Mon–Fri, 9:00 AM–5:00 PM EST"
    },
    {
      "type": "textarea",
      "id": "address_text",
      "label": "Studio Address",
      "default": "53 Knightsbridge Rd Suite 204,\nPiscataway, NJ 08854"
    },
    {
      "type": "url",
      "id": "map_url",
      "label": "Custom Google Map URL (Optional)",
      "info": "Leave blank to automatically query Google Maps with the address text."
    },
    {
      "type": "header",
      "content": "Side Image Settings"
    },
    {
      "type": "image_picker",
      "id": "side_image",
      "label": "Side Image"
    },
    {
      "type": "text",
      "id": "image_caption",
      "label": "Image Caption Text",
      "default": "Engineering Excellence, Delivered to Your Door."
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "Custom Contact Form"
    }
  ]
}
{% endschema %}