{{ 'sdp.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  Size deck page · Cross-link card. Points the wood page at its composite twin (and vice
  versa): image on the left, eyebrow / heading / text, one button on the right.
{%- endcomment -%}

{%- liquid
  assign twin_product = section.settings.twin_product
  assign twin_size = section.settings.size_option
  assign xlink = section.settings.button_link
  assign link_filter = section.settings.link_filter
  assign x_image = section.settings.image
  assign x_focal = section.settings.image_focal
  assign x_alt = section.settings.image_alt
  assign x_eyebrow = section.settings.eyebrow
  assign x_heading = section.settings.heading
  assign x_text = section.settings.text
  assign x_label = section.settings.button_label

  comment
    Deck size page: the entry's twin (same size, other material) gives the price and the
    link; without a twin, the other material's main product priced from its first size
    and the entry's link (usually the Deck Kits by Size collection, opened on that tab).
  endcomment
  assign sdp = page.metafields.custom.deck_size.value
  if template.name == 'collection'
    assign sdp = collection.metafields.custom.deck_size.value
  endif
  if sdp != blank
    assign product = sdp.product.value
    assign twin = sdp.twin.value
    if sdp.material.value == 'composite'
      assign other_material = 'wood'
      assign twin_product = all_products['pressure-treated-kiln-dried-wood-deck-kit']
    else
      assign other_material = 'composite'
      assign twin_product = all_products['a-diy-composite-deck-kit']
    endif
    assign twin_size = ''
    if twin != blank
      assign twin_product = twin.product.value
      assign twin_size = twin.width.value | append: ' x ' | append: twin.length.value
      capture xlink
        render 'sdp-entry-url', entry: twin
      endcapture
      assign xlink = xlink | strip
      assign link_filter = 'none'
    else
      assign xlink = sdp.xl_link.value | default: xlink
      assign link_filter = other_material
    endif
    if sdp.xl_image != blank
      assign x_image = sdp.xl_image.value
    endif
  endif

  capture price_line
    render 'sdp-prices', product: product, size: twin_size, discount_fallback: 0, code: '', twin: twin_product
  endcapture
  assign price_parts = price_line | strip | split: '|'
  assign p_twin = price_parts[2]

  capture x_alt
    render 'sdp-t', text: x_alt, sdp: sdp
  endcapture
  capture x_eyebrow
    render 'sdp-t', text: x_eyebrow, sdp: sdp
  endcapture
  capture x_heading
    render 'sdp-t', text: x_heading, sdp: sdp
  endcapture
  capture x_text
    render 'sdp-t', text: x_text, sdp: sdp
  endcapture
  capture x_label
    render 'sdp-t', text: x_label, sdp: sdp
  endcapture
  assign x_alt = x_alt | strip
  assign x_eyebrow = x_eyebrow | strip
  assign x_heading = x_heading | strip
  assign x_text = x_text | strip
  assign x_label = x_label | strip
-%}

<div class="sdp sdp-crosslink sdp--sand"{% if section.settings.anchor_id != blank %} id="{{ section.settings.anchor_id | handle }}"{% endif %}>
  <div class="sdp__inner">
    <div class="sdp-crosslink__card">
      {%- assign image_alt = x_alt | default: x_heading -%}
      {%- render 'sdp-image',
        image: x_image,
        class: 'sdp-crosslink__media',
        sizes: '(min-width: 990px) 295px, calc(100vw - 48px)',
        focal: x_focal,
        alt: image_alt
      -%}
      <div class="sdp-crosslink__body">
        <div class="sdp-crosslink__copy">
          {%- if x_eyebrow != blank -%}
            <p class="sdp-label">{{ x_eyebrow | escape }}</p>
          {%- endif -%}
          {%- if x_heading != blank -%}
            <h2 class="sdp-crosslink__title">{{ x_heading | escape }}</h2>
          {%- endif -%}
          {%- if x_text != blank -%}
            <p class="sdp-crosslink__text">{{ x_text | escape | replace: '[twin_price]', p_twin }}</p>
          {%- endif -%}
        </div>
        {%- if x_label != blank -%}
          {%- if xlink == blank and section.settings.twin_product != blank -%}{%- assign xlink = section.settings.twin_product.url -%}{%- endif -%}
          {%- if xlink != blank and link_filter != 'none' and link_filter != blank and xlink contains '/collections/' -%}
            {%- assign xlink = xlink | append: '?material=' | append: link_filter -%}
          {%- endif -%}
          <a class="sdp-btn sdp-btn--sm" href="{{ xlink | default: '#' }}">
            {{ x_label | escape }}
            {%- render 'sdp-icon', name: 'arrow-right' -%}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "SDP · Cross-link card",
  "tag": "section",
  "class": "section",
  "enabled_on": { "templates": ["product", "collection", "page"] },
  "settings": [
    { "type": "text", "id": "anchor_id", "label": "Anchor ID" },
    { "type": "product", "id": "twin_product", "label": "Same size in the other material", "info": "Its price fills [twin_price] in the text." },
    { "type": "text", "id": "size_option", "label": "Size variant", "info": "e.g. \"12 x 12\" — picks the twin's variant for [twin_price].", "default": "12 x 12" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "image_focal", "label": "Image focal point (CSS object-position)", "default": "50% 50%" },
    { "type": "text", "id": "image_alt", "label": "Image alt text (SEO)", "default": "12x12 A-DIY composite deck kit beside a pool" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Prefer low maintenance?" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The same 12x12 deck is also available in composite" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "[twin_price] · Amazon Gray or Forest Wood · stain and fade resistant · 25-year warranty on the composite boards. Same engineered frame, same weekend build." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "See the 12×12 composite deck" },
    { "type": "url", "id": "button_link", "label": "Button link", "info": "Leave blank to link to the twin product." },
    { "type": "select", "id": "link_filter", "label": "Open the Deck Kits by Size collection on", "info": "Only for a collection link: preselects that material tab.", "options": [ { "value": "none", "label": "All sizes" }, { "value": "wood", "label": "Pressure-treated wood" }, { "value": "composite", "label": "Composite" }, { "value": "compact", "label": "Compact series" } ], "default": "none" }
  ],
  "presets": [{ "name": "SDP · Cross-link card" }]
}
{% endschema %}
