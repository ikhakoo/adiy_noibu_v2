{{ 'sdp.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  Size deck page · Cross-link card. Points the wood page at its composite twin (and vice
  versa): image on the left, eyebrow / heading / text, one button on the right.
{%- endcomment -%}

<div class="sdp sdp-crosslink sdp--sand"{% if section.settings.anchor_id != blank %} id="{{ section.settings.anchor_id | handle }}"{% endif %}>
  <div class="sdp__inner">
    <div class="sdp-crosslink__card">
      {%- render 'sdp-image',
        image: section.settings.image,
        class: 'sdp-crosslink__media',
        sizes: '(min-width: 990px) 295px, calc(100vw - 48px)',
        focal: section.settings.image_focal,
        alt: section.settings.heading
      -%}
      <div class="sdp-crosslink__body">
        <div class="sdp-crosslink__copy">
          {%- if section.settings.eyebrow != blank -%}
            <p class="sdp-label">{{ section.settings.eyebrow | escape }}</p>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <h2 class="sdp-crosslink__title">{{ section.settings.heading | escape }}</h2>
          {%- endif -%}
          {%- if section.settings.text != blank -%}
            <p class="sdp-crosslink__text">{{ section.settings.text | escape }}</p>
          {%- endif -%}
        </div>
        {%- if section.settings.button_label != blank -%}
          <a class="sdp-btn sdp-btn--sm" href="{{ section.settings.button_link | default: '#' }}">
            {{ section.settings.button_label | escape }}
            {%- render 'sdp-icon', name: 'arrow-right' -%}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "SDP · Cross-link card",
  "tag": "section",
  "class": "section",
  "enabled_on": { "templates": ["product", "collection", "page"] },
  "settings": [
    { "type": "text", "id": "anchor_id", "label": "Anchor ID" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "image_focal", "label": "Image focal point (CSS object-position)", "default": "50% 50%" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Prefer low maintenance?" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The same 12x12 deck is also available in composite" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "$5,700 · Amazon Gray or Forest Wood · stain and fade resistant · 25-year warranty on the structure and boards. Same engineered frame, same weekend build." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "See the 12×12 composite deck" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [{ "name": "SDP · Cross-link card" }]
}
{% endschema %}
