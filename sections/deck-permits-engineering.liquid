{%- style -%}
  .deck-permits-{{ section.id }} {
    background-color: {{ section.settings.section_bg }};
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }

  @media screen and (min-width: 750px) {
    .deck-permits-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_desktop }}px;
      padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
    }
  }

  .deck-permits-grid-{{ section.id }} {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  @media screen and (min-width: 990px) {
    .deck-permits-grid-{{ section.id }} {
      display: grid;
      grid-template-columns: 1.15fr 0.85fr;
      gap: 48px;
      align-items: start;
    }
  }

  /* Top Content Block with Accent Border */
  .deck-permits-top-block-{{ section.id }} {
    border-left: 3px solid {{ section.settings.accent_border_color }};
    padding-left: 20px;
    margin-bottom: 2rem;
  }

  .deck-permits-title-{{ section.id }} {
    font-size: 18px;
    font-weight: 600;
    color: #1a1a1a;
    line-height: 1.25;
    margin: 0 0 1.25rem 0;
  }

  @media screen and (min-width: 750px) {
    .deck-permits-title-{{ section.id }} {
      font-size: 26px;
    }
  }

  .deck-permits-text-{{ section.id }} {
    font-size: 13.5px;
    line-height: 1.6;
    color: #555555;
  }

  .deck-permits-text-{{ section.id }} p {
    margin: 0 0 1rem 0;
    font-size: 16px;
  }

  .deck-permits-text-{{ section.id }} p:last-child {
    margin-bottom: 0;
  }

  /* Questions List Block (Outside Border) */
  .deck-permits-questions-block-{{ section.id }} {
    padding-left: 0;
  }

  .deck-permits-subtitle-{{ section.id }} {
    font-size: 17px;
    font-weight: 600;
    color: #1a1a1a;
    margin: 0 0 0.85rem 0;
  }

  .deck-permits-list-{{ section.id }} {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .deck-permits-list-item-{{ section.id }} {
    position: relative;
    padding-left: 14px;
    font-size: 16px;
    line-height: 1.5;
    color: #444444;
    margin-bottom: 6px;
  }

  .deck-permits-list-item-{{ section.id }}::before {
    content: "•";
    position: absolute;
    left: 0;
    top: 0;
    color: #666666;
  }

  /* Right Column Visuals & Note Card */
  .deck-permits-media-{{ section.id }} {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .deck-permits-image-wrapper-{{ section.id }} {
    position: relative;
    width: 100%;
    border-radius: 16px;
    overflow: hidden;
    background-color: #f0f0f0;
    aspect-ratio: 16 / 10;
  }

  .deck-permits-image-{{ section.id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .deck-permits-note-card-{{ section.id }} {
    background-color: #ffffff;
    border-radius: 10px;
    padding: 16px 20px;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.03);
    border: 1px solid rgba(0, 0, 0, 0.04);
  }

  .deck-permits-note-title-{{ section.id }} {
    font-size: 13.5px;
    font-weight: 700;
    color: #1a1a1a;
    margin: 0 0 6px 0;
  }

  .deck-permits-note-text-{{ section.id }} {
    font-size: 11.5px;
    line-height: 1.5;
    color: #555555;
    margin: 0;
  }
{%- endstyle -%}

<div class="deck-permits-{{ section.id }}">
  <div class="page-width">
    <div class="deck-permits-grid-{{ section.id }}">
      
      {%- comment -%} Left Column Content {%- endcomment -%}
      <div class="deck-permits-content-{{ section.id }}">
        
        {%- comment -%} Top Block with Left Accent Border {%- endcomment -%}
        <div class="deck-permits-top-block-{{ section.id }}">
          {%- if section.settings.heading != blank -%}
            <h2 class="deck-permits-title-{{ section.id }}">{{ section.settings.heading }}</h2>
          {%- endif -%}

          {%- if section.settings.body_text != blank -%}
            <div class="deck-permits-text-{{ section.id }}">
              {{ section.settings.body_text }}
            </div>
          {%- endif -%}
        </div>

        {%- comment -%} Bottom Questions List (No Border) {%- endcomment -%}
        <div class="deck-permits-questions-block-{{ section.id }}">
          {%- if section.settings.questions_heading != blank -%}
            <h3 class="deck-permits-subtitle-{{ section.id }}">{{ section.settings.questions_heading }}</h3>
          {%- endif -%}

          {%- assign questions = section.settings.questions_list | newline_to_br | split: '<br />' -%}
          {%- if questions.size > 0 -%}
            <ul class="deck-permits-list-{{ section.id }}">
              {%- for question in questions -%}
                {%- assign clean_question = question | strip -%}
                {%- if clean_question != blank -%}
                  <li class="deck-permits-list-item-{{ section.id }}">{{ clean_question }}</li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          {%- endif -%}
        </div>

      </div>

      {%- comment -%} Right Column Media & Note {%- endcomment -%}
      <div class="deck-permits-media-{{ section.id }}">
        {%- if section.settings.image != blank -%}
          <div class="deck-permits-image-wrapper-{{ section.id }}">
            {%- assign image_class = 'deck-permits-image-' | append: section.id -%}
            {%- assign alt_text = section.settings.heading | default: 'Deck permits and engineering' | escape -%}
            {{ section.settings.image 
              | image_url: width: 1000 
              | image_tag: loading: 'lazy', class: image_class, alt: alt_text 
            }}
          </div>
        {%- endif -%}

        {%- if section.settings.note_title != blank or section.settings.note_text != blank -%}
          <div class="deck-permits-note-card-{{ section.id }}">
            {%- if section.settings.note_title != blank -%}
              <h4 class="deck-permits-note-title-{{ section.id }}">{{ section.settings.note_title }}</h4>
            {%- endif -%}
            {%- if section.settings.note_text != blank -%}
              <p class="deck-permits-note-text-{{ section.id }}">{{ section.settings.note_text }}</p>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>

    </div>
  </div>
</div>

{% schema %}
{
  "name": "Deck Permits Info",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "New York Deck Permits and A-DIY Engineering Information"
    },
    {
      "type": "richtext",
      "id": "body_text",
      "label": "Description Text",
      "default": "<p>A permit may be required depending on the deck's dimensions, height, location, attachment method and local rules.</p><p>The New York State Uniform Code establishes minimum construction standards throughout the state except New York City. Local cities, towns, villages and counties generally administer and enforce the applicable codes. New York City maintains its own construction-code and permit system.</p><p>Requirements may differ between neighboring municipalities.</p>"
    },
    {
      "type": "text",
      "id": "questions_heading",
      "label": "Questions Subtitle",
      "default": "Questions to Ask the Building Department"
    },
    {
      "type": "textarea",
      "id": "questions_list",
      "label": "Questions List (One per line)",
      "default": "Does the proposed deck require a permit?\nIs zoning approval, a site plan or a survey required?\nWhat setbacks apply?\nAre stamped plans required?\nWhat footing information must be submitted?\nWhat inspections are required?\nAre stairs or railings required at the proposed height?\nCan the homeowner perform the work?"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Section Image"
    },
    {
      "type": "text",
      "id": "note_title",
      "label": "Note Box Title",
      "default": "New York City"
    },
    {
      "type": "textarea",
      "id": "note_text",
      "label": "Note Box Text",
      "default": "New York City homeowners must follow current Department of Buildings requirements. The city may require approved plans and design work completed by a New York State licensed professional engineer or registered architect."
    },
    {
      "type": "header",
      "content": "Section Styling"
    },
    {
      "type": "color",
      "id": "section_bg",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "accent_border_color",
      "label": "Accent Border Color",
      "default": "#c67d3e"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Desktop Padding Top",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Desktop Padding Bottom",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Mobile Padding Top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Mobile Padding Bottom",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "Deck Permits Info"
    }
  ]
}
{% endschema %}