{{ 'state-seo.css' | asset_url | stylesheet_tag }}
{{ 'city-seo.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  City SEO landing page · Service area (nearby city cards).
  Page metafields: city_seo.service_heading, city_seo.service_intro, city_seo.service_cities
  (list of "State SEO · City" metaobjects: name, image, image_alt, link).
{%- endcomment -%}

{%- liquid
  assign m = page.metafields.city_seo
  assign city = m.city_name.value | default: 'your city'
  assign heading = m.service_heading.value | default: section.settings.heading | replace: '[city]', city
  assign intro = m.service_intro.value | default: section.settings.intro | replace: '[city]', city
  assign cities = m.service_cities.value
-%}

{%- if cities.size > 0 -%}
<div class="ss ss--white cs-area" id="{{ section.settings.anchor_id | default: 'service-area' | handle }}">
  <div class="ss__inner">
    <div class="cs-head cs-head--center">
      <h2 class="ss-h2">{{ heading | escape }}</h2>
      <span class="ss-bar" aria-hidden="true"></span>
      {%- if intro != blank -%}<p class="ss-lead">{{ intro | escape }}</p>{%- endif -%}
    </div>
    <ul class="cs-area__grid">
      {%- for c in cities -%}
        {%- assign label = c.name.value | default: c.name -%}
        <li class="cs-area__item">
          {%- if c.link.value != blank -%}<a href="{{ c.link.value }}">{%- endif -%}
          <div class="cs-area__img">
            {%- if c.image.value != blank -%}{{ c.image.value | image_url: width: 600 | image_tag: widths: '300, 450, 600', sizes: '(min-width: 990px) 224px, 45vw', loading: 'lazy', alt: c.image_alt.value | default: label }}{%- else -%}{{ 'image' | placeholder_svg_tag }}{%- endif -%}
          </div>
          <span class="cs-area__name">{{ label | escape }}{% render 'city-seo-icon', name: 'arrow' %}</span>
          {%- if c.link.value != blank -%}</a>{%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "City SEO · Service area",
  "tag": "section",
  "class": "section",
  "enabled_on": { "templates": ["page"] },
  "settings": [
    { "type": "paragraph", "content": "Cards come from the page metafield City SEO · Service area cities. The section hides when it is empty." },
    { "type": "text", "id": "anchor_id", "label": "Anchor ID", "default": "service-area" },
    { "type": "text", "id": "heading", "label": "Heading fallback", "default": "Deck Kit Delivery Across [city]" },
    { "type": "textarea", "id": "intro", "label": "Intro fallback" }
  ],
  "presets": [{ "name": "City SEO · Service area" }]
}
{% endschema %}
