{%- comment -%}
  Fallback alt for gallery images whose alt was never set in the Files admin.
{%- endcomment -%}
{%- assign gallery_alt_fallback = section.settings.title | default: 'A-DIY deck installed by a customer' | strip_html -%}
<div class="custom-gallery-wrapper-main mobile-layout-{{ section.settings.mobile_layout }}" style="background-color: {{ section.settings.bg_color | default: '#f7f7f7' }};">
    <div class="custom-gallery-wrapper page-width">
        {% if section.settings.title != blank or section.settings.subtitle != blank %}
            <div class="gallery-header">
            {% if section.settings.title != blank %}
                <h2>{{ section.settings.title }}</h2>
            {% endif %}
            {% if section.settings.subtitle != blank %}
                <p>{{ section.settings.subtitle }}</p>
            {% endif %}
            </div>
        {% endif %}

        <div class="gallery-blocks-container" id="GalleryBlocksContainer-{{ section.id }}">
            {% for block in section.blocks %}
              {% assign remainder = forloop.index0 | modulo: 7 %}
              {% assign block_group_index = forloop.index0 | divided_by: 7 %}
              {% assign group_hidden = false %}
              {% if block_group_index >= 2 %}
                {% assign group_hidden = true %}
              {% endif %}

              {% comment %} Start of a 7-image block grid group {% endcomment %}
              {% if remainder == 0 %}
                {% assign is_even_group = block_group_index | modulo: 2 %}
                <div class="gallery-grid-block {% if is_even_group == 0 %}featured-pos-left{% else %}featured-pos-right{% endif %} {% if group_hidden %}is-hidden{% endif %}" data-gallery-block-group="{{ block_group_index }}">
              {% endif %}

              <div class="gallery-item {% if remainder == 0 %}item-featured{% else %}item-small{% endif %}" {{ block.shopify_attributes }}>
                {% if block.settings.image != blank %}
                  <img 
                    src="{{ block.settings.image | image_url: width: 800 }}" 
                    data-full-src="{{ block.settings.image | image_url: width: 1600 }}"
                    alt="{{ block.settings.image.alt | default: gallery_alt_fallback | escape }}" 
                    loading="lazy" 
                    width="{{ block.settings.image.width }}" 
                    height="{{ block.settings.image.height }}"
                    class="gallery-lightbox-trigger"
                  >
                {% else %}
                  {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                {% endif %}
              </div>

              {% comment %} End of a 7-image block grid group OR end of loop {% endcomment %}
              {% if remainder == 6 or forloop.last %}
                </div>
              {% endif %}
            {% endfor %}
        </div>

        {% assign total_groups = section.blocks.size | divided_by: 7 %}
        {% assign total_modulo = section.blocks.size | modulo: 7 %}
        {% if total_modulo > 0 %}{% assign total_groups = total_groups | plus: 1 %}{% endif %}

        {% if total_groups > 2 %}
            <div class="gallery-load-more-btn-wrap">
              <button type="button" class="btn gallery-btn is-hidden" id="ShowLessGallery-{{ section.id }}">
                SHOW LESS
              </button>
              <button type="button" class="btn gallery-btn" id="LoadMoreGallery-{{ section.id }}">
                  LOAD MORE
              </button>
            </div>
        {% endif %}
    </div>
</div>

<!-- Lightbox Modal -->
<div class="gallery-lightbox" id="GalleryLightbox-{{ section.id }}" aria-hidden="true" role="dialog">
  <div class="lightbox-overlay"></div>
  <button type="button" class="lightbox-close" id="LightboxClose-{{ section.id }}" aria-label="Close">&times;</button>
  <div class="lightbox-stage">
    <button type="button" class="lightbox-nav lightbox-prev" id="LightboxPrev-{{ section.id }}" aria-label="Previous">&lsaquo;</button>
    <div class="lightbox-frame">
      <img src="" id="LightboxImage-{{ section.id }}" alt="" loading="lazy">
    </div>
    <button type="button" class="lightbox-nav lightbox-next" id="LightboxNext-{{ section.id }}" aria-label="Next">&rsaquo;</button>
  </div>
</div>

<style>
  .custom-gallery-wrapper {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .gallery-header {
    text-align: left;
    margin-bottom: 24px;
  }

  .gallery-header h2 {
    margin: 0 0 0.5rem 0;
    line-height: 1.2;
    color: #111;
  }

  .gallery-header p {
    font-size: 1.2rem;
    color: #666;
    margin: 0;
    letter-spacing: 0.5px;
    text-transform: uppercase;
  }

  .gallery-blocks-container {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .gallery-grid-block {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    grid-auto-rows: minmax(180px, auto);
    gap: 12px;
    transition: all 0.3s ease;
  }

  .gallery-grid-block.is-hidden {
    display: none;
  }

  .gallery-item {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    border-radius: 4px;
  }

  .gallery-item img, .gallery-item .placeholder-svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    cursor: pointer;
    transition: transform 0.3s ease;
    aspect-ratio: 1;
  }

  .gallery-item img:hover {
    transform: scale(1.03);
  }

  @media screen and (min-width: 769px) {
    .gallery-grid-block.featured-pos-left {
      grid-template-areas:
        "feat feat img2 img3 img4"
        "feat feat img5 img6 img7";
    }

    .gallery-grid-block.featured-pos-right {
      grid-template-areas:
        "img2 img3 img4 feat feat"
        "img5 img6 img7 feat feat";
    }

    .gallery-item.item-featured { grid-area: feat; }
    .gallery-item:nth-child(2) { grid-area: img2; }
    .gallery-item:nth-child(3) { grid-area: img3; }
    .gallery-item:nth-child(4) { grid-area: img4; }
    .gallery-item:nth-child(5) { grid-area: img5; }
    .gallery-item:nth-child(6) { grid-area: img6; }
    .gallery-item:nth-child(7) { grid-area: img7; }
  }

  .gallery-load-more-btn-wrap {
    display: flex;
    justify-content: center;
    gap: 12px;
    margin-top: 32px;
  }

  .gallery-btn {
    padding: 12px 32px;
    cursor: pointer;
    border-radius: 8px;
    font-size: 14px;
    border: 1px solid #194636;
    transition: background-color .3s ease, color .3s ease, box-shadow .3s ease, transform .3s ease;
    background: #EFF9F5;
    color: #000;
  }

  .gallery-btn:hover {
    border-color: #000;
    background: #000;
    color: #fff;
  }

  .gallery-btn.is-hidden {
    display: none;
  }

  .gallery-lightbox {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    z-index: 999999;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.25s ease, visibility 0.25s ease;
  }

  .gallery-lightbox.active {
    opacity: 1;
    visibility: visible;
    background: #000000c9;
  }

  .lightbox-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.75);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  .lightbox-close {
    position: absolute;
    top: 20px;
    right: 25px;
    background: transparent;
    border: none;
    color: #fff;
    font-size: 32px;
    cursor: pointer;
    z-index: 10;
    line-height: 1;
    opacity: 0.8;
    transition: opacity 0.2s;
  }

  .lightbox-close:hover { opacity: 1; }

  .lightbox-stage {
    position: relative;
    z-index: 5;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    max-width: 1200px;
    padding: 0 80px;
  }

  .lightbox-frame {
    width: 100%;
    max-width: 900px;
    height: 90vh;
    max-height: 900px;
    border-radius: 12px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .lightbox-frame img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  .lightbox-nav {
    background: rgba(255, 255, 255, 0.25);
    border: 1px solid rgba(255, 255, 255, 0.3);
    color: #fff;
    font-size: 28px;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 6;
    transition: all 0.2s ease;
  }

  .lightbox-nav:hover {
    background: rgba(255, 255, 255, 0.8);
    color: #000;
  }

  .lightbox-prev { left: 15px; }
  .lightbox-next { right: 15px; }

  @media screen and (max-width: 768px) {
    .gallery-grid-block {
      grid-template-columns: repeat(2, 1fr);
      grid-auto-rows: minmax(150px, auto);
      gap: 8px;
    }

    .gallery-item.item-featured {
      grid-column: span 2 !important;
      grid-row: span 2 !important;
    }

    .mobile-layout-grid_2_col .gallery-blocks-container {
      display: grid !important;
      grid-template-columns: repeat(2, 1fr) !important;
      gap: 8px !important;
    }

    .mobile-layout-grid_2_col .gallery-grid-block {
      display: contents !important;
    }

    .mobile-layout-grid_2_col .gallery-grid-block.is-hidden {
      display: none !important;
    }

    .mobile-layout-grid_2_col .gallery-item.item-featured,
    .mobile-layout-grid_2_col .gallery-item.item-small {
      grid-column: span 1 !important;
      grid-row: span 1 !important;
      height: 100% !important;
    }

    .mobile-layout-grid_2_col .gallery-item img {
      aspect-ratio: 1 / 1;
      object-fit: cover;
    }

    .lightbox-stage { padding: 0 10px; }
    .lightbox-frame { height: 60vh; max-width: 90vw; border-radius: 8px; }
    .lightbox-nav { width: 38px; height: 38px; font-size: 22px; background: rgba(0, 0, 0, 0.5); }
    .lightbox-prev { left: 20px; }
    .lightbox-next { right: 20px; }
  }

@media screen and (max-width: 749px) {

  /* Lightbox close was an unsized &times; glyph (~20x32); nav buttons 38x38. */
  .lightbox-close {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
  }
  .lightbox-nav {
    width: 44px;
    height: 44px;
  }
}
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const sectionId = '{{ section.id }}';
    const container = document.getElementById(`GalleryBlocksContainer-${sectionId}`);
    const loadMoreBtn = document.getElementById(`LoadMoreGallery-${sectionId}`);
    const showLessBtn = document.getElementById(`ShowLessGallery-${sectionId}`);

    const lightbox = document.getElementById(`GalleryLightbox-${sectionId}`);
    const lightboxImg = document.getElementById(`LightboxImage-${sectionId}`);
    const closeBtn = document.getElementById(`LightboxClose-${sectionId}`);
    const prevBtn = document.getElementById(`LightboxPrev-${sectionId}`);
    const nextBtn = document.getElementById(`LightboxNext-${sectionId}`);

    let galleryImages = [];
    let currentIndex = 0;

    if (loadMoreBtn && showLessBtn && container) {
      const blocks = Array.from(container.querySelectorAll('.gallery-grid-block'));

      function updateButtons() {
        const hiddenBlocks = blocks.filter(b => b.classList.contains('is-hidden'));
        const visibleBlocks = blocks.filter(b => !b.classList.contains('is-hidden'));

        if (hiddenBlocks.length === 0) {
          loadMoreBtn.classList.add('is-hidden');
        } else {
          loadMoreBtn.classList.remove('is-hidden');
        }

        if (visibleBlocks.length > 2) {
          showLessBtn.classList.remove('is-hidden');
        } else {
          showLessBtn.classList.add('is-hidden');
        }
      }

      loadMoreBtn.addEventListener('click', function() {
        const firstHidden = blocks.find(b => b.classList.contains('is-hidden'));
        if (firstHidden) {
          firstHidden.classList.remove('is-hidden');
          updateButtons();
        }
      });

      showLessBtn.addEventListener('click', function() {
        const visibleBlocks = blocks.filter(b => !b.classList.contains('is-hidden'));
        if (visibleBlocks.length > 2) {
          const lastVisible = visibleBlocks[visibleBlocks.length - 1];
          lastVisible.classList.add('is-hidden');
          updateButtons();
        }
      });
    }

    function refreshGalleryImages() {
      galleryImages = Array.from(container.querySelectorAll('.gallery-lightbox-trigger'));
    }

    function openLightbox(index) {
      refreshGalleryImages();
      if (index < 0 || index >= galleryImages.length) return;
      
      currentIndex = index;
      const targetImg = galleryImages[currentIndex];
      const fullSrc = targetImg.getAttribute('data-full-src') || targetImg.src;

      lightboxImg.src = fullSrc;
      lightboxImg.alt = targetImg.getAttribute('alt') || '';
      lightbox.classList.add('active');
      lightbox.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }

    function closeLightbox() {
      lightbox.classList.remove('active');
      lightbox.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }

    function showNext() {
      refreshGalleryImages();
      currentIndex = (currentIndex + 1) % galleryImages.length;
      openLightbox(currentIndex);
    }

    function showPrev() {
      refreshGalleryImages();
      currentIndex = (currentIndex - 1 + galleryImages.length) % galleryImages.length;
      openLightbox(currentIndex);
    }

    container.addEventListener('click', function(e) {
      if (e.target.classList.contains('gallery-lightbox-trigger')) {
        refreshGalleryImages();
        const index = galleryImages.indexOf(e.target);
        if (index !== -1) {
          openLightbox(index);
        }
      }
    });

    if (closeBtn) closeBtn.addEventListener('click', closeLightbox);
    if (nextBtn) nextBtn.addEventListener('click', showNext);
    if (prevBtn) prevBtn.addEventListener('click', showPrev);

    if (lightbox) {
      lightbox.addEventListener('click', function(e) {
        if (!e.target.closest('.lightbox-frame') && !e.target.closest('.lightbox-nav')) {
          closeLightbox();
        }
      });
    }

    document.addEventListener('keydown', function(e) {
      if (!lightbox.classList.contains('active')) return;
      if (e.key === 'Escape') closeLightbox();
      if (e.key === 'ArrowRight') showNext();
      if (e.key === 'ArrowLeft') showPrev();
    });
  });
</script>

{% schema %}
{
  "name": "A-DIY Real Life Gallery 2",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Poly & Bark, in real life"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subheading",
      "default": "USE #POLYANDBARK AND TAG US @POLYANDBARK"
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "Mobile Layout Style",
      "default": "featured",
      "options": [
        {
          "value": "featured",
          "label": "Featured Layout (1 Big Image + Small Images)"
        },
        {
          "value": "grid_2_col",
          "label": "Equal 2-Column Grid (Standard 2x2)"
        }
      ]
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background Color",
      "default": "#f4f4f4"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top Padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "gallery_image",
      "name": "Gallery Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Select Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "A-DIY Real Life Gallery 2",
      "blocks": [
        { "type": "gallery_image" },
        { "type": "gallery_image" },
        { "type": "gallery_image" },
        { "type": "gallery_image" },
        { "type": "gallery_image" },
        { "type": "gallery_image" },
        { "type": "gallery_image" }
      ]
    }
  ]
}
{% endschema %}