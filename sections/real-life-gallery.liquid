{%- comment -%}
  Fallback alt for gallery images whose alt was never set in the Files admin.
{%- endcomment -%}
{%- assign gallery_alt_fallback = section.settings.title | default: 'A-DIY deck installed by a customer' | strip_html -%}
<div class="custom-gallery-wrapper-main mobile-layout-{{ section.settings.mobile_layout }}" style="background-color: {{ section.settings.bg_color | default: '#f7f7f7' }};">
    <div class="custom-gallery-wrapper page-width">
        {% if section.settings.title != blank or section.settings.subtitle != blank %}
            <div class="gallery-header">
            {% if section.settings.title != blank %}
                <h2>{{ section.settings.title }}</h2>
            {% endif %}
            {% if section.settings.subtitle != blank %}
                <p>{{ section.settings.subtitle }}</p>
            {% endif %}
            </div>
        {% endif %}

        <div class="gallery-blocks-container" id="GalleryBlocksContainer-{{ section.id }}">
            {% for block in section.blocks %}
              {% assign remainder = forloop.index0 | modulo: 7 %}
              {% assign block_group_index = forloop.index0 | divided_by: 7 %}
              {% assign group_hidden = false %}
              {% if block_group_index >= 2 %}
                {% assign group_hidden = true %}
              {% endif %}

              {% comment %} Start of a 7-image block grid group {% endcomment %}
              {% if remainder == 0 %}
                {% assign is_even_group = block_group_index | modulo: 2 %}
                <div class="gallery-grid-block {% if is_even_group == 0 %}featured-pos-left{% else %}featured-pos-right{% endif %} {% if group_hidden %}is-hidden{% endif %}" data-gallery-block-group="{{ block_group_index }}">
              {% endif %}

              {%- comment -%}
                `sizes` must describe the tile, not the section. This grid is a
                7-up mosaic: one `item-featured` and six `item-small` per group,
                and the two render at very different widths.

                Measured on the live homepage at 1512px / DPR 2:
                  item-featured -> 513css box (needs 1026px)
                  item-small    -> 250css box (needs  500px)

                The previous `(min-width: 769px) 50vw, 100vw` claimed 756css for
                BOTH, so the browser resolved 1512 device px and took the 1100w
                candidate for every tile - a 1100px image in a 250px box on the
                six small tiles of every group. That one attribute accounted for
                22 MB of the homepage's 30.6 MB of image weight.

                Small tiles now resolve to the 600w candidate instead of 1100w.
                Measured over the 14 initially-visible tiles at 1512px / DPR 2:
                4123 KB before, 1778 KB after (-57%).

                The grid lives in `.page-width`, which stops growing at ~1300px,
                so past 1400px viewport the tiles are fixed px, not a share of
                the viewport - hence the px clause first.

                Mobile: `mobile_layout` is `featured`, whose CSS is a 2-column
                grid (section-real-life-gallery.css:216-225), so small tiles are
                ~50vw there and only the featured tile is full-bleed.
              {%- endcomment -%}
              {%- if remainder == 0 -%}
                {%- assign tile_sizes = '(min-width: 1400px) 520px, (min-width: 769px) 36vw, 100vw' -%}
              {%- else -%}
                {%- assign tile_sizes = '(min-width: 1400px) 260px, (min-width: 769px) 18vw, 50vw' -%}
              {%- endif -%}

              {%- comment -%}
                Only the first two groups (14 of 126 tiles) are visible; the other
                112 sit in `.is-hidden` (display:none) behind LOAD MORE. The srcset
                ladder is ~1.1 KB of candidate URLs per tag, so emitting it for all
                126 put ~123 KB of URLs in the document for images nobody has asked
                to see.

                Hidden tiles ship no ladder at all. Every candidate is the same CDN
                URL with a different `width=`, so JS rebuilds the whole srcset from
                `src` at reveal time - the same trick openLightbox already uses to
                derive its 1600w URL. Only `data-sizes` has to be carried, because
                that differs between featured and small tiles.

                `src` stays on every tile: the lightbox reads it, and a display:none
                image is never fetched anyway.
              {%- endcomment -%}

              <div class="gallery-item {% if remainder == 0 %}item-featured{% else %}item-small{% endif %}" {{ block.shopify_attributes }}>
                {% if block.settings.image != blank %}
                  <img
                    src="{{ block.settings.image | image_url: width: 600 }}"
                    {% if group_hidden %}
                      data-sizes="{{ tile_sizes }}"
                    {% else %}
                      srcset="{{ block.settings.image | image_url: width: 200 }} 200w,
                              {{ block.settings.image | image_url: width: 300 }} 300w,
                              {{ block.settings.image | image_url: width: 400 }} 400w,
                              {{ block.settings.image | image_url: width: 600 }} 600w,
                              {{ block.settings.image | image_url: width: 800 }} 800w,
                              {{ block.settings.image | image_url: width: 1100 }} 1100w"
                      sizes="{{ tile_sizes }}"
                    {% endif %}
                    alt="{{ block.settings.image.alt | default: gallery_alt_fallback | escape }}"
                    loading="lazy"
                    decoding="async"
                    width="{{ block.settings.image.width }}"
                    height="{{ block.settings.image.height }}"
                    class="gallery-lightbox-trigger"
                  >
                {% else %}
                  {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                {% endif %}
              </div>

              {% comment %} End of a 7-image block grid group OR end of loop {% endcomment %}
              {% if remainder == 6 or forloop.last %}
                </div>
              {% endif %}
            {% endfor %}
        </div>

        {% assign total_groups = section.blocks.size | divided_by: 7 %}
        {% assign total_modulo = section.blocks.size | modulo: 7 %}
        {% if total_modulo > 0 %}{% assign total_groups = total_groups | plus: 1 %}{% endif %}

        {% if total_groups > 2 %}
            <div class="gallery-load-more-btn-wrap">
              <button type="button" class="btn gallery-btn is-hidden" id="ShowLessGallery-{{ section.id }}">
                SHOW LESS
              </button>
              <button type="button" class="btn gallery-btn" id="LoadMoreGallery-{{ section.id }}">
                  LOAD MORE
              </button>
            </div>
        {% endif %}
    </div>
</div>

<!-- Lightbox Modal -->
<div class="gallery-lightbox" id="GalleryLightbox-{{ section.id }}" aria-hidden="true" role="dialog">
  <div class="lightbox-overlay"></div>
  <button type="button" class="lightbox-close" id="LightboxClose-{{ section.id }}" aria-label="Close">&times;</button>
  <div class="lightbox-stage">
    <button type="button" class="lightbox-nav lightbox-prev" id="LightboxPrev-{{ section.id }}" aria-label="Previous">&lsaquo;</button>
    <div class="lightbox-frame">
      {%- comment -%}
        Not lazy: this <img> starts with an empty src and only gets one when the
        viewer clicks a thumbnail. Chrome keeps a lazy image with no initial src
        deferred even after src is assigned, so the lightbox opened to an empty
        frame - verified on the preview, where flipping this to eager made the
        same URL load instantly. A click is an explicit request; nothing to defer.
      {%- endcomment -%}
      <img src="" id="LightboxImage-{{ section.id }}" alt="">
    </div>
    <button type="button" class="lightbox-nav lightbox-next" id="LightboxNext-{{ section.id }}" aria-label="Next">&rsaquo;</button>
  </div>
</div>

{%- comment -%}
  Liquid-free rules moved to assets/section-real-life-gallery.css so they are cached across
  page views instead of being re-sent inside every HTML document. Only the
  per-section padding rules, which interpolate settings, stay inline.

  Loaded blocking, not deferred: these rules set the card sizes. Deferring them
  let the cards collapse to zero height at first paint, which put every image in
  the section inside the viewport and defeated loading="lazy" - measured as 10
  extra eager downloads in comparison-cards. Gzipped this is 1-2KB.
{%- endcomment -%}
{{ 'section-real-life-gallery.css' | asset_url | stylesheet_tag }}
<style>.custom-gallery-wrapper {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const sectionId = '{{ section.id }}';
    const container = document.getElementById(`GalleryBlocksContainer-${sectionId}`);
    const loadMoreBtn = document.getElementById(`LoadMoreGallery-${sectionId}`);
    const showLessBtn = document.getElementById(`ShowLessGallery-${sectionId}`);

    const lightbox = document.getElementById(`GalleryLightbox-${sectionId}`);
    const lightboxImg = document.getElementById(`LightboxImage-${sectionId}`);
    const closeBtn = document.getElementById(`LightboxClose-${sectionId}`);
    const prevBtn = document.getElementById(`LightboxPrev-${sectionId}`);
    const nextBtn = document.getElementById(`LightboxNext-${sectionId}`);

    let galleryImages = [];
    let currentIndex = 0;

    if (loadMoreBtn && showLessBtn && container) {
      const blocks = Array.from(container.querySelectorAll('.gallery-grid-block'));

      function updateButtons() {
        const hiddenBlocks = blocks.filter(b => b.classList.contains('is-hidden'));
        const visibleBlocks = blocks.filter(b => !b.classList.contains('is-hidden'));

        if (hiddenBlocks.length === 0) {
          loadMoreBtn.classList.add('is-hidden');
        } else {
          loadMoreBtn.classList.remove('is-hidden');
        }

        if (visibleBlocks.length > 2) {
          showLessBtn.classList.remove('is-hidden');
        } else {
          showLessBtn.classList.add('is-hidden');
        }
      }

      // Hidden tiles ship without a srcset to keep it out of the HTML; rebuild it
      // from `src` here, BEFORE the group gets a layout box, so the browser
      // resolves the ladder once instead of fetching the `src` candidate and then
      // re-fetching the right one. `sizes` is set first because selection reads it.
      const GALLERY_WIDTHS = [200, 300, 400, 600, 800, 1100];

      function promoteBlockImages(block) {
        block.querySelectorAll('img[data-sizes]').forEach(function (img) {
          const src = img.getAttribute('src') || '';
          if (!/[?&]width=\d+/.test(src)) return;

          img.setAttribute('sizes', img.dataset.sizes);
          img.setAttribute(
            'srcset',
            GALLERY_WIDTHS.map(function (w) {
              return src.replace(/([?&]width=)\d+/, '$1' + w) + ' ' + w + 'w';
            }).join(', ')
          );
          delete img.dataset.sizes;
        });
      }

      loadMoreBtn.addEventListener('click', function() {
        const firstHidden = blocks.find(b => b.classList.contains('is-hidden'));
        if (firstHidden) {
          promoteBlockImages(firstHidden);
          firstHidden.classList.remove('is-hidden');
          updateButtons();
        }
      });

      showLessBtn.addEventListener('click', function() {
        const visibleBlocks = blocks.filter(b => !b.classList.contains('is-hidden'));
        if (visibleBlocks.length > 2) {
          const lastVisible = visibleBlocks[visibleBlocks.length - 1];
          lastVisible.classList.add('is-hidden');
          updateButtons();
        }
      });
    }

    function refreshGalleryImages() {
      galleryImages = Array.from(container.querySelectorAll('.gallery-lightbox-trigger'));
    }

    function openLightbox(index) {
      refreshGalleryImages();
      if (index < 0 || index >= galleryImages.length) return;
      
      currentIndex = index;
      const targetImg = galleryImages[currentIndex];
      // The lightbox wants the same image at a larger width. Deriving it from the
      // src beats emitting a second full CDN URL as data-full-src on all 126 blocks.
      const baseSrc = targetImg.getAttribute('src') || targetImg.src || '';
      const fullSrc = /[?&]width=\d+/.test(baseSrc)
        ? baseSrc.replace(/([?&]width=)\d+/, '$1' + 1600)
        : (targetImg.currentSrc || targetImg.src);

      lightboxImg.src = fullSrc;
      lightboxImg.alt = targetImg.getAttribute('alt') || '';
      lightbox.classList.add('active');
      lightbox.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }

    function closeLightbox() {
      lightbox.classList.remove('active');
      lightbox.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }

    function showNext() {
      refreshGalleryImages();
      currentIndex = (currentIndex + 1) % galleryImages.length;
      openLightbox(currentIndex);
    }

    function showPrev() {
      refreshGalleryImages();
      currentIndex = (currentIndex - 1 + galleryImages.length) % galleryImages.length;
      openLightbox(currentIndex);
    }

    container.addEventListener('click', function(e) {
      if (e.target.classList.contains('gallery-lightbox-trigger')) {
        refreshGalleryImages();
        const index = galleryImages.indexOf(e.target);
        if (index !== -1) {
          openLightbox(index);
        }
      }
    });

    if (closeBtn) closeBtn.addEventListener('click', closeLightbox);
    if (nextBtn) nextBtn.addEventListener('click', showNext);
    if (prevBtn) prevBtn.addEventListener('click', showPrev);

    if (lightbox) {
      lightbox.addEventListener('click', function(e) {
        if (!e.target.closest('.lightbox-frame') && !e.target.closest('.lightbox-nav')) {
          closeLightbox();
        }
      });
    }

    document.addEventListener('keydown', function(e) {
      if (!lightbox.classList.contains('active')) return;
      if (e.key === 'Escape') closeLightbox();
      if (e.key === 'ArrowRight') showNext();
      if (e.key === 'ArrowLeft') showPrev();
    });
  });
</script>

{% schema %}
{
  "name": "A-DIY Real Life Gallery 2",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Poly & Bark, in real life"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subheading",
      "default": "USE #POLYANDBARK AND TAG US @POLYANDBARK"
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "Mobile Layout Style",
      "default": "featured",
      "options": [
        {
          "value": "featured",
          "label": "Featured Layout (1 Big Image + Small Images)"
        },
        {
          "value": "grid_2_col",
          "label": "Equal 2-Column Grid (Standard 2x2)"
        }
      ]
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background Color",
      "default": "#f4f4f4"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top Padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "gallery_image",
      "name": "Gallery Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Select Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "A-DIY Real Life Gallery 2",
      "blocks": [
        { "type": "gallery_image" },
        { "type": "gallery_image" },
        { "type": "gallery_image" },
        { "type": "gallery_image" },
        { "type": "gallery_image" },
        { "type": "gallery_image" },
        { "type": "gallery_image" }
      ]
    }
  ]
}
{% endschema %}