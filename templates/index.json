        "text_review_BbwFE7": {
          "type": "text_review",
          "settings": {
            "is_5_star": true,
            "is_4_star": false,
            "is_3_star": false,
            "author_name": "David Owens",
            "author_handle": "",
            "headline": "Easy build 12x12 pressure treated deck",
            "social_icon": "trustpilot",
            "review_text": "I bought a 12x12 pressure treated deck. Great company communication throughout. All materials come packaged in a crate. The material is packaged in order of use as you take from the top, allowing us to time our build over several evenings without having lumber scattered across the yard and remaining protected in the crate. Instructions are clear and there’s also an online step by step video guide.\nI’m not a construction oriented individual, but my wife and I put it all together (including site prep) in four evenings. About 16 hours, including beer breaks - and it still came out level and great looking. We put a sauna on it and now it’s our favorite place in the yard.\nEasy, painless, cost effective. I am planning on a second deck and will use A-Diy again."
          }
        },
