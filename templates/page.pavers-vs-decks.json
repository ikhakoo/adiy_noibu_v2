        "step_number": "1",
        "step_label": "Step 1 of 7 · Installing pavers",
        "eyebrow": "The reality of installing pavers",
        "heading": "It's Not Just Laying Down Stones.",
        "intro": "A paver patio is really two projects: the base you never see, and the surface you do. Most of the work, the cost, and the long-term performance is decided by the first one.",
        "placeholder_label": "Excavation and compacted gravel base · stock photo (replace)",
        "callout_label": "Why the ground matters more than the stones",
        "callout_text": "Pavers only stay where the base holds them. A beautiful stone laid on a poorly prepared base will sink, tilt, and separate; a plain stone on a properly built base will stay flat for years. The preparation is the product."
      }
    },
    "problems": {
      "type": "pvd-problems",
      "blocks": {
        "problem-1": { "type": "problem", "settings": { "image": "shopify://shop_images/pavers-vs-decks-problem-sinking.jpg", "title": "Sinking or uneven pavers", "what": "Individual stones or whole areas drop below the surrounding surface, creating dips and trip edges.", "why": "The base was too thin, unevenly compacted, or has washed out underneath from water moving through it.", "fix": "Lift the affected pavers, rebuild and re-compact the base beneath them, re-screed the sand, and reset the stones. For large areas this means redoing the patio." } },
        "problem-2": { "type": "problem", "settings": { "image": "shopify://shop_images/pavers-vs-decks-problem-weeds.jpg", "title": "Weeds in the joints", "what": "Grass and weeds sprout between the stones within a season or two.", "why": "Wind-blown seed settles into joint sand, and ordinary sand gives roots an easy home.", "fix": "Pull or treat the weeds, blow out the old joint sand, and re-sand with polymeric sand, which hardens when wet. This is a recurring job." } },
        "problem-3": { "type": "problem", "settings": { "image": "shopify://shop_images/pavers-vs-decks-problem-pooling.jpg", "title": "Water pooling", "what": "Puddles sit on the patio after rain instead of draining away.", "why": "The surface was not graded to a consistent slope, or low spots have developed as the base settled.", "fix": "Minor pooling can be lived with. Real correction means lifting the pavers in the low area and re-grading the base." } },
        "problem-4": { "type": "problem", "settings": { "image": "shopify://shop_images/pavers-vs-decks-problem-edges.jpg", "title": "Edges separating or shifting", "what": "The outer rows creep outward and gaps open up across the patio.", "why": "Missing or failed edge restraints let the stones migrate under foot traffic and freeze-thaw movement.", "fix": "Install or replace edge restraints, push the field back into place, and re-sand the joints." } },
        "problem-5": { "type": "problem", "settings": { "image": "shopify://shop_images/pavers-vs-decks-problem-freeze.jpg", "title": "Freeze-thaw movement", "what": "Pavers heave upward in winter and settle unevenly in spring, especially in colder regions.", "why": "Water trapped in or under the base expands as it freezes and pushes the surface up.", "fix": "Improve drainage so water cannot sit in the base. In severe cases the base depth and material need to be rebuilt for the climate." } },
        "problem-6": { "type": "problem", "settings": { "image": "shopify://shop_images/pavers-vs-decks-problem-cracked.jpg", "title": "Cracked or chipped pavers", "what": "Individual stones split or lose corners.", "why": "A void under the stone, a heavy point load, or de-icing salts breaking down the surface over time.", "fix": "Replace the stone. Matching the original color and texture can be hard once a product line changes." } }
      },
      "block_order": ["problem-1", "problem-2", "problem-3", "problem-4", "problem-5", "problem-6"],
