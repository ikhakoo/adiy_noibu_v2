      "blocks": {
        "step-1": { "type": "step", "settings": { "title": "Mark out and plan", "text": "Lay out the footprint, check for utilities, and decide where water will go before a single shovel goes in." } },
        "step-2": { "type": "step", "settings": { "title": "Excavate", "text": "The whole area is dug out to several inches below the finished height to make room for base layers. For a typical patio that is a lot of soil to move by hand or by machine." } },
        "step-3": { "type": "step", "settings": { "title": "Haul away the soil", "text": "Excavated earth has to go somewhere. It is heavy, bulky, and often needs a dumpster, a trailer, or a disposal fee." } },
        "step-4": { "type": "step", "settings": { "title": "Lay the aggregate base", "text": "Crushed stone is spread in layers to create a stable platform. Too thin, and the surface moves later." } },
        "step-5": { "type": "step", "settings": { "title": "Compact every layer", "text": "Each lift of base material is run over with a plate compactor. Uneven compaction is the number one reason pavers sink." } },
        "step-6": { "type": "step", "settings": { "title": "Grade for drainage", "text": "The base is sloped slightly away from the house so rain runs off instead of pooling. This has to be measured, not eyeballed." } },
        "step-7": { "type": "step", "settings": { "title": "Screed the bedding sand", "text": "A thin, perfectly level layer of sand is pulled across the base with a straight edge. This is the surface the pavers actually sit on." } },
        "step-8": { "type": "step", "settings": { "title": "Set and cut the pavers", "text": "Stones go down in pattern, and every edge and curve has to be cut to fit with a masonry saw." } },
        "step-9": { "type": "step", "settings": { "title": "Edge, sand, and compact again", "text": "Edge restraints are installed, joint sand is swept in, and the finished surface is compacted and sealed." } }
