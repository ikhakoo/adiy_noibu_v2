    "faq": {
      "type": "fin-faq",
      "blocks": {
        "question_1": {
          "type": "question",
          "settings": {
            "question": "Does A-DIY offer 0% APR financing?",
            "answer": "<p>Yes. Through Affirm, qualified buyers see offers as low as 0% APR, such as $205/mo for the [price] 12×12 wood deck. A-DIY Split Payments are always 0% with no fees.</p>"
          }
        },
        "question_2": {
          "type": "question",
          "settings": {
            "question": "Will checking my rate affect my credit score?",
            "answer": "<p>Checking eligibility with Affirm won't affect your credit score, and Klarna Pay in 4 uses a soft check. Klarna's Pay over time runs a credit check when you apply.</p>"
          }
        },
        "question_3": {
          "type": "question",
          "settings": {
            "question": "What do I need to apply?",
            "answer": "<p>Affirm and Klarna require you to be at least 18, live in the US, and verify by text; you may be asked for your Social Security number.</p>"
          }
        },
        "question_4": {
          "type": "question",
          "settings": {
            "question": "How long can I finance a deck?",
            "answer": "<p>Affirm and Shop Pay Installments offer monthly plans up to 24 months or longer depending on eligibility; Klarna offers 3–24 months; A-DIY Split Payments run 4, 6 or 8 months.</p>"
          }
        },
        "question_5": {
          "type": "question",
          "settings": {
            "question": "What is A-DIY Split Payments?",
            "answer": "<p>An interest-free plan where your kit price is divided into 4, 6 or 8 monthly charges to one card. There are no fees, and your deck ships after the last payment.</p>"
          }
        },
        "question_6": {
          "type": "question",
          "settings": {
            "question": "What is A-DIY Reserve?",
            "answer": "<p>A $250 non-refundable deposit that locks today's kit price and lets you choose a future delivery date. The deposit comes off your balance.</p>"
          }
        },
        "question_7": {
          "type": "question",
          "settings": {
            "question": "Are there fees or prepayment penalties?",
            "answer": "<p>Affirm doesn't charge late fees, and you can pay Klarna financing off early at no extra cost. Klarna Pay in 4 may charge a late fee of up to $7. A-DIY Split Payments have no fees.</p>"
          }
        },
        "question_8": {
          "type": "question",
          "settings": {
            "question": "Is a down payment required?",
            "answer": "<p>Lenders may ask for a down payment depending on your order and eligibility; you'll see it before you confirm.</p>"
          }
        },
        "question_9": {
          "type": "question",
          "settings": {
            "question": "Can I combine financing with a discount code?",
            "answer": "<p>Yes. Apply your code at checkout and the financed amount is your discounted total.</p>"
          }
        },
        "question_10": {
          "type": "question",
          "settings": {
            "question": "Does the monthly estimate include tax and shipping?",
            "answer": "<p>No. Estimates exclude taxes and shipping; your lender shows the final amount at checkout.</p>"
          }
        },
        "question_11": {
          "type": "question",
          "settings": {
            "question": "Can I pay by bank transfer?",
            "answer": "<p>Yes, for orders over $3,000 choose Bank Deposit. Your order stays pending until the transfer arrives and ships within 10–14 business days of receipt; transfers not received within 7 business days are cancelled.</p>"
          }
        },
        "question_12": {
          "type": "question",
          "settings": {
            "question": "What happens if I return a financed deck?",
            "answer": "<p>Refunds go back to your lender. With Shop Pay Installments monthly plans, interest already paid isn't refunded.</p>"
          }
        },
        "question_13": {
          "type": "question",
          "settings": {
            "question": "Can I finance a custom-size deck?",
            "answer": "<p>Yes. Our deck specialists can create a custom order you pay with the same checkout options.</p>"
          }
        }
