        "text_review_jhzJcD": {
          "type": "text_review",
          "settings": {
            "is_5_star": true,
            "is_4_star": false,
            "is_3_star": false,
            "author_name": "Beth",
            "author_handle": "",
            "headline": "Can be built by one person",
            "social_icon": "trustpilot",
            "review_text": "As a 61-year-old retiree, I was able to assemble my 12 x 24 composite deck completely by myself (on a compound slope, no less). This is a credit to their design team's ability to make the build process nearly \"Lincoln Log\" esque. The fit was spot on for the most part, and only minor adjustments were needed. Typical of any large construction project. I came up short of a few composite screws and plugs, but their customer service quickly sent me the missing parts. They even reimbursed me for one board I had to replace due to warpage. I saved enough money by doing it myself, it was like getting the hot tub I put on it for free."
          }
        },
        "text_review_MVVbzD": {
          "type": "text_review",
          "settings": {
