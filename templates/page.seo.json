:"#ECE8E4","active_border_color":"#194636","font_size":16,"font_weight":"400","border_radius":10,"padding_top":30,"padding_bottom":30}},"multicolumn_TGXkFF":{"type":"multicolumn","blocks":{"column_c6Pngj":{"type":"column","settings":{"enable_autoplay":false,"image":"shopify:\/\/shop_images\/fi_13549226_ba99fb80-a8a7-4269-9abf-0776f2484fac.png","title":"Hire a Full-Service Deck Contractor","text":"<p>A deck builder can manage design, materials, permits, foundations, construction, inspections and cleanup. This is often the best choice when the project is highly customized or the homeowner wants one company to manage the entire job.<br\/><br\/><\/p>","link_label":"","link":""}},"column_YgDGfW":{"type":"column","settings":{"enable_autoplay":false,"title":"Build From Raw Materials","text":"<p>The homeowner or builder purchases lumber, hardware and decking separately, then handles the design, measurements, cuts, structural layout and assembly. This approach offers flexibility but requires more planning and construction knowledge.<br\/><br\/><\/p>","link_label":"","link":""}},"column_69ahGQ":{"type":"column","settings":{"enable_autoplay":false,"title":"Use a Professionally Engineered Deck System","text":"<p>A ready-to-assemble system uses a standardized design and coordinated components prepared for assembly. A-DIY is designed for homeowners who want a real structural deck without beginning with a loose pile of raw materials or completing every cut at the property.<br\/><br\/><\/p>","link_label":"","link":""}}},"block_order":["column_c6Pngj","column_YgDGfW","column_69ahGQ"],"name":"t:sections.multicolumn.presets.name","settings":{"custom_class":"","title":"Three Ways to Build a Deck in New York","title_content":"","image_width":"third","image_ratio":"portrait","button_label":"Button label","button_link":"","columns_desktop":3,"column_alignment":"left","background_style":"primary","color_scheme":"","columns_mobile":"1","swipe_on_mobile":false,"padding_top":36,"padding_botto