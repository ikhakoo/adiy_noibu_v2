    "faq_accordion_tUDpHR": {
      "type": "faq-accordion",
      "blocks": {
        "faq_item_KicD3L": {
          "type": "faq_item",
          "settings": {
            "question": "Have you completed similar decks in this city or county?",
            "answer": "<p>Yes, we have completed numerous deck installations in this area and are fully familiar with local zoning and structural codes.</p>"
          }
        },
        "faq_item_HCdmhX": {
          "type": "faq_item",
          "settings": {
            "question": "Are you licensed or registered where required?",
            "answer": "<p>Yes, we maintain all required state and municipal contractor licenses and registrations.</p>"
          }
        },
        "faq_item_JtQhCb": {
          "type": "faq_item",
          "settings": {
            "question": "Can you provide current proof of insurance?",
            "answer": "<p>We carry full general liability and workers' compensation insurance. Certificates can be provided directly upon request.</p>"
          }
        },
        "faq_item_HJDY3c": {
          "type": "faq_item",
          "settings": {
            "question": "What lumber, framing dimensions and decking product are included?",
            "answer": "<p>Our detailed written quotes specify all lumber grades, post dimensions, joist spacing, and exact decking brand/line selected.</p>"
          }
        },
        "faq_item_aUwJRb": {
          "type": "faq_item",
          "settings": {
            "question": "What foundation system is proposed?",
            "answer": "<p>Depending on soil conditions and deck height, we utilize concrete footings poured below frost depth or helical screw piles.</p>"
          }
        },
        "faq_item_RaPrhG": {
          "type": "faq_item",
          "settings": {
            "question": "Who handles permits, plans and inspections?",
            "answer": "<p>We manage the entire permit process from architectural drafting/engineering submission to scheduling final municipal inspections.</p>"
          }
        },
        "faq_item_pXtewa": {
          "type": "faq_item",
          "settings": {
            "question": "Are stairs, railings, demolition and cleanup included?",
            "answer": "<p>Yes, all specified components including old deck removal, site preparation, stairs, code-compliant railings, and site cleanup are detailed in our proposals.</p>"
