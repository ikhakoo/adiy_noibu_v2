{"sections":{"main":{"type":"main-page","disabled":true,"settings":{"padding_top":28,"padding_bottom":28}},"image_with_text_JjwmnC":{"type":"image-with-text","blocks":{"heading_8gjqmi":{"type":"heading","settings":{"sub_heading":"","heading":"Building a Deck in New York: Contractors, Costs, Permits and Deck-Kit Options"}},"text_rBz8q3":{"type":"text","settings":{"text":"<p>Planning a deck in New York usually begins with a few big questions: Should you hire a deck builder, purchase the materials yourself or use a professionally engineered system that arrives prepared for assembly?<br\/><br\/>This guide explains the main options, what affects the cost, how permits work, what to ask a contractor and how to choose between pressure-treated wood and composite decking.<br\/><br\/>A-DIY offers a third way to complete the project: a professionally engineered deck system delivered with coordinated components prepared for assembly. You can build it yourself or hire a local handyman, carpenter or contractor to help.<br\/><br\/><\/p>","text_style":"body"}},"button_6jfzcR":{"type":"button","settings":{"button_label":"EXPLORE DECK OPTIONS","button_link":"shopify:\/\/collections\/deck-kits","button_style_secondary":false,"button_label_2":"SEE HOW A-DIY WORKS","button_link_2":"shopify:\/\/pages\/design-consultation","button_style_secondary_2":true}}},"block_order":["heading_8gjqmi","text_rBz8q3","button_6jfzcR"],"name":"t:sections.image-with-text.presets.name","settings":{"custom_class":"seo-hero-sec","image":"shopify:\/\/shop_images\/image_8336.png","height":"adapt","desktop_image_width":"medium","layout":"text_first","image_behavior":"none","content_layout":"no-overlap","desktop_content_position":"top","desktop_content_alignment":"left","mobile_content_alignment":"left","section_color_scheme":"","color_scheme":"","padding_top":36,"padding_bottom":36}},"featured_icon_scrolling_kF3ffz":{"type":"featured-icon-scrolling","blocks":{"marquee_item_NmY9PP":{"type":"marquee_item","settings