          }
        },
        "faq_item_x6kxBh": {
          "type": "faq_item",
          "settings": {
            "question": "What is the payment schedule?",
            "answer": "<p>We follow a structured milestone payment schedule linked to project stages (e.g., initial deposit, framing completion, final walkthrough).</p>"
