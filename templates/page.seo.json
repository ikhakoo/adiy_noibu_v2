          "type": "guide_card",
          "settings": {
            "is_dark": true,
            "title": "What Should a Written Deck Quote Include?",
            "checklist_items": "Deck dimensions and layout\nLumber grade and framing dimensions\nSurface material and brand\nHardware and connectors\nFootings, posts and bracing\nStairs and railings\nPermit and engineering responsibility\nDemolition, disposal and cleanup\nSchedule, payments and warranty\nAll exclusions and allowances",
            "notice_text": ""
          }
        }
