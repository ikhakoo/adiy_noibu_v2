    "buying": {
      "type": "multicolumn",
      "blocks": {
        "column_buying_1": {
          "type": "column",
          "settings": {
            "image": "",
            "title": "Delivery",
            "text": "<p>Kits ship via LTL ground freight anywhere in the United States, typically arriving within 10 to 14 business days. The carrier contacts you to schedule curbside delivery.</p>",
            "link_label": "",
            "link": "",
            "enable_autoplay": false
          }
        },
        "column_buying_2": {
          "type": "column",
          "settings": {
            "image": "",
            "title": "Warranty",
            "text": "<p>Wood kits carry a 5-year structural warranty. Composite kits carry a 25-year warranty that covers the structure as well as staining and fading on the boards.</p>",
            "link_label": "",
            "link": "",
            "enable_autoplay": false
          }
        },
        "column_buying_3": {
          "type": "column",
          "settings": {
            "image": "",
            "title": "Paying over time",
            "text": "<p>Financing is available through Affirm, Klarna and Shop Pay, with $0 down and 0% interest options over terms of up to 24 months. Financing is subject to credit approval; terms and conditions apply.</p>",
            "link_label": "",
            "link": "",
            "enable_autoplay": false
          }
        }
      },
