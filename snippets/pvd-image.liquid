{%- comment -%}
  Cover-cropped image box for the Pavers vs. Decks page. The box sets the size (CSS);
  the image fills it with object-fit: cover.

  Accepts:
  - image: {Object} Image picker value
  - class: {String} Extra classes on the wrapper
  - sizes: {String} sizes attribute
  - eager: {Boolean} Load eagerly with high priority (above-the-fold images)
{%- endcomment -%}
<div class="pvd-media{% if class != blank %} {{ class }}{% endif %}">
  {%- if image != blank -%}
    {%- liquid
      if eager
        assign loading = 'eager'
        assign priority = 'high'
      else
        assign loading = 'lazy'
        assign priority = 'auto'
      endif
    -%}
    {{
      image
      | image_url: width: 2400
      | image_tag:
        widths: '400, 600, 800, 1100, 1500, 2000, 2400',
        sizes: sizes,
        loading: loading,
        fetchpriority: priority,
        alt: image.alt
    }}
  {%- else -%}
    {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
  {%- endif -%}
</div>
