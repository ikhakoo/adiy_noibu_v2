{%- comment -%}
  SEO Guide media slot.
  Renders a Shopify video (muted loop) or an image. When both are empty,
  shows a labeled placeholder in the theme editor only, and nothing on the
  live storefront.

  Accepts:
  - image: image object
  - video: video object (Shopify-hosted, from a "video" setting)
  - label: text shown on the editor placeholder
  - ratio: CSS aspect-ratio value, e.g. '16 / 9' (optional)
  - sizes: sizes attribute for the image
  - eager: true to load the image eagerly (hero)
  - class: extra classes on the wrapper
  - bare: true to output only the img/video tag with no wrapper
{%- endcomment -%}
{%- liquid
  assign loading = 'lazy'
  assign fetchpriority = 'auto'
  if eager
    assign loading = 'eager'
    assign fetchpriority = 'high'
  endif
  assign sizes = sizes | default: '(min-width: 990px) 50vw, 100vw'
  assign style = ''
  if ratio != blank
    assign style = 'aspect-ratio: ' | append: ratio | append: ';'
  endif
-%}
{%- if video != blank -%}
  {%- capture media_tag -%}
    {{- video | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, controls: false, preload: 'metadata', image_size: '1600x' -}}
  {%- endcapture -%}
{%- elsif image != blank -%}
  {%- capture media_tag -%}
    {{- image | image_url: width: 2400 | image_tag: loading: loading, fetchpriority: fetchpriority, sizes: sizes, widths: '400, 600, 800, 1100, 1500, 2000, 2400', alt: image.alt | default: label -}}
  {%- endcapture -%}
{%- endif -%}

{%- if media_tag != blank -%}
  {%- if bare -%}
    {{ media_tag }}
  {%- else -%}
    <div class="sg-media {{ class }}"{% if style != blank %} style="{{ style }}"{% endif %}>{{ media_tag }}</div>
  {%- endif -%}
{%- elsif request.design_mode -%}
  <div class="sg-media sg-media--ph {{ class }}"{% if style != blank %} style="{{ style }}"{% endif %}>
    <span class="sg-media__lbl">
      <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2" fill="none" stroke="currentColor" stroke-width="1.4"/><circle cx="9" cy="10" r="1.8" fill="none" stroke="currentColor" stroke-width="1.4"/><path d="M4 18l5-5 4 4 3-3 4 4" fill="none" stroke="currentColor" stroke-width="1.4"/></svg>
      {{ label | default: 'Add an image or video' | escape }}
    </span>
  </div>
{%- endif -%}
