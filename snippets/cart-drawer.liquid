{% comment %}
  Renders cart drawer

  Usage:
  {% render 'cart-drawer' %}
{% endcomment %}

{{ 'quantity-popover.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}

<script src="{{ 'cart.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'quantity-popover.js' | asset_url }}" defer="defer"></script>

<style>
  .drawer {
    visibility: hidden;
  }

  .drawer.is-empty cart-drawer-items,
  .drawer.is-empty .truck-icon-text,
  .drawer.is-empty .drawer__footer{
    display:none;
  }
  .drawer.is-empty .drawer__header {
    display: flex;
  }
  .drawer.is-empty .drawer__inner{
    align-items: flex-start;
    grid-template-rows: 0fr;
  }

  .drawer__top-bar {
    background-color: #1c1d1a;
    color: #ffffff;
    text-align: center;
    padding: 10px 15px;
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0;
    text-transform: uppercase;
  }
  .drawer__top-bar a{
    color: #fff;
  }

  .drawer__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 18px 20px;
    border-bottom: 1px solid #e8e8e8;
    background-color: #ffffff;
  }

  .drawer__heading {
    margin: 0;
    font-size: 18px;
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: #000000;
  }

  .drawer__close {
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    right: 1rem;
  }

  .drawer__close svg {
    width: 18px;
    height: 18px;
    stroke-width: 1.5px;
  }

  .drawer .drawer__inner{
    padding: 0;
    border: 0;
    width: 50rem;
  }
  .drawer cart-drawer-items{
    padding: 0 15px;
    max-height: fit-content;
  }
  cart-drawer-items .icon-text{
    display:flex;
    align-items:center;
    background:#EBF0EE;
    border:1px solid #C8D5D0;
    border-radius: 6px;
    padding: 6px 15px;
    margin-top: 20px;
    margin-bottom: 20px;
    width: fit-content;
    gap: 10px;
  }
  cart-drawer-items .icon-text img{
    width:18px;
  }
  cart-drawer-items .icon-text p{
    margin:0;
    color:#3A6958;
    font-size:12px;
    text-transform: uppercase;
  }
  /* Layout Alignment */
  .drawer .custom-cart-item {
    display: flex;
    padding: 1rem 0;
    border-bottom: 1px solid #e8e8e8;
    gap: 1.5rem;
  }

  .drawer .custom-cart-item .cart-item__media {
    width: auto;
    flex-shrink: 0;
  }

  .drawer .custom-cart-item .cart-item__image {
    border-radius: 12px;
    object-fit: cover;
    width: 100%;
    height: auto;
  }

  .drawer .custom-cart-item .cart-item__details {
    flex-grow: 1;
    display: flex;
    flex-direction: column;
  }

  .drawer .cart-item__title .cart-item__name{
    font-size: 16px;
    font-weight: 600;
    margin-bottom: 5px;
  }

  .drawer .cart-item__title .cart-item__name:hover {
    text-decoration: none;
  }

  .quantity:before,
  .quantity:after{
    display:none;
  }
  
  .drawer .custom-cart-drawer-item {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    gap: 2rem;
    padding: 15px 0 10px;
  }
  .drawer .custom-cart-drawer-item .main-cart-item__media{
    width: 20%;
  }
  .drawer .custom-cart-drawer-item .main-cart-item__details{
    width: 80%;
    display: flex;
    flex-direction: column;
    row-gap: 1rem;
  }
  .drawer .custom-cart-drawer-item .cart-item__quantity-wrapper{
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .drawer .custom-cart-drawer-item .cart-item__quantity-wrapper .quantity-popover-container{
    width: 25%;
  }
  .drawer .custom-cart-drawer-item .quantity-popover-container .cart-quantity{
    width: 100%;
    min-height: auto;
    padding: 2px 8px;
    border-radius: 50px;
    border: 1px solid #D2C4BC;
  }
  .drawer .custom-cart-drawer-item .quantity-popover-container .quantity__button{
    width: auto;
  }
  .drawer .custom-cart-drawer-item .quantity-popover-container .quantity__input{
    font-size:14px;
  }
  .drawer .custom-cart-drawer-item .cart-item__quantity-wrapper .cart-item__totals{
    width: 75%;
  }
  .drawer .custom-cart-drawer-item .cart-item__quantity {
    padding: 0;
  }
  .drawer .custom-cart-drawer-item .cart-item__details{
    display: flex;
    align-items: start;
    justify-content: space-between;
  }
  .product-options-custom,
  .product-options-inline {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    font-family: var(--font-body-family);
    font-style: var(--font-body-style);
    font-weight: var(--font-body-weight);
    text-transform: uppercase;
    color: #4a3e3d;
    margin:0;
  }
  .product-options-custom .product-option{
    font-size: 12px;
    margin:0;
  }
  .product-options-custom .product-option dd {
    margin: 0;
  }

  .product-options-custom .product-option:not(:last-child)::after {
    content: "/";
    margin-left: 8px;
  }
  .drawer .custom-cart-drawer-item .cart-item__details .col-2,
  .drawer .custom-cart-drawer-item .cart-item__details cart-remove-button{
    margin:0;
  }
  .drawer .custom-cart-drawer-item .cart-item__details .cart-remove-button {
    display: flex;
    align-items: flex-start;
  }
  .drawer .custom-cart-drawer-item .cart-item__image {
    max-width: 100%;
    border-radius: 10px;
    height: 70px;
    object-fit: cover;
    width: 90px;
  }

  .truck-icon-text{
    display: flex;
    align-items: center;
    gap: 2rem;
    margin: 0 15px auto;
    background: #F5F3EE;
    padding: 10px 20px;
    border: 1px solid #F2EEE9;
    border-radius: 8px;
  }
  .truck-icon-text img{
    width: 36px;
  }
  .truck-icon-text .content{
    font-size: 14px;
    max-width: 70%;
  }
  .truck-icon-text .content p{
    margin: 0;
  }
  .truck-icon-text .content .heading{
    font-size: 16px;
    font-weight: 500;
  }

  .drawer .drawer__footer{
    background-color: #F5F3EE;
    margin: 15px;
    padding-left:15px;
    padding-right:15px;
    border: 1px solid #EEEAE4;
  }

  .drawer .cart-drawer .tax-note{
    display:none;
  }
  .drawer .cart-drawer__footer .cart__ctas{
    margin: 0 15px;
  }
  .drawer .cart-drawer .cart__checkout-button{
    background-color: #3A6958;
    border-radius: 8px;
    font-size: 18px;
    text-transform: uppercase;
    letter-spacing: 2px;
    font-weight: 400;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
  
  }

  .cart-summary-block {
    padding: 20px;
    border-radius: 6px;
    display: flex;
    flex-direction: column;
    gap: 7px;
    padding-top: 0;
  }
  .cart-summary-block.no-discount .summary-row-subtotal{
    display:none;
  }
  .summary-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 14px;
    color: #333333;
  }

  .summary-label {
    font-weight: 400;
    font-size: 20px;
  }

  .summary-value {
    font-weight: 400;
    color: #1a1a1a;
    font-size: 20px;
  }

  /* Discount row styling */
  .discount-row .summary-value {
    color: #2e5b44; /* Dark green tone */
  }

  /* Total row styling */
  .summary-row.total-row {
    margin-top: 0;
    padding-top: 0;
  }

  .total-row .summary-label {
    font-size: 22px;
    font-weight: 500;
    color: #1a1a1a;
  }

  .total-price-wrapper {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .compare-at-price {
    color: #8c8c8c;
    font-size: 16px;
    text-decoration: line-through;
  }

  .final-price {
    font-size: 22px;
    font-weight: 500;
    color: #1a1a1a;
  }

  /* Container flex layout for horizontal alignment */
  .drawer .custom-price-layout {
    display: flex !important;
    align-items: center;
    justify-content: flex-end;
    gap: 7px;
    flex-wrap: wrap;
  }

  /* Save Badge Styling */
  .drawer .save-badge {
    background-color: #f3f7f5;
    color: #2e5b44;
    border: 1px solid #dce8e2;
    border-radius: 20px;
    padding: 1px 9px;
    {% comment %} font-size: 12px; {% endcomment %}
    font-size: 9px;
  }

  /* Strikethrough / Compare-at Price */
  .drawer .custom-price-layout .compare-price {
    color: #8c8c8c;
    {% comment %} font-size: 15px; {% endcomment %}
    font-size: 13px;
    text-decoration: line-through;
    margin: 0;
  }

  /* Final Price */
  .drawer .custom-price-layout .final-price {
    color: #1a1a1a;
    {% comment %} font-size: 20px; {% endcomment %}
    font-size: 17px;
    font-weight: 400;
    margin: 0;
  }

  @media screen and (max-width: 768px){
    .drawer .save-badge{
      font-size: 10px;
    }
    .drawer .custom-price-layout .compare-price{
      font-size: 13px;
    }
    .drawer .custom-price-layout .final-price{
      font-size: 18px;
    }
    .truck-icon-text .content{
      max-width: 100%;
      font-size: 13px;
    }
    .summary-label,
    .summary-value{
      font-size: 18px;
    }
    cart-drawer-items .icon-text{
      margin-top: 10px;
      margin-bottom: 10px;
    }
  }


  .om-empty-cart {
  text-align: center;
  padding: 40px 20px;
  max-width: 420px;
  margin: 0 auto;
}

.om-empty-cart__title {
  font-size: 26px;
  font-weight: 600;
  color: #111111;
  margin: 0 0 10px 0;
  letter-spacing: -0.02em;
}

.om-empty-cart__subtext {
  font-size: 15px;
  line-height: 1.5;
  color: #666666;
  margin: 0 0 30px 0;
  font-weight: 400;
}

.om-empty-cart__links {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.om-empty-cart__card {
  display: flex;
  align-items: center;
  gap: 16px;
  background-color: #f7f6f4;
  padding: 10px 14px;
  border-radius: 16px;
  text-decoration: none;
  transition: background-color 0.2s ease, transform 0.2s ease;
}

.om-empty-cart__card:hover {
  background-color: #efeeea;
  transform: translateY(-1px);
}

.om-empty-cart__img-wrap {
  width: 52px;
  height: 52px;
  border-radius: 12px;
  overflow: hidden;
  background-color: #e5e3df;
  flex-shrink: 0;
}

.om-empty-cart__img-wrap img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.om-empty-cart__placeholder {
  width: 100%;
  height: 100%;
  background: #dedcdc;
}

.om-empty-cart__card-title {
  font-size: 17px;
  font-weight: 600;
  color: #111111;
  text-align: left;
}

.drawer__inner-empty .cart-drawer__warnings{
    justify-content: space-between;
    padding-bottom: 5rem;
}
.drawer__inner-empty .cart-drawer__warnings a.btn{
  background: #194636;
  color:#fff;
}

</style>

<cart-drawer class="drawer{% if cart == empty %} is-empty{% endif %}">
  <div id="CartDrawer" class="cart-drawer">
    <div id="CartDrawer-Overlay" class="cart-drawer__overlay"></div>
    <div
      class="drawer__inner gradient color-{{ settings.cart_color_scheme }}"
      role="dialog"
      aria-modal="true"
      aria-label="{{ 'sections.cart.title' | t }}"
      tabindex="-1"
    >
      {% comment %} {%- if cart == empty -%}
        <div class="drawer__inner-empty">
          <div class="cart-drawer__warnings center{% if settings.cart_drawer_collection != blank %} cart-drawer__warnings--has-collection{% endif %}">
            <div class="cart-drawer__empty-content">
              <h2 class="cart__empty-text">{{ 'sections.cart.empty' | t }}</h2>
              <button
                class="drawer__close"
                type="button"
                onclick="this.closest('cart-drawer').close()"
                aria-label="{{ 'accessibility.close' | t }}"
              >
                <span class="svg-wrapper">
                  {{- 'icon-close.svg' | inline_asset_content -}}
                </span>
              </button>
              <a href="{{ routes.all_products_collection_url }}" class="button">
                {{ 'general.continue_shopping' | t }}
              </a>

              {%- if shop.customer_accounts_enabled and customer == null -%}
                <p class="cart__login-title h3">{{ 'sections.cart.login.title' | t }}</p>
                <p class="cart__login-paragraph">
                  {{ 'sections.cart.login.paragraph_html' | t: link: routes.account_login_url }}
                </p>
              {%- endif -%}
            </div>
          </div>
          {%- if settings.cart_drawer_collection != blank -%}
            <div class="cart-drawer__collection">
              {% render 'card-collection', card_collection: settings.cart_drawer_collection, columns: 1 %}
            </div>
          {%- endif -%}
        </div>
      {%- endif -%} {% endcomment %}
      {% comment %} <div class="drawer__header">
        <h2 class="drawer__heading">{{ 'sections.cart.title' | t }}</h2>
        <button
          class="drawer__close"
          type="button"
          onclick="this.closest('cart-drawer').close()"
          aria-label="{{ 'accessibility.close' | t }}"
        >
          <span class="svg-wrapper">
            {{- 'icon-close.svg' | inline_asset_content -}}
          </span>
        </button>
      </div> {% endcomment %}
      <div class="drawer__header-wrapper">
        <!-- Top Banner -->
        <div class="drawer__top-bar">
          <span>Question? Our Deck Specialists <a href="tel:+17863582872" title="tel:+17863582872">Are Just a Call Away</a></span>
        </div>

        <!-- Main Header -->
        <div class="drawer__header">
          <h2 class="drawer__heading">
            YOUR CART ({{ cart.item_count }})
          </h2>
          <button
            class="drawer__close"
            type="button"
            onclick="this.closest('cart-drawer').close()"
            aria-label="{{ 'accessibility.close' | t }}"
          >
            <span class="svg-wrapper">
              {{- 'icon-close.svg' | inline_asset_content -}}
            </span>
          </button>
        </div>

      
      </div>
      {%- if cart == empty -%}
        <div class="drawer__inner-empty">
          <div class="cart-drawer__warnings center{% if settings.cart_drawer_collection != blank %} cart-drawer__warnings--has-collection{% endif %}">
            {% comment %} <div class="cart-drawer__empty-content">
              <h2 class="cart__empty-text">{{ 'sections.cart.empty' | t }}</h2>
              {% comment %} <button
                class="drawer__close"
                type="button"
                onclick="this.closest('cart-drawer').close()"
                aria-label="{{ 'accessibility.close' | t }}"
              >
                <span class="svg-wrapper">
                  {{- 'icon-close.svg' | inline_asset_content -}}
                </span>
              </button> {% endcomment %}
              <a href="{{ routes.all_products_collection_url }}" class="button">
                {{ 'general.continue_shopping' | t }}
              </a>
              {%- if shop.customer_accounts_enabled and customer == null -%}
                <p class="cart__login-title h3">{{ 'sections.cart.login.title' | t }}</p>
                <p class="cart__login-paragraph">
                  {{ 'sections.cart.login.paragraph_html' | t: link: routes.account_login_url }}
                </p>
              {%- endif -%}
            </div> {% endcomment %}
            <div class="cart-drawer__empty-content om-empty-cart">
              <h2 class="om-empty-cart__title">Your Cart is Empty</h2>
              <p class="om-empty-cart__subtext">
                Looks like your cart is empty! Feel free to browse our selection and add some items you love.
              </p>

              <div class="om-empty-cart__links">
                {% comment %} Card 1: Pressure Treated Deck {% endcomment %}
                <a href="/collections/pressure-treated-deck" class="om-empty-cart__card">
                  <div class="om-empty-cart__img-wrap">
                    <img src="https://a-diy.com/cdn/shop/files/Image_Ratios_16.png?crop=center&height=144&v=1737102929&width=144" alt="compsite deck" width="144">
                  </div>
                  <span class="om-empty-cart__card-title">Pressure Treated Deck</span>
                </a>

                {% comment %} Card 2: Composite Deck {% endcomment %}
                <a href="/collections/composite-deck" class="om-empty-cart__card">
                  <div class="om-empty-cart__img-wrap">
                    <img src="https://a-diy.com/cdn/shop/files/Image_Ratios_18.png?crop=center&height=144&v=1737102930&width=144" alt="compsite deck" width="144">
                  </div>
                  <span class="om-empty-cart__card-title">Composite Deck</span>
                </a>
              </div>
            </div>
            <a href="/collections/start-your-new-deck" class="btn"> Shop All </a>
          </div>
          {%- if settings.cart_drawer_collection != blank -%}
            <div class="cart-drawer__collection">
              {% render 'card-collection', card_collection: settings.cart_drawer_collection, columns: 1 %}
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}
      <cart-drawer-items
        view-event-payload="{{ cart | standard_event_data: 'view', context: 'dialog' | escape }}"
        view-event-trigger="manual"
        {% if cart == empty %}
          class=" is-empty"
        {% endif %}
      >
        {% comment %} <div class="icon-text">
          <img src="https://cdn.shopify.com/s/files/1/0456/9638/5046/files/Container_7db51fc4-12ee-4fab-a433-ded25d7b219d.png?v=1786549489" alt="icon"/>
          <p>5 year STRUCTURAL WARRANTY</p>
        </div> {% endcomment %}

        <form
          action="{{ routes.cart_url }}"
          id="CartDrawer-Form"
          class="cart__contents cart-drawer__form"
          method="post"
        >
          <div id="CartDrawer-CartItems" class="drawer__contents js-contents">
            {%- if cart != empty -%}
              <div class="drawer__cart-items-wrapper">
                {% comment %} <table class="cart-items" role="table">
                  <thead role="rowgroup" style="display:none;">
                    <tr role="row">
                      <th id="CartDrawer-ColumnProductImage" role="columnheader">
                        <span class="visually-hidden">{{ 'sections.cart.headings.image' | t }}</span>
                      </th>
                      <th
                        id="CartDrawer-ColumnProduct"
                        class="caption-with-letter-spacing"
                        scope="col"
                        role="columnheader"
                      >
                        {{ 'sections.cart.headings.product' | t }}
                      </th>
                      <th
                        id="CartDrawer-ColumnTotal"
                        class="right caption-with-letter-spacing"
                        scope="col"
                        role="columnheader"
                      >
                        {{ 'sections.cart.headings.total' | t }}
                      </th>
                      <th id="CartDrawer-ColumnQuantity" role="columnheader">
                        <span class="visually-hidden">{{ 'sections.cart.headings.quantity' | t }}</span>
                      </th>
                    </tr>
                  </thead>

                  <tbody role="rowgroup">
                    {%- for item in cart.items -%}
                      <tr
                        id="CartDrawer-Item-{{ item.index | plus: 1 }}"
                        class="cart-item{% if item.parent_relationship.parent != null %} cart-item__nested-line{% endif %}"
                        role="row"
                        {% if item.parent_relationship.parent != null %}
                          aria-label="{{- 'products.product.nested_label' | t: title: item.product.title, parent_title: item.parent_relationship.parent.title | escape -}}"
                        {% endif %}
                      >
                        <td
                          class="cart-item__media"
                          role="cell"
                          headers="CartDrawer-ColumnProductImage"
                        >
                          {% if item.image %}
                            {% comment %} Leave empty space due to a:empty CSS display: none rule {% endcomment %}
                            <a href="{{ item.url }}" class="cart-item__link" tabindex="-1" aria-hidden="true"> </a>
                            <img
                              class="cart-item__image"
                              src="{{ item.image | image_url: width: 300 }}"
                              alt="{{ item.image.alt | escape }}"
                              loading="lazy"
                              width="150"
                              height="{{ 150 | divided_by: item.image.aspect_ratio | ceil }}"
                            >
                          {% endif %}
                        </td>

                        <td class="cart-item__details" role="cell" headers="CartDrawer-ColumnProduct">
                          {%- if settings.show_vendor -%}
                            <p class="caption-with-letter-spacing light">{{ item.product.vendor }}</p>
                          {%- endif -%}

                          <div class="cart-item__title">
                            <a href="{{ item.url }}" class="cart-item__name h4 break">
                              {{- item.product.title | escape -}}
                            </a>
                            {%- assign cart_disclosure_modal_id = 'CartDisclosureModal-drawer-' | append: item.key | replace: ':', '-' -%}
                            {%- render 'cart-disclosure-indicator',
                              product: item.product,
                              modal_id: cart_disclosure_modal_id
                            -%}
                          </div>

                          {%- if item.original_price != item.final_price -%}
                            <div class="cart-item__discounted-prices">
                              <span class="visually-hidden">
                                {{ 'products.product.price.regular_price' | t }}
                              </span>
                              <s class="cart-item__old-price product-option">
                                {{- item.original_price | money -}}
                              </s>
                              <span class="visually-hidden">
                                {{ 'products.product.price.sale_price' | t }}
                              </span>
                              <strong class="cart-item__final-price product-option">
                                {{ item.final_price | money }}
                              </strong>
                            </div>
                          {%- else -%}
                            <div class="product-option">
                              {{ item.original_price | money }}
                            </div>
                          {%- endif -%}

                          {%- if item.product.has_only_default_variant == false
                            or item.properties.size != 0
                            or item.selling_plan_allocation != null
                          -%}
                            <dl>
                              {%- if item.product.has_only_default_variant == false -%}
                                {%- for option in item.options_with_values -%}
                                  <div class="product-option">
                                    <dt>{{ option.name }}:</dt>
                                    <dd>
                                      {{ option.value -}}
                                      {%- unless forloop.last %}, {% endunless %}
                                    </dd>
                                  </div>
                                {%- endfor -%}
                              {%- endif -%}

                              {%- for property in item.properties -%}
                                {%- assign property_first_char = property.first | slice: 0 -%}
                                {%- if property.last != blank and property_first_char != '_' -%}
                                  <div class="product-option">
