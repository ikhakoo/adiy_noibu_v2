{% comment %} Sticky Floating Add to Cart Bar Snippet {% endcomment %}
{% assign current_variant = product.selected_or_first_available_variant %}

<div id="sticky-add-to-cart-bar" class="sticky-atc-bar">
  <div class="sticky-atc-container">
    
    <!-- Left Side: Pricing and Trust Badges -->
    <div class="sticky-atc-info">
      <div class="sticky-atc-price-wrapper">
        <!-- Compare Price (Strikethrough) -->
        <span id="sticky-compare-price" class="sticky-price-compare {% unless current_variant.compare_at_price > current_variant.price %}hidden{% endunless %}">
          {{ current_variant.compare_at_price | money }}
        </span>

        <!-- Regular / Sale Price -->
        <span id="sticky-current-price" class="sticky-price-current">
          {{ current_variant.price | money }}
        </span>

        <!-- Save Amount Badge -->
        {% assign save_amount = current_variant.compare_at_price | minus: current_variant.price %}
        <span id="sticky-save-badge" class="sticky-save-badge {% unless current_variant.compare_at_price > current_variant.price %}hidden{% endunless %}">
          Save <span id="sticky-save-amount">{{ save_amount | money }}</span>
        </span>
      </div>

      <!-- Trust Badges Under Price -->
      <div class="sticky-atc-features">
        <span class="feature-item">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><text x="12" y="15" font-size="8" text-anchor="middle" fill="currentColor" stroke="none">10</text></svg>
          10-Year Warranty
        </span>
        <span class="feature-item">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
          100-Day Money Back
        </span>
      </div>
    </div>

    <!-- Right Side: Add to Cart Button -->
    <div class="sticky-atc-action">
      <button type="button" id="sticky-submit-btn" class="sticky-add-btn" {% unless current_variant.available %}disabled{% endunless %}>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
        <span id="sticky-btn-text">
          {% if current_variant.available %}
            Add To Cart
          {% else %}
            Sold Out
          {% endif %}
        </span>
      </button>
    </div>

  </div>
</div>