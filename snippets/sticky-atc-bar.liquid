<!-- ========================================== -->
<!-- BOTTOM-RIGHT FLOATING ADD TO CART STYLES -->
<!-- ========================================== -->
<style>
  .bottom-right-floating-atc {
    position: fixed;
    bottom: 25px;
    right: 25px;
    z-index: 99999;
  }

  .bottom-right-floating-atc .floating-atc-btn {
    background-color: #1a4234; /* Apni pasand ya image ke mutabiq dark green color */
    color: #ffffff;
    border: none;
    padding: 15px 30px;
    font-size: 16px;
    font-weight: 600;
    border-radius: 50px; /* Fully rounded ya 8px kar sakte hain */
    cursor: pointer;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.25);
    display: flex;
    align-items: center;
    gap: 10px;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .bottom-right-floating-atc .floating-atc-btn:hover {
    transform: translateY(-2px);
    opacity: 0.95;
  }

  /* Mobile screen ke liye thoda adjust karne ke liye */
  @media (max-width: 768px) {
    .bottom-right-floating-atc {
      bottom: 15px;
      right: 15px;
    }
    .bottom-right-floating-atc .floating-atc-btn {
      padding: 12px 20px;
      font-size: 14px;
    }
  }
</style>

<!-- ========================================== -->
<!-- HTML STRUCTURE -->
<!-- ========================================== -->
<div class="bottom-right-floating-atc">
  <button type="button" class="floating-atc-btn" onclick="triggerOriginalAddToCart()">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
      <line x1="3" y1="6" x2="21" y2="6"></line>
      <path d="M16 10a4 4 0 0 1-8 0"></path>
    </svg>
    <span>Add to cart</span>
  </button>
</div>

<!-- ========================================== -->
<!-- JAVASCRIPT LOGIC -->
<!-- ========================================== -->
<script>
  function triggerOriginalAddToCart() {
    // Ye function asli/main Add to Cart button ko click kar dega taaki cart me product add ho jaye
    const mainAddToCartBtn = document.querySelector('form[action*="/cart/add"] button[type="submit"]') || 
                             document.querySelector('.product-form__submit');
    if (mainAddToCartBtn) {
      mainAddToCartBtn.click();
    } else {
      console.log("Main add to cart button nahi mila!");
    }
  }
</script>