{%- if product.selected_or_first_available_variant -%}
  <div class="custom-sticky-atc-bar" id="customStickyATC">
    <div class="sticky-atc-inner">
      
      <!-- Left Side: Pricing & Savings -->
      <div class="sticky-atc-left">
        <div class="sticky-price-row">
          <span class="sticky-current-price">{{ product.selected_or_first_available_variant.price | money }}</span>
          {%- if product.selected_or_first_available_variant.compare_at_price > product.selected_or_first_available_variant.price -%}
            <span class="sticky-compare-price">{{ product.selected_or_first_available_variant.compare_at_price | money }}</span>
            <span class="sticky-save-badge">
              Save {{ product.selected_or_first_available_variant.compare_at_price | minus: product.selected_or_first_available_variant.price | money }}
            </span>
          {%- endif -%}
        </div>
        
        <!-- Trust Badges -->
        <div class="sticky-trust-badges">
          <div class="sticky-badge-item">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
            <span>10-Year Warranty</span>
          </div>
          <div class="sticky-badge-item">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
            <span>100-Day Returns</span>
          </div>
        </div>
      </div>

      <!-- Right Side: Add to Cart Form -->
      <div class="sticky-atc-right">
        <form action="/cart/add" method="post" enctype="multipart/form-data">
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
          <button type="submit" class="sticky-submit-btn" {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %}>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path><line x1="3" y1="6" x2="21" y2="6"></line><path d="M16 10a4 4 0 0 1-8 0"></path></svg>
            <span>{% if product.selected_or_first_available_variant.available %}Add To Cart{% else %}Sold Out{% endif %}</span>
          </button>
        </form>
      </div>

    </div>
  </div>

  <style>
    .custom-sticky-atc-bar {
      position: fixed;
      bottom: -100px; /* Shuru me screen se bahar rakha hai */
      left: 0;
      width: 100%;
      background-color: #ffffff;
      box-shadow: 0 -4px 20px rgba(0, 0, 0, 0.1);
      z-index: 99999;
      padding: 12px 20px;
      box-sizing: border-box;
      transition: bottom 0.3s ease-in-out;
    }

    .custom-sticky-atc-bar.is-visible {
      bottom: 0; /* Jab class lagegi toh screen par aa jayega */
    }

    .sticky-atc-inner {
      max-width: 1200px;
      margin: 0 auto;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
    }

    .sticky-atc-left {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }

    .sticky-price-row {
      display: flex;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap;
    }

    .sticky-current-price {
      font-size: 16px;
      font-weight: 700;
      color: #111;
    }

    .sticky-compare-price {
      font-size: 14px;
      text-decoration: line-height;
      text-decoration: line-through;
      color: #888;
    }

    .sticky-save-badge {
      background-color: #eaf6ed;
      color: #1b3d2f;
      font-size: 12px;
      font-weight: 600;
      padding: 2px 8px;
      border-radius: 20px;
    }

    .sticky-trust-badges {
      display: flex;
      align-items: center;
      gap: 15px;
    }

    .sticky-badge-item {
      display: flex;
      align-items: center;
      gap: 5px;
      font-size: 12px;
      color: #555;
    }

    .sticky-badge-item svg {
      stroke: #555;
    }

    .sticky-submit-btn {
      background-color: #1b3d2f;
      color: #ffffff;
      border: none;
      border-radius: 6px;
      padding: 12px 28px;
      font-size: 15px;
      font-weight: 600;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 8px;
      transition: opacity 0.2s;
      white-space: nowrap;
    }

    .sticky-submit-btn:hover {
      opacity: 0.9;
    }

    @media screen and (max-width: 768px) {
      .sticky-trust-badges {
        display: none;
      }
      .custom-sticky-atc-bar {
        padding: 10px 15px;
      }
      .sticky-submit-btn {
        padding: 10px 18px;
        font-size: 14px;
      }
    }
  </style>

  <script>
  document.addEventListener("DOMContentLoaded", function () {
    const stickyBar = document.getElementById("customStickyATC");
    if (!stickyBar) return;

    // Shopify ke main Add to Cart button ko dhoondne ke liye common selectors
    const mainAddToCartBtn = document.querySelector('form[action*="/cart/add"] button[type="submit"], .product-form__submit, button[name="add"], .product__submit');

    if (!mainAddToCartBtn) return;

    function checkButtonVisibility() {
      const rect = mainAddToCartBtn.getBoundingClientRect();
      const windowHeight = window.innerHeight || document.documentElement.clientHeight;

      // Check karein ke kya main button screen (viewport) ke andar kahin bhi visible hai
      const isVisible = (rect.top <= windowHeight) && (rect.bottom >= 0);

      if (isVisible) {
        // Agar main button screen par dikh raha hai, toh sticky bar hide kar do
        stickyBar.classList.remove("is-visible");
      } else {
        // Agar main button screen se upar ya niche nikal gaya hai, toh sticky bar show kar do
        stickyBar.classList.add("is-visible");
      }
    }

    // Scroll aur Resize par check karte rahein
    window.addEventListener("scroll", checkButtonVisibility);
    window.addEventListener("resize", checkButtonVisibility);
    
    // Page load hone par bhi ek baar check karein
    checkButtonVisibility();
  });
</script>
{%- endif -%}