{%- assign current_variant = product.selected_or_first_available_variant -%}

<div class="inline-atc-box" id="inline-atc-box-{{ section.id }}">
  <div class="inline-atc-content">
    
    <!-- Left Section: Pricing & Badges -->
    <div class="inline-atc-left">
      <div class="inline-atc-prices">
        <!-- Compare At Price (Strikethrough) -->
        <span class="inline-price-compare {% unless current_variant.compare_at_price > current_variant.price %}hidden{% endunless %}" id="atc-compare-price">
          {{ current_variant.compare_at_price | money }}
        </span>

        <!-- Selling Price -->
        <span class="inline-price-current" id="atc-current-price">
          {{ current_variant.price | money }}
        </span>

        <!-- Discount / Save Badge -->
        {%- assign save_amount = current_variant.compare_at_price | minus: current_variant.price -%}
        <span class="inline-save-badge {% unless current_variant.compare_at_price > current_variant.price %}hidden{% endunless %}" id="atc-save-badge">
          Save <span id="atc-save-amount">{{ save_amount | money }}</span>
        </span>
      </div>

      <!-- Trust Badges under price -->
      <div class="inline-atc-features">
        <span class="feature-tag">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><text x="12" y="15" font-size="8" text-anchor="middle" fill="currentColor" stroke="none">10</text></svg>
          10-Year Warranty
        </span>
        <span class="feature-tag">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
          100-Day Money Back
        </span>
      </div>
    </div>

    <!-- Right Section: Add To Cart Button -->
    <div class="inline-atc-right">
      <button 
        type="button" 
        class="inline-atc-btn" 
        id="inline-atc-button"
        data-variant-id="{{ current_variant.id }}"
        {% unless current_variant.available %}disabled{% endunless %}
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
        <span id="inline-atc-btn-text">
          {% if current_variant.available %}
            Add To Cart
          {% else %}
            Sold Out
          {% endif %}
        </span>
      </button>
    </div>

  </div>
</div>

<style>
  .inline-atc-box {
    position: fixed;
    bottom: 0;
    left: 0;
    width: 100%;
    background: #ffffff;
    border-top: 1px solid #e2e2e2;
    padding: 14px 20px;
    box-shadow: 0 -4px 20px rgba(0, 0, 0, 0.08);
    box-sizing: border-box;
    font-family: inherit;
    z-index: 99999;
  }

  .inline-atc-content {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 15px;
  }

  .inline-atc-left {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .inline-atc-prices {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  .inline-price-compare {
    text-decoration: line-through;
    color: #777777;
    font-size: 14px;
  }

  .inline-price-current {
    font-size: 18px;
    font-weight: 700;
    color: #1a1a1a;
  }

  .inline-save-badge {
    background-color: #e5f5e8;
    color: #276d33;
    padding: 2px 8px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 600;
    display: inline-block;
  }

  .inline-atc-features {
    display: flex;
    align-items: center;
    gap: 15px;
    color: #444444;
    font-size: 11px;
    font-weight: 500;
  }

  .feature-tag {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .inline-atc-right {
    flex-shrink: 0;
  }

  .inline-atc-btn {
    background-color: #8c6a58;
    color: #ffffff;
    border: none;
    border-radius: 8px;
    padding: 12px 24px;
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 8px;
    transition: background-color 0.2s ease;
    white-space: nowrap;
  }

  .inline-atc-btn:hover {
    background-color: #745444;
  }

  .inline-atc-btn:disabled {
    background-color: #cccccc;
    cursor: not-allowed;
  }

  .hidden {
    display: none !important;
  }

  @media (max-width: 480px) {
    .inline-atc-content {
      flex-direction: column;
      align-items: flex-start;
    }
    .inline-atc-right {
      width: 100%;
    }
    .inline-atc-btn {
      width: 100%;
      justify-content: center;
    }
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    function formatMoney(cents) {
      return (cents / 100).toLocaleString("en-US", {
        style: "currency",
        currency: "USD"
      });
    }

    const buttonEl = document.getElementById("inline-atc-button");
    const btnTextEl = document.getElementById("inline-atc-btn-text");
    const currentPriceEl = document.getElementById("atc-current-price");
    const comparePriceEl = document.getElementById("atc-compare-price");
    const saveBadgeEl = document.getElementById("atc-save-badge");
    const saveAmountEl = document.getElementById("atc-save-amount");

    // Variant change hone par price aur variant id update karna
    function updateAtcBox(variant) {
      if (!variant) return;

      if (buttonEl) {
        buttonEl.setAttribute("data-variant-id", variant.id);
      }

      if (currentPriceEl) {
        currentPriceEl.innerText = formatMoney(variant.price);
      }

      if (variant.compare_at_price && variant.compare_at_price > variant.price) {
        const saveAmount = variant.compare_at_price - variant.price;

        if (comparePriceEl) {
          comparePriceEl.innerText = formatMoney(variant.compare_at_price);
          comparePriceEl.classList.remove("hidden");
        }
        if (saveAmountEl) {
          saveAmountEl.innerText = formatMoney(saveAmount);
        }
        if (saveBadgeEl) {
          saveBadgeEl.classList.remove("hidden");
        }
      } else {
        if (comparePriceEl) comparePriceEl.classList.add("hidden");
        if (saveBadgeEl) saveBadgeEl.classList.add("hidden");
      }

      if (buttonEl && btnTextEl) {
        if (variant.available) {
          buttonEl.removeAttribute("disabled");
          btnTextEl.innerText = "Add To Cart";
        } else {
          buttonEl.setAttribute("disabled", "true");
          btnTextEl.innerText = "Sold Out";
        }
      }
    }

    // Theme ke variant change event ko sunna
    document.addEventListener("variant:changed", function (e) {
      if (e.detail && e.detail.variant) {
        updateAtcBox(e.detail.variant);
      }
    });

    // AJAX Add to Cart button click handler
    if (buttonEl) {
      buttonEl.addEventListener("click", function () {
        const variantId = this.getAttribute("data-variant-id");
        if (!variantId || buttonEl.hasAttribute("disabled")) return;

        const originalText = btnTextEl.innerText;
        btnTextEl.innerText = "Adding...";
        buttonEl.setAttribute("disabled", "true");

        fetch('/cart/add.js', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({
            id: variantId,
            quantity: 1
          })
        })
        .then(response => response.json())
        .then(data => {
          btnTextEl.innerText = "Added!";
          setTimeout(() => {
            btnTextEl.innerText = originalText;
            buttonEl.removeAttribute("disabled");
          }, 1500);

          document.dispatchEvent(new CustomEvent('cart:refresh', { detail: data }));
        })
        .catch(error => {
          console.error('Error adding to cart:', error);
          btnTextEl.innerText = originalText;
          buttonEl.removeAttribute("disabled");
        });
      });
    }
  });
</script>