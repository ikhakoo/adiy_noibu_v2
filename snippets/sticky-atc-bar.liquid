{% comment %} Sticky Floating Add to Cart Bar Snippet {% endcomment %}
{% assign current_variant = product.selected_or_first_available_variant %}

<div id="sticky-add-to-cart-bar" class="sticky-atc-bar">
  <div class="sticky-atc-container">
    
    <!-- Left Side: Pricing and Trust Badges -->
    <div class="sticky-atc-info">
      <div class="sticky-atc-price-wrapper">
        <!-- Compare Price (Strikethrough) -->
        <span id="sticky-compare-price" class="sticky-price-compare {% unless current_variant.compare_at_price > current_variant.price %}hidden{% endunless %}">
          {{ current_variant.compare_at_price | money }}
        </span>

        <!-- Regular / Sale Price -->
        <span id="sticky-current-price" class="sticky-price-current">
          {{ current_variant.price | money }}
        </span>

        <!-- Save Amount Badge -->
        {% assign save_amount = current_variant.compare_at_price | minus: current_variant.price %}
        <span id="sticky-save-badge" class="sticky-save-badge {% unless current_variant.compare_at_price > current_variant.price %}hidden{% endunless %}">
          Save <span id="sticky-save-amount">{{ save_amount | money }}</span>
        </span>
      </div>

      <!-- Trust Badges Under Price -->
      <div class="sticky-atc-features">
        <span class="feature-item">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><text x="12" y="15" font-size="8" text-anchor="middle" fill="currentColor" stroke="none">10</text></svg>
          10-Year Warranty
        </span>
        <span class="feature-item">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
          100-Day Money Back
        </span>
      </div>
    </div>

    <!-- Right Side: Add to Cart Button -->
    <div class="sticky-atc-action">
      <button type="button" id="sticky-submit-btn" class="sticky-add-btn" {% unless current_variant.available %}disabled{% endunless %}>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
        <span id="sticky-btn-text">
          {% if current_variant.available %}
            Add To Cart
          {% else %}
            Sold Out
          {% endif %}
        </span>
      </button>
    </div>

  </div>
</div>
  <style>
    .sticky-atc-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  background-color: #ffffff;
  box-shadow: 0 -4px 15px rgba(0, 0, 0, 0.1);
  z-index: 999;
  padding: 12px 20px;
  font-family: inherit;
  transition: transform 0.3s ease-in-out;
}

.sticky-atc-container {
  max-width: 1200px;
  margin: 0 auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.sticky-atc-info {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.sticky-atc-price-wrapper {
  display: flex;
  align-items: center;
  gap: 10px;
}

.sticky-price-compare {
  text-decoration: line-through;
  color: #666666;
  font-size: 16px;
}

.sticky-price-current {
  font-weight: bold;
  font-size: 18px;
  color: #111111;
}

.sticky-save-badge {
  background-color: #eaf8e6;
  color: #1e6d1e;
  padding: 3px 10px;
  border-radius: 12px;
  font-size: 13px;
  font-weight: 600;
}

.sticky-atc-features {
  display: flex;
  gap: 15px;
  font-size: 12px;
  color: #333333;
}

.feature-item {
  display: flex;
  align-items: center;
  gap: 5px;
}

.sticky-add-btn {
  background-color: #8c6a58; /* Color matching the reference image */
  color: #ffffff;
  border: none;
  padding: 12px 32px;
  border-radius: 8px;
  font-size: 16px;
  font-weight: 600;
  cursor: pointer;
  display: flex;
  align-items: center;
  gap: 8px;
  transition: background-color 0.2s;
}

.sticky-add-btn:hover {
  background-color: #755544;
}

.sticky-add-btn:disabled {
  background-color: #cccccc;
  cursor: not-allowed;
}

.hidden {
  display: none !important;
}

@media (max-width: 768px) {
  .sticky-atc-features {
    display: none; /* Hide trust badges on smaller screens */
  }
}
  </style>

  <script>
    document.addEventListener("DOMContentLoaded", function () {
  // Main Product Form Element
  const mainProductForm = document.querySelector('form[action*="/cart/add"]');
  const stickyButton = document.getElementById("sticky-submit-btn");

  // Format Money Helper Function
  function formatMoney(cents) {
    return (cents / 100).toLocaleString("en-US", {
      style: "currency",
      currency: "USD"
    });
  }

  // Handle Sticky Add to Cart Click
  if (stickyButton && mainProductForm) {
    stickyButton.addEventListener("click", function (e) {
      e.preventDefault();
      
      // Main form ka submit button trigger karein
      const mainSubmitBtn = mainProductForm.querySelector('[name="add"]');
      if (mainSubmitBtn) {
        mainSubmitBtn.click();
      } else {
        mainProductForm.submit();
      }
    });
  }

  // Listen for Variant Change Event (Works on Shopify Dawn & similar themes)
  document.addEventListener("variant:changed", function (event) {
    const variant = event.detail.variant;
    updateStickyBar(variant);
  });

  // Alternative Observer for Shopify Theme Select Selectors
  const variantSelects = document.querySelector('variant-selects, variant-radios');
  if (variantSelects) {
    variantSelects.addEventListener('change', function() {
      // Small delay to allow theme JS to update URL/State
      setTimeout(() => {
        if (window.ShopifyAnalytics && window.ShopifyAnalytics.meta && window.ShopifyAnalytics.meta.selectedVariantId) {
             // You can fetch or read variant details from window.product or Theme API
        }
      }, 100);
    });
  }

  // Update Sticky Bar Elements dynamically
  function updateStickyBar(variant) {
    if (!variant) return;

    const currentPriceEl = document.getElementById("sticky-current-price");
    const comparePriceEl = document.getElementById("sticky-compare-price");
    const saveBadgeEl = document.getElementById("sticky-save-badge");
    const saveAmountEl = document.getElementById("sticky-save-amount");
    const btnTextEl = document.getElementById("sticky-btn-text");

    // Update Price
    if (currentPriceEl) {
      currentPriceEl.innerText = formatMoney(variant.price);
    }

    // Update Compare & Save Badge
    if (variant.compare_at_price && variant.compare_at_price > variant.price) {
      const saveAmount = variant.compare_at_price - variant.price;
      
      if (comparePriceEl) {
        comparePriceEl.innerText = formatMoney(variant.compare_at_price);
        comparePriceEl.classList.remove("hidden");
      }
      
      if (saveAmountEl) {
        saveAmountEl.innerText = formatMoney(saveAmount);
      }
      
      if (saveBadgeEl) {
        saveBadgeEl.classList.remove("hidden");
      }
    } else {
      if (comparePriceEl) comparePriceEl.classList.add("hidden");
      if (saveBadgeEl) saveBadgeEl.classList.add("hidden");
    }

    // Update Button Availability
    if (stickyButton && btnTextEl) {
      if (variant.available) {
        stickyButton.removeAttribute("disabled");
        btnTextEl.innerText = "Add To Cart";
      } else {
        stickyButton.setAttribute("disabled", "true");
        btnTextEl.innerText = "Sold Out";
      }
    }
  }
});
</script>