<!-- ========================================== -->
<!-- FULL-WIDTH BOTTOM STICKY ADD TO CART BAR -->
<!-- ========================================== -->
<style>
  .full-width-sticky-atc {
    position: fixed;
    bottom: 0;
    left: 0;
    width: 100%;
    background: #ffffff;
    padding: 12px 24px;
    box-shadow: 0 -4px 16px rgba(0, 0, 0, 0.15);
    z-index: 99999;
    display: flex;
    justify-content: space-between;
    align-items: center;
    box-sizing: border-box;
    transform: translateY(100%);
    opacity: 0;
    transition: transform 0.3s ease, opacity 0.3s ease;
    pointer-events: none;
  }

  /* Jab main button screen se bahar hoga tab ye active hogi */
  .full-width-sticky-atc.is-active {
    transform: translateY(0);
    opacity: 1;
    pointer-events: auto;
  }

  .sticky-product-title {
    font-size: 16px;
    font-weight: 600;
    color: #111111;
  }

  .sticky-action-btn {
    background-color: #1a4234; /* Dark green theme matching color */
    color: #ffffff;
    border: none;
    padding: 14px 32px;
    font-size: 16px;
    font-weight: 600;
    border-radius: 6px;
    cursor: pointer;
    transition: opacity 0.2s ease;
  }

  .sticky-action-btn:hover {
    opacity: 0.9;
  }

  /* Mobile devices ke liye responsive adjustment */
  @media (max-width: 768px) {
    .full-width-sticky-atc {
      flex-direction: column;
      gap: 10px;
      padding: 10px 15px;
      text-align: center;
    }
    .sticky-action-btn {
      width: 100%;
    }
  }
</style>

<!-- ========================================== -->
<!-- HTML STRUCTURE -->
<!-- ========================================== -->
<div class="full-width-sticky-atc" id="fullWidthStickyBar">
  <div class="sticky-product-title">
    {{ product.title }}
  </div>
  <div>
    <button type="button" class="sticky-action-btn" onclick="triggerOriginalAddToCart()">
      Add to cart
    </button>
  </div>
</div>

<!-- ========================================== -->
<!-- JAVASCRIPT LOGIC -->
<!-- ========================================== -->
<script>
  document.addEventListener("DOMContentLoaded", function () {
    const mainAddToCartBtn = document.querySelector('form[action*="/cart/add"] button[type="submit"]') || 
                             document.querySelector('.product-form__submit');
    const stickyBar = document.getElementById('fullWidthStickyBar');

    if (mainAddToCartBtn && stickyBar) {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          // Jab main button view se hat jayega, tab full-width bar bottom par show hogi
          if (!entry.isIntersecting) {
            stickyBar.classList.add('is-active');
          } else {
            stickyBar.classList.remove('is-active');
          }
        });
      }, { threshold: 0 });

      observer.observe(mainAddToCartBtn);
    }
  });

  // Sticky bar ke button par click karne se original add to cart trigger hoga
  function triggerOriginalAddToCart() {
    const mainAddToCartBtn = document.querySelector('form[action*="/cart/add"] button[type="submit"]') || 
                             document.querySelector('.product-form__submit');
    if (mainAddToCartBtn) {
      mainAddToCartBtn.click();
    }
  }
</script>