{%- comment -%}
  Cover-cropped image box for the size deck page (sdp-*) sections. The box sets the size
  (CSS aspect-ratio / height); the image fills it with object-fit: cover.

  Accepts:
  - image: {Object} image_picker value (falls back to a placeholder when blank)
  - class: {String} extra classes on the wrapper
  - sizes: {String} sizes attribute
  - eager: {Boolean} load eagerly with high priority (above-the-fold images)
  - focal: {String} CSS object-position override, e.g. "50% 40%"
  - alt: {String} alt text override
{%- endcomment -%}
<div class="sdp-media{% if class != blank %} {{ class }}{% endif %}{% if image == blank %} sdp-media--placeholder{% endif %}"{% if focal != blank %} style="--sdp-focal: {{ focal }};"{% endif %}>
  {%- if image != blank -%}
    {%- liquid
      if eager
        assign loading = 'eager'
        assign priority = 'high'
      else
        assign loading = 'lazy'
        assign priority = 'auto'
      endif
      assign alt_text = alt | default: image.alt
    -%}
    {{
      image
      | image_url: width: 2400
      | image_tag:
        widths: '400, 600, 800, 1100, 1500, 2000, 2400',
        sizes: sizes,
        loading: loading,
        fetchpriority: priority,
        alt: alt_text
    }}
  {%- else -%}
    {{ 'image' | placeholder_svg_tag }}
  {%- endif -%}
</div>
