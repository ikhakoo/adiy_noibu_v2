{%- comment -%}
  Right Column Sticky Box with Runtime Price Sync via MutationObserver
  Usage: {% render 'custom-sticky-atc-bar' %}
{%- endcomment -%}

<div id="right-column-sticky-box" class="right-column-sticky-box">
  <div class="rac-content">
    
    <!-- Price & Savings Section -->
    <div class="rac-price-row">
      <div class="rac-prices" id="sticky-price-container">
        {%- assign current_variant = product.selected_or_first_available_variant -%}
        {%- if current_variant.compare_at_price > current_variant.price -%}
          <span class="rac-compare-price">{{ current_variant.compare_at_price | money }}</span>
        {%- endif -%}
        <span class="rac-current-price">{{ current_variant.price | money }}</span>
        
        {%- if current_variant.compare_at_price > current_variant.price -%}
          {%- assign save_amt = current_variant.compare_at_price | minus: current_variant.price -%}
          <span class="rac-save-badge">Save {{ save_amt | money }}</span>
        {%- endif -%}
      </div>
    </div>

    <div class="rac-perks">
      <span class="rac-perk-item">🛡️ 10-Year Warranty</span>
      <span class="rac-perk-item">✅ 100-Day Money Back</span>
    </div>

    <!-- Buy Buttons Render -->
    <div class="rac-action">
      {%- render 'buy-buttons',
        block: block,
        product: product,
        product_form_id: product_form_id,
        section_id: section.id,
        show_pickup_availability: true
      -%}
    </div>

  </div>
</div>

<style>
  #right-column-sticky-box.right-column-sticky-box {
    display: none !important;
    position: sticky !important;
    bottom: 20px !important;
    width: 100% !important;
    background-color: #ffffff !important;
    box-shadow: 0 5px 25px rgba(0, 0, 0, 0.12) !important;
    padding: 18px !important;
    border-radius: 8px !important;
    z-index: 99999 !important;
    border: 1px solid #e5e5e5 !important;
    box-sizing: border-box;
    margin-top: 20px;
  }

  #right-column-sticky-box.right-column-sticky-box.is-visible {
    display: block !important;
  }

  .rac-content {
    display: flex;
    flex-direction: column;
    gap: 12px;
    width: 100%;
  }

  .rac-price-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .rac-prices {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  .rac-compare-price {
    text-decoration: line-through;
    color: #888;
    font-size: 14px;
  }

  .rac-current-price {
    font-size: 18px;
    font-weight: 700;
    color: #121212;
  }

  .rac-save-badge {
    background-color: #eaf6ea;
    color: #2b7a2b;
    padding: 3px 8px;
    border-radius: 12px;
    font-size: 12px;
    font-weight: 600;
  }

  .rac-perks {
    display: flex;
    align-items: center;
    gap: 15px;
    font-size: 12px;
    color: #555;
    border-top: 1px solid #f0f0f0;
    padding-top: 8px;
  }

  .rac-action {
    width: 100%;
  }

  .rac-action .product-form {
    margin: 0 !important;
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    const stickyBox = document.getElementById("right-column-sticky-box");
    const mainAddToCartBtn = document.querySelector(".product-form__submit, form[action*='/cart/add'] button[type='submit']");
    const productFormContainer = document.querySelector(".product-form, product-form, .product__info-container");

    if (!stickyBox || !mainAddToCartBtn) return;

    if (productFormContainer) {
      productFormContainer.appendChild(stickyBox);
    }

    function checkVisibility() {
      const btnRect = mainAddToCartBtn.getBoundingClientRect();
      const windowHeight = window.innerHeight || document.documentElement.clientHeight;
      const isBtnOutOfView = (btnRect.top > windowHeight) || (btnRect.bottom < 0);

      if (isBtnOutOfView) {
        stickyBox.classList.add("is-visible");
      } else {
        stickyBox.classList.remove("is-visible");
      }
    }

    window.addEventListener("scroll", checkVisibility, { passive: true });
    window.addEventListener("resize", checkVisibility, { passive: true });
    checkVisibility();

    // Runtime Price Sync via MutationObserver on main product price element
    const mainPriceElement = document.querySelector('.price, .product__price, [id*="price-"], .no-js-hidden .price');
    const stickyPriceContainer = document.getElementById('sticky-price-container');

    if (mainPriceElement && stickyPriceContainer) {
      const observer = new MutationObserver(function(mutations) {
        stickyPriceContainer.innerHTML = mainPriceElement.innerHTML;
      });

      observer.observe(mainPriceElement, {
        childList: true,
        subtree: true,
        characterData: true
      });
    }
  });
</script>