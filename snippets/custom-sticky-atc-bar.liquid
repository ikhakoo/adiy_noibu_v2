{%- comment -%}
  Right-Side Floating Sticky ATC Box
  Usage: {% render 'custom-sticky-atc-bar' %}
{%- endcomment -%}

<div id="right-sticky-atc-box" class="right-sticky-box">
  <div class="right-sticky-content">
    <!-- Price & Savings -->
    <div class="right-sticky-prices">
      {%- if product.selected_or_first_available_variant.compare_at_price > product.selected_or_first_available_variant.price -%}
        <span class="right-compare-price">{{ product.selected_or_first_available_variant.compare_at_price | money }}</span>
      {%- endif -%}
      <span class="right-current-price">{{ product.selected_or_first_available_variant.price | money }}</span>
      
      {%- if product.selected_or_first_available_variant.compare_at_price > product.selected_or_first_available_variant.price -%}
        {%- assign save_amt = product.selected_or_first_available_variant.compare_at_price | minus: product.selected_or_first_available_variant.price -%}
        <span class="right-save-badge">Save {{ save_amt | money }}</span>
      {%- endif -%}
    </div>

    <!-- Add to Cart Button -->
    <div class="right-sticky-action">
      {%- form 'product', product, id: 'right-sticky-form', class: 'sticky-product-form' -%}
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" id="right-variant-input">
        <button type="submit" name="add" class="right-sticky-btn" {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %}>
          <span>{% if product.selected_or_first_available_variant.available %}Add To Cart{% else %}Sold Out{% endif %}</span>
        </button>
      {%- endform -%}
    </div>
  </div>
</div>

<style>
  /* Shuru mein yeh hidden rahega */
  #right-sticky-atc-box.right-sticky-box {
    display: none;
    position: sticky;
    bottom: 20px;
    background-color: #ffffff;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.12);
    padding: 16px;
    border-radius: 8px;
    z-index: 99;
    border: 1px solid #e5e5e5;
    margin-top: 20px;
    transition: all 0.3s ease-in-out;
  }

  /* Jab JS active class degi tab yeh right column mein show ho jayega */
  #right-sticky-atc-box.right-sticky-box.is-visible {
    display: block;
  }

  .right-sticky-content {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .right-sticky-prices {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  .right-compare-price {
    text-decoration: line-through;
    color: #888;
    font-size: 14px;
  }

  .right-current-price {
    font-weight: 700;
    color: #121212;
    font-size: 18px;
  }

  .right-save-badge {
    background-color: #eaf6ea;
    color: #2b7a2b;
    padding: 3px 8px;
    border-radius: 12px;
    font-size: 12px;
    font-weight: 600;
  }

  .right-sticky-action .right-sticky-btn {
    background-color: #8b7355; /* Apne theme ke button color ke mutabiq match kar lein */
    color: #fff;
    border: none;
    width: 100%;
    padding: 12px 20px;
    font-size: 15px;
    font-weight: 600;
    border-radius: 4px;
    cursor: pointer;
    transition: background-color 0.2s ease;
  }

  .right-sticky-btn:hover {
    background-color: #725d43;
  }

  .right-sticky-btn:disabled {
    background-color: #ccc;
    cursor: not-allowed;
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    const stickyBox = document.getElementById("right-sticky-atc-box");
    const mainAddToCartBtn = document.querySelector(".product-form__submit, form[action*='/cart/add'] button[type='submit']");
    const productInfoWrapper = document.querySelector(".product__info-wrapper, .product-info-container, .product__column-sticky");

    if (!stickyBox || !mainAddToCartBtn) return;

    // Agar aap chahte hain ke yeh sirf right column ke andar hi render ho, toh isko wahan move kar sakte hain
    if (productInfoWrapper) {
      productInfoWrapper.appendChild(stickyBox);
    }

    function checkVisibility() {
      const rect = mainAddToCartBtn.getBoundingClientRect();
      const windowHeight = window.innerHeight || document.documentElement.clientHeight;

      // Check karein ke main button screen par nazar aa raha hai ya nahi
      const isButtonVisible = (rect.top <= windowHeight) && (rect.bottom >= 0);

      // Agar main button screen par hai, toh right side wala box HIDE rahega
      // Jab main button screen se upar ya neeche nikal jayega, toh right side wala box SHOW ho jayega
      if (!isButtonVisible) {
        stickyBox.classList.add("is-visible");
      } else {
        stickyBox.classList.remove("is-visible");
      }
    }

    window.addEventListener("scroll", checkVisibility, { passive: true });
    window.addEventListener("resize", checkVisibility, { passive: true });
    
    checkVisibility();
  });
</script>