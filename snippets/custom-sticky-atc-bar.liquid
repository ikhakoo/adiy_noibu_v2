{%- comment -%}
  Floating Sticky Add to Cart Bar
  Usage: {% render 'sticky-atc-bar' %}
{%- endcomment -%}

<div id="custom-sticky-atc-bar" class="custom-sticky-atc">
  <div class="custom-sticky-container">
    <!-- Left: Price & Savings / Badges -->
    <div class="custom-sticky-left">
      <div class="custom-sticky-prices">
        {%- if product.selected_or_first_available_variant.compare_at_price > product.selected_or_first_available_variant.price -%}
          <span class="custom-compare-price">{{ product.selected_or_first_available_variant.compare_at_price | money }}</span>
        {%- endif -%}
        <span class="custom-current-price">{{ product.selected_or_first_available_variant.price | money }}</span>
        
        {%- if product.selected_or_first_available_variant.compare_at_price > product.selected_or_first_available_variant.price -%}
          {%- assign save_amount = product.selected_or_first_available_variant.compare_at_price | minus: product.selected_or_first_available_variant.price -%}
          <span class="custom-save-badge">Save {{ save_amount | money }}</span>
        {%- endif -%}
      </div>
      
      <!-- Optional Trust Badges / Info (Jaise aapke screenshot mein hain) -->
      <div class="custom-sticky-perks">
        <span class="perk-item">🛡️ 10-Year Warranty</span>
        <span class="perk-item">✅ 100-Day Money Back</span>
      </div>
    </div>

    <!-- Right: Add to Cart Button -->
    <div class="custom-sticky-right">
      {%- form 'product', product, id: 'custom-sticky-form', class: 'sticky-product-form' -%}
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" id="sticky-variant-input">
        <button type="submit" name="add" class="custom-sticky-btn" {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %}>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>
          <span>{% if product.selected_or_first_available_variant.available %}Add To Cart{% else %}Sold Out{% endif %}</span>
        </button>
      {%- endform -%}
    </div>
  </div>
</div>

<style>
  #custom-sticky-atc-bar.custom-sticky-atc {
    position: fixed !important;
    bottom: 0 !important;
    left: 0 !important;
    right: 0 !important;
    width: 100% !important;
    background-color: #ffffff !important;
    box-shadow: 0 -4px 20px rgba(0, 0, 0, 0.1) !important;
    padding: 14px 24px !important;
    z-index: 999999 !important;
    transform: translateY(100%);
    transition: transform 0.3s ease-in-out;
    border-top: 1px solid #e5e5e5;
    box-sizing: border-box;
  }

  #custom-sticky-atc-bar.custom-sticky-atc.is-visible {
    transform: translateY(0) !important;
  }

  .custom-sticky-container {
    max-width: 1300px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }

  .custom-sticky-left {
    display: flex;
    align-items: center;
    gap: 24px;
    flex-wrap: wrap;
  }

  .custom-sticky-prices {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 16px;
  }

  .custom-compare-price {
    text-decoration: line-through;
    color: #888;
    font-size: 15px;
  }

  .custom-current-price {
    font-weight: 700;
    color: #121212;
    font-size: 18px;
  }

  .custom-save-badge {
    background-color: #eaf6ea;
    color: #2b7a2b;
    padding: 4px 10px;
    border-radius: 20px;
    font-size: 13px;
    font-weight: 600;
  }

  .custom-sticky-perks {
    display: flex;
    align-items: center;
    gap: 15px;
    font-size: 13px;
    color: #555;
  }

  .custom-sticky-right .custom-sticky-btn {
    background-color: #8b7355; /* Apne theme ke button color se match kar lein */
    color: #fff;
    border: none;
    padding: 14px 32px;
    font-size: 15px;
    font-weight: 600;
    border-radius: 4px;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 8px;
    transition: background-color 0.2s ease;
    white-space: nowrap;
  }

  .custom-sticky-btn:hover {
    background-color: #725d43;
  }

  .custom-sticky-btn:disabled {
    background-color: #ccc;
    cursor: not-allowed;
  }

  /* Responsive Design for Mobile */
  @media screen and (max-width: 768px) {
    .custom-sticky-perks {
      display: none; /* Mobile par space bachane ke liye perks hide kar diye hain */
    }
    .custom-sticky-container {
      gap: 10px;
    }
    .custom-sticky-prices {
      font-size: 14px;
    }
    .custom-current-price {
      font-size: 15px;
    }
    .custom-save-badge {
      font-size: 11px;
      padding: 2px 6px;
    }
    #custom-sticky-atc-bar.custom-sticky-atc {
      padding: 10px 15px !important;
    }
    .custom-sticky-right .custom-sticky-btn {
      padding: 10px 18px;
      font-size: 14px;
    }
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    const stickyBar = document.getElementById("custom-sticky-atc-bar");
    const mainAddToCartBtn = document.querySelector(".product-form__submit, form[action*='/cart/add'] button[type='submit']");
    // Product section container ko target karne ke liye
    const productSection = document.querySelector(".product, .product-section, section[id*='product']");

    if (!stickyBar || !mainAddToCartBtn) return;

    // Bar ko document body ke end mein move kar dete hain
    document.body.appendChild(stickyBar);

    function checkVisibility() {
      const btnRect = mainAddToCartBtn.getBoundingClientRect();
      const windowHeight = window.innerHeight || document.documentElement.clientHeight;
      
      // Check karein ke kya user abhi product section ke andar hi hai ya nahi
      let isProductInView = true;
      if (productSection) {
        const sectionRect = productSection.getBoundingClientRect();
        // Product section tabhi view mein hai jab tak uska koi hissa screen par hai
        isProductInView = (sectionRect.top <= windowHeight && sectionRect.bottom >= 0);
      }

      // Main button screen view se bahar nikal gaya ho (upar ya neeche)
      const isBtnOutOfView = (btnRect.top > windowHeight) || (btnRect.bottom < 0);

      // Sticky bar sirf tab show hoga jab user product section ke andar ho AUR main button screen par na ho
      if (isProductInView && isBtnOutOfView) {
        stickyBar.classList.add("is-visible");
      } else {
        stickyBar.classList.remove("is-visible");
      }
    }

    window.addEventListener("scroll", checkVisibility, { passive: true });
    window.addEventListener("resize", checkVisibility, { passive: true });
    
    // Initial check
    checkVisibility();
  });
</script>