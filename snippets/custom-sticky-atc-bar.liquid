{%- comment -%}
  Right Column Sticky Box with Direct Form Submission Sync
  Usage: {% render 'custom-sticky-atc-bar' %}
{%- endcomment -%}

{%- assign current_variant = product.selected_or_first_available_variant -%}

<div id="right-column-sticky-box" class="right-column-sticky-box">
  <div class="rac-content">
    <div class="sticky-left">
      <div class="rac-price-row">
        <div class="rac-prices" id="DesktopSticky-Price-{{ section.id }}">
          {%- if current_variant.metafields.custom.deck_price.value -%}
            {%- assign deck_price_cents = current_variant.metafields.custom.deck_price.value | times: 100 -%}
            <span class="rac-compare-price" id="DesktopSticky-DeckPrice-{{ section.id }}">
              {{ deck_price_cents | money }}
            </span>
          {%- endif -%}

          <span class="rac-current-price" id="DesktopSticky-CurrentPrice-{{ section.id }}">
            {{ current_variant.price | money }}
          </span>
          
        </div>
      </div>

      <!-- Trust Badges -->
      <div class="rac-perks">
        <span class="rac-perk-item">
          <svg class="hanso-product-main__benefit-icon" viewBox="0 0 21 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M19.8238 9.11206C19.8238 15.2808 16.068 20.8518 10.3404 23.1429C4.61289 20.8518 0.857178 15.2808 0.857178 9.11206V2.73013L10.3404 0.857178L19.8238 2.73013V9.11206Z" stroke="currentColor" stroke-miterlimit="10"></path><path d="M6.68572 14.5716V8.57163H7.65429V14.5716H6.68572ZM5.48572 9.45449V8.57163H7.56857V9.45449H5.48572ZM12.1886 14.6575C11.7371 14.6575 11.3229 14.5318 10.9457 14.2804C10.5743 14.0232 10.2771 13.6632 10.0543 13.2004C9.83142 12.7375 9.72 12.1918 9.72 11.5632C9.72 10.9347 9.8286 10.3918 10.0457 9.93466C10.2686 9.4718 10.5657 9.11463 10.9371 8.86323C11.3085 8.61183 11.72 8.48608 12.1714 8.48608C12.6285 8.48608 13.0429 8.61183 13.4143 8.86323C13.7857 9.11463 14.08 9.4718 14.2971 9.93466C14.52 10.3918 14.6314 10.9375 14.6314 11.5718C14.6314 12.2003 14.52 12.7461 14.2971 13.2089C14.08 13.6718 13.7857 14.029 13.4143 14.2804C13.0485 14.5318 12.64 14.6575 12.1886 14.6575ZM12.1714 13.7318C12.4686 13.7318 12.7257 13.6518 12.9429 13.4918C13.16 13.3318 13.3286 13.0918 13.4486 12.7718C13.5743 12.4518 13.6371 12.049 13.6371 11.5632C13.6371 11.0832 13.5743 10.6832 13.4486 10.3632C13.3286 10.0433 13.1571 9.80608 12.9343 9.6518C12.7172 9.49177 12.4629 9.4118 12.1714 9.4118C11.88 9.4118 11.6229 9.49177 11.4 9.6518C11.1829 9.80608 11.0143 10.0433 10.8943 10.3632C10.7743 10.6775 10.7143 11.0775 10.7143 11.5632C10.7143 12.049 10.7743 12.4518 10.8943 12.7718C11.0143 13.0918 11.1829 13.3318 11.4 13.4918C11.6229 13.6518 11.88 13.7318 12.1714 13.7318Z" fill="currentColor"></path></svg>
          10-Year Warranty</span>
        <span class="rac-perk-item"><svg class="hanso-product-main__benefit-icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M8.37075 11.2583C10.4598 12.579 12.0207 14.939 12.0207 14.939H12.052C12.052 14.939 15.368 9.0712 21.5286 5.4624" stroke="currentColor" stroke-linecap="square"></path><path d="M11.7212 21.25C16.8298 21.25 20.9712 17.1086 20.9712 12C20.9712 6.89137 16.8298 2.75 11.7212 2.75C6.61256 2.75 2.47119 6.89137 2.47119 12C2.47119 17.1086 6.61256 21.25 11.7212 21.25Z" stroke="currentColor" stroke-linecap="round" clip-rule="evenodd" fill-rule="evenodd"></path></svg>
          100-Day Money Back</span>
      </div>
    </div>
    <div class="rac-action">
      <button 
        type="button" 
        id="DesktopSticky-AddToCartBtn-{{ section.id }}" 
        class="rac-btn button button--primary"
        {% unless current_variant.available %}disabled{% endunless %}
      >
        <span>{% if current_variant.available %}Add to cart{% else %}Sold Out{% endif %}</span>
      </button>
    </div>

  </div>
</div>

<style>
  #right-column-sticky-box.right-column-sticky-box {
    display: none !important;
    position: sticky !important;
    bottom: 20px !important;
    width: calc(100% + 40px) !important; /* Width ko column se thoda barha diya hai */
    margin-left: -20px !important;     /* Left side se stretch karne ke liye */
    margin-right: -20px !important;    /* Right side se stretch karne ke liye */
    background-color: #ffffff !important;
    box-shadow: 0 5px 25px rgba(0, 0, 0, 0.12) !important;
    padding: 18px 24px !important;     /* Andar ki padding thodi adjust kar di */
    border-radius: 8px !important;
    z-index: 6 !important;
    border: 1px solid #e5e5e5 !important;
    box-sizing: border-box;
    margin-top: 20px;
  }

  #right-column-sticky-box.right-column-sticky-box.is-visible {
    display: block !important;
  }

  .rac-content {
    display: flex;
    gap: 12px;
    width: 100%;
    align-items: center;
  }
  .sticky-left{
    width: 60%;
  }
  .rac-action {
    width: 40%;
  }

  .rac-price-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .rac-prices {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  .rac-compare-price {
    text-decoration: line-through;
    color: #888;
    font-size: 14px;
  }

  .rac-current-price {
    font-size: 18px;
    font-weight: 700;
    color: #121212;
  }

  .rac-save-badge {
    background-color: #eaf6ea;
    color: #2b7a2b;
    padding: 3px 8px;
    border-radius: 12px;
    font-size: 12px;
    font-weight: 600;
  }

  .rac-perks {
    display: flex;
    align-items: center;
    gap: 15px;
    font-size: 12px;
    color: #555;
    padding-top: 8px;
  }

  .rac-perk-item {
    display:flex;
    align-items:center;
    gap: 12px;
  }
  .rac-perk-item svg {
    width:15px;
  }


  .rac-btn {
    background-color: #194636 !important; /* Aapke theme ka button color */
    color: #fff !important;
    border: none !important;
    width: 100% !important;
    padding: 14px 20px !important;
    font-size: 16px !important;
    font-weight: 600 !important;
    border-radius: 4px !important;
    cursor: pointer !important;
    text-align: center;
    transition: background-color 0.2s ease;
  }

  .rac-btn:hover {
    background-color: #123327 !important;
  }

  .rac-btn:disabled {
    background-color: #ccc !important;
    cursor: not-allowed !important;
  }
</style>

<script>
  (function() {
    const productData = {{ product | json }};
    const moneyFormat = "{{ shop.money_format | escape }}";

    {% if product.variants.size > 0 %}
      const variantMetafields = {
        {% for variant in product.variants %}
          "{{ variant.id }}": {
            "deck_price": {% if variant.metafields.custom.deck_price.value %}{{ variant.metafields.custom.deck_price.value | times: 100 }}{% else %}null{% endif %}
          }{% unless forloop.last %},{% endunless %}
        {% endfor %}
      };
      
      productData.variants = productData.variants.map(v => {
        if (variantMetafields[v.id]) {
          v.deck_price = variantMetafields[v.id].deck_price;
        }
        return v;
      });
    {% endif %}

    function formatMoney(cents, format) {
      if (typeof cents === 'string') cents = cents.replace('.', '');
      let value = '';
      const placeholderRegex = /\{\{\s*(\w+)\s*\}\}/;
      const formatString = format || '${{amount}}';

      function defaultOption(opt, def) {
        return (typeof opt == 'undefined') ? def : opt;
      }

      function formatWithDelimiters(number, precision, thousands, decimal) {
        precision = defaultOption(precision, 2);
        thousands = defaultOption(thousands, ',');
        decimal   = defaultOption(decimal, '.');

        if (isNaN(number) || number == null) return 0;

        number = (number / 100.0).toFixed(precision);

        const parts = number.split('.');
        const dollars = parts[0].replace(/(\d)(?=(\d\d\d)+(?!\d))/g, '$1' + thousands);
        const cents = parts[1] ? (decimal + parts[1]) : '';

        return dollars + cents;
      }

      switch (formatString.match(placeholderRegex)[1]) {
        case 'amount':
          value = formatWithDelimiters(cents, 2);
          break;
        case 'amount_no_decimals':
          value = formatWithDelimiters(cents, 0);
          break;
        case 'amount_with_comma_separator':
          value = formatWithDelimiters(cents, 2, '.', ',');
          break;
        case 'amount_no_decimals_with_space_separator':
          value = formatWithDelimiters(cents, 0, ' ');
          break;
      }

      return formatString.replace(placeholderRegex, value);
    }

    function initDesktopStickyATC() {
      const stickyBox = document.getElementById("right-column-sticky-box");
      const mainAddToCartBtn = document.querySelector(".product-form__submit, form[action*='/cart/add'] button[type='submit']");
      const productFormContainer = document.querySelector(".product-form, product-form, .product__info-container");

      if (!stickyBox || !mainAddToCartBtn) return;

      if (productFormContainer) {
        productFormContainer.appendChild(stickyBox);
      }

      function checkVisibility() {
        const btnRect = mainAddToCartBtn.getBoundingClientRect();
        const windowHeight = window.innerHeight || document.documentElement.clientHeight;
        const isBtnOutOfView = (btnRect.top > windowHeight) || (btnRect.bottom < 0);

        if (isBtnOutOfView) {
          stickyBox.classList.add("is-visible");
        } else {
          stickyBox.classList.remove("is-visible");
        }
      }

      window.addEventListener("scroll", checkVisibility, { passive: true });
      window.addEventListener("resize", checkVisibility, { passive: true });
      checkVisibility();

      const priceContainer = document.getElementById('DesktopSticky-Price-{{ section.id }}');
      const stickyActionBtn = document.getElementById('DesktopSticky-AddToCartBtn-{{ section.id }}');

      function updateStickyVariant(variant) {
        if (!variant) return;

        // Update Price
        if (priceContainer) {
          let priceHTML = '';
          if (variant.deck_price) {
            const formattedDeckPrice = formatMoney(variant.deck_price, moneyFormat);
            priceHTML += `<span class="rac-compare-price">${formattedDeckPrice}</span> `;
          }
          
          priceHTML += `<span class="rac-current-price">${formatMoney(variant.price, moneyFormat)}</span>`;
          priceHTML += ` <span class="rac-save-badge">Due Today</span>`;
          
          priceContainer.innerHTML = priceHTML;
        }

        // Update Button state
        if (stickyActionBtn) {
          if (variant.available) {
            stickyActionBtn.removeAttribute('disabled');
            stickyActionBtn.querySelector('span').textContent = "Add to cart";
          } else {
            stickyActionBtn.setAttribute('disabled', 'disabled');
            stickyActionBtn.querySelector('span').textContent = "Sold Out";
          }
        }
      }

      // Listen to theme variant change event
      document.addEventListener('variant:change', function(evt) {
        if (evt.detail && evt.detail.variant) {
          updateStickyVariant(evt.detail.variant);
        }
      });

      // Observe variant input value changes on main form
      const mainForm = document.querySelector('form[action*="/cart/add"]');
      const variantInput = mainForm ? mainForm.querySelector('input[name="id"]') : null;
      if (variantInput) {
        const observerVariantInput = new MutationObserver(() => {
          const selectedVariantId = parseInt(variantInput.value);
          if (productData && productData.variants) {
            const matchedVariant = productData.variants.find(v => v.id === selectedVariantId);
            if (matchedVariant) updateStickyVariant(matchedVariant);
          }
        });
        observerVariantInput.observe(variantInput, { attributes: true, attributeFilter: ['value'] });
      }

      // When sticky button is clicked, trigger the main product form's submit button
      if (stickyActionBtn) {
        stickyActionBtn.addEventListener('click', function(e) {
          e.preventDefault();
          const currentMainSubmit = mainForm ? mainForm.querySelector('[type="submit"], [name="add"]') : mainAddToCartBtn;
          if (currentMainSubmit && !currentMainSubmit.disabled) {
            currentMainSubmit.click();
          }
        });
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initDesktopStickyATC);
    } else {
      initDesktopStickyATC();
    }
  })();
</script>