{%- comment -%}
  Product + Offer structured data for a size collection (collection.deck-size), built from
  the variant pinned by the collection metafield custom.seo_variant_id. It sits alongside
  the CollectionPage markup; the offer points at the product URL with that variant selected.
  The rating is the product's reviews.rating / reviews.rating_count, as on the product page.
  On the deck-size-seo template the name and description come from the SEO entry. No return
  policy is declared: the store's policy (freight returns, deductions, promo orders final
  sale) can't be expressed accurately in MerchantReturnPolicy.

  Accepts:
  - sdp: {Metaobject} deck_size_page entry, optional
  - product: {Object} the pinned variant's product
  - variant: {Object} the pinned variant
  - heading: {String} page H1
  - image: {Object} hero image
  - rating_value / rating_count: {String} the store-wide rating shown on the page's review
    wall; used instead of the product's review metafields so schema matches what is visible
{%- endcomment -%}
{%- liquid
  assign product_url = request.origin | append: collection.url
  assign item_name = collection.title
  for opt in variant.options
    unless opt contains ' x '
      if product.variants.size > 1 and variant.options.size > 1
        assign item_name = item_name | append: ' (' | append: opt | append: ')'
      endif
    endunless
  endfor
  assign description = collection.metafields.global.description_tag | default: heading
  assign seo_template = false
  if template.suffix == 'deck-size-seo' and sdp != blank
    assign seo_template = true
    assign item_name = sdp.name.value | default: item_name
    assign description = sdp.seo_meta.value.schema_description | default: sdp.seo_meta.value.description | default: description
  endif
  assign rating_value = rating_value | default: product.metafields.reviews.rating.value.rating
  assign rating_count = rating_count | default: product.metafields.reviews.rating_count.value | default: 0 | remove: ',' | plus: 0
  assign item_image = image | default: variant.featured_media.preview_image | default: product.featured_media.preview_image
-%}
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Product",
    "name": {{ item_name | json }},
    "url": {{ product_url | json }},
    "description": {{ description | strip_html | json }},
    "brand": { "@type": "Brand", "name": {{ product.vendor | default: shop.name | json }} },
    {%- if item_image != blank %}
    "image": [{{ item_image | image_url: width: 1600 | prepend: 'https:' | json }}],
    {%- endif %}
    {%- if variant.sku != blank %}
    "sku": {{ variant.sku | json }},
    {%- endif %}
    {%- if rating_value != blank and rating_count > 0 %}
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": {{ rating_value | append: '' | json }},
      "ratingCount": {{ rating_count | json }},
      "bestRating": "5",
      "worstRating": "1"
    },
    {%- endif %}
    "offers": {
      "@type": "Offer",
      {%- if variant.sku != blank %}"sku": {{ variant.sku | json }},{% endif %}
      "price": {{ variant.price | divided_by: 100.0 | json }},
      "priceCurrency": {{ cart.currency.iso_code | json }},
      "availability": "https://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}",
      "url": {{ product_url | json }},
      "itemCondition": "https://schema.org/NewCondition",
      "seller": { "@type": "Organization", "name": {{ shop.name | json }} }
    }
  }
</script>
