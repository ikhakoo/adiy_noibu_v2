{% comment %}
  Mobile Sticky Add-to-Cart Bar (Fixed Real-time Price & Metafields Sync)
{% endcomment %}

{%- assign current_variant = product.selected_or_first_available_variant -%}

{%- assign current_v_deck = current_variant.metafields.custom.deck_price.value | times: 1 | default: 0 -%}
{%- assign current_v_disc = current_variant.metafields.custom.discount_value.value | times: 1 | default: 0 -%}
{%- assign current_v_offered = current_v_deck | minus: current_v_disc -%}
{%- if current_v_offered <= 0 -%}{%- assign current_v_offered = current_variant.price -%}{%- endif -%}
{%- assign current_save_amount = current_v_deck | minus: current_v_offered -%}

{%- comment -%} Variant Metafile JSON Mapping for JavaScript {%- endcomment -%}
<script type="application/json" id="VariantMetafieldsJson-{{ section.id }}">
  {
    {%- for variant in product.variants -%}
      {%- assign v_deck = variant.metafields.custom.deck_price.value | times: 1 | default: 0 -%}
      {%- assign v_disc = variant.metafields.custom.discount_value.value | times: 1 | default: 0 -%}
      {%- assign v_offered = v_deck | minus: v_disc -%}
      {%- if v_offered <= 0 -%}{%- assign v_offered = variant.price -%}{%- endif -%}
      {%- assign save_amt = v_deck | minus: v_offered -%}
      "{{ variant.id }}": {
        "deckPrice": {{ v_deck }},
        "discountValue": {{ v_disc }},
        "offeredPrice": {{ v_offered }},
        "saveAmount": {{ save_amt }},
        "dueTodayPrice": {{ variant.price }}
      }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  }
</script>

<div id="MobileStickyATC-{{ section.id }}" class="mobile-sticky-atc-wrapper">
  <div class="mobile-sticky-atc-content">
    
    <!-- Top Row: Prices & Save Badge -->
    <div class="mobile-sticky-atc-top-row">
      <div class="mobile-sticky-atc-price-wrap" id="MobileStickyATC-PriceWrap-{{ section.id }}">
        <span class="mobile-sticky-atc-deck-price" id="MobileStickyATC-DeckPrice-{{ section.id }}" style="{%- unless current_v_deck > 0 and current_v_deck > current_v_offered -%}display: none;{%- endunless -%}">
          {{ current_v_deck | money }}
        </span>
        <span class="mobile-sticky-atc-price" id="MobileStickyATC-Price-{{ section.id }}">
          {{ current_v_offered | money }}
        </span>
      </div>

      <div class="mobile-sticky-atc-save-badge-wrap" id="MobileStickyATC-SaveWrap-{{ section.id }}" style="{%- unless current_save_amount > 0 -%}display: none;{%- endunless -%}">
        <span class="mobile-sticky-atc-save-badge" id="MobileStickyATC-SaveBadge-{{ section.id }}">
          Save {{ current_save_amount | money }}
        </span>
      </div>
    </div>

    <!-- Middle Row: Trust Badges -->
    <div class="mobile-sticky-atc-trust-row">
      <div class="trust-badge-item">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        <span>10-Year Warranty</span>
      </div>
      <div class="trust-badge-item">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
        <span>100-Day Money Back</span>
      </div>
    </div>

    <!-- Bottom Row: Add to Cart Button -->
    <div class="mobile-sticky-atc-action">
      <button
        type="button"
        id="MobileStickyATC-Button-{{ section.id }}"
        class="mobile-sticky-atc-btn button button--primary"
        {% unless current_variant.available %}disabled{% endunless %}
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right: 6px; vertical-align: middle;"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>
        {%- if current_variant.available -%}
          {{ 'products.product.add_to_cart' | t | default: 'Add To Cart' }}
        {%- else -%}
          {{ 'products.product.sold_out' | t | default: 'Sold Out' }}
        {%- endif -%}
      </button>
    </div>

  </div>
</div>

<style>
  @media screen and (min-width: 751px) {
    .mobile-sticky-atc-wrapper {
      display: none !important;
    }
  }

  @media screen and (max-width: 750px) {
    .mobile-sticky-atc-wrapper {
      position: fixed;
      bottom: 0;
      left: 0;
      width: 100%;
      background: #ffffff;
      box-shadow: 0 -4px 16px rgba(0, 0, 0, 0.12);
      z-index: 999;
      padding: 10px 14px 12px 14px;
      transform: translateY(100%);
      transition: transform 0.3s ease-in-out;
      border-top: 1px solid #eaeaea;
      border-top-left-radius: 12px;
      border-top-right-radius: 12px;
    }

    .mobile-sticky-atc-wrapper.is-visible {
      transform: translateY(0);
    }

    .mobile-sticky-atc-content {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .mobile-sticky-atc-top-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
    }

    .mobile-sticky-atc-price-wrap {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .mobile-sticky-atc-deck-price {
      font-size: 13px;
      color: #888888;
      text-decoration: line-through;
      font-weight: 400;
    }

    .mobile-sticky-atc-price {
      font-size: 15px;
      font-weight: 700;
      color: #000000;
    }

    .mobile-sticky-atc-save-badge {
      background-color: #eaf3ec;
      color: #2e6930;
      font-size: 11px;
      font-weight: 600;
      padding: 3px 8px;
      border-radius: 12px;
      white-space: nowrap;
    }

    .mobile-sticky-atc-trust-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-size: 11px;
      color: #444;
      padding: 0 4px;
    }

    .trust-badge-item {
      display: flex;
      align-items: center;
      gap: 4px;
    }

    .trust-badge-item svg {
      stroke: #555;
    }

    .mobile-sticky-atc-btn {
      width: 100%;
      padding: 11px 16px;
      font-size: 14px;
      font-weight: 600;
      border-radius: 6px;
      background: #8b6f5d !important;
      color: #ffffff !important;
      border: none;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
    }
  }
</style>

<script>
  (function() {
    const productData = {{ product | json }};
    const moneyFormat = "{{ shop.money_format | escape }}";
    
    let variantMetafields = {};
    try {
      const metafieldsScript = document.getElementById('VariantMetafieldsJson-{{ section.id }}');
      if (metafieldsScript) {
        variantMetafields = JSON.parse(metafieldsScript.textContent);
      }
    } catch(e) {
      console.error('Error parsing variant metafields JSON:', e);
    }

    function formatMoney(cents, format) {
      if (typeof cents === 'string') cents = cents.replace('.', '');
      let value = '';
      const placeholderRegex = /\{\{\s*(\w+)\s*\}\}/;
      const formatString = format || '${{amount}}';

      function defaultOption(opt, def) {
        return (typeof opt == 'undefined') ? def : opt;
      }

      function formatWithDelimiters(number, precision, thousands, decimal) {
        precision = defaultOption(precision, 2);
        thousands = defaultOption(thousands, ',');
        decimal   = defaultOption(decimal, '.');

        if (isNaN(number) || number == null) return 0;

        number = (number / 100.0).toFixed(precision);

        const parts = number.split('.');
        const dollars = parts[0].replace(/(\d)(?=(\d\d\d)+(?!\d))/g, '$1' + thousands);
        const cents = parts[1] ? (decimal + parts[1]) : '';

        return dollars + cents;
      }

      const match = formatString.match(placeholderRegex);
      if (!match) return formatString;

      switch (match[1]) {
        case 'amount':
          value = formatWithDelimiters(cents, 2);
          break;
        case 'amount_no_decimals':
          value = formatWithDelimiters(cents, 0);
          break;
        case 'amount_with_comma_separator':
          value = formatWithDelimiters(cents, 2, '.', ',');
          break;
        case 'amount_no_decimals_with_space_separator':
          value = formatWithDelimiters(cents, 0, ' ');
          break;
      }

      return formatString.replace(placeholderRegex, value);
    }

    function initMobileStickyATC() {
      const stickyBar = document.getElementById('MobileStickyATC-{{ section.id }}');
      if (!stickyBar) return;

      const mainForm = document.querySelector('form[action*="/cart/add"]');
      const mainSubmitBtn = mainForm ? mainForm.querySelector('[type="submit"], [name="add"]') : null;
      const stickyBtn = document.getElementById('MobileStickyATC-Button-{{ section.id }}');
      const priceEl = document.getElementById('MobileStickyATC-Price-{{ section.id }}');
      const deckPriceEl = document.getElementById('MobileStickyATC-DeckPrice-{{ section.id }}');
      const saveWrapEl = document.getElementById('MobileStickyATC-SaveWrap-{{ section.id }}');
      const saveBadgeEl = document.getElementById('MobileStickyATC-SaveBadge-{{ section.id }}');

      if (!mainSubmitBtn) return;

      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (!entry.isIntersecting && window.innerWidth <= 750) {
            stickyBar.classList.add('is-visible');
          } else {
            stickyBar.classList.remove('is-visible');
          }
        });
      }, { threshold: 0 });

      observer.observe(mainSubmitBtn);

      function updateStickyVariant(variant) {
        if (!variant) return;

        const meta = variantMetafields[variant.id];
        let displayPrice = variant.price;
        let displayDeckPrice = 0;
        let displaySaveAmount = 0;

        if (meta) {
          displayDeckPrice = meta.deckPrice;
          displayPrice = meta.offeredPrice > 0 ? meta.offeredPrice : variant.price;
          displaySaveAmount = meta.saveAmount;
        }

        if (priceEl) {
          priceEl.innerHTML = formatMoney(displayPrice, moneyFormat);
        }

        if (deckPriceEl) {
          if (displayDeckPrice > 0 && displayDeckPrice > displayPrice) {
            deckPriceEl.style.display = 'inline';
            deckPriceEl.innerHTML = formatMoney(displayDeckPrice, moneyFormat);
          } else {
            deckPriceEl.style.display = 'none';
          }
        }

        if (saveWrapEl && saveBadgeEl) {
          if (displaySaveAmount > 0) {
            saveWrapEl.style.display = 'block';
            saveBadgeEl.innerHTML = 'Save ' + formatMoney(displaySaveAmount, moneyFormat);
          } else {
            saveWrapEl.style.display = 'none';
          }
        }

        if (stickyBtn) {
          if (variant.available) {
            stickyBtn.removeAttribute('disabled');
            stickyBtn.innerHTML = `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right: 6px; vertical-align: middle;"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>` + "{{ 'products.product.add_to_cart' | t | default: 'Add To Cart' }}";
          } else {
            stickyBtn.setAttribute('disabled', 'disabled');
            stickyBtn.textContent = "{{ 'products.product.sold_out' | t | default: 'Sold Out' }}";
          }
        }
      }

      document.addEventListener('variant:change', function(evt) {
        if (evt.detail && evt.detail.variant) {
          updateStickyVariant(evt.detail.variant);
        }
      });

      const variantInput = mainForm ? mainForm.querySelector('input[name="id"]') : null;
      if (variantInput) {
        const observerVariantInput = new MutationObserver(() => {
          const selectedVariantId = parseInt(variantInput.value);
          if (productData && productData.variants) {
            const matchedVariant = productData.variants.find(v => v.id === selectedVariantId);
            if (matchedVariant) updateStickyVariant(matchedVariant);
          }
        });
        observerVariantInput.observe(variantInput, { attributes: true, attributeFilter: ['value'] });
      }

      let lastUrl = location.href;
      new MutationObserver(() => {
        const url = location.href;
        if (url !== lastUrl) {
          lastUrl = url;
          const urlParams = new URLSearchParams(window.location.search);
          const variantId = parseInt(urlParams.get('variant'));
          if (variantId && productData && productData.variants) {
            const matchedVariant = productData.variants.find(v => v.id === variantId);
            if (matchedVariant) updateStickyVariant(matchedVariant);
          }
        }
      }).observe(document, { subtree: true, childList: true });

      if (stickyBtn) {
        stickyBtn.addEventListener('click', function(e) {
          e.preventDefault();
          if (mainSubmitBtn.disabled) return;
          
          mainSubmitBtn.click();

          const targetContainer = document.querySelector('.dp-actions-container');
          if (targetContainer) {
            targetContainer.scrollIntoView({
              behavior: 'smooth',
              block: 'center'
            });
          }
        });
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initMobileStickyATC);
    } else {
      initMobileStickyATC();
    }
  })();
</script>