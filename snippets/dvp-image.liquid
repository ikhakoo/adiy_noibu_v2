{%- comment -%}
  Deck vs Patio landing page · responsive cover-fit image inside a .dvp-media box.
  Falls back to a placeholder until an image is picked in the theme editor.

  Accepts:
  - image: {Object} image_picker value
  - alt: {String} SEO alt text (falls back to the file's alt)
  - sizes: {String}
  - eager: {Boolean} load eagerly with high fetch priority (hero only)
  - class: {String} extra classes for the wrapper
{%- endcomment -%}
<div class="dvp-media {{ class }}">
  {%- if image != blank -%}
    {%- assign dvp_alt = alt | default: image.alt -%}
    {%- assign dvp_pos = 'object-position: ' | append: image.presentation.focal_point -%}
    {%- if eager -%}
      {{ image | image_url: width: 2400 | image_tag: widths: '480, 720, 960, 1200, 1500, 1920, 2400', sizes: sizes, loading: 'eager', fetchpriority: 'high', alt: dvp_alt, style: dvp_pos }}
    {%- else -%}
      {{ image | image_url: width: 1800 | image_tag: widths: '360, 480, 720, 960, 1200, 1500, 1800', sizes: sizes, loading: 'lazy', alt: dvp_alt, style: dvp_pos }}
    {%- endif -%}
  {%- else -%}
    {{ 'lifestyle-1' | placeholder_svg_tag }}
  {%- endif -%}
</div>
