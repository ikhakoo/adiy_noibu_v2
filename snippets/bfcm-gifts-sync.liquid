{%- comment -%}
  BFCM free gifts — site-wide cart sync config. Rendered once in layout/theme.liquid.

  Rule (enforced by assets/bfcm-gifts.js until `bfcm_end`):
  - cart contains any product whose type is `qualifying_type` → each gift is in the cart at qty 1
  - no qualifying product in the cart → gift lines are removed

  Gifts are looked up by handle. If a gift product doesn't exist (or isn't
  available on the Online Store) it's skipped; with none found, nothing loads.
{%- endcomment -%}

{%- liquid
  assign bfcm_end = '2026-11-30T23:59:59-05:00'
  assign qualifying_type = 'Deck Kit'
  assign gift_handles = 'bfcm-gift-bougerv-portable-fridge,bfcm-gift-bougerv-heated-blanket' | split: ','

  assign now_s = 'now' | date: '%s' | plus: 0
  assign end_s = bfcm_end | date: '%s' | plus: 0

  assign gift_ids = ''
  for handle in gift_handles
    assign gift = all_products[handle]
    if gift != blank and gift.available
      assign gift_ids = gift_ids | append: gift.selected_or_first_available_variant.id | append: ','
    endif
  endfor
  assign gift_ids = gift_ids | split: ','

  comment
    Decide server-side whether the current cart is already correct, so the
    script only touches the cart API on page load when something is off.
  endcomment
  assign has_deck = false
  assign gift_line_count = 0
  assign gifts_wrong = false
  for item in cart.items
    if item.product.type == qualifying_type
      assign has_deck = true
    endif
    assign vid = item.variant_id | append: ''
    if gift_ids contains vid
      assign gift_line_count = gift_line_count | plus: 1
      if item.quantity != 1
        assign gifts_wrong = true
      endif
    endif
  endfor
  assign needs_sync = false
  if has_deck and gift_line_count != gift_ids.size
    assign needs_sync = true
  elsif has_deck == false and gift_line_count > 0
    assign needs_sync = true
  elsif gifts_wrong
    assign needs_sync = true
  endif
-%}

{%- if gift_ids.size > 0 and now_s < end_s -%}
  <script type="application/json" id="BfcmGiftsConfig">
    {
      "end": {{ bfcm_end | json }},
      "qualifyingType": {{ qualifying_type | json }},
      "giftVariantIds": [{% for id in gift_ids %}{{ id | plus: 0 }}{% unless forloop.last %},{% endunless %}{% endfor %}],
      "needsSync": {{ needs_sync }}
    }
  </script>
  <script src="{{ 'bfcm-gifts.js' | asset_url }}" defer="defer"></script>
{%- endif -%}
