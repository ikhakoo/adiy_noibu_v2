{%- comment -%}
  State SEO landing pages · responsive image inside a .ss-media box (cover-fit).
  Falls back to a placeholder until an image is picked in the theme editor.

  Accepts:
  - image: {Object} image_picker value
  - alt: {String} SEO alt text (falls back to the file's alt)
  - sizes: {String}
  - eager: {Boolean} load eagerly with high fetch priority (hero only)
  - class: {String} extra classes for the wrapper
  - attrs: {String} extra attributes for the wrapper (block.shopify_attributes)
  - placeholder: {String} placeholder_svg_tag name (default lifestyle-1)
  - position: {String} object-position override, e.g. '50% 65%' (default: the image's focal point)
{%- endcomment -%}
<div class="ss-media {{ class }}" {{ attrs }}>
  {%- if image != blank -%}
    {%- assign ss_alt = alt | default: image.alt -%}
    {%- assign ss_pos = 'object-position: ' | append: image.presentation.focal_point -%}
    {%- if position != blank -%}{%- assign ss_pos = 'object-position: ' | append: position -%}{%- endif -%}
    {%- if eager -%}
      {{ image | image_url: width: 1800 | image_tag: widths: '480, 720, 960, 1200, 1500, 1800', sizes: sizes, loading: 'eager', fetchpriority: 'high', alt: ss_alt, style: ss_pos }}
    {%- else -%}
      {{ image | image_url: width: 1800 | image_tag: widths: '360, 480, 720, 960, 1200, 1500, 1800', sizes: sizes, loading: 'lazy', alt: ss_alt, style: ss_pos }}
    {%- endif -%}
  {%- else -%}
    {%- assign ss_placeholder = placeholder | default: 'lifestyle-1' -%}
    {{ ss_placeholder | placeholder_svg_tag }}
  {%- endif -%}
</div>
