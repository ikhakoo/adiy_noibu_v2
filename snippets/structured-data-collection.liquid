{%- comment -%}
  ItemList for collection and search listings, so an answer engine can see what a
  listing URL actually contains rather than inferring it from the layout.

  Emitted only when there is something to list. Note that this theme disables
  `main-collection-product-grid`, so a collection can render with products in
  `collection.products` that are not visible on the page - the list still
  describes the collection truthfully, and each entry links to the product URL.
{%- endcomment -%}

{%- liquid
  assign list_items = ''
  comment
    The deck-sizes template emits its own ItemList (sections/sdp-collection.liquid).
    Products tagged hide-product (the size SEO pages) are left out of every other list.
  endcomment
  if request.page_type == 'collection' and collection.template_suffix != 'deck-sizes'
    assign list_items = collection.products
    assign list_name = collection.title
  endif
-%}

{%- if list_items.size > 0 -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "ItemList",
      "name": {{ list_name | strip_html | json }},
      "url": {{ request.origin | append: collection.url | json }},
      "itemListElement": [
        {%- assign list_position = 0 -%}
        {%- for item in list_items limit: 30 -%}
          {%- if item.tags contains 'hide-product' -%}{%- continue -%}{%- endif -%}
          {%- assign list_position = list_position | plus: 1 -%}
          {%- if list_position > 1 -%},{%- endif -%}
          {
            "@type": "ListItem",
            "position": {{ list_position }},
            "url": {{ request.origin | append: item.url | json }},
            "name": {{ item.title | strip_html | json }}
          }
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}
